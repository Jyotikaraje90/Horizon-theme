<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign p = section.settings.product | default: product
  assign cur = p.selected_or_first_available_variant | default: p.variants.first

  assign color_names = section.settings.color_option_names | downcase | split: ','

  assign serif = "'Playfair Display', serif"
  assign sans  = "'Proxima Nova', 'Nunito Sans', sans-serif"

  assign title_font = serif
  if section.settings.title_font == 'sans'
    assign title_font = sans
  endif

  comment
    Rating: read from a review app metafield when present, otherwise fall back to
    the section setting so the design still renders on a store without reviews.
  endcomment
  assign rating_value = section.settings.fallback_rating
  if p.metafields.reviews.rating.value.rating
    assign rating_value = p.metafields.reviews.rating.value.rating
  endif
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
-%}

<style>
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;

    /* Layout */
    --pi-pdp-max-width: {{ section.settings.content_width }}px;
    --pi-pdp-col-gap: {{ section.settings.column_gap }}px;
    --pi-pdp-info-width: {{ section.settings.info_width }}px;
    --pi-pdp-info-gap: {{ section.settings.info_gap }}px;
    --pi-pdp-pad-top: {{ section.settings.padding_top }}px;
    --pi-pdp-pad-bottom: {{ section.settings.padding_bottom }}px;
    --pi-pdp-gutter: {{ section.settings.side_gutter }}px;

    /* Gallery */
    --pi-pdp-thumb-size: {{ section.settings.thumb_size }}px;
    --pi-pdp-thumb-gap: {{ section.settings.thumb_gap }}px;
    --pi-pdp-thumb-radius: {{ section.settings.thumb_radius }}px;
    --pi-pdp-thumb-border: {{ section.settings.thumb_border_color }};
    --pi-pdp-media-radius: {{ section.settings.media_radius }}px;
    --pi-pdp-stage-height: {{ section.settings.stage_height }}px;
    --pi-pdp-tile-bg: {{ section.settings.tile_bg }};

    /* Badge */
    --pi-pdp-badge-bg: {{ section.settings.badge_bg }};
    --pi-pdp-badge-color: {{ section.settings.badge_text_color }};
    --pi-pdp-badge-radius: {{ section.settings.badge_radius }}px;
    --pi-pdp-badge-size: {{ section.settings.badge_size }}px;
    --pi-pdp-wishlist-color: {{ section.settings.wishlist_color }};

    /* Typography */
    --pi-pdp-title-font: {{ title_font }};
    --pi-pdp-title-size: {{ section.settings.title_size }}px;
    --pi-pdp-title-weight: {{ section.settings.title_weight }};
    --pi-pdp-title-color: {{ section.settings.title_color }};
    --pi-pdp-price-size: {{ section.settings.price_size }}px;
    --pi-pdp-price-color: {{ section.settings.price_color }};
    --pi-pdp-compare-color: {{ section.settings.compare_price_color }};
    --pi-pdp-star-size: {{ section.settings.star_size }}px;

    /* Options */
    --pi-pdp-option-label-size: {{ section.settings.option_label_size }}px;
    --pi-pdp-option-label-color: {{ section.settings.option_label_color }};
    --pi-pdp-swatch-size: {{ section.settings.swatch_size }}px;
    --pi-pdp-swatch-radius: {{ section.settings.swatch_radius }}px;
    --pi-pdp-swatch-bg: {{ section.settings.swatch_bg }};
    --pi-pdp-swatch-border: {{ section.settings.swatch_border_color }};
    --pi-pdp-swatch-active: {{ section.settings.swatch_selected_border_color }};
    --pi-pdp-pill-bg: {{ section.settings.pill_bg }};
    --pi-pdp-pill-color: {{ section.settings.pill_text_color }};
    --pi-pdp-pill-active-bg: {{ section.settings.pill_selected_bg }};
    --pi-pdp-pill-active-color: {{ section.settings.pill_selected_text_color }};
    --pi-pdp-pill-radius: {{ section.settings.pill_radius }}px;
    --pi-pdp-pill-size: {{ section.settings.pill_size }}px;

    /* Buy row */
    --pi-pdp-control-height: {{ section.settings.control_height }}px;
    --pi-pdp-qty-width: {{ section.settings.qty_width }}px;
    --pi-pdp-qty-border: {{ section.settings.qty_border_color }};
    --pi-pdp-qty-radius: {{ section.settings.qty_radius }}px;
    --pi-pdp-btn-bg: {{ section.settings.btn_bg }};
    --pi-pdp-btn-text: {{ section.settings.btn_text }};
    --pi-pdp-btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --pi-pdp-btn-hover-text: {{ section.settings.btn_hover_text }};
    --pi-pdp-btn-radius: {{ section.settings.btn_radius }}px;
    --pi-pdp-btn-size: {{ section.settings.btn_size }}px;
    --pi-pdp-btn-disabled-bg: {{ section.settings.btn_disabled_bg }};

    /* Accordions */
    --pi-pdp-acc-heading-size: {{ section.settings.acc_heading_size }}px;
    --pi-pdp-acc-heading-color: {{ section.settings.acc_heading_color }};
    --pi-pdp-acc-text-size: {{ section.settings.acc_text_size }}px;
    --pi-pdp-acc-text-color: {{ section.settings.acc_text_color }};
    --pi-pdp-acc-icon-color: {{ section.settings.acc_icon_color }};
    --pi-pdp-acc-row-padding: {{ section.settings.acc_row_padding }}px;
    --pi-pdp-line: {{ section.settings.divider_color }};

    /* Share */
    --pi-pdp-share-label-size: {{ section.settings.share_label_size }}px;
    --pi-pdp-share-label-color: {{ section.settings.share_label_color }};
    --pi-pdp-share-size: {{ section.settings.share_icon_size }}px;
    --pi-pdp-share-bg: {{ section.settings.share_icon_bg }};
    --pi-pdp-share-color: {{ section.settings.share_icon_color }};
    --pi-pdp-share-hover-bg: {{ section.settings.share_icon_hover_bg }};
    --pi-pdp-share-hover-color: {{ section.settings.share_icon_hover_color }};
    --pi-pdp-share-radius: {{ section.settings.share_icon_radius }}px;
  }

  .pi-pdp {
    background: {{ section.settings.bg_color }};
  }
  .pi-pdp__inner {
    max-width: calc(var(--pi-pdp-max-width) + (var(--pi-pdp-gutter) * 2));
    margin: 0 auto;
    padding: var(--pi-pdp-pad-top) var(--pi-pdp-gutter) var(--pi-pdp-pad-bottom);
    box-sizing: border-box;
  }

  /* ── Row: [thumbs + image] + gap + [info] ── */
  .pi-pdp__row {
    display: flex;
    flex-direction: {% if section.settings.media_position == 'right' %}row-reverse{% else %}row{% endif %};
    align-items: flex-start;
    gap: var(--pi-pdp-col-gap);
    width: 100%;
  }

  /* ── Media ── */
  .pi-pdp__media {
    display: flex;
    flex-direction: {% if section.settings.thumb_position == 'right' %}row-reverse{% else %}row{% endif %};
    align-items: flex-start;
    gap: var(--pi-pdp-thumb-gap);
    flex: 1 1 auto;
    min-width: 0;
    {% if section.settings.sticky_media %}position: sticky; top: {{ section.settings.sticky_offset }}px;{% endif %}
  }
  .pi-pdp__thumbs {
    display: flex;
    flex-direction: column;
    gap: var(--pi-pdp-thumb-gap);
    width: var(--pi-pdp-thumb-size);
    flex: 0 0 var(--pi-pdp-thumb-size);
  }
  .pi-pdp__thumb {
    width: var(--pi-pdp-thumb-size);
    height: var(--pi-pdp-thumb-size);
    box-sizing: border-box;
    border: {{ section.settings.thumb_border_width }}px solid var(--pi-pdp-thumb-border);
    border-radius: var(--pi-pdp-thumb-radius);
    background: var(--pi-pdp-tile-bg);
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    display: block;
    appearance: none;
    -webkit-appearance: none;
    transition: box-shadow 0.15s ease;
  }
  .pi-pdp__thumb img,
  .pi-pdp__thumb .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    {% if section.settings.multiply_blend %}mix-blend-mode: multiply;{% endif %}
    display: block;
  }
  .pi-pdp__thumb.is-active { box-shadow: 0 0 0 {{ section.settings.thumb_border_width }}px var(--pi-pdp-thumb-border) inset; }

  .pi-pdp__stage {
    flex: 1 1 auto;
    min-width: 0;
    height: var(--pi-pdp-stage-height);
    background: var(--pi-pdp-tile-bg);
    border-radius: var(--pi-pdp-media-radius);
    overflow: hidden;
    position: relative;
  }
  .pi-pdp__stage img,
  .pi-pdp__stage .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    {% if section.settings.multiply_blend %}mix-blend-mode: multiply;{% endif %}
    display: block;
  }

  /* ── Info column ── */
  .pi-pdp__info {
    flex: 0 0 var(--pi-pdp-info-width);
    max-width: var(--pi-pdp-info-width);
    display: flex;
    flex-direction: column;
    gap: var(--pi-pdp-info-gap);
  }
  .pi-pdp__head {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.head_gap }}px;
  }

  .pi-pdp__badge-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .pi-pdp__badge {
    display: inline-flex;
    align-items: center;
    padding: {{ section.settings.badge_padding_y }}px {{ section.settings.badge_padding_x }}px;
    border-radius: var(--pi-pdp-badge-radius);
    background: var(--pi-pdp-badge-bg);
    font-family: {{ sans }};
    font-size: var(--pi-pdp-badge-size);
    font-weight: 400;
    line-height: 1.3;
    color: var(--pi-pdp-badge-color);
    white-space: nowrap;
  }
  .pi-pdp__wishlist {
    width: {{ section.settings.wishlist_size }}px;
    height: {{ section.settings.wishlist_size }}px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease;
  }
  .pi-pdp__wishlist:hover { transform: scale(1.12); }
  .pi-pdp__wishlist svg { width: 100%; height: 100%; display: block; }
  .pi-pdp__wishlist-path { stroke: var(--pi-pdp-wishlist-color); }
  .pi-pdp__wishlist.is-active .pi-pdp__wishlist-path { fill: var(--pi-pdp-wishlist-color); }

  .pi-pdp__titleblock {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.title_block_gap }}px;
    width: 100%;
  }
  .pi-pdp__title {
    font-family: var(--pi-pdp-title-font);
    font-size: var(--pi-pdp-title-size);
    font-weight: var(--pi-pdp-title-weight);
    line-height: {{ section.settings.title_line_height }};
    color: var(--pi-pdp-title-color);
    margin: 0;
  }
  .pi-pdp__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: {{ sans }};
    font-size: var(--pi-pdp-price-size);
    font-weight: {{ section.settings.price_weight }};
    line-height: 1.3;
    color: var(--pi-pdp-price-color);
    margin: 0;
  }
  .pi-pdp__price-compare {
    font-size: {{ section.settings.compare_price_size }}px;
    font-weight: 400;
    color: var(--pi-pdp-compare-color);
    text-decoration: line-through;
  }
  .pi-pdp__rating {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ section.settings.star_gap }}px;
  }
  .pi-pdp__rating svg {
    width: var(--pi-pdp-star-size);
    height: var(--pi-pdp-star-size);
    display: block;
  }
  .pi-pdp__rating-count {
    font-family: {{ sans }};
    font-size: 14px;
    color: {{ section.settings.rating_count_color }};
    margin-left: 5px;
  }

  /* ── Options ── */
  .pi-pdp__options {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.option_group_gap }}px;
  }
  .pi-pdp__option {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.option_inner_gap }}px;
  }
  .pi-pdp__option-label {
    font-family: {{ sans }};
    font-size: var(--pi-pdp-option-label-size);
    font-weight: {{ section.settings.option_label_weight }};
    line-height: 1.3;
    color: var(--pi-pdp-option-label-color);
    margin: 0;
  }
  .pi-pdp__option-selected {
    font-weight: 400;
    opacity: 0.75;
    margin-left: 6px;
  }

  .pi-pdp__swatches,
  .pi-pdp__pills {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: {{ section.settings.value_gap }}px;
  }
  .pi-pdp__swatch {
    width: var(--pi-pdp-swatch-size);
    height: var(--pi-pdp-swatch-size);
    box-sizing: border-box;
    border: {{ section.settings.swatch_border_width }}px solid var(--pi-pdp-swatch-border);
    border-radius: var(--pi-pdp-swatch-radius);
    background: var(--pi-pdp-swatch-bg);
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .pi-pdp__swatch img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    {% if section.settings.multiply_blend %}mix-blend-mode: multiply;{% endif %}
    display: block;
  }
  .pi-pdp__swatch-fill { position: absolute; inset: 0; }
  a.pi-pdp__sibling { display: block; text-decoration: none; }
  .pi-pdp__swatch.is-selected {
    border-color: var(--pi-pdp-swatch-active);
    box-shadow: 0 0 0 {{ section.settings.swatch_border_width }}px var(--pi-pdp-swatch-active) inset;
  }
  .pi-pdp__swatch.is-unavailable { opacity: 0.4; }

  .pi-pdp__pill {
    padding: {{ section.settings.pill_padding_y }}px {{ section.settings.pill_padding_x }}px;
    border-radius: var(--pi-pdp-pill-radius);
    border: 1px solid transparent;
    background: var(--pi-pdp-pill-bg);
    font-family: {{ sans }};
    font-size: var(--pi-pdp-pill-size);
    font-weight: 400;
    line-height: 1.3;
    color: var(--pi-pdp-pill-color);
    cursor: pointer;
    white-space: nowrap;
    appearance: none;
    -webkit-appearance: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pi-pdp__pill.is-selected {
    background: var(--pi-pdp-pill-active-bg);
    color: var(--pi-pdp-pill-active-color);
  }
  .pi-pdp__pill.is-unavailable { opacity: 0.45; text-decoration: line-through; }

  /* ── Quantity + Add to cart ── */
  .pi-pdp__buy {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: {{ section.settings.buy_gap }}px;
    width: 100%;
  }
  .pi-pdp__qty {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: var(--pi-pdp-qty-width);
    flex: 0 0 var(--pi-pdp-qty-width);
    height: var(--pi-pdp-control-height);
    box-sizing: border-box;
    border: 1px solid var(--pi-pdp-qty-border);
    border-radius: var(--pi-pdp-qty-radius);
    padding: 0 8px;
  }
  .pi-pdp__qty-btn {
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    color: var(--pi-pdp-qty-border);
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
  }
  .pi-pdp__qty-input {
    width: 40px;
    border: none;
    text-align: center;
    font-family: {{ sans }};
    font-size: 16px;
    color: var(--pi-pdp-qty-border);
    background: transparent;
    -moz-appearance: textfield;
  }
  .pi-pdp__qty-input::-webkit-outer-spin-button,
  .pi-pdp__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .pi-pdp__atc {
    flex: 1 1 auto;
    height: var(--pi-pdp-control-height);
    background: var(--pi-pdp-btn-bg);
    color: var(--pi-pdp-btn-text);
    border: 1px solid var(--pi-pdp-btn-bg);
    border-radius: var(--pi-pdp-btn-radius);
    font-family: {{ sans }};
    font-size: var(--pi-pdp-btn-size);
    font-weight: 600;
    letter-spacing: {{ section.settings.btn_letter_spacing }}px;
    text-transform: {{ section.settings.btn_text_case }};
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .pi-pdp__atc:hover:not([disabled]) {
    background: var(--pi-pdp-btn-hover-bg);
    border-color: var(--pi-pdp-btn-hover-bg);
    color: var(--pi-pdp-btn-hover-text);
  }
  .pi-pdp__atc[disabled] {
    background: var(--pi-pdp-btn-disabled-bg);
    border-color: var(--pi-pdp-btn-disabled-bg);
    cursor: not-allowed;
  }

  /* ── Accordions ── */
  .pi-pdp__accordions { display: flex; flex-direction: column; }
  .pi-pdp__acc { border-bottom: 1px solid var(--pi-pdp-line); }
  .pi-pdp__acc:first-child { border-top: 1px solid var(--pi-pdp-line); }
  .pi-pdp__acc-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: var(--pi-pdp-acc-row-padding) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: {{ sans }};
    font-size: var(--pi-pdp-acc-heading-size);
    font-weight: 600;
    line-height: 1.35;
    color: var(--pi-pdp-acc-heading-color);
    appearance: none;
    -webkit-appearance: none;
  }
  .pi-pdp__acc-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .pi-pdp__acc-icon::before,
  .pi-pdp__acc-icon::after {
    content: '';
    position: absolute;
    background: var(--pi-pdp-acc-icon-color);
    transition: opacity 0.2s ease;
  }
  .pi-pdp__acc-icon::before { top: 7.5px; left: 0; width: 16px; height: 1.5px; }
  .pi-pdp__acc-icon::after  { left: 7.5px; top: 0; width: 1.5px; height: 16px; }
  .pi-pdp__acc.is-open .pi-pdp__acc-icon::after { opacity: 0; }

  .pi-pdp__acc-panel {
    display: none;
    padding: 0 0 var(--pi-pdp-acc-row-padding);
    font-family: {{ sans }};
    font-size: var(--pi-pdp-acc-text-size);
    font-weight: 400;
    line-height: {{ section.settings.acc_text_line_height }};
    color: var(--pi-pdp-acc-text-color);
  }
  .pi-pdp__acc.is-open .pi-pdp__acc-panel { display: block; }
  .pi-pdp__acc-panel p { margin: 0 0 12px; }
  .pi-pdp__acc-panel p:last-child { margin-bottom: 0; }
  .pi-pdp__acc-panel ul,
  .pi-pdp__acc-panel ol { margin: 0 0 12px; padding-left: 20px; }

  /* ── Share ── */
  .pi-pdp__share {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ section.settings.share_gap }}px;
  }
  .pi-pdp__share-label {
    font-family: {{ sans }};
    font-size: var(--pi-pdp-share-label-size);
    font-weight: 600;
    color: var(--pi-pdp-share-label-color);
  }
  .pi-pdp__share-link {
    width: var(--pi-pdp-share-size);
    height: var(--pi-pdp-share-size);
    border-radius: var(--pi-pdp-share-radius);
    background: var(--pi-pdp-share-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .pi-pdp__share-link:hover { background: var(--pi-pdp-share-hover-bg); }
  .pi-pdp__share-link svg {
    width: calc(var(--pi-pdp-share-size) * 0.52);
    height: calc(var(--pi-pdp-share-size) * 0.52);
    display: block;
  }
  .pi-pdp__share-link svg path { fill: var(--pi-pdp-share-color); }
  .pi-pdp__share-link:hover svg path { fill: var(--pi-pdp-share-hover-color); }

  .pi-pdp__empty {
    font-family: {{ sans }};
    font-size: 16px;
    color: #555555;
    text-align: center;
    padding: 40px 0;
  }

  /* ── Responsive ── */
  @media (max-width: {{ section.settings.stack_breakpoint }}px) {
    .pi-pdp__row { flex-direction: column; gap: {{ section.settings.mobile_row_gap }}px; }
    .pi-pdp__media {
      position: static;
      flex-direction: column-reverse;
      align-items: stretch;
      width: 100%;
      gap: {{ section.settings.mobile_thumb_gap }}px;
    }
    .pi-pdp__thumbs {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
      flex: 1 1 auto;
      gap: {{ section.settings.mobile_thumb_gap }}px;
      overflow-x: auto;
    }
    .pi-pdp__thumb {
      width: {{ section.settings.mobile_thumb_size }}px;
      height: {{ section.settings.mobile_thumb_size }}px;
      flex: 0 0 {{ section.settings.mobile_thumb_size }}px;
    }
    .pi-pdp__stage { height: auto; aspect-ratio: 1 / 1; }
    .pi-pdp__info { width: 100%; flex: 1 1 auto; max-width: none; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-pdp-pad-top: {{ section.settings.mobile_padding_top }}px;
      --pi-pdp-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pi-pdp-gutter: {{ section.settings.mobile_side_gutter }}px;
      --pi-pdp-title-size: {{ section.settings.mobile_title_size }}px;
      --pi-pdp-price-size: {{ section.settings.mobile_price_size }}px;
      --pi-pdp-option-label-size: {{ section.settings.mobile_option_label_size }}px;
      --pi-pdp-swatch-size: {{ section.settings.mobile_swatch_size }}px;
      --pi-pdp-acc-heading-size: {{ section.settings.mobile_acc_heading_size }}px;
    }
  }
</style>

<div class="pi-pdp" id="pi-pdp-{{ section.id }}">
  <div class="pi-pdp__inner">

    {%- if p == blank -%}
      <p class="pi-pdp__empty">Select a product in the section settings, or add this section to a product template.</p>
    {%- else -%}

      {%- capture variant_data -%}
        [
        {%- for v in p.variants -%}
          {
            "id": {{ v.id }},
            "available": {{ v.available }},
            "options": {{ v.options | json }},
            "price": {{ v.price | money | json }},
            "compare_at": {{ v.compare_at_price | money | json }},
            "has_compare": {% if v.compare_at_price > v.price %}true{% else %}false{% endif %},
            "media_id": {{ v.featured_media.id | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
        ]
      {%- endcapture -%}

      <script type="application/json" data-pi-pdp-variants="{{ section.id }}">{{ variant_data }}</script>

      <div class="pi-pdp__row">

        {%- comment -%} ── Media ── {%- endcomment -%}
        <div class="pi-pdp__media">
          {%- if section.settings.show_thumbnails -%}
            <div class="pi-pdp__thumbs">
              {%- if p.media.size > 0 -%}
                {%- for media in p.media limit: section.settings.thumb_limit -%}
                  <button type="button"
                          class="pi-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                          data-media-id="{{ media.id }}"
                          data-full="{{ media.preview_image | image_url: width: 1400 }}"
                          aria-label="Show image {{ forloop.index }} of {{ p.title | escape }}">
                    <img src="{{ media.preview_image | image_url: width: 300 }}"
                         alt="{{ media.alt | default: p.title | escape }}"
                         width="{{ section.settings.thumb_size }}" height="{{ section.settings.thumb_size }}" loading="lazy">
                  </button>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..4) -%}
                  <span class="pi-pdp__thumb">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="pi-pdp__stage">
            {%- if p.featured_media -%}
              <img id="pi-pdp-stage-{{ section.id }}"
                   src="{{ p.featured_media.preview_image | image_url: width: 1400 }}"
                   alt="{{ p.featured_media.alt | default: p.title | escape }}"
                   width="1400" height="1400">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} ── Info ── {%- endcomment -%}
        <div class="pi-pdp__info">

          <div class="pi-pdp__head">
            {%- if section.settings.show_badge or section.settings.show_wishlist -%}
              <div class="pi-pdp__badge-row">
                {%- if section.settings.show_badge -%}
                  <span class="pi-pdp__badge" data-pi-pdp-availability>
                    {%- if cur.available -%}{{ section.settings.in_stock_text }}{%- else -%}{{ section.settings.out_of_stock_text }}{%- endif -%}
                  </span>
                {%- else -%}
                  <span></span>
                {%- endif -%}
                {%- if section.settings.show_wishlist -%}
                  <button type="button" class="pi-pdp__wishlist" aria-label="{{ section.settings.wishlist_label }}">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            fill="transparent" class="pi-pdp__wishlist-path"/>
                    </svg>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="pi-pdp__titleblock">
              {%- if section.settings.show_title -%}
                <h1 class="pi-pdp__title">{{ p.title }}</h1>
              {%- endif -%}

              {%- if section.settings.show_price -%}
                <p class="pi-pdp__price">
                  <span data-pi-pdp-price>{{ cur.price | money }}</span>
                  {%- if cur.compare_at_price > cur.price -%}
                    <span class="pi-pdp__price-compare" data-pi-pdp-compare>{{ cur.compare_at_price | money }}</span>
                  {%- else -%}
                    <span class="pi-pdp__price-compare" data-pi-pdp-compare hidden></span>
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- if section.settings.show_rating -%}
                <div class="pi-pdp__rating" aria-label="Rated {{ rating_value }} out of 5">
                  {%- assign rounded = rating_value | round -%}
                  {%- for i in (1..5) -%}
                    <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.77l-5.2 2.73.99-5.78-4.21-4.1 5.82-.85L10 1.5z"
                            fill="{% if forloop.index <= rounded %}{{ section.settings.star_color }}{% else %}{{ section.settings.star_empty_color }}{% endif %}"/>
                    </svg>
                  {%- endfor -%}
                  {%- if section.settings.show_rating_count and rating_count > 0 -%}
                    <span class="pi-pdp__rating-count">({{ rating_count }})</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} ── Options ── {%- endcomment -%}
          {%- liquid
            comment
              Linked colour products: this catalogue keeps each metal finish as its own
              product rather than as a Color variant, so there is no option to render.
              When enabled, find the sibling products and show them as a linked swatch row.
            endcomment
            assign has_color_option = false
            for option in p.options_with_values
              assign opt_handle = option.name | downcase
              for name in color_names
                assign trimmed = name | strip
                if trimmed != blank and opt_handle contains trimmed
                  assign has_color_option = true
                endif
              endfor
            endfor

            assign sib_source = section.settings.sibling_source
            assign sib_list = blank
            assign sib_count = 0
            assign sib_base = ''
            assign sib_tag = ''

            if sib_source != 'none' and has_color_option == false
              if sib_source == 'metafield'
                assign sib_ns = section.settings.sibling_metafield_namespace
                assign sib_key = section.settings.sibling_metafield_key
                if sib_ns != blank and sib_key != blank
                  assign sib_list = p.metafields[sib_ns][sib_key].value
                  assign sib_count = sib_list.size
                endif
              else
                assign sib_collection = section.settings.sibling_collection
                if sib_collection == blank
                  assign sib_collection = p.collections.first
                endif

                # Title mode: drop the leading colour word, match on what remains
                assign title_words = p.title | split: ' '
                for w in title_words offset: 1
                  assign sib_base = sib_base | append: w | append: ' '
                endfor
                assign sib_base = sib_base | strip | downcase

                # Tag mode: find the grouping tag this product carries
                for t in p.tags
                  if t contains section.settings.sibling_tag_prefix
                    assign sib_tag = t
                  endif
                endfor

                assign sib_list = sib_collection.products
                for op in sib_list
                  assign op_title = op.title | downcase
                  if sib_source == 'title' and sib_base != blank and op_title contains sib_base
                    assign sib_count = sib_count | plus: 1
                  endif
                  if sib_source == 'tag' and sib_tag != blank and op.tags contains sib_tag
                    assign sib_count = sib_count | plus: 1
                  endif
                endfor
              endif
            endif

            assign render_options = false
            if section.settings.show_options
              if p.has_only_default_variant == false
                assign render_options = true
              endif
              if sib_count > 1
                assign render_options = true
              endif
            endif
          -%}

          {%- if render_options -%}
            <div class="pi-pdp__options" data-pi-pdp-options>

              {%- if sib_count > 1 -%}
                <div class="pi-pdp__option">
                  <p class="pi-pdp__option-label">
                    {{ section.settings.sibling_label }}{{ section.settings.option_label_suffix }}
                    {%- if section.settings.show_selected_value -%}
                      <span class="pi-pdp__option-selected">{{ p.title | split: ' ' | first }}</span>
                    {%- endif -%}
                  </p>
                  <div class="pi-pdp__swatches">
                    {%- for op in sib_list -%}
                      {%- liquid
                        assign show_sib = false
                        if sib_source == 'metafield'
                          assign show_sib = true
                        else
                          assign op_title = op.title | downcase
                          if sib_source == 'title' and sib_base != blank and op_title contains sib_base
                            assign show_sib = true
                          endif
                          if sib_source == 'tag' and sib_tag != blank and op.tags contains sib_tag
                            assign show_sib = true
                          endif
                        endif
                      -%}
                      {%- if show_sib -%}
                        <a href="{{ op.url }}"
                           class="pi-pdp__swatch pi-pdp__sibling{% if op.id == p.id %} is-selected{% endif %}"
                           title="{{ op.title | escape }}"
                           aria-label="{{ op.title | escape }}"
                           {% if op.id == p.id %}aria-current="true"{% endif %}>
                          {%- if op.featured_media -%}
                            <img src="{{ op.featured_media.preview_image | image_url: width: 300 }}"
                                 alt="{{ op.title | escape }}"
                                 width="{{ section.settings.swatch_size }}" height="{{ section.settings.swatch_size }}" loading="lazy">
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              {%- if p.has_only_default_variant == false -%}
              {%- for option in p.options_with_values -%}
                {%- liquid
                  assign opt_handle = option.name | downcase
                  assign is_color = false
                  for name in color_names
                    assign trimmed = name | strip
                    if trimmed != blank and opt_handle contains trimmed
                      assign is_color = true
                    endif
                  endfor
                -%}
                <div class="pi-pdp__option" data-option-position="{{ option.position }}">
                  <p class="pi-pdp__option-label">
                    {{ option.name }}{{ section.settings.option_label_suffix }}
                    {%- if section.settings.show_selected_value -%}
                      <span class="pi-pdp__option-selected" data-selected-for="{{ option.position }}">{{ cur.options[forloop.index0] }}</span>
                    {%- endif -%}
                  </p>

                  {%- if is_color -%}
                    <div class="pi-pdp__swatches">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign swatch_variant = blank
                          for v in p.variants
                            if v.options[forloop.parentloop.parentloop.index0] == value
                              assign swatch_variant = v
                              break
                            endif
                          endfor
                        -%}
                        <button type="button"
                                class="pi-pdp__swatch{% if cur.options[forloop.parentloop.index0] == value %} is-selected{% endif %}"
                                data-option-position="{{ option.position }}"
                                data-value="{{ value | escape }}"
                                aria-label="{{ option.name }}: {{ value | escape }}">
                          {%- if section.settings.swatch_source == 'variant_image' and swatch_variant.featured_media -%}
                            <img src="{{ swatch_variant.featured_media.preview_image | image_url: width: 300 }}"
                                 alt="{{ value | escape }}"
                                 width="{{ section.settings.swatch_size }}" height="{{ section.settings.swatch_size }}" loading="lazy">
                          {%- elsif value.swatch.image -%}
                            <img src="{{ value.swatch.image | image_url: width: 300 }}"
                                 alt="{{ value | escape }}"
                                 width="{{ section.settings.swatch_size }}" height="{{ section.settings.swatch_size }}" loading="lazy">
                          {%- elsif value.swatch.color -%}
                            <span class="pi-pdp__swatch-fill" style="background: {{ value.swatch.color }};"></span>
                          {%- elsif swatch_variant.featured_media -%}
                            <img src="{{ swatch_variant.featured_media.preview_image | image_url: width: 300 }}"
                                 alt="{{ value | escape }}"
                                 width="{{ section.settings.swatch_size }}" height="{{ section.settings.swatch_size }}" loading="lazy">
                          {%- elsif p.featured_media -%}
                            <img src="{{ p.featured_media.preview_image | image_url: width: 300 }}"
                                 alt="{{ value | escape }}"
                                 width="{{ section.settings.swatch_size }}" height="{{ section.settings.swatch_size }}" loading="lazy">
                          {%- endif -%}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="pi-pdp__pills">
                      {%- for value in option.values -%}
                        <button type="button"
                                class="pi-pdp__pill{% if cur.options[forloop.parentloop.index0] == value %} is-selected{% endif %}"
                                data-option-position="{{ option.position }}"
                                data-value="{{ value | escape }}">{{ value }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%} ── Buy ── {%- endcomment -%}
          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pi-pdp__form" data-pi-pdp-form>
            <input type="hidden" name="id" value="{{ cur.id }}" data-pi-pdp-variant-id>
            <div class="pi-pdp__buy">
              {%- if section.settings.show_quantity -%}
                <div class="pi-pdp__qty">
                  <button type="button" class="pi-pdp__qty-btn" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                  <input class="pi-pdp__qty-input" type="number" name="quantity" value="1" min="1" aria-label="Quantity">
                  <button type="button" class="pi-pdp__qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
              {%- endif -%}
              <button type="submit" class="pi-pdp__atc" data-pi-pdp-atc {% unless cur.available %}disabled{% endunless %}>
                {%- if cur.available -%}{{ section.settings.atc_text }}{%- else -%}{{ section.settings.sold_out_text }}{%- endif -%}
              </button>
            </div>
          </form>

          {%- comment -%} ── Accordions ── {%- endcomment -%}
          <div class="pi-pdp__accordions">
            {%- if section.settings.show_description and p.description != blank -%}
              <div class="pi-pdp__acc{% if section.settings.open_description %} is-open{% endif %}">
                <button type="button" class="pi-pdp__acc-trigger" aria-expanded="{{ section.settings.open_description }}">
                  {{ section.settings.description_heading }}
                  <span class="pi-pdp__acc-icon" aria-hidden="true"></span>
                </button>
                <div class="pi-pdp__acc-panel">{{ p.description }}</div>
              </div>
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                {%- liquid
                  assign panel_content = block.settings.content
                  if block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
                    assign mf = p.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
                    if mf != blank
                      assign panel_content = mf
                    endif
                  endif
                -%}
                {%- if panel_content != blank -%}
                  <div class="pi-pdp__acc{% if block.settings.open_by_default %} is-open{% endif %}" {{ block.shopify_attributes }}>
                    <button type="button" class="pi-pdp__acc-trigger" aria-expanded="{{ block.settings.open_by_default }}">
                      {{ block.settings.heading }}
                      <span class="pi-pdp__acc-icon" aria-hidden="true"></span>
                    </button>
                    <div class="pi-pdp__acc-panel">{{ panel_content }}</div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} ── Share ── {%- endcomment -%}
          {%- if section.settings.show_share -%}
            {%- assign share_url = shop.url | append: p.url -%}
            {%- assign share_title = p.title | url_encode -%}
            <div class="pi-pdp__share">
              {%- if section.settings.share_label != blank -%}
                <span class="pi-pdp__share-label">{{ section.settings.share_label }}</span>
              {%- endif -%}

              {%- if section.settings.share_facebook -%}
                <a class="pi-pdp__share-link" href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
                  <svg viewBox="0 0 320 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
                </a>
              {%- endif -%}

              {%- if section.settings.share_x -%}
                <a class="pi-pdp__share-link" href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on X">
                  <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/></svg>
                </a>
              {%- endif -%}

              {%- if section.settings.share_pinterest -%}
                <a class="pi-pdp__share-link" href="https://pinterest.com/pin/create/button/?url={{ share_url }}&media={{ p.featured_media.preview_image | image_url: width: 1000 }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on Pinterest">
                  <svg viewBox="0 0 384 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M204 6.5C101.4 6.5 0 74.9 0 185.6 0 256 39.6 296 63.6 296c9.9 0 15.6-27.6 15.6-35.4 0-9.3-23.7-29.1-23.7-67.8 0-80.4 61.2-137.4 140.4-137.4 68.1 0 118.5 38.7 118.5 109.8 0 53.1-21.3 152.7-90.3 152.7-24.9 0-46.2-18-46.2-43.8 0-37.8 26.4-74.4 26.4-113.4 0-66.2-93.9-54.2-93.9 25.8 0 16.8 2.1 35.4 9.6 50.7-13.8 59.4-42 147.9-42 209.1 0 18.9 2.7 37.5 4.5 56.4 3.4 3.8 1.7 3.4 6.9 1.5 50.4-69 48.6-82.5 71.4-172.8 12.3 23.4 44.1 36 69.3 36 106.2 0 153.9-103.5 153.9-196.8C384 71.3 287.4 6.5 204 6.5z"/></svg>
                </a>
              {%- endif -%}

              {%- if section.settings.share_whatsapp -%}
                <a class="pi-pdp__share-link" href="https://wa.me/?text={{ share_title }}%20{{ share_url }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
                  <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 110.9L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-71.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-65.9-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
                </a>
              {%- endif -%}

              {%- if section.settings.share_email -%}
                <a class="pi-pdp__share-link" href="mailto:?subject={{ share_title }}&body={{ share_url }}" aria-label="Share by email">
                  <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4 0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
(function () {
  var id   = {{ section.id | json }};
  var root = document.getElementById('pi-pdp-' + id);
  if (!root) return;

  /* ── Gallery ── */
  var stage  = document.getElementById('pi-pdp-stage-' + id);
  var thumbs = Array.prototype.slice.call(root.querySelectorAll('.pi-pdp__thumb'));

  function activateThumb(btn) {
    if (!btn || !stage) return;
    var full = btn.getAttribute('data-full');
    if (full) stage.src = full;
    thumbs.forEach(function (t) { t.classList.toggle('is-active', t === btn); });
  }
  thumbs.forEach(function (btn) {
    btn.addEventListener('click', function () { activateThumb(btn); });
  });

  function showMedia(mediaId) {
    if (!mediaId) return;
    var match = thumbs.filter(function (t) { return t.getAttribute('data-media-id') === String(mediaId); })[0];
    if (match) activateThumb(match);
  }

  /* ── Quantity ── */
  var qtyInput = root.querySelector('.pi-pdp__qty-input');
  var minus    = root.querySelector('[data-qty-minus]');
  var plus     = root.querySelector('[data-qty-plus]');
  if (minus && qtyInput) minus.addEventListener('click', function () {
    qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
  });
  if (plus && qtyInput) plus.addEventListener('click', function () {
    qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
  });

  /* ── Accordions ── */
  root.querySelectorAll('.pi-pdp__acc-trigger').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var item = trigger.parentElement;
      var open = item.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  /* ── Wishlist ── */
  var wish = root.querySelector('.pi-pdp__wishlist');
  if (wish) wish.addEventListener('click', function () { wish.classList.toggle('is-active'); });

  /* ── Variant picker ── */
  var dataEl = root.querySelector('[data-pi-pdp-variants="' + id + '"]');
  if (!dataEl) return;

  var variants;
  try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }
  if (!variants || !variants.length) return;

  var optionsWrap = root.querySelector('[data-pi-pdp-options]');
  var idInput     = root.querySelector('[data-pi-pdp-variant-id]');
  var priceEl     = root.querySelector('[data-pi-pdp-price]');
  var compareEl   = root.querySelector('[data-pi-pdp-compare]');
  var availEl     = root.querySelector('[data-pi-pdp-availability]');
  var atcBtn      = root.querySelector('[data-pi-pdp-atc]');

  var texts = {
    inStock:    {{ section.settings.in_stock_text | json }},
    outOfStock: {{ section.settings.out_of_stock_text | json }},
    atc:        {{ section.settings.atc_text | json }},
    soldOut:    {{ section.settings.sold_out_text | json }}
  };

  var current  = variants.filter(function (v) { return v.id === parseInt(idInput.value, 10); })[0] || variants[0];
  var selected = current.options.slice();

  function findVariant(opts) {
    return variants.filter(function (v) {
      return opts.every(function (o, i) { return o == null || v.options[i] === o; });
    })[0];
  }

  function markAvailability() {
    if (!optionsWrap) return;
    optionsWrap.querySelectorAll('.pi-pdp__swatch, .pi-pdp__pill').forEach(function (el) {
      var pos   = parseInt(el.getAttribute('data-option-position'), 10);
      var probe = selected.slice();
      probe[pos - 1] = el.getAttribute('data-value');
      var match = findVariant(probe);
      el.classList.toggle('is-unavailable', !(match && match.available));
    });
  }

  function syncSelectedLabels() {
    if (!optionsWrap) return;
    optionsWrap.querySelectorAll('[data-selected-for]').forEach(function (el) {
      var pos = parseInt(el.getAttribute('data-selected-for'), 10);
      el.textContent = selected[pos - 1] || '';
    });
  }

  function render(variant) {
    if (!variant) {
      if (atcBtn) { atcBtn.disabled = true; atcBtn.textContent = texts.soldOut; }
      if (availEl) availEl.textContent = texts.outOfStock;
      return;
    }
    current = variant;
    idInput.value = variant.id;
    if (priceEl) priceEl.textContent = variant.price;
    if (compareEl) {
      if (variant.has_compare) { compareEl.textContent = variant.compare_at; compareEl.hidden = false; }
      else { compareEl.textContent = ''; compareEl.hidden = true; }
    }
    if (availEl) availEl.textContent = variant.available ? texts.inStock : texts.outOfStock;
    if (atcBtn) {
      atcBtn.disabled = !variant.available;
      atcBtn.textContent = variant.available ? texts.atc : texts.soldOut;
    }
    if (variant.media_id) showMedia(variant.media_id);

    if (window.history && history.replaceState) {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url.toString());
    }
  }

  if (optionsWrap) {
    optionsWrap.addEventListener('click', function (e) {
      var btn = e.target.closest('.pi-pdp__swatch, .pi-pdp__pill');
      if (!btn) return;
      var pos = parseInt(btn.getAttribute('data-option-position'), 10);
      var val = btn.getAttribute('data-value');
      selected[pos - 1] = val;

      var match = findVariant(selected);
      if (!match) {
        /* Keep the clicked value, relax the others to the first combination that exists */
        var relaxed = selected.map(function (o, i) { return i === pos - 1 ? val : null; });
        match = findVariant(relaxed);
        if (match) selected = match.options.slice();
      }

      optionsWrap.querySelectorAll('.pi-pdp__swatch, .pi-pdp__pill').forEach(function (b) {
        var bp = parseInt(b.getAttribute('data-option-position'), 10);
        b.classList.toggle('is-selected', selected[bp - 1] === b.getAttribute('data-value'));
      });

      render(match);
      markAvailability();
      syncSelectedLabels();
    });
  }

  markAvailability();
  syncSelectedLabels();
})();
</script>

