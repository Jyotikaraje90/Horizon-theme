        { "type": "text",     "id": "author_role",  "label": "Customer title",   "default": "Fashion Designer" }
      ]
    },
    {
      "type": "social_photo",
      "name": "Social Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI Studio Social",
      "blocks": [
        { "type": "piercing_card", "settings": { "title": "Earlobe Piercing",  "description": "A classic and versatile piercing for effortless style." } },
        { "type": "piercing_card", "settings": { "title": "Navel Piercing",    "description": "A trendy and stylish piercing on belly button for body jewelry lovers." } },
        { "type": "piercing_card", "settings": { "title": "Septum Piercing",   "description": "A bold, central nose piercing with customizable jewelry options." } },
        { "type": "piercing_card", "settings": { "title": "Helix Piercing",    "description": "A stylish cartilage piercing along the upper ear." } },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "review_text": "Absolutely in love with my new tattoo! The artists at Puertoink are incredibly skilled and made me feel comfortable throughout the entire process. The precision and attention to detail are unmatched. The studio has a clean, professional atmosphere, and the artist worked patiently with me to perfect my design. I couldn't have asked for a better experience.",
            "author_name": "Emily Carter",
            "author_role": "Fashion Designer"
          }
        },
        { "type": "social_photo" },
        { "type": "social_photo" },
        { "type": "social_photo" },
        { "type": "social_photo" },
        { "type": "social_photo" }
      ]
    }
  ]
}
{% endschema %}
