<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  /* ─── Shared arrow ──────────────────────────────── */
  .pi-ss-arrow {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1.5px solid #000;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .pi-ss-arrow:hover { background: #000; }
  .pi-ss-arrow:hover svg path { stroke: #fff; }

  /* ════════════════════════════════════════════════
     FRAME 1 — PIERCING SERVICES
  ════════════════════════════════════════════════ */
  .pi-ps {
    padding: 80px 0;
    background: #fff;
  }
  .pi-ps__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }
  .pi-ps__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    min-height: 70px;
  }
  .pi-ps__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 3.75vw, 54px);
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    margin: 0;
    line-height: 1.2;
  }
  .pi-ps__arrows { display: flex; gap: 20px; }
  .pi-ps__track-wrap { overflow: hidden; }
  .pi-ps__track {
    display: flex;
    gap: 30px;
    transition: transform 0.4s ease;
    will-change: transform;
  }
  .pi-ps__card {
    flex: 0 0 360px;
    width: 360px;
    display: flex;
    flex-direction: column;
  }
  .pi-ps__card-img {
    width: 360px;
    height: 360px;
    overflow: hidden;
    flex-shrink: 0;
    background: #f3f3f3;
  }
  .pi-ps__card-img img,
  .pi-ps__card-img .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pi-ps__card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pi-ps__card-title {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
  }
  .pi-ps__card-desc {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    letter-spacing: 0;
    color: #121212;
    margin: 0;
  }
  .pi-ps__footer { display: flex; justify-content: center; }
  .pi-ps__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    height: 55px;
    padding: 16px 40px;
    border-radius: 8px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .pi-ps__btn:hover { background: #222; color: #fff; text-decoration: none; }

  /* ════════════════════════════════════════════════
     FRAME 2 — HAPPY CUSTOMERS
  ════════════════════════════════════════════════ */
  .pi-hc {
    padding: 64px 0;
    background: #fff;
  }
  .pi-hc__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .pi-hc__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 3.75vw, 54px);
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    margin: 0;
    text-align: center;
  }
  .pi-hc__row {
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 1090px;
    justify-content: center;
  }
  .pi-hc__card-wrap {
    flex: 1;
    max-width: 930px;
    overflow: hidden;
  }
  .pi-hc__card {
    background: #fff;
    border-radius: 30px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.10);
    padding: 40px 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .pi-hc__slide { display: none; }
  .pi-hc__slide.is-active {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }
  .pi-hc__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #f3f3f3;
  }
  .pi-hc__avatar img,
  .pi-hc__avatar .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pi-hc__stars {
    display: flex;
    gap: 4px;
    align-items: center;
    justify-content: center;
  }
  .pi-hc__stars svg { flex-shrink: 0; }
  .pi-hc__text {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.75;
    color: #333;
    max-width: 720px;
    margin: 0;
  }
  .pi-hc__author {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #000;
    margin: 0;
  }

  /* ════════════════════════════════════════════════
     FRAME 3 — TRUSTED BY THE BEST
  ════════════════════════════════════════════════ */
  .pi-tb { background: #fff; overflow: hidden; }
  .pi-tb__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 340px);
  }
  .pi-tb__title-cell {
    position: relative;
    background: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px;
    overflow: hidden;
  }
  .pi-tb__deco {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    z-index: 0;
    pointer-events: none;
  }
  .pi-tb__deco img {
    width: 100%;
    height: auto;
    display: block;
  }
  .pi-tb__title-content {
    position: relative;
    z-index: 1;
  }
  .pi-tb__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 2.8vw, 44px);
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.2;
    color: #000;
    margin: 0 0 20px;
  }
  .pi-tb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    height: 44px;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    align-self: flex-start;
    white-space: nowrap;
  }
  .pi-tb__btn:hover { background: #222; color: #fff; text-decoration: none; }
  .pi-tb__photo {
    overflow: hidden;
    background: #e5e5e5;
  }
  .pi-tb__photo img,
  .pi-tb__photo .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Responsive ────────────────────────────── */
  @media (max-width: 989px) {
    .pi-ps__inner, .pi-hc__inner { padding: 0 24px; }
    .pi-ps__card { flex: 0 0 280px; width: 280px; }
    .pi-ps__card-img { width: 280px; height: 280px; }
    .pi-tb__grid { grid-template-rows: repeat(2, 260px); }
  }
  @media (max-width: 749px) {
    .pi-ps__inner, .pi-hc__inner { padding: 0 16px; }
    .pi-ps__heading { font-size: clamp(28px, 7vw, 40px); }
    .pi-ps__card { flex: 0 0 240px; width: 240px; }
    .pi-ps__card-img { width: 240px; height: 240px; }
    .pi-hc__row { gap: 12px; }
    .pi-hc__card { padding: 24px; }
    .pi-tb__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: 200px repeat(3, 200px);
    }
    .pi-tb__title-cell { grid-column: 1 / -1; }
  }
</style>

{%- assign piercing_cards = section.blocks | where: "type", "piercing_card" -%}
{%- assign testimonials   = section.blocks | where: "type", "testimonial" -%}
{%- assign social_photos  = section.blocks | where: "type", "social_photo" -%}

{%- comment -%} ── FRAME 1: PIERCING SERVICES ── {%- endcomment -%}
<div class="pi-ps" id="pi-ps-{{ section.id }}">
  <div class="pi-ps__inner">

    <div class="pi-ps__header">
      {%- if section.settings.piercing_heading != blank -%}
        <h2 class="pi-ps__heading">{{ section.settings.piercing_heading }}</h2>
      {%- endif -%}
      <div class="pi-ps__arrows">
        <div role="button" tabindex="0" class="pi-ss-arrow pi-ps__prev" aria-label="Previous piercing" style="width:50px;height:50px;border-radius:50%;background:#ffffff;border:1.5px solid #000000;box-sizing:border-box;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;">
            <path fill="#000000" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </div>
        <div role="button" tabindex="0" class="pi-ss-arrow pi-ps__next" aria-label="Next piercing" style="width:50px;height:50px;border-radius:50%;background:#000000;border:1.5px solid #000000;box-sizing:border-box;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;transform:rotate(180deg);">
            <path fill="#ffffff" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="pi-ps__track-wrap">
      <div class="pi-ps__track" id="pi-ps-track-{{ section.id }}">
        {%- for block in piercing_cards -%}
          <div class="pi-ps__card" {{ block.shopify_attributes }}>
            <div class="pi-ps__card-img">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 720 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  width="360"
                  height="360"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="pi-ps__card-body">
              {%- if block.settings.title != blank -%}
                <h4 class="pi-ps__card-title">{{ block.settings.title }}</h4>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="pi-ps__card-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.piercing_button_label != blank -%}
      <div class="pi-ps__footer">
        <a href="{{ section.settings.piercing_button_link }}" class="pi-ps__btn">
          {{ section.settings.piercing_button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{%- comment -%} ── FRAME 2: HAPPY CUSTOMERS ── {%- endcomment -%}
<div class="pi-hc" id="pi-hc-{{ section.id }}">
  <div class="pi-hc__inner">

    {%- if section.settings.customers_heading != blank -%}
      <h2 class="pi-hc__heading">{{ section.settings.customers_heading }}</h2>
    {%- endif -%}

    {%- if testimonials.size > 0 -%}
      <div class="pi-hc__row">
        <button class="pi-ss-arrow pi-hc__prev" aria-label="Previous testimonial">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#000000" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>

        <div class="pi-hc__card-wrap">
          <div class="pi-hc__card">
            {%- for block in testimonials -%}
              <div class="pi-hc__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                <div class="pi-hc__avatar">
                  {%- if block.settings.avatar != blank -%}
                    <img
                      src="{{ block.settings.avatar | image_url: width: 160 }}"
                      alt="{{ block.settings.author_name | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'customer' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="pi-hc__stars">
                  {%- assign rating = block.settings.rating | default: 5 -%}
                  {%- for i in (1..5) -%}
                    {%- if i <= rating -%}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="#FFBA00" xmlns="http://www.w3.org/2000/svg"><path d="M10 0L12.35 6.76L19.51 6.91L13.8 11.24L15.88 18.09L10 14L4.12 18.09L6.2 11.24L0.49 6.91L7.65 6.76Z"/></svg>
                    {%- else -%}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#FFBA00" stroke-width="1" xmlns="http://www.w3.org/2000/svg"><path d="M10 0L12.35 6.76L19.51 6.91L13.8 11.24L15.88 18.09L10 14L4.12 18.09L6.2 11.24L0.49 6.91L7.65 6.76Z"/></svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.review_text != blank -%}
                  <p class="pi-hc__text">{{ block.settings.review_text }}</p>
                {%- endif -%}
                {%- if block.settings.author_name != blank -%}
                  <p class="pi-hc__author">
                    — {{ block.settings.author_name }}
                    {%- if block.settings.author_role != blank -%}, {{ block.settings.author_role }}{%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <button class="pi-ss-arrow pi-hc__next" aria-label="Next testimonial">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#000000" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;transform:rotate(180deg);">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
      </div>
    {%- endif -%}

  </div>
</div>

{%- comment -%} ── FRAME 3: TRUSTED BY THE BEST ── {%- endcomment -%}
<div class="pi-tb">
  <div class="pi-tb__grid">

    <div class="pi-tb__title-cell">
      {%- if section.settings.trusted_deco_image != blank -%}
        <div class="pi-tb__deco">
          <img
            src="{{ section.settings.trusted_deco_image | image_url: width: 400 }}"
            alt=""
            loading="lazy"
          >
        </div>
      {%- endif -%}
      <div class="pi-tb__title-content">
        {%- if section.settings.trusted_heading != blank -%}
          <h2 class="pi-tb__heading">{{ section.settings.trusted_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.trusted_button_label != blank -%}
          <a href="{{ section.settings.trusted_button_link }}" class="pi-tb__btn">
            {{ section.settings.trusted_button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in social_photos -%}
      <div class="pi-tb__photo" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endfor -%}

  </div>
</div>

<script>
(function () {
  /* Piercing Services carousel */
  var psWrap = document.getElementById('pi-ps-{{ section.id }}');
  if (psWrap) {
    var psTrack = document.getElementById('pi-ps-track-{{ section.id }}');
    var psCardW = 360 + 30;
    var psIdx   = 0;

    function psVisible() { return Math.floor(psTrack.parentElement.offsetWidth / psCardW) || 1; }
    function psSlide(i) {
      var total = psTrack.querySelectorAll('.pi-ps__card').length;
      psIdx = Math.max(0, Math.min(i, Math.max(0, total - psVisible())));
      psTrack.style.transform = 'translateX(-' + (psIdx * psCardW) + 'px)';
    }
    var psPrev = psWrap.querySelector('.pi-ps__prev');
    var psNext = psWrap.querySelector('.pi-ps__next');
    psPrev.addEventListener('click', function () { psSlide(psIdx - 1); });
    psNext.addEventListener('click', function () { psSlide(psIdx + 1); });
    psPrev.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') psSlide(psIdx - 1); });
    psNext.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') psSlide(psIdx + 1); });
  }

  /* Happy Customers slider */
  var hcWrap = document.getElementById('pi-hc-{{ section.id }}');
  if (hcWrap) {
    var hcSlides = hcWrap.querySelectorAll('.pi-hc__slide');
    var hcIdx    = 0;

    function hcShow(i) {
      hcSlides[hcIdx].classList.remove('is-active');
      hcIdx = (i + hcSlides.length) % hcSlides.length;
      hcSlides[hcIdx].classList.add('is-active');
    }

    var hcPrev = hcWrap.querySelector('.pi-hc__prev');
    var hcNext = hcWrap.querySelector('.pi-hc__next');
    if (hcPrev) hcPrev.addEventListener('click', function () { hcShow(hcIdx - 1); });
    if (hcNext) hcNext.addEventListener('click', function () { hcShow(hcIdx + 1); });
  }
})();
</script>

{% schema %}
{
  "name": "PI Studio Social",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Piercing Services" },
    {
      "type": "text",
      "id": "piercing_heading",
      "label": "Heading",
      "default": "Piercing Services"
    },
    {
      "type": "text",
      "id": "piercing_button_label",
      "label": "Button text",
      "default": "View All Piercing Services"
    },
    { "type": "url", "id": "piercing_button_link", "label": "Button link" },
    { "type": "header", "content": "Happy Customers" },
    {
      "type": "text",
      "id": "customers_heading",
      "label": "Heading",
      "default": "Happy Customers"
    },
    { "type": "header", "content": "Trusted by the Best" },
    {
      "type": "text",
      "id": "trusted_heading",
      "label": "Heading",
      "default": "Trusted by the Best"
    },
    {
      "type": "text",
      "id": "trusted_button_label",
      "label": "Button text",
      "default": "Explore More"
    },
    { "type": "url",          "id": "trusted_button_link",  "label": "Button link" },
    { "type": "image_picker", "id": "trusted_deco_image",   "label": "Decorative illustration" }
  ],
  "blocks": [
    {
      "type": "piercing_card",
      "name": "Piercing Card",
      "settings": [
        { "type": "image_picker", "id": "image",       "label": "Image" },
        { "type": "text",         "id": "title",       "label": "Title",       "default": "Piercing Style" },
        { "type": "textarea",     "id": "description", "label": "Description", "default": "Describe this piercing style." }
