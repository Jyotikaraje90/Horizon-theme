<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .pi-blogs {
    max-width: 1500px;
    margin: 0 auto;
  }

  .pi-blogs__heading {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin: 0 0 60px;
  }

  /* Search result notice — only visible when the page is filtered by ?q= */
  .pi-blogs__note,
  .pi-blogs__empty {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 18px;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin: -30px 0 40px;
  }

  .pi-blogs__empty { margin: 20px 0 0; }

  .pi-blogs__note-clear {
    color: inherit;
    text-decoration: underline;
  }

  .pi-blogs__note-clear:hover { opacity: .7; }

  .pi-blogs__note[hidden],
  .pi-blogs__empty[hidden],
  .pi-blogs__card-link[hidden] { display: none !important; }

  .pi-blogs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
  }

  .pi-blogs__card {
    position: relative;
    width: 100%;
    height: 423px;
  }

  .pi-blogs__image-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 360px;
    border-radius: 20px;
    overflow: hidden;
    background: #e0e0e0;
    z-index: 1;
  }

  .pi-blogs__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .pi-blogs__card-content {
    position: absolute;
    top: 270px;
    left: 0;
    width: calc(100% - 60px);
    box-sizing: border-box;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #F0F0F0;
    border-radius: 0 20px 20px 20px;
    z-index: 2;
  }

  .pi-blogs__date-wrap {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 5px 10px;
    background: #CCCCCC;
    border-radius: 4px;
  }

  .pi-blogs__date {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: {{ section.settings.date_color }};
    margin: 0;
  }

  .pi-blogs__title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .pi-blogs__card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
  }

  .pi-blogs__card-link:hover .pi-blogs__title {
    color: {{ section.settings.hover_color }};
  }

  /* Responsive */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 30px {{ section.settings.padding_bottom }}px;
    }

    .pi-blogs__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .pi-blogs__heading {
      font-size: clamp(28px, 5vw, 48px);
      margin-bottom: 40px;
    }

    .pi-blogs__card { height: 380px; }
    .pi-blogs__image-wrap { height: 310px; }
    .pi-blogs__card-content { top: 230px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
    }

    .pi-blogs__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pi-blogs__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      margin-bottom: 30px;
    }

    .pi-blogs__card { height: 340px; }
    .pi-blogs__image-wrap { height: 280px; border-radius: 12px; }

    .pi-blogs__card-content {
      top: 205px;
      width: calc(100% - 40px);
      padding: 20px;
      gap: 12px;
      border-radius: 0 12px 12px 12px;
    }

    .pi-blogs__title {
      font-size: 18px;
      line-height: 24px;
    }
  }
</style>

<div class="pi-blogs">
  {%- if section.settings.show_heading -%}
    <h2 class="pi-blogs__heading">{{ section.settings.title | default: 'Blogs' }}</h2>
  {%- endif -%}

  {%- comment -%}
    Populated by the script below when the page is opened with ?q=…, e.g. from
    the blog sidebar search. Server-rendered empty so it costs nothing when
    there is no query.
  {%- endcomment -%}
  <p class="pi-blogs__note" data-blogs-note hidden></p>

  {%- comment -%}
    Source. A picked blog wins; otherwise the blog of the current page when this
    section sits on templates/blog.json. Falling back to the hand-entered
    blog_post blocks keeps the old /pages/blogs listing alive until every post
    exists as an article.

    Articles give each card `article.url`, so every post opens its own detail
    page automatically — no per-card link to fill in.
  {%- endcomment -%}
  {%- assign bl_blog = nil -%}
  {%- if section.settings.blog != blank -%}
    {%- assign bl_blog = blogs[section.settings.blog] -%}
  {%- elsif blog != blank -%}
    {%- assign bl_blog = blog -%}
  {%- endif -%}
  {%- assign bl_fmt = section.settings.date_format | default: '%b %d, %Y' -%}

  <div class="pi-blogs__grid" data-blogs-grid>
    {%- if bl_blog != blank and bl_blog.articles.size > 0 -%}
      {%- for bl_art in bl_blog.articles -%}
        <a
          href="{{ bl_art.url }}"
          class="pi-blogs__card-link"
          data-blog-card
          data-blog-title="{{ bl_art.title | escape }}"
        >
          <div class="pi-blogs__card">
            <div class="pi-blogs__image-wrap">
              {%- if bl_art.image != blank -%}
                <img
                  src="{{ bl_art.image | image_url: width: 600 }}"
                  alt="{{ bl_art.image.alt | default: bl_art.title | escape }}"
                  loading="lazy"
                  class="pi-blogs__image"
                >
              {%- endif -%}
            </div>

            <div class="pi-blogs__card-content">
              <span class="pi-blogs__date-wrap">
                <span class="pi-blogs__date">{{ bl_art.published_at | date: bl_fmt }}</span>
              </span>
              <h3 class="pi-blogs__title">{{ bl_art.title }}</h3>
            </div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'blog_post' -%}
        <a
          href="{{ block.settings.blog_link | default: '#' }}"
          class="pi-blogs__card-link"
          data-blog-card
          data-blog-title="{{ block.settings.blog_title | escape }}"
        >
          <div class="pi-blogs__card">
            <div class="pi-blogs__image-wrap">
              {%- if block.settings.blog_image != blank -%}
                <img
                  src="{{ block.settings.blog_image | image_url: width: 600 }}"
                  alt="{{ block.settings.blog_title | escape }}"
                  loading="lazy"
                  class="pi-blogs__image"
                >
              {%- endif -%}
            </div>

            <div class="pi-blogs__card-content">
              {%- if block.settings.blog_date != blank -%}
                <span class="pi-blogs__date-wrap">
                  <span class="pi-blogs__date">{{ block.settings.blog_date }}</span>
                </span>
              {%- endif -%}
              <h3 class="pi-blogs__title">{{ block.settings.blog_title | default: 'Blog Post Title' }}</h3>
            </div>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
    {%- endif -%}
  </div>

  <p class="pi-blogs__empty" data-blogs-empty hidden>
    {{ section.settings.no_results_text | default: 'No blogs match your search.' }}
  </p>
</div>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;

  var grid  = root.querySelector('[data-blogs-grid]');
  var note  = root.querySelector('[data-blogs-note]');
  var empty = root.querySelector('[data-blogs-empty]');
  if (!grid) return;

  var cards = grid.querySelectorAll('[data-blog-card]');

  /* Read the query the blog sidebar search sends over. */
  var params = new URLSearchParams(window.location.search);
  var raw = (params.get('q') || '').trim();
  if (!raw) return;

  /* Match on title only — the blog blocks carry no body text to search. */
  var needle = raw.toLowerCase();
  var shown = 0;

  for (var i = 0; i < cards.length; i++) {
    var title = (cards[i].getAttribute('data-blog-title') || '').toLowerCase();
    var hit = title.indexOf(needle) !== -1;
    cards[i].hidden = !hit;
    if (hit) shown++;
  }

  if (note) {
    /* textContent, not innerHTML — the query comes straight from the URL. */
    note.textContent = shown
      ? shown + (shown === 1 ? ' result for “' : ' results for “') + raw + '”'
      : 'No results for “' + raw + '”';

    var clear = document.createElement('a');
    clear.href = window.location.pathname;
    clear.className = 'pi-blogs__note-clear';
    clear.textContent = 'Show all blogs';
    note.appendChild(document.createTextNode(' — '));
    note.appendChild(clear);
    note.hidden = false;
  }

  if (empty) empty.hidden = shown !== 0;
})();
</script>

{% schema %}
{
  "name": "PI Blogs",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Pick a blog to list its articles. Each card then links to its own article page. Leave empty to keep using the manual Blog Post blocks below."
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "Date format",
      "default": "%b %d, %Y",
      "info": "Liquid date format, used only for articles."
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "info": "Turn off when a page hero above the section already shows the title.",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Blogs"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No search results text",
      "default": "No blogs match your search.",
      "info": "Shown when the blog search returns nothing."
    },
