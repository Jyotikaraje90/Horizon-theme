<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .pi-blogs {
    max-width: 1500px;
    margin: 0 auto;
  }

  .pi-blogs__heading {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin: 0 0 60px;
  }

  .pi-blogs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
  }

  .pi-blogs__card {
    position: relative;
    width: 100%;
    aspect-ratio: 487 / 423;
    border-radius: 12px;
    overflow: hidden;
  }

  .pi-blogs__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .pi-blogs__card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #F0F0F0;
    height: 153px;
    justify-content: flex-start;
    z-index: 10;
  }

  .pi-blogs__date {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: {{ section.settings.date_color }};
    margin: 0;
  }

  .pi-blogs__title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .pi-blogs__card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
  }

  .pi-blogs__card-link:hover .pi-blogs__title {
    color: {{ section.settings.hover_color }};
  }

  /* Responsive */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 30px {{ section.settings.padding_bottom }}px;
    }

    .pi-blogs__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .pi-blogs__heading {
      font-size: clamp(28px, 5vw, 48px);
      margin-bottom: 40px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
    }

    .pi-blogs__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pi-blogs__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      margin-bottom: 30px;
    }

    .pi-blogs__card-content {
      padding: 16px;
    }

    .pi-blogs__title {
      font-size: 18px;
      line-height: 24px;
    }
  }
</style>

<div class="pi-blogs">
  <h2 class="pi-blogs__heading">{{ section.settings.title | default: 'Blogs' }}</h2>

  <div class="pi-blogs__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'blog_post' -%}
        <a href="{{ block.settings.blog_link | default: '#' }}" class="pi-blogs__card-link">
          <div class="pi-blogs__card">
            {%- if block.settings.blog_image != blank -%}
              <img
                src="{{ block.settings.blog_image | image_url: width: 600 }}"
                alt="{{ block.settings.blog_title | escape }}"
                loading="lazy"
                class="pi-blogs__image"
              >
            {%- else -%}
              <div class="pi-blogs__image" style="background: #f0f0f0;"></div>
            {%- endif -%}

            <div class="pi-blogs__card-content">
              {%- if block.settings.blog_date != blank -%}
                <p class="pi-blogs__date">{{ block.settings.blog_date }}</p>
              {%- endif -%}
              <h3 class="pi-blogs__title">{{ block.settings.blog_title | default: 'Blog Post Title' }}</h3>
            </div>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "PI Blogs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Blogs"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 28,
      "max": 54,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile Heading Size",
      "min": 20,
      "max": 40,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors & Typography"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Title Hover Color",
      "default": "#B49146"
    }
  ],
  "blocks": [
    {
      "type": "blog_post",
      "name": "Blog Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "blog_image",
          "label": "Blog Image"
        },
        {
          "type": "text",
          "id": "blog_date",
          "label": "Date",
          "default": "Feb 28, 2025"
        },
        {
          "type": "text",
          "id": "blog_title",
          "label": "Blog Title",
          "default": "Blog Post Title"
        },
        {
          "type": "url",
          "id": "blog_link",
          "label": "Blog Post URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI Blogs",
      "blocks": [
        {
          "type": "blog_post",
          "settings": {
            "blog_date": "Feb 28, 2025",
            "blog_title": "How to Choose the Perfect Piercing Jewelry for Your Style?"
          }
        },
        {
          "type": "blog_post",
          "settings": {
            "blog_date": "Feb 27, 2025",
            "blog_title": "The Rising Trend of Minimalist Tattoos & Their Meaning"
          }
        },
        {
          "type": "blog_post",
          "settings": {
            "blog_date": "Feb 26, 2025",
            "blog_title": "Tattoo Aftercare 101: Essential Tips for Long-Lasting Ink"
          }
        }
      ]
    }
  ]
}
{% endschema %}
