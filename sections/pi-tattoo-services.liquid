<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
  #pi-ts-{{ section.id }} {
    --pi-ts-pad-top: {{ section.settings.padding_top }}px;
    --pi-ts-pad-bottom: {{ section.settings.padding_bottom }}px;
    --pi-ts-bg-color: {{ section.settings.bg_color }};
    --pi-ts-heading-size: {{ section.settings.heading_size }}px;
    /* Never overridden — the laptop/tablet steps scale from this so they can't
       collide with the mobile --pi-ts-heading-size override below. */
    --pi-ts-heading-base: {{ section.settings.heading_size }}px;
    --pi-ts-heading-color: {{ section.settings.heading_color }};
    --pi-ts-card-radius: {{ section.settings.card_radius }}px;
    --pi-ts-card-title-size: {{ section.settings.card_title_size }}px;
    --pi-ts-card-title-color: {{ section.settings.card_title_color }};
    --pi-ts-card-desc-size: {{ section.settings.card_desc_size }}px;
    --pi-ts-card-desc-color: {{ section.settings.card_desc_color }};
    --pi-ts-btn-bg: {{ section.settings.btn_bg }};
    --pi-ts-btn-text: {{ section.settings.btn_text }};
    --pi-ts-btn-radius: {{ section.settings.btn_radius }}px;
    --pi-ts-btn-size: {{ section.settings.btn_size }}px;
    --pi-ts-btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --pi-ts-btn-hover-text: {{ section.settings.btn_hover_text }};
  }
  @media (max-width: 749px) {
    #pi-ts-{{ section.id }} {
      --pi-ts-pad-top: {{ section.settings.mobile_padding_top }}px;
      --pi-ts-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pi-ts-heading-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
</style>

<style>
  /* ─── Section wrapper ─────────────────────────── */
  .pi-ts {
    background: var(--pi-ts-bg-color, #ffffff);
    padding-top: var(--pi-ts-pad-top, 50px);
    padding-bottom: var(--pi-ts-pad-bottom, 80px);
  }

  .pi-ts__inner {
    /* Same correction as pi-best-sellers: 1500 is the design's content column,
       so the outer box needs to be 1500 + the 40px gutters. At max-width 1500
       with box-sizing: border-box the padding came out of the column, leaving
       1420 -- while this section's own card values (flex 0 0 360px, 20px track
       gap) need 4*360 + 3*20 = 1500. The fourth card was clipped by 80px and
       reachable only through the arrows, and the section sat 40px inset from the
       rest of the page (content began at x=245 against the header's 205). */
    max-width: 1580px;
    margin-inline: auto;
    padding-inline: 40px;
    display: flex;
    flex-direction: column;
    gap: 50px;
    box-sizing: border-box;
  }

  /* ─── Header row ──────────────────────────────── */
  .pi-ts__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    min-height: 70px;
  }

  .pi-ts__heading {
    font-family: 'Playfair Display', serif;
    font-size: var(--pi-ts-heading-size, 54px);
    font-weight: 600;
    /* Figma H2 is 54/70. Kept as a ratio so it survives a heading_size change. */
    line-height: 1.2963;
    text-transform: uppercase;
    color: var(--pi-ts-heading-color, #000000);
    letter-spacing: 0;
    margin: 0;
    text-align: {{ section.settings.text_alignment }};
  }

  /* ─── Arrow buttons ───────────────────────────── */
  .pi-ts__arrows--desktop {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .pi-ts__arrow {
    width: 50px !important;
    height: 50px !important;
    min-width: 50px;
    border-radius: 50% !important;
    border: 1.5px solid #000000 !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    padding: 0 !important;
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  /* Prev: outlined */
  .pi-ts__arrow--prev {
    background-color: #ffffff !important;
  }
  .pi-ts__arrow--prev svg path {
    fill: #000000 !important;
  }
  .pi-ts__arrow--prev:hover {
    background-color: #000000 !important;
  }
  .pi-ts__arrow--prev:hover svg path {
    fill: #ffffff !important;
  }

  /* Next: filled */
  .pi-ts__arrow--next {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }
  .pi-ts__arrow--next svg path {
    fill: #ffffff !important;
  }
  .pi-ts__arrow--next:hover {
    background-color: #333333 !important;
  }

  /* ─── Content area ────────────────────────────── */
  .pi-ts__content {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* ─── Carousel container (for overlay arrows) ─── */
  .pi-ts__carousel-container {
    position: relative;
  }

  /* ─── Mobile overlay arrows (hidden on desktop) ── */
  .pi-ts__arrows--mobile-overlay {
    display: none;
  }

  /* ─── Carousel track ──────────────────────────── */
  .pi-ts__track-wrap {
    overflow: hidden;
  }

  .pi-ts__track {
    display: flex;
    gap: 20px;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  /* ─── Card ────────────────────────────────────── */
  .pi-ts__card {
    flex: 0 0 360px;
    width: 360px;
    display: flex;
    flex-direction: column;
    /* Figma card 48095956: image 360 + gap 20 + body 93 = 473. The gap used to
       be faked by the body's 16px top padding, which made the card 135px tall
       against a 93px spec. */
    gap: 20px;
  }

  /* Linked cards keep the card's own typography rather than anchor styling */
  .pi-ts__card--link {
    text-decoration: none;
    color: inherit;
  }

  .pi-ts__card--link .pi-ts__card-img img {
    transition: transform .35s ease;
  }

  .pi-ts__card--link:hover .pi-ts__card-img img {
    transform: scale(1.05);
  }

  .pi-ts__card-img {
    width: 360px;
    height: 360px;
    overflow: hidden;
    border-radius: var(--pi-ts-card-radius, 10px);
    flex-shrink: 0;
    background: #f3f3f3;
  }

  .pi-ts__card-img img,
  .pi-ts__card-img .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-ts__card-body {
    width: 360px;
    box-sizing: border-box;
    /* Figma frame 2123 has no padding -- the description text node is 360px
       wide against a Fill(360) frame, so it runs edge to edge. With padding
       zeroed, the 93px hug height puts the title/desc gap at 10px
       (26 + 10 + 57 = 93), not the 20px the panel reports. */
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-radius: 0 0 var(--pi-ts-card-radius, 10px) var(--pi-ts-card-radius, 10px);
    background: #ffffff;
  }

  .pi-ts__card-title {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: var(--pi-ts-card-title-size, 20px);
    font-weight: 600;
    line-height: 26px;
    color: var(--pi-ts-card-title-color, #000000);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-ts__card-desc {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: var(--pi-ts-card-desc-size, 18px);
    font-weight: 400;
    line-height: 29px;
    color: var(--pi-ts-card-desc-color, #121212);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── Footer / Button ─────────────────────────── */
  .pi-ts__footer {
    display: flex;
    justify-content: center;
  }

  .pi-ts__btn-mobile { display: none; }

  @media (max-width: 749px) {
    .pi-ts__btn-desktop { display: none; }
    .pi-ts__btn-mobile { display: inline; }
  }

  .pi-ts__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--pi-ts-btn-bg, #000000);
    color: var(--pi-ts-btn-text, #ffffff);
    height: 55px;
    padding: 16px 32px;
    border-radius: var(--pi-ts-btn-radius, 8px);
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: var(--pi-ts-btn-size, 18px);
    font-weight: 600;
    line-height: 23px;
    letter-spacing: 0;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .pi-ts__btn:hover {
    background: var(--pi-ts-btn-hover-bg, #222222);
    text-decoration: none;
    color: var(--pi-ts-btn-hover-text, #ffffff);
  }

  /* ─── Responsive ──────────────────────────────── */
  /* Shared laptop heading step (same breakpoint in every homepage section) */
  @media (max-width: 1279px) {
    .pi-ts__heading { font-size: calc(var(--pi-ts-heading-base, 54px) * 0.82); line-height: 1.3; }
  }

  @media (max-width: 989px) {
    .pi-ts__inner { padding-inline: 40px; }
    .pi-ts__card { flex: 0 0 280px; width: 280px; }
    /* 1:1, matching both Figma breakpoints (360x360 and 167x167). This step
       used to be 280x300, which stretched every card image at tablet. */
    .pi-ts__card-img { width: 280px; height: 280px; }
    .pi-ts__card-body { width: 280px; }
    .pi-ts__card-title { font-size: 18px; }
    .pi-ts__card-desc { font-size: 18px; line-height: 29px; }
    .pi-ts__heading { font-size: clamp(28px, 5vw, calc(var(--pi-ts-heading-base, 54px) * 0.89)); line-height: 1.2; }
  }

  /* Mobile heading size applies from 749px, matching the other sections (the
     card grid still reflows separately at 600px below). Must stay after the
     989px block — same specificity, so source order decides. */
  @media (max-width: 749px) {
    .pi-ts__heading { font-size: var(--pi-ts-heading-size, 30px); line-height: 1.3; }
  }

  @media (max-width: 767px) {
    /* Figma mobile: 30 between heading and content, 20 between the card row
       and the button (39 + 30 + 318 = 387; 248 + 20 + 50 = 318). These two were
       the wrong way round. */
    .pi-ts__inner { padding-inline: 18px; gap: 30px; }
    .pi-ts__content { gap: 20px; }
    /* 20px gap gives a 167px card at 390 (354 inner - 20 / 2), matching the
       Figma card size used by every carousel section */
    .pi-ts__track { gap: 20px; }
    .pi-ts__card { flex: 0 0 calc((100% - 20px) / 2); width: auto; gap: 10px; }
    .pi-ts__card-img { width: 100%; height: auto; aspect-ratio: 1 / 1; }
    /* Mobile keeps its own 10px image->text gap (now on .pi-ts__card). */
    .pi-ts__card-body { width: 100%; gap: 5px; padding: 0; }
    .pi-ts__card-title { font-size: 18px; line-height: 23px; -webkit-line-clamp: 2; -webkit-font-smoothing: antialiased; }
    .pi-ts__card-desc { font-size: 14px; line-height: 22px; -webkit-line-clamp: 2; -webkit-font-smoothing: antialiased; color: #121212; }

    /* Button: match best sellers exactly */
    .pi-ts__footer { width: 100%; box-sizing: border-box; }
    .pi-ts__btn { width: 100%; height: 50px; font-size: 14px; font-family: 'Proxima Nova', sans-serif; line-height: 18px; box-sizing: border-box; padding: 16px 32px; overflow: hidden; }

    /* Hide header arrows */
    .pi-ts__arrows--desktop { display: none; }

    /* Show overlay arrows — JS sets top dynamically like best sellers */
    .pi-ts__arrows--mobile-overlay {
      display: flex;
      position: absolute;
      top: 0;
      transform: translateY(-50%);

      /* Flush with the carousel edges, not -17px outside them. The arrows are
         35px wide, so -17px centred each on the container edge and left the next
         arrow ~1px from the viewport edge wherever the section gutter is 18px —
         looking cut off, and sitting under the scrollbar in a real browser.
         Matches pi-best-sellers and pi-studio-social. */
      left: 0;
      right: 0;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 5;
    }
    .pi-ts__arrows--mobile-overlay .pi-ts__arrow {
      pointer-events: auto;
      width: 35px !important;
      height: 35px !important;
      min-width: 35px;
    }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  /* Nothing left to scroll to in this direction. Last in the block so it beats
     the equal-specificity .pi-ts__arrows--mobile-overlay .pi-ts__arrow rule on
     source order; pointer-events also suppresses the hover fill. */
  .pi-ts__arrow.is-disabled {
    opacity: 0.3;
    cursor: default !important;
    pointer-events: none !important;
  }
</style>

<div class="pi-ts" id="pi-ts-{{ section.id }}">
  <div class="pi-ts__inner">

    {%- comment -%} Header: heading + desktop arrows {%- endcomment -%}
    <div class="pi-ts__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-ts__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="pi-ts__arrows--desktop">
        <div role="button" tabindex="0" class="pi-ts__arrow pi-ts__arrow--prev" aria-label="Previous services">
          <svg width="16" height="16" viewBox="4 4 16 16" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;">
            <path fill="#000000" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </div>
        <div role="button" tabindex="0" class="pi-ts__arrow pi-ts__arrow--next" aria-label="Next services">
          <svg width="16" height="16" viewBox="4 4 16 16" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;transform:rotate(180deg);">
            <path fill="#ffffff" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </div>
      </div>
    </div>

    {%- comment -%} Content: carousel + button {%- endcomment -%}
    <div class="pi-ts__content">
      <div class="pi-ts__carousel-container">
        <div class="pi-ts__track-wrap">
          <div class="pi-ts__track" id="pi-ts-track-{{ section.id }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'card' -%}
                {%- comment -%}
                  Render the card as an anchor when it has a link, keeping the
                  same class so it stays the flex item the track sizes against.
                {%- endcomment -%}
                {%- liquid
                  assign card_tag = 'div'
                  if block.settings.link != blank
                    assign card_tag = 'a'
                  endif
                -%}
                <{{ card_tag }}
                  class="pi-ts__card{% if block.settings.link != blank %} pi-ts__card--link{% endif %}"
                  {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="pi-ts__card-img">
                    {%- if block.settings.image != blank -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 720 }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                        width="360"
                        height="360"
                        loading="lazy"
                      >
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="pi-ts__card-body">
                    {%- if block.settings.title != blank -%}
                      <h4 class="pi-ts__card-title">{{ block.settings.title }}</h4>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="pi-ts__card-desc">{{ block.settings.description }}</p>
                    {%- endif -%}
                  </div>
                </{{ card_tag }}>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Mobile overlay arrows {%- endcomment -%}
        <div class="pi-ts__arrows--mobile-overlay">
          <div role="button" tabindex="0" class="pi-ts__arrow pi-ts__arrow--prev" aria-label="Previous services">
            <svg width="14" height="14" viewBox="4 4 16 16" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;">
              <path fill="#000000" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
            </svg>
          </div>
          <div role="button" tabindex="0" class="pi-ts__arrow pi-ts__arrow--next" aria-label="Next services">
            <svg width="14" height="14" viewBox="4 4 16 16" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;transform:rotate(180deg);">
              <path fill="#ffffff" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
            </svg>
          </div>
        </div>
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="pi-ts__footer">
          <a href="{{ section.settings.button_link }}" class="pi-ts__btn">
            <span class="pi-ts__btn-desktop">{{ section.settings.button_label }}</span>
            <span class="pi-ts__btn-mobile">{{ section.settings.mobile_button_label | default: section.settings.button_label }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('pi-ts-{{ section.id }}');
    if (!section) return;

    var track = section.querySelector('#pi-ts-track-{{ section.id }}');
    var trackWrap = section.querySelector('.pi-ts__track-wrap');
    var prevBtns = section.querySelectorAll('.pi-ts__arrow--prev');
    var nextBtns = section.querySelectorAll('.pi-ts__arrow--next');
    var mobileArrows = section.querySelector('.pi-ts__arrows--mobile-overlay');

    var currentIndex = 0;

    function updateMobileArrowPos() {
      if (!mobileArrows) return;
      var imgWrap = track.querySelector('.pi-ts__card-img');
      if (!imgWrap) return;
      mobileArrows.style.top = (imgWrap.offsetHeight / 2) + 'px';
    }

    function getGap() {
      return parseFloat(window.getComputedStyle(track).gap) || 20;
    }

    function getCardWidth() {
      var card = track.querySelector('.pi-ts__card');
      if (!card) return 380;
      return card.offsetWidth + getGap();
    }

    function getVisibleCount() {
      /* N cards occupy N*card + (N-1)*gap, so add one gap back before dividing
         by the card+gap step. Without it a 1500px track holding exactly four
         360px cards with 20px gaps reported 3 (floor(1500/380) = 3), leaving the
         next arrow live and scrolling into blank space. The +1 absorbs
         subpixel rounding on fractional layouts. */
      return Math.max(1, Math.floor((trackWrap.offsetWidth + getGap() + 1) / getCardWidth()));
    }

    function getTotalCards() {
      return track.querySelectorAll('.pi-ts__card').length;
    }

    function getMaxIndex() {
      return Math.max(0, getTotalCards() - getVisibleCount());
    }

    /* Grey out an arrow that has nowhere to go. With four cards fully visible on
       a wide viewport maxIndex is 0, so both arrows are inert and must not
       advertise otherwise. Re-evaluated on resize because the visible count
       changes with the breakpoint. */
    function updateArrows() {
      var maxIndex = getMaxIndex();
      function paint(btns, disabled) {
        [].slice.call(btns).forEach(function (btn) {
          btn.classList.toggle('is-disabled', disabled);
          btn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
          if (disabled) { btn.removeAttribute('tabindex'); }
          else { btn.setAttribute('tabindex', '0'); }
        });
      }
      paint(prevBtns, currentIndex <= 0);
      paint(nextBtns, currentIndex >= maxIndex);
    }

    function slideTo(index) {
      currentIndex = Math.max(0, Math.min(index, getMaxIndex()));
      track.style.transform = 'translateX(-' + (currentIndex * getCardWidth()) + 'px)';
      updateArrows();
    }

    function step(btn, delta) {
      if (btn.classList.contains('is-disabled')) return;
      slideTo(currentIndex + delta);
    }

    prevBtns.forEach(function (btn) {
      btn.addEventListener('click', function () { step(btn, -1); });
      btn.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') step(btn, -1); });
    });
    nextBtns.forEach(function (btn) {
      btn.addEventListener('click', function () { step(btn, 1); });
      btn.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') step(btn, 1); });
    });

    window.addEventListener('resize', function () { slideTo(0); updateMobileArrowPos(); });
    updateMobileArrowPos();
    updateArrows();
  })();
</script>

{% schema %}
{
  "name": "PI Tattoo Services",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tattoo Services"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Tattoo Services"
    },
    {
      "type": "text",
      "id": "mobile_button_label",
      "label": "Button label (mobile)",
      "default": "Explore Our Jewelry Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 54
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (mobile)",
      "default": 30
    },
