<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign s = section.settings
-%}

<style>
  #shopify-section-{{ section.id }} {
    margin-top: {{ s.margin_top }}px;
    margin-bottom: {{ s.margin_bottom }}px;
  }

  .pi-wl {
    background: {{ s.bg_color }};
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  }

  .pi-wl__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding-inline: 20px;
  }

  .pi-wl__heading {
    font-family: 'Playfair Display', serif;
    font-size: {{ s.heading_size }}px;
    color: {{ s.heading_color }};
    text-align: {{ s.text_alignment }};
    margin: 0 0 12px;
  }

  .pi-wl__count {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 18px;
    color: {{ s.subtext_color }};
    text-align: {{ s.text_alignment }};
    margin: 0 0 40px;
  }

  /* ── Grid: 4 across desktop, matches the jewelry grid rhythm ── */
  .pi-wl__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ s.grid_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pi-wl__card {
    position: relative;
    background: {{ s.card_bg }};
    border-radius: {{ s.card_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .pi-wl__img-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .pi-wl__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .35s ease;
  }

  .pi-wl__card:hover .pi-wl__img { transform: scale(1.05); }

  .pi-wl__body {
    padding: 18px 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1 1 auto;
  }

  .pi-wl__title {
    font-family: 'Nunito Sans', sans-serif;
    font-size: {{ s.card_title_size }}px;
    font-weight: 600;
    color: {{ s.card_title_color }};
    text-decoration: none;
    line-height: 1.35;
  }

  .pi-wl__title:hover { text-decoration: underline; }

  .pi-wl__price {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    color: {{ s.card_price_color }};
    margin: 0;
  }

  .pi-wl__actions {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .pi-wl__btn {
    font-family: 'Nunito Sans', sans-serif;
    font-size: {{ s.btn_size }}px;
    background: {{ s.btn_bg }};
    color: {{ s.btn_text }};
    border: none;
    border-radius: {{ s.btn_radius }}px;
    padding: 10px 18px;
    text-decoration: none;
    cursor: pointer;
    transition: background .25s ease, color .25s ease;
    display: inline-block;
  }

  .pi-wl__btn:hover {
    background: {{ s.btn_hover_bg }};
    color: {{ s.btn_hover_text }};
  }

  /* Remove control — kept text-only so it never competes with the primary CTA */
  .pi-wl__remove {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    background: none;
    border: none;
    color: {{ s.remove_color }};
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .pi-wl__remove:hover { opacity: .7; }

  /* ── Empty / loading states ── */
  .pi-wl__state {
    text-align: center;
    padding: 40px 0 10px;
  }

  .pi-wl__state-text {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 18px;
    color: {{ s.subtext_color }};
    margin: 0 0 24px;
  }

  .pi-wl [hidden] { display: none !important; }

  @media (max-width: 1199px) {
    .pi-wl__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 989px) {
    .pi-wl__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 749px) {
    .pi-wl {
      padding-top: {{ s.mobile_padding_top }}px;
      padding-bottom: {{ s.mobile_padding_bottom }}px;
    }
    .pi-wl__heading { font-size: {{ s.mobile_heading_size }}px; }
    .pi-wl__count { font-size: 16px; margin-bottom: 28px; }
    .pi-wl__grid { gap: {{ s.mobile_grid_gap }}px; }
  }
</style>

<div class="pi-wl">
  <div class="pi-wl__inner">
    <h1 class="pi-wl__heading">{{ s.heading }}</h1>
    <p class="pi-wl__count" data-wl-count></p>

    {%- comment -%} Loading state — replaced as soon as the fetches resolve {%- endcomment -%}
    <div class="pi-wl__state" data-wl-loading>
      <p class="pi-wl__state-text">{{ s.loading_text }}</p>
    </div>

    {%- comment -%} Empty state {%- endcomment -%}
    <div class="pi-wl__state" data-wl-empty hidden>
      <p class="pi-wl__state-text">{{ s.empty_text }}</p>
      {%- if s.empty_button_label != blank -%}
        <a href="{{ s.empty_button_link | default: '/pages/shop-jewelry' }}" class="pi-wl__btn">
          {{- s.empty_button_label -}}
        </a>
      {%- endif -%}
    </div>

    <ul class="pi-wl__grid" data-wl-grid hidden></ul>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;

  /* Storage contract — the heart buttons on product cards write the same key.
     Value is a JSON array of product handles, newest first. */
  var KEY = 'puertoink:wishlist';

  var grid    = root.querySelector('[data-wl-grid]');
  var empty   = root.querySelector('[data-wl-empty]');
  var loading = root.querySelector('[data-wl-loading]');
  var countEl = root.querySelector('[data-wl-count]');

  function read() {
    try {
      var raw = window.localStorage.getItem(KEY);
      if (!raw) return [];
      var arr = JSON.parse(raw);
      return Array.isArray(arr) ? arr.filter(function (h) { return typeof h === 'string' && h; }) : [];
    } catch (e) {
      return [];
    }
  }

  function write(list) {
    try { window.localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) {}
  }

  function money(cents) {
    if (typeof cents !== 'number') return '';
    return '{{ shop.currency }} ' + (cents / 100).toFixed(2);
  }

  function setCount(n) {
    if (!countEl) return;
    if (!n) { countEl.textContent = ''; return; }
    countEl.textContent = n === 1 ? '1 item saved' : n + ' items saved';
  }

  function showEmpty() {
    if (loading) loading.hidden = true;
    if (grid) grid.hidden = true;
    if (empty) empty.hidden = false;
    setCount(0);
  }

  function card(product) {
    var li = document.createElement('li');
    li.className = 'pi-wl__card';
    li.setAttribute('data-handle', product.handle);

    var img = (product.featured_image || (product.images && product.images[0]) || '');
    var url = '/products/' + product.handle;

    var imgHtml = img
      ? '<a class="pi-wl__img-wrap" href="' + url + '" tabindex="-1" aria-hidden="true">' +
          '<img class="pi-wl__img" src="' + img + '" alt="" loading="lazy" width="400" height="400">' +
        '</a>'
      : '';

    li.innerHTML =
      imgHtml +
      '<div class="pi-wl__body">' +
        '<a class="pi-wl__title" href="' + url + '"></a>' +
        '<p class="pi-wl__price">' + money(product.price) + '</p>' +
        '<div class="pi-wl__actions">' +
          '<a class="pi-wl__btn" href="' + url + '">{{ s.card_button_label | escape }}</a>' +
          '<button class="pi-wl__remove" type="button" data-wl-remove>{{ s.remove_label | escape }}</button>' +
        '</div>' +
      '</div>';

    /* Title set via textContent so product names with & or quotes can't break markup */
    li.querySelector('.pi-wl__title').textContent = product.title || product.handle;

    li.querySelector('[data-wl-remove]').addEventListener('click', function () {
      var next = read().filter(function (h) { return h !== product.handle; });
      write(next);
      li.remove();
      var left = grid.children.length;
      setCount(left);
      if (!left) showEmpty();
    });

    return li;
  }

  var handles = read();

  if (!handles.length) { showEmpty(); return; }

  /* Fetch each saved product. Handles that 404 (product deleted or unpublished)
     are dropped from storage so the list self-heals instead of showing gaps. */
  Promise.all(handles.map(function (h) {
    return fetch('/products/' + encodeURIComponent(h) + '.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
  })).then(function (results) {
    var alive = [];
    var frag = document.createDocumentFragment();

    results.forEach(function (p, i) {
      if (!p || !p.handle) return;
      alive.push(handles[i]);
      frag.appendChild(card(p));
    });

    if (alive.length !== handles.length) write(alive);

    if (loading) loading.hidden = true;

    if (!alive.length) { showEmpty(); return; }

    grid.appendChild(frag);
    grid.hidden = false;
    if (empty) empty.hidden = true;
    setCount(alive.length);
  });
})();
</script>

{% schema %}
{
  "name": "PI Wishlist",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "loading_text", "label": "Loading text", "default": "Loading your saved items…" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "You haven't saved anything yet. Tap the heart on any piece to keep it here." },
    { "type": "text", "id": "empty_button_label", "label": "Empty state button label", "default": "Explore Our Jewelry Collection" },
    { "type": "url", "id": "empty_button_link", "label": "Empty state button link" },
    { "type": "text", "id": "card_button_label", "label": "Card button label", "default": "View Product" },
    { "type": "text", "id": "remove_label", "label": "Remove link label", "default": "Remove" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "default": 100, "unit": "px" },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 0, "max": 120, "step": 4, "default": 56, "unit": "px" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "default": 0, "unit": "px" },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "default": 0, "unit": "px" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 60, "step": 2, "default": 30, "unit": "px" },
    { "type": "range", "id": "mobile_grid_gap", "label": "Mobile grid gap", "min": 8, "max": 40, "step": 2, "default": 16, "unit": "px" },

    { "type": "header", "content": "Typography & colour" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 72, "step": 1, "default": 54, "unit": "px" },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 16, "max": 48, "step": 1, "default": 30, "unit": "px" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#000000" },
    { "type": "color", "id": "subtext_color", "label": "Sub text colour", "default": "#121212" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Cards" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#e6e6e6" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 40, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "card_title_size", "label": "Card title size", "min": 12, "max": 30, "step": 1, "default": 20, "unit": "px" },
    { "type": "color", "id": "card_title_color", "label": "Card title colour", "default": "#000000" },
    { "type": "color", "id": "card_price_color", "label": "Card price colour", "default": "#121212" },
    { "type": "color", "id": "remove_color", "label": "Remove link colour", "default": "#121212" },

    { "type": "header", "content": "Button" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "btn_radius", "label": "Button radius", "min": 0, "max": 30, "step": 1, "default": 8, "unit": "px" },
    { "type": "range", "id": "btn_size", "label": "Button text size", "min": 12, "max": 24, "step": 1, "default": 16, "unit": "px" },
    { "type": "color", "id": "btn_hover_bg", "label": "Button hover background", "default": "#b49146" },
    { "type": "color", "id": "btn_hover_text", "label": "Button hover text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "PI Wishlist" }]
}
{% endschema %}
