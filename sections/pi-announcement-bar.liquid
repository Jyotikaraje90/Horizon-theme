<style>
  .pi-announcement {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 40px;
    background-color: #111111;
    color: #ffffff;
    font-size: 12px;
    letter-spacing: 0.04em;
    box-sizing: border-box;
    width: 100%;
  }

  .pi-announcement__social {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .pi-announcement__social a {
    color: #ffffff;
    display: flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .pi-announcement__social a:hover {
    opacity: 1;
  }

  .pi-announcement__social svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
    display: block;
  }

  .pi-announcement__text {
    text-align: center;
    white-space: nowrap;
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .pi-announcement__locations {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .pi-announcement__locations svg {
    width: 10px;
    height: 13px;
    fill: currentColor;
    flex-shrink: 0;
  }

  .pi-announcement__location-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pi-announcement__location-list li {
    display: flex;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.03em;
  }

  .pi-announcement__location-list li + li::before {
    content: '|';
    margin: 0 8px;
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .pi-announcement {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 8px 20px;
      gap: 6px;
    }

    .pi-announcement__social,
    .pi-announcement__locations {
      display: none;
    }
  }
</style>

<div class="pi-announcement">
  <!-- Left: Social Icons -->
  <div class="pi-announcement__social">
    {%- if section.settings.facebook_url != blank -%}
      <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          {%- else -%}
      <span aria-label="Facebook">
    {%- endif -%}

        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
         {%- if section.settings.facebook_url != blank -%}
      </a>
       {%- else -%}
      </span>
    {%- endif -%}
    {%- if section.settings.twitter_url != blank -%}
      <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
        {%- else -%}
      <span aria-label="X (Twitter)">
    {%- endif -%}
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.254 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        {%- if section.settings.twitter_url != blank -%}
      </a>
       {%- else -%}
      </span>
    {%- endif -%}
    {%- if section.settings.instagram_url != blank -%}
      <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        {%- else -%}
      <span aria-label="Instagram">
    {%- endif -%}
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        {%- if section.settings.instagram_url != blank -%}
      </a>
      {%- else -%}
      </span>
    {%- endif -%}
  </div>

  <!-- Center: Announcement Text -->
  <div class="pi-announcement__text">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}" style="color:#ffffff; text-decoration:none;">
        {{ section.settings.announcement_text }}
      </a>
    {%- else -%}
      {{ section.settings.announcement_text }}
    {%- endif -%}
  </div>

  <!-- Right: Locations -->
  <div class="pi-announcement__locations">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
    </svg>
    <ul class="pi-announcement__location-list">
      {%- assign locations = section.settings.locations | split: ',' -%}
      {%- for location in locations -%}
        <li>{{ location | strip }}</li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "PI Announcement Bar",
  "tag": "section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Text",
      "default": "Sign up and get 10% off on Piercing Jewelry"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Link (optional)"
    },
    {
      "type": "header",
      "content": "Locations"
    },
    {
      "type": "text",
      "id": "locations",
      "label": "Locations (comma separated)",
      "default": "Crete, Athens, Antwerp, Amsterdam"
    }
  ],
  "presets": [
    {
      "name": "PI Announcement Bar"
    }
  ]
}
{% endschema %}
