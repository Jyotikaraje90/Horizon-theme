<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  #pi-tdc-{{ section.id }} {
    --pi-tdc-bg: {{ section.settings.bg_color }};
    --pi-tdc-heading-color: {{ section.settings.heading_color }};
    --pi-tdc-text-color: {{ section.settings.text_color }};
    --pi-tdc-image-radius: {{ section.settings.image_radius }}px;
    --pi-tdc-feature-size: {{ section.settings.feature_text_size | default: 20 }}px;
  }
</style>

<style>
  .pi-tdc {
    background: var(--pi-tdc-bg, #ffffff);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pi-tdc__inner {
    max-width: 1580px;
    margin-inline: auto;
    padding-inline: 40px;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: 50px;
  }

  /* ─── Left column ──────────────────────────────── */
  .pi-tdc__left {
    flex: 0 0 34.67%;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .pi-tdc__about {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .pi-tdc__label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 34px;
    font-weight: 500;
    line-height: 44px;
    color: var(--pi-tdc-heading-color, #000000);
    margin: 0;
  }

  .pi-tdc__label::before {
    content: '';
    width: 4px;
    height: 40px;
    background: var(--pi-tdc-heading-color, #000000);
    flex-shrink: 0;
  }

  .pi-tdc__text {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    color: var(--pi-tdc-text-color, #121212);
    margin: 0;
    text-align: left;
  }

  .pi-tdc__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    height: 50px;
    padding: 14px 28px;
    border-radius: {{ section.settings.btn_radius }}px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .pi-tdc__btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
  }

  /* Button row — a second, outlined button sits beside the primary (Figma gap 20) */
  .pi-tdc__btns {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    flex-wrap: wrap;
    gap: 20px;
  }
  .pi-tdc__btn--outline {
    background: transparent;
    color: {{ section.settings.btn_outline_text }};
    border: 1px solid {{ section.settings.btn_outline_border }};
    font-weight: 700;
  }

  {%- if section.settings.button2_label != blank -%}
    /* Figma `Btn` spec, applied to both buttons of the two-button pair:
       Fixed 55px height, padding 16/32, 16px/21 uppercase, no letter-spacing.
       Emitted only when a secondary button is in use, so single-button
       instances (e.g. Realistic Tattoos) keep their existing 50px/14px sizing. */
    .pi-tdc__btn {
      box-sizing: border-box;
      height: 55px;
      padding: 16px 32px;
      font-size: 16px;
      line-height: 21px;
      letter-spacing: 0;
    }
  {%- endif -%}
  .pi-tdc__btn--outline:hover {
    background: {{ section.settings.btn_outline_hover_bg }};
    color: {{ section.settings.btn_outline_hover_text }};
    border-color: {{ section.settings.btn_outline_hover_bg }};
  }

  .pi-tdc__left-img {
    width: 100%;
    aspect-ratio: 520 / 601;
    border-radius: var(--pi-tdc-image-radius, 10px);
    overflow: hidden;
    background: #f3f3f3;
  }

  /* ─── Right column ─────────────────────────────── */
  .pi-tdc__right {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .pi-tdc__right-img {
    width: 100%;
    aspect-ratio: 930 / 740;
    border-radius: var(--pi-tdc-image-radius, 10px);
    overflow: hidden;
    background: #f3f3f3;
  }

  /* display:contents so the <picture> wrapper (added for the mobile source)
     doesn't become a layout box between the frame and the img */
  .pi-tdc__left-img picture,
  .pi-tdc__right-img picture { display: contents; }

  .pi-tdc__left-img img,
  .pi-tdc__right-img img,
  .pi-tdc__left-img .placeholder-svg,
  .pi-tdc__right-img .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Feature list ─────────────────────────────── */
  .pi-tdc__features {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-tdc__features-heading {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    color: var(--pi-tdc-heading-color, #000000);
    margin: 0;
  }

  .pi-tdc__feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .pi-tdc__feature {
    position: relative;
    padding-left: 22px;
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: var(--pi-tdc-feature-size, 20px);
    line-height: 32px;
    font-weight: 400;
    color: var(--pi-tdc-text-color, #121212);
  }

  .pi-tdc__feature::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 13px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pi-tdc-text-color, #121212);
  }

  .pi-tdc__feature-title {
    font-weight: 700;
    font-size: 18px;
    line-height: 29px;
    color: var(--pi-tdc-text-color, #121212);
  }

  .pi-tdc__feature-desc {
    font-weight: 400;
    font-size: var(--pi-tdc-feature-size, 20px);
  }

  /* ─── Responsive ───────────────────────────────── */
  @media (max-width: 989px) {
    .pi-tdc__inner { padding-inline: 24px; flex-direction: column; }
    .pi-tdc__left { flex: none; width: 100%; }
    .pi-tdc__right { width: 100%; }
  }

  @media (max-width: 600px) {
    .pi-tdc__inner { padding-inline: 18px; gap: 32px; }
    .pi-tdc__left { gap: 32px; }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

<div class="pi-tdc" id="pi-tdc-{{ section.id }}">
  <div class="pi-tdc__inner">

    <div class="pi-tdc__left">
      <div class="pi-tdc__about">
        {%- if section.settings.about_heading != blank -%}
          <h2 class="pi-tdc__label">{{ section.settings.about_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.about_text != blank -%}
          <p class="pi-tdc__text">{{ section.settings.about_text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
          <div class="pi-tdc__btns">
            {%- if section.settings.button_label != blank -%}
              <a href="{{ section.settings.button_link }}" class="pi-tdc__btn">{{ section.settings.button_label }}</a>
            {%- endif -%}
            {%- if section.settings.button2_label != blank -%}
              <a href="{{ section.settings.button2_link }}" class="pi-tdc__btn pi-tdc__btn--outline">{{ section.settings.button2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pi-tdc__left-img">
        {%- if section.settings.left_image != blank -%}
          <picture>
            {%- if section.settings.left_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.left_image_mobile | image_url: width: 1040 }}">
            {%- endif -%}
            <img
              src="{{ section.settings.left_image | image_url: width: 1040 }}"
              alt="{{ section.settings.left_image.alt | escape }}"
              loading="lazy"
            >
          </picture>
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="pi-tdc__right">
      <div class="pi-tdc__right-img">
        {%- if section.settings.right_image != blank -%}
          <picture>
            {%- if section.settings.right_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.right_image_mobile | image_url: width: 1240 }}">
            {%- endif -%}
            <img
              src="{{ section.settings.right_image | image_url: width: 1860 }}"
              alt="{{ section.settings.right_image.alt | escape }}"
              loading="lazy"
            >
          </picture>
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
      {%- if section.settings.features_heading != blank or feature_blocks.size > 0 -%}
        <div class="pi-tdc__features">
          {%- if section.settings.features_heading != blank -%}
            <h3 class="pi-tdc__features-heading">{{ section.settings.features_heading }}</h3>
          {%- endif -%}
          {%- if feature_blocks.size > 0 -%}
            <ul class="pi-tdc__feature-list">
              {%- for block in feature_blocks -%}
                <li class="pi-tdc__feature" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}<strong class="pi-tdc__feature-title">{{ block.settings.title }}:</strong> {% endif -%}
                  {%- if block.settings.description != blank -%}<span class="pi-tdc__feature-desc">{{ block.settings.description }}</span>{% endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "PI Tattoo Detail Content",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "About Block"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Heading",
      "default": "About Realistic Tattoos"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Description",
      "default": "Realistic tattoos bring lifelike detail and depth to the skin, capturing portraits, animals, and nature with striking precision. Using advanced shading and fine linework, our artists create pieces that look like photographs come to life."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button label",
      "info": "Optional. Renders as an outlined button beside the first one. Leave empty to show only one button."
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left column image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "left_image_mobile",
      "label": "Left column image — Mobile",
      "info": "Optional. Shown at ≤749px. If empty, the desktop image is used."
    },
    {
      "type": "header",
      "content": "Work Showcase"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right column large image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "right_image_mobile",
      "label": "Right column large image — Mobile",
      "info": "Optional. Shown at ≤749px. If empty, the desktop image is used."
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "range",
      "id": "feature_text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Feature text size",
      "info": "Lower this to keep long feature lines from wrapping. 20 = original.",
      "default": 20
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features heading",
      "default": "Realistic Tattoo Features"
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Button hover background",
      "default": "#B49146"
    },
    {
      "type": "color",
      "id": "btn_hover_text",
      "label": "Button hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "color",
      "id": "btn_outline_text",
      "label": "Secondary button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_outline_border",
      "label": "Secondary button border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_outline_hover_bg",
      "label": "Secondary button hover background",
      "default": "#B49146"
    },
    {
      "type": "color",
      "id": "btn_outline_hover_text",
      "label": "Secondary button hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short supporting description of this feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI Tattoo Detail Content",
      "blocks": [
        { "type": "feature", "settings": { "title": "Bold Outlines & Vibrant Colors", "description": "Crisp linework and rich color saturation that keeps the design sharp for years." } },
        { "type": "feature", "settings": { "title": "Custom Design Options", "description": "Every piece is tailored to your vision, sized and styled to fit your body." } },
        { "type": "feature", "settings": { "title": "Expert Artists & Premium Inks", "description": "Skilled artists using skin-safe, high-pigment inks for a lasting finish." } }
      ]
    }
  ]
}
{% endschema %}
