<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .pi-cart {
    max-width: 1500px;
    margin: 0 auto;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
  }

  /* [thumb + details] ... [quantity + remove] ... [line total], spread with
     space-between exactly as the Figma frame does, which keeps the controls off
     the far right. The three columns carry fixed widths rather than hugging
     their text: space-between splits the leftover space evenly, so a column
     sized by its content would land at a different x on every row. */
  .pi-cart__row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .pi-cart__product {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 50px;
    flex: 0 1 480px;
    min-width: 0;
  }

  /* ── Column headings ─────────────────────────────── */
  .pi-cart__head {
    padding-bottom: 18px;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .pi-cart__head-label {
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .pi-cart__head .pi-cart__head-label:last-child { text-align: right; }

  /* ── Line items ──────────────────────────────────── */
  .pi-cart__item {
    padding: 18px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .pi-cart__media {
    width: 110px;
    height: 110px;
    border-radius: 8px;
    overflow: hidden;
    background: {{ section.settings.thumb_bg }};
  }

  .pi-cart__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Figma: 12px under the title, then 5px between the option lines. */
  .pi-cart__details {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .pi-cart__title {
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: {{ section.settings.text_color }};
    margin: 0;
    text-decoration: none;
  }

  .pi-cart__title { margin-bottom: 7px; }
  .pi-cart__title:hover { color: {{ section.settings.accent_color }}; }

  .pi-cart__option {
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  /* ── Quantity + remove ───────────────────────────── */
  .pi-cart__controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }

  .pi-cart__qty {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 149px;
    height: 53px;
    border: 1px solid {{ section.settings.text_color }};
    border-radius: 8px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .pi-cart__qty-btn {
    flex: 0 0 46px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    font: inherit;
  }

  .pi-cart__qty-btn:hover { color: {{ section.settings.accent_color }}; }
  .pi-cart__qty-btn svg { width: 14px; height: 14px; }

  .pi-cart__qty-input {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    height: 100%;
    border: 0;
    padding: 0;
    text-align: center;
    background: transparent;
    font-family: inherit;
    font-weight: 400;
    font-size: 16px;
    color: {{ section.settings.text_color }};
    outline: none;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .pi-cart__qty-input::-webkit-outer-spin-button,
  .pi-cart__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pi-cart__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20.37px;
    height: 23px;
    color: {{ section.settings.remove_color }};
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .pi-cart__remove:hover { color: {{ section.settings.accent_color }}; }
  .pi-cart__remove svg { width: 20.37px; height: 23px; }

  .pi-cart__price {
    flex: 0 0 120px;
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: {{ section.settings.text_color }};
    text-align: right;
    margin: 0;
  }

  /* ── Upgrade offer ───────────────────────────────
     A strip, not a card: it acts on a line already in the cart, so it reads as
     an amendment to the list above rather than a second shop. */
  .pi-cart__upgrade {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .pi-cart__upgrade-media {
    flex: none;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: 8px;
    background: {{ section.settings.thumb_bg }};
  }

  .pi-cart__upgrade-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pi-cart__upgrade-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .pi-cart__upgrade-eyebrow {
    margin: 0 0 3px;
    color: {{ section.settings.accent_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pi-cart__upgrade-title {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
  }

  .pi-cart__upgrade-note {
    margin: 4px 0 0;
    color: {{ section.settings.muted_color }};
    font-size: 14px;
    line-height: 1.45;
  }

  .pi-cart__upgrade-btn {
    flex: none;
    padding: 11px 20px;
    background: none;
    border: 1px solid {{ section.settings.accent_color }};
    border-radius: 5px;
    color: {{ section.settings.accent_color }};
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .pi-cart__upgrade-btn:hover:not(:disabled) {
    background: {{ section.settings.accent_color }};
    color: #ffffff;
  }

  .pi-cart__upgrade-btn:disabled { opacity: 0.6; cursor: default; }

  @media screen and (max-width: 600px) {
    .pi-cart__upgrade { flex-wrap: wrap; }
    .pi-cart__upgrade-btn { width: 100%; }
  }

  /* ── Cart cross-sell ─────────────────────────────── */
  .pi-cart__cross-sell {
    padding: 38px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .pi-cart__cross-sell-heading {
    margin: 0 0 20px;
    color: {{ section.settings.text_color }};
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    line-height: 1.15;
    font-weight: 600;
  }

  .pi-cart__cross-sell-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cross_sell_products_to_show }}, minmax(0, 1fr));
    gap: 20px;
  }

  .pi-cart__cross-sell-card {
    min-width: 0;
  }

  .pi-cart__cross-sell-image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: {{ section.settings.thumb_bg }};
  }

  .pi-cart__cross-sell-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pi-cart__cross-sell-title {
    display: block;
    margin: 14px 0 6px;
    color: {{ section.settings.text_color }};
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }

  .pi-cart__cross-sell-title:hover { color: {{ section.settings.accent_color }}; }

  .pi-cart__cross-sell-price {
    margin: 0 0 12px;
    color: {{ section.settings.text_color }};
    font-size: 16px;
  }

  .pi-cart__cross-sell-add {
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid {{ section.settings.text_color }};
    border-radius: {{ section.settings.btn_radius }}px;
    background: transparent;
    color: {{ section.settings.text_color }};
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .pi-cart__cross-sell-add:hover:not(:disabled) {
    border-color: {{ section.settings.btn_hover_bg }};
    background: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
  }

  .pi-cart__cross-sell-add:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  /* ── Totals ──────────────────────────────────────── */
  /* Aligned to the right-hand pair of columns so SUBTOTAL sits above the
     quantity column and the amount lines up with the line totals. */
  .pi-cart__foot {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  .pi-cart__subtotal {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
    width: 100%;
    max-width: 552px;
  }

  .pi-cart__subtotal-label {
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .pi-cart__subtotal-value {
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .pi-cart__note {
    width: 100%;
    max-width: 552px;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: {{ section.settings.muted_color }};
    margin: 0;
  }

  .pi-cart__actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 30px;
    margin-top: 30px;
  }

  .pi-cart__continue {
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  .pi-cart__continue:hover { color: {{ section.settings.accent_color }}; }

  .pi-cart__checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 32px;
    border: 1px solid {{ section.settings.btn_bg }};
    border-radius: {{ section.settings.btn_radius }}px;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    font-family: inherit;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    letter-spacing: 0;
    text-transform: uppercase;
    cursor: pointer;
  }

  .pi-cart__checkout:hover {
    background: {{ section.settings.btn_hover_bg }};
    border-color: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
  }

  /* ── Empty state ─────────────────────────────────── */
  .pi-cart__empty {
    text-align: center;
    padding: 40px 0 20px;
  }

  .pi-cart__empty p {
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: {{ section.settings.muted_color }};
    margin: 0 0 30px;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      padding-left: 30px;
      padding-right: 30px;
    }

    .pi-cart__row { gap: 24px; }
    .pi-cart__product { gap: 24px; }
  }

  /* The quantity control drops under the details and the line total moves up
     beside the title, so a phone row stays two columns rather than four. */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
    }

    .pi-cart__row {
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }

    .pi-cart__product {
      flex: 1 1 100%;
      align-items: flex-start;
      gap: 16px;
    }

    .pi-cart__head { display: none; }

    .pi-cart__media { width: 90px; height: 90px; }

    .pi-cart__title { font-size: 16px; line-height: 22px; }
    .pi-cart__option { font-size: 14px; line-height: 20px; }

    .pi-cart__controls { gap: 12px; }

    .pi-cart__qty { width: 128px; height: 46px; }
    .pi-cart__qty-btn { flex: 0 0 40px; }

    .pi-cart__price {
      flex: 0 0 auto;
      min-width: 0;
      text-align: right;
      font-size: 18px;
    }

    .pi-cart__subtotal,
    .pi-cart__note { max-width: 100%; }

    .pi-cart__actions {
      width: 100%;
      justify-content: space-between;
      gap: 16px;
    }

    .pi-cart__checkout { padding: 0 24px; }

    .pi-cart__cross-sell { padding: 28px 0; }
    .pi-cart__cross-sell-heading { font-size: 26px; }
    .pi-cart__cross-sell-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  }
</style>

<div class="pi-cart">
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate data-pi-cart-form>

      <div class="pi-cart__row pi-cart__head">
        <p class="pi-cart__head-label">{{ section.settings.product_label | default: 'Product' }}</p>
        <p class="pi-cart__head-label">{{ section.settings.total_label | default: 'Total' }}</p>
      </div>

      {%- for item in cart.items -%}
        <div class="pi-cart__row pi-cart__item">

          <div class="pi-cart__product">
          <div class="pi-cart__media">
            {%- if item.image -%}
              <img
                src="{{ item.image | image_url: width: 300 }}"
                alt="{{ item.image.alt | escape }}"
                loading="lazy"
                width="110"
                height="110"
              >
            {%- endif -%}
          </div>

          <div class="pi-cart__details">
            <a href="{{ item.url }}" class="pi-cart__title">{{ item.product.title }}</a>

            {%- unless item.product.has_only_default_variant -%}
              {%- for option in item.options_with_values -%}
                <p class="pi-cart__option">{{ option.name }}: {{ option.value }}</p>
              {%- endfor -%}
            {%- endunless -%}

            {%- for property in item.properties -%}
              {%- unless property.last == blank or property.first.first == '_' -%}
                <p class="pi-cart__option">{{ property.first }}: {{ property.last }}</p>
              {%- endunless -%}
            {%- endfor -%}
          </div>
          </div>

          <div class="pi-cart__controls">
            <div class="pi-cart__qty">
              <button
                type="button"
                class="pi-cart__qty-btn"
                data-pi-cart-step="-1"
                aria-label="{{ 'accessibility.decrease_quantity' | t | default: 'Decrease quantity' }}"
              >
                <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M2 7H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>

              <input
                type="number"
                class="pi-cart__qty-input"
                name="updates[{{ item.key }}]"
                value="{{ item.quantity }}"
                min="0"
                aria-label="{{ 'accessibility.quantity' | t | default: 'Quantity' }}"
                data-pi-cart-qty
              >

              <button
                type="button"
                class="pi-cart__qty-btn"
                data-pi-cart-step="1"
                aria-label="{{ 'accessibility.increase_quantity' | t | default: 'Increase quantity' }}"
              >
                <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M7 2V12M2 7H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
            </div>

            <a
              href="{{ item.url_to_remove }}"
              class="pi-cart__remove"
              aria-label="Remove {{ item.product.title | escape }}"
            >
              <svg viewBox="0 0 21 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M1.5 5.2H19.2M7.3 5.2V2.4C7.3 1.9 7.7 1.5 8.2 1.5H12.5C13 1.5 13.4 1.9 13.4 2.4V5.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M3.9 5.2L4.9 20.6C4.9 21.1 5.3 21.5 5.8 21.5H14.9C15.4 21.5 15.8 21.1 15.8 20.6L16.8 5.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8.6 9.3V17.4M12.1 9.3V17.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </a>
          </div>

          <p class="pi-cart__price">{{ item.final_line_price | money }}</p>
        </div>
      {%- endfor -%}

      {%- comment -%} ── Upgrade offer ──
        At most one, taken from the first cart line whose product points at a
        dearer available variant through custom.upgrade_to (a variant reference,
        or a product reference whose first available variant is used). It swaps
        the line rather than adding beside it, which is what separates an
        upgrade from the cross-sell below.
      {%- endcomment -%}
      {%- liquid
        assign upgrade_from = blank
        assign upgrade_to = blank

        if section.settings.show_upgrade
          for item in cart.items
            assign ref = item.product.metafields.custom.upgrade_to.value
            if ref == blank
              continue
            endif

            comment
              A variant reference exposes .product; a product reference does not.
            endcomment
            if ref.product
              assign candidate = ref
            else
              assign candidate = ref.selected_or_first_available_variant
            endif

            if candidate == blank or candidate.available == false
              continue
            endif
            if candidate.id == item.variant_id
              continue
            endif
            comment
              Only ever upsell upward — a cheaper target would read as a downgrade.
            endcomment
            if candidate.price <= item.variant.price
              continue
            endif

            assign upgrade_present = false
            for cart_item in cart.items
              if cart_item.variant_id == candidate.id
                assign upgrade_present = true
                break
              endif
            endfor
            if upgrade_present
              continue
            endif

            assign upgrade_from = item
            assign upgrade_to = candidate
            break
          endfor
        endif
      -%}

      {%- if upgrade_to != blank -%}
        {%- liquid
          assign upgrade_delta = upgrade_to.price | minus: upgrade_from.variant.price
          assign upgrade_image = upgrade_to.image | default: upgrade_to.product.featured_image
          assign upgrade_name = upgrade_to.product.title
          unless upgrade_to.title == 'Default Title'
            assign upgrade_name = upgrade_name | append: ' — ' | append: upgrade_to.title
          endunless
          assign upgrade_cta = section.settings.upgrade_cta | replace: '{price}', upgrade_delta | money
        -%}
        <aside class="pi-cart__upgrade">
          <div class="pi-cart__upgrade-media">
            {%- if upgrade_image -%}
              <img
                src="{{ upgrade_image | image_url: width: 200 }}"
                alt="{{ upgrade_image.alt | escape }}"
                loading="lazy"
                width="64"
                height="64"
              >
            {%- endif -%}
          </div>

          <div class="pi-cart__upgrade-body">
            <p class="pi-cart__upgrade-eyebrow">{{ section.settings.upgrade_eyebrow }}</p>
            <p class="pi-cart__upgrade-title">{{ upgrade_name }}</p>
            <p class="pi-cart__upgrade-note">
              {{ section.settings.upgrade_note }}
              {%- if upgrade_from.quantity > 1 %} Swaps all {{ upgrade_from.quantity }}.{% endif -%}
            </p>
          </div>

          <button
            type="button"
            class="pi-cart__upgrade-btn"
            data-pi-cart-upgrade
            data-from="{{ upgrade_from.variant_id }}"
            data-to="{{ upgrade_to.id }}"
            data-qty="{{ upgrade_from.quantity }}"
          >
            {{ upgrade_cta }}
          </button>
        </aside>
      {%- endif -%}

      {%- if section.settings.cross_sell_collection != blank -%}
        {%- assign cross_sell_count = 0 -%}
        {%- capture cross_sell_cards -%}
          {%- for recommended_product in section.settings.cross_sell_collection.products -%}
            {%- liquid
              assign product_already_in_cart = false
              for cart_item in cart.items
                if cart_item.product.id == recommended_product.id
                  assign product_already_in_cart = true
                  break
                endif
              endfor
              assign recommended_variant = recommended_product.selected_or_first_available_variant
            -%}

            {%- unless product_already_in_cart -%}
              <article class="pi-cart__cross-sell-card">
                <a class="pi-cart__cross-sell-image" href="{{ recommended_product.url }}" aria-label="{{ recommended_product.title | escape }}">
                  {%- if recommended_product.featured_image -%}
                    {{ recommended_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 360, 600', alt: recommended_product.featured_image.alt }}
                  {%- endif -%}
                </a>
                <a class="pi-cart__cross-sell-title" href="{{ recommended_product.url }}">{{ recommended_product.title }}</a>
                <p class="pi-cart__cross-sell-price">{{ recommended_product.price | money }}</p>
                <button
                  type="button"
                  class="pi-cart__cross-sell-add"
                  data-pi-cart-cross-sell-add
                  data-variant-id="{{ recommended_variant.id }}"
                  {% unless recommended_variant.available %}disabled{% endunless %}
                >
                  {% if recommended_variant.available %}Add to cart{% else %}Sold out{% endif %}
                </button>
              </article>
              {%- assign cross_sell_count = cross_sell_count | plus: 1 -%}
              {%- if cross_sell_count >= section.settings.cross_sell_products_to_show -%}{% break %}{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if cross_sell_count > 0 -%}
          <aside class="pi-cart__cross-sell" aria-labelledby="pi-cart-cross-sell-{{ section.id }}">
            <h2 id="pi-cart-cross-sell-{{ section.id }}" class="pi-cart__cross-sell-heading">
              {{ section.settings.cross_sell_heading | default: 'Complete your order' }}
            </h2>
            <div class="pi-cart__cross-sell-grid">{{ cross_sell_cards }}</div>
          </aside>
        {%- endif -%}
      {%- endif -%}

      <div class="pi-cart__foot">
        <div class="pi-cart__subtotal">
          <p class="pi-cart__subtotal-label">{{ section.settings.subtotal_label | default: 'Subtotal' }}</p>
          <p class="pi-cart__subtotal-value">{{ cart.total_price | money }}</p>
        </div>

        <p class="pi-cart__note">{{ section.settings.tax_note | default: 'Taxes and shipping calculated at checkout' }}</p>

        <div class="pi-cart__actions">
          <a href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}" class="pi-cart__continue">
            {{ section.settings.continue_label | default: 'Continue Shopping' }}
          </a>

          <button type="submit" name="checkout" class="pi-cart__checkout">
            {{ section.settings.checkout_label | default: 'Checkout' }}
          </button>
        </div>
      </div>

    </form>
  {%- else -%}
    <div class="pi-cart__empty">
      <p>{{ section.settings.empty_text | default: 'Your cart is currently empty.' }}</p>
      <a href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}" class="pi-cart__checkout">
        {{ section.settings.continue_label | default: 'Continue Shopping' }}
      </a>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var form = root.querySelector('[data-pi-cart-form]');
    if (!form) return;

    /* Stepping submits the form so the line total and subtotal are recalculated
       by Shopify rather than guessed on the client. */
    root.querySelectorAll('[data-pi-cart-step]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = btn.parentElement.querySelector('[data-pi-cart-qty]');
        if (!input) return;
        var next = parseInt(input.value, 10) + parseInt(btn.dataset.piCartStep, 10);
        if (isNaN(next) || next < 0) next = 0;
        input.value = next;
        form.submit();
      });
    });

    root.querySelectorAll('[data-pi-cart-qty]').forEach(function (input) {
      input.addEventListener('change', function () {
        form.submit();
      });
    });

    /* The swap goes out as ONE /cart/update.js call — removing the old line and
       adding the new one as separate requests races, and a failure between them
       leaves the shopper with both items or neither. */
    root.querySelectorAll('[data-pi-cart-upgrade]').forEach(function (button) {
      button.addEventListener('click', function () {
        if (button.disabled) return;

        var label = button.textContent;
        button.disabled = true;
        button.textContent = 'Upgrading…';

        var updates = {};
        updates[button.dataset.from] = 0;
        updates[button.dataset.to] = Number(button.dataset.qty) || 1;

        fetch('{{ routes.cart_url }}/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ updates: updates })
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Unable to upgrade the item');
            window.location.assign('{{ routes.cart_url }}');
          })
          .catch(function () {
            button.disabled = false;
            button.textContent = label;
          });
      });
    });

    root.querySelectorAll('[data-pi-cart-cross-sell-add]').forEach(function (button) {
      button.addEventListener('click', function () {
        if (button.disabled) return;

        button.disabled = true;
        button.textContent = 'Adding…';

        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(button.dataset.variantId), quantity: 1 }] })
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Unable to add item to cart');
            window.location.assign('{{ routes.cart_url }}');
          })
          .catch(function () {
            button.disabled = false;
            button.textContent = 'Try again';
          });
      });
    });
  })();
</script>

