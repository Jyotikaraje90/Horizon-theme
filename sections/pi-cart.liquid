    {
      "type": "text",
      "id": "total_label",
      "label": "Total column label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Taxes and shipping calculated at checkout"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue shopping label",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "Continue shopping URL"
    },
    {
