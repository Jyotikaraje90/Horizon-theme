<style>
  #shopify-section-{{ section.id }} {
    background: #000000;
    padding: 100px 0;
  }

  .pi-vision {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 80px;
  }

  .pi-vision__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .pi-vision__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 54px;
    line-height: 1.3;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .pi-vision__subheading-wrap {
    border-left: 3px solid #ffffff;
    padding-left: 15px;
  }

  .pi-vision__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 28px;
    line-height: 38px;
    color: #ffffff;
    margin: 0;
  }

  .pi-vision__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 18px;
    line-height: 29px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .pi-vision__image {
    flex: 0 0 580px;
    height: 500px;
    overflow: hidden;
  }

  .pi-vision__image img,
  .pi-vision__image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1279px) {
    .pi-vision { gap: 60px; }
    .pi-vision__image { flex: 0 0 460px; height: 420px; }
    .pi-vision__heading { font-size: 44px; }
    .pi-vision__subheading { font-size: 24px; line-height: 34px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 70px 0; }
    .pi-vision { flex-direction: column; padding: 0 32px; gap: 40px; }
    .pi-vision__image { flex: none; width: 100%; height: 360px; }
    .pi-vision__heading { font-size: 36px; }
    .pi-vision__subheading { font-size: 22px; line-height: 32px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 50px 0; }
    .pi-vision { padding: 0 20px; }
    .pi-vision__heading { font-size: 28px; }
    .pi-vision__image { height: 260px; }
    .pi-vision__text { font-size: 16px; line-height: 26px; }
  }
</style>

<div class="pi-vision">

  <div class="pi-vision__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="pi-vision__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="pi-vision__subheading-wrap">
        <h3 class="pi-vision__subheading">{{ section.settings.subheading }}</h3>
      </div>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="pi-vision__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>

  <div class="pi-vision__image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1160 }}"
        alt="{{ section.settings.image.alt | default: 'Our Vision' | escape }}"
        loading="lazy"
        width="580"
        height="500"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Vision",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Vision"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Redefining Self-Expression Through Artistry"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "Our vision is to redefine body art by blending creativity, precision, and individuality. We strive to be a global leader in tattoo artistry and piercing craftsmanship, offering a space where self-expression meets innovation. Our commitment to excellence, safety, and client satisfaction drives us to continuously evolve, pushing the boundaries of modern tattooing and piercing. Through our passionate team and welcoming atmosphere, we aim to create meaningful, lasting art while building a community founded on trust and artistry."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "PI Vision"
    }
  ]
}
{% endschema %}
