<style>
  #shopify-section-{{ section.id }} {
    --pi-PAD-TOP: {{ section.settings.padding_top }}px;
    --pi-PAD-BOTTOM: {{ section.settings.padding_bottom }}px;
    --pi-vision-bg: {{ section.settings.bg_color }};
    --pi-vision-heading-size: {{ section.settings.heading_size }}px;
    --pi-vision-heading-color: {{ section.settings.heading_color }};
    --pi-vision-subheading-size: {{ section.settings.subheading_size }}px;
    --pi-vision-subheading-color: {{ section.settings.subheading_color }};
    --pi-vision-accent-border-color: {{ section.settings.accent_border_color }};
    --pi-vision-accent-border-width: {{ section.settings.accent_border_width }}px;
    --pi-vision-body-size: {{ section.settings.body_text_size }}px;
    --pi-vision-body-color: {{ section.settings.body_text_color }};
    --pi-vision-image-radius: {{ section.settings.image_radius }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-PAD-TOP: {{ section.settings.mobile_padding_top }}px;
      --pi-PAD-BOTTOM: {{ section.settings.mobile_padding_bottom }}px;
      --pi-vision-heading-size: {{ section.settings.mobile_heading_size }}px;
      --pi-vision-subheading-size: {{ section.settings.mobile_subheading_size }}px;
      --pi-vision-body-size: {{ section.settings.mobile_body_text_size }}px;
    }
  }
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    background: var(--pi-vision-bg);
    padding: var(--pi-PAD-TOP) 0 var(--pi-PAD-BOTTOM);
  }

  .pi-vision {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3.34%;
  }

  .pi-vision__content {
    flex: 0 0 47.33%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .pi-vision__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-vision-heading-size);
    line-height: 70px;
    text-transform: uppercase;
    color: var(--pi-vision-heading-color);
    text-align: {{ section.settings.text_alignment }};
    margin: 0;
  }

  .pi-vision__sub-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pi-vision__subheading-wrap {
    border-left: var(--pi-vision-accent-border-width) solid var(--pi-vision-accent-border-color);
    padding-left: 15px;
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .pi-vision__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: var(--pi-vision-subheading-size);
    line-height: 40px;
    color: var(--pi-vision-subheading-color);
    margin: 0;
    white-space: nowrap;
  }

  .pi-vision__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: var(--pi-vision-body-size);
    line-height: 29px;
    font-weight: 400;
    color: var(--pi-vision-body-color);
    margin: 0;
  }
  .pi-vision__text p      { margin: 0; }
  .pi-vision__text strong { font-weight: 700; }

  .pi-vision__image {
    flex: 0 0 49.33%;
    aspect-ratio: 740 / 500;
    border-radius: var(--pi-vision-image-radius);
    overflow: hidden;
  }

  .pi-vision__image img,
  .pi-vision__image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1279px) {
    .pi-vision__heading { font-size: 44px; line-height: 58px; }
    .pi-vision__subheading { font-size: 26px; line-height: 36px; white-space: normal; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 70px 0; }
    .pi-vision { flex-direction: column; padding: 0 32px; gap: 40px; }
    .pi-vision__content { flex: none; width: 100%; gap: 30px; }
    /* Content first, image below (Figma order). Let the 740/500 (≈354/239)
       aspect-ratio govern instead of a fixed height. */
    .pi-vision__image { flex: none; width: 100%; }
    .pi-vision__heading { font-size: 36px; line-height: 48px; }
    .pi-vision__subheading { font-size: 24px; line-height: 34px; }
  }

  @media (max-width: 749px) {
    .pi-vision { padding: 0 20px; }
    .pi-vision__content { gap: 20px; }
    .pi-vision__heading { line-height: 38px; }
    .pi-vision__subheading { line-height: 28px; }
    .pi-vision__text { line-height: 26px; }
  }
</style>

<div class="pi-vision">

  <div class="pi-vision__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="pi-vision__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="pi-vision__sub-block">
      {%- if section.settings.subheading != blank -%}
        <div class="pi-vision__subheading-wrap">
          <h3 class="pi-vision__subheading">{{ section.settings.subheading }}</h3>
        </div>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="pi-vision__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="pi-vision__image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1480 }}"
        alt="{{ section.settings.image.alt | default: 'Our Vision' | escape }}"
        loading="lazy"
        width="580"
        height="500"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Vision",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Vision"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Redefining Self-Expression Through Artistry"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Our vision is to redefine body art by blending creativity, precision, and individuality. We strive to be a global leader in <strong>tattoo artistry and piercing craftsmanship</strong>, offering a space where self-expression meets innovation. Our commitment to excellence, safety, and client satisfaction drives us to continuously evolve, pushing the boundaries of modern tattooing and piercing. Through our passionate team and welcoming atmosphere, we aim to create meaningful, lasting art while building a community founded on trust and artistry.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_subheading_size",
      "label": "Mobile subheading size",
      "min": 14,
      "max": 34,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_border_color",
      "label": "Accent border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "accent_border_width",
      "label": "Accent border width",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "header",
      "content": "Body Text"
    },
    {
      "type": "range",
      "id": "body_text_size",
      "label": "Body text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "mobile_body_text_size",
      "label": "Mobile body text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "PI Vision"
    }
  ]
}
{% endschema %}
