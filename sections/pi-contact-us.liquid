<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
    background: #ffffff;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .pi-contact-us {
    max-width: 1500px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    min-height: 683px;
    overflow: hidden;
  }

  /* ── Left panel ──────────────────────────────────── */
  .pi-contact-us__form-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: {{ section.settings.padding_top }}px 30px {{ section.settings.padding_bottom }}px;
    gap: 10px;
    flex: 0 0 60.67%;
    background: {{ section.settings.form_bg_color }};
    border-radius: 15px 0 0 15px;
    box-sizing: border-box;
    text-align: {{ section.settings.text_alignment }};
  }

  .pi-contact-us__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
    width: 100%;
  }

  /* Heading */
  .pi-contact-us__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
  }

  .pi-contact-us__title-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .pi-contact-us__title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 57px;
    color: {{ section.settings.heading_color }};
    margin: 0;
    text-align: {{ section.settings.text_alignment }};
  }

  .pi-contact-us__rule {
    width: 50px;
    height: 3px;
    background: #000000;
    flex-shrink: 0;
    border: none;
    margin: 0;
  }

  .pi-contact-us__subtitle {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 29px;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
    width: 100%;
  }

  /* Shopify contact form tag generates a bare <form> — must stretch to full width */
  .pi-contact-us__details > form {
    width: 100%;
  }

  /* Form */
  .pi-contact-us__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  .pi-contact-us__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 20px;
    width: 100%;
  }

  .pi-contact-us__row > * {
    min-width: 0;
    box-sizing: border-box;
  }

  .pi-contact-us__field {
    box-sizing: border-box;
    flex: 1;
    min-width: 0;
    height: 55px;
    padding: 20px;
    background: {{ section.settings.input_bg }};
    border: 1px solid {{ section.settings.input_border_color }} !important;
    border-radius: 8px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: {{ section.settings.input_text_color }};
    outline: none;
    box-shadow: none !important;
  }

  .pi-contact-us__field::placeholder { color: {{ section.settings.input_text_color }}; opacity: 0.6; }
  .pi-contact-us__field:focus { border-color: {{ section.settings.input_focus_border_color }}; }

  .pi-contact-us__select-wrap {
    position: relative;
    min-width: 0;
    width: 100%;
  }

  .pi-contact-us__select {
    box-sizing: border-box;
    width: 100%;
    height: 55px;
    padding: 0 44px 0 20px;
    background: {{ section.settings.input_bg }};
    border: 1px solid {{ section.settings.input_border_color }} !important;
    border-radius: 8px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: {{ section.settings.input_text_color }};
    outline: none;
    box-shadow: none !important;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
  }

  .pi-contact-us__select:focus { border-color: {{ section.settings.input_focus_border_color }}; }

  .pi-contact-us__select-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 11px;
    height: 7px;
  }

  .pi-contact-us__textarea {
    box-sizing: border-box;
    width: 100%;
    height: 150px;
    padding: 20px;
    background: {{ section.settings.input_bg }};
    border: 1px solid {{ section.settings.input_border_color }} !important;
    border-radius: 8px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: {{ section.settings.input_text_color }};
    outline: none;
    box-shadow: none !important;
    resize: vertical;
  }

  .pi-contact-us__textarea::placeholder { color: {{ section.settings.input_text_color }}; opacity: 0.6; }
  .pi-contact-us__textarea:focus { border-color: {{ section.settings.input_focus_border_color }}; }

  .pi-contact-us__textarea--tall {
    height: 215px;
    resize: none;
  }

  .pi-contact-us__row--upload {
    align-items: stretch;
  }

  .pi-contact-us__row--upload .pi-contact-us__textarea {
    flex: 1;
    width: auto;
    min-width: 0;
  }

  .pi-contact-us__dropzone {
    box-sizing: border-box;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    min-height: 215px;
    padding: 20px;
    background: {{ section.settings.input_bg }};
    border: 1px dashed {{ section.settings.input_border_color }};
    border-radius: 8px;
    cursor: pointer;
  }

  .pi-contact-us__dropzone-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .pi-contact-us__dropzone-icon {
    width: 32px;
    height: 32px;
    color: {{ section.settings.input_text_color }};
  }

  .pi-contact-us__dropzone-title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #000000;
    margin: 0;
  }

  .pi-contact-us__dropzone-hint {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    color: {{ section.settings.input_text_color }};
    margin: 0;
  }

  .pi-contact-us__dropzone-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 16px 32px;
    border: 1px solid #000000;
    border-radius: 8px;
    background: #ffffff;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #000000;
  }

  .pi-contact-us__dropzone-filename {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    color: {{ section.settings.input_focus_border_color }};
    margin: 0;
    word-break: break-all;
  }

  /* Submit row */
  .pi-contact-us__submit-row {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    width: 100%;
  }

  .pi-contact-us__btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 16px 32px;
    gap: 20px;
    height: 55px;
    background: {{ section.settings.btn_bg }};
    border: none;
    border-radius: {{ section.settings.btn_radius }}px;
    cursor: pointer;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: {{ section.settings.btn_size }}px;
    line-height: 21px;
    text-align: center;
    text-transform: uppercase;
    color: {{ section.settings.btn_text }};
    white-space: nowrap;
    box-sizing: border-box;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pi-contact-us__btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
  }

  .pi-contact-us__success {
    display: none;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    color: #000000;
    padding: 12px 0;
    margin: 0;
  }

  /* Shopify re-renders the page with form.errors when e.g. the email is
     malformed. Without this the submit silently appeared to do nothing. */
  .pi-contact-us__errors {
    margin: 0 0 15px;
    padding: 14px 18px;
    border: 1.5px solid #C0392B;
    border-radius: 8px;
    background: #FDECEA;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #8E2A20;
  }
  .pi-contact-us__errors ul { margin: 6px 0 0; padding-left: 20px; }

  /* ── Thank-you modal ──────────────────────────────
     Rendered only when form.posted_successfully? is true, so its mere presence
     in the DOM is the "submitted" signal. The inline .pi-contact-us__success
     paragraph stays as the no-JS fallback. */
  .pi-contact-us__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.65);
    box-sizing: border-box;
  }
  .pi-contact-us__modal[hidden] { display: none; }

  .pi-contact-us__modal-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    box-sizing: border-box;
    padding: 44px 36px 36px;
    border-radius: 15px;
    background: #ffffff;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .pi-contact-us__modal-icon {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: {{ section.settings.btn_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pi-contact-us__modal-icon svg { display: block; width: 32px; height: 32px; }

  .pi-contact-us__modal-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 30px;
    line-height: 1.25;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  .pi-contact-us__modal-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #121212;
    margin: 0;
  }

  .pi-contact-us__modal-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    margin-top: 6px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: {{ section.settings.btn_size }}px;
    text-transform: uppercase;
    border: none;
    border-radius: {{ section.settings.btn_radius }}px;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .pi-contact-us__modal-btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
  }

  .pi-contact-us__modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    line-height: 1;
    color: #121212;
  }
  .pi-contact-us__modal-close svg { display: block; width: 14px; height: 14px; }

  @media (max-width: 749px) {
    .pi-contact-us__modal-card { padding: 36px 22px 28px; gap: 14px; }
    .pi-contact-us__modal-title { font-size: 24px; }
    .pi-contact-us__modal-text { font-size: 15px; }
    .pi-contact-us__modal-btn { height: 50px; width: 100%; }
  }

  /* ── Right panel ─────────────────────────────────── */
  .pi-contact-us__image-panel {
    flex: 1;
    position: relative;
    background: #F3F4F3;
    border-radius: 0 15px 15px 0;
    overflow: hidden;
    min-height: 683px;
  }

  .pi-contact-us__image-panel picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pi-contact-us__image-panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .pi-contact-us__overlay {
    display: none;
  }

  /* ── No-image variant: single centered panel ───────── */
  .pi-contact-us--no-image {
    max-width: 800px;
  }
  .pi-contact-us--no-image.pi-contact-us--wide {
    max-width: 1500px;
  }
  .pi-contact-us--no-image .pi-contact-us__form-panel {
    flex: 1 1 100%;
    border-radius: 15px;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 989px) {
    .pi-contact-us {
      flex-direction: column;
      min-height: auto;
    }

    .pi-contact-us__form-panel {
      flex: none;
      width: 100%;
      /* Image is hidden below 990, so the form panel is the whole card — round all
         four corners (was top-only when the image sat stacked underneath). */
      border-radius: 15px;
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    /* Remove the stacked image wherever it would sit below the form (all widths
       under 990). Desktop (>=990) keeps the side-by-side image panel. */
    .pi-contact-us__image-panel {
      display: none;
    }

    .pi-contact-us__title {
      font-size: clamp(28px, 5vw, 48px);
      line-height: 1.2;
    }
    .pi-contact-us__subtitle {
      font-size: 18px;
      line-height: 29px;
    }
  }

  /* Above 749: give the card a side gutter so it doesn't sit flush against the
     viewport edges. Padding on the section keeps the 1500px max-width centering
     intact on very wide screens (card just centers inside the padded area). */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} { padding-left: 40px; padding-right: 40px; }
  }

  @media (max-width: 749px) {
    .pi-contact-us { margin: 0 20px; }
    .pi-contact-us__form-panel { padding-left: 20px; padding-right: 20px; }
    .pi-contact-us__details { gap: 20px; }
    .pi-contact-us__row { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: 1fr; gap: 15px; }
    .pi-contact-us__form { gap: 15px; }
    .pi-contact-us__field { width: 100%; height: 53px; padding: 20px; border-radius: 8px; }
    .pi-contact-us__select-wrap { width: 100%; }
    .pi-contact-us__select { height: 53px; border-radius: 8px; }
    .pi-contact-us__dropzone { width: 100%; }
    .pi-contact-us__title { font-size: {{ section.settings.mobile_heading_size }}px; line-height: 1.3; }
    .pi-contact-us__subtitle { font-size: 16px; line-height: 26px; color: #000000; }
    .pi-contact-us__heading { gap: 5px; }
    .pi-contact-us__textarea { height: 150px; border-radius: 8px; }
    /* Size the button to its own text instead of stretching it full-width,
       aligned to the right (matching desktop). */
    .pi-contact-us__btn { width: auto; height: 50px; padding: 16px 40px; }
    .pi-contact-us__submit-row { align-items: flex-end; }
    .pi-contact-us__image-panel { display: none; }
  }

  /* Below 414: revert to the full-width button (as it was before). At 414 and up
     it stays auto-sized/right-aligned per the rule above. */
  @media (max-width: 413px) {
    .pi-contact-us__btn { width: 100%; padding: 16px 32px; }
    .pi-contact-us__submit-row { align-items: stretch; }
  }
</style>

<div class="pi-contact-us{% if section.settings.background_image == blank %} pi-contact-us--no-image{% endif %}{% if section.settings.detailed_booking_form %} pi-contact-us--wide{% endif %}">

  <div class="pi-contact-us__form-panel">
    <div class="pi-contact-us__details">

      <div class="pi-contact-us__heading">
        <div class="pi-contact-us__title-wrap">
          <h2 class="pi-contact-us__title">{{ section.settings.title | default: 'Get In Touch' }}</h2>
          <hr class="pi-contact-us__rule">
        </div>
        <p class="pi-contact-us__subtitle">{{ section.settings.subtitle | default: "Fill out the contact form below and we'll get back to you as soon as we can! You can also get in touch via phone or email." }}</p>
      </div>

      {%- comment -%}
        Built with `assign` rather than inline `{{ }}`: Liquid does not
        interpolate inside a quoted tag argument, so the id was rendering as the
        literal string "pi-contact-form-{{ section.id }}". Shopify posts the form
        and redirects to `/contact#<id>` to surface the success/error message, so
        with an unresolvable id the anchor matched nothing and the page never
        scrolled to the response.
      {%- endcomment -%}
      {%- assign contact_form_id = 'pi-contact-form-' | append: section.id -%}
      {%- form 'contact', id: contact_form_id -%}

        {%- if form.posted_successfully? -%}
          <p class="pi-contact-us__success" style="display:block;">
            {{- section.settings.success_message | default: "Thank you! We'll be in touch soon." -}}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="pi-contact-us__errors" role="alert" tabindex="-1" data-pi-contact-errors>
            {{ 'templates.contact.form.error_heading' | t | default: 'Please check the form and try again:' }}
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- assign location_blocks = section.blocks | where: 'type', 'location' -%}
        {%- assign artist_blocks = section.blocks | where: 'type', 'artist' -%}

        <div class="pi-contact-us__form">

          {%- if section.settings.detailed_booking_form -%}

            <div class="pi-contact-us__row">
              <input
                class="pi-contact-us__field"
                type="text"
                name="contact[First Name]"
                placeholder="First Name*"
                required
                autocomplete="given-name"
              >
              <input
                class="pi-contact-us__field"
                type="text"
                name="contact[Last Name]"
                placeholder="Last Name*"
                required
                autocomplete="family-name"
              >
              <input
                class="pi-contact-us__field"
                type="tel"
                name="contact[Phone]"
                placeholder="Phone*"
                required
                autocomplete="tel"
              >
            </div>

            <div class="pi-contact-us__row">
              <input
                class="pi-contact-us__field"
                type="email"
                name="contact[email]"
                placeholder="Email*"
                required
                autocomplete="email"
              >
              {%- if location_blocks.size > 0 -%}
                <div class="pi-contact-us__select-wrap">
                  <select class="pi-contact-us__select" name="contact[Studio Location]" required>
                    <option value="" disabled selected>Select Our Studio Location*</option>
                    {%- for block in location_blocks -%}
                      <option value="{{ block.settings.location_name | escape }}">{{ block.settings.location_name }}</option>
                    {%- endfor -%}
                  </select>
                  <svg class="pi-contact-us__select-icon" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M1 1L5.5 6L10 1" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              {%- endif -%}
              <div class="pi-contact-us__select-wrap">
                <select class="pi-contact-us__select" name="contact[Tattoo Size]" required>
                  <option value="" disabled selected>Tattoo Size Selection*</option>
                  <option value="Small (up to 2 in)">Small (up to 2 in)</option>
                  <option value="Medium (2-6 in)">Medium (2-6 in)</option>
                  <option value="Large (6-10 in)">Large (6-10 in)</option>
                  <option value="Extra Large (10+ in)">Extra Large (10+ in)</option>
                </select>
                <svg class="pi-contact-us__select-icon" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 1L5.5 6L10 1" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <div class="pi-contact-us__row">
              <input
                class="pi-contact-us__field"
                type="text"
                name="contact[Placement On Body]"
                placeholder="Placement On Body"
                autocomplete="off"
              >
              <div class="pi-contact-us__select-wrap">
                <select class="pi-contact-us__select" name="contact[Preferred Tattoo Artist]">
                  <option value="" disabled selected>Preferred Tattoo Artist</option>
                  {%- for block in artist_blocks -%}
                    <option value="{{ block.settings.artist_name | escape }}">{{ block.settings.artist_name }}</option>
                  {%- endfor -%}
                </select>
                <svg class="pi-contact-us__select-icon" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 1L5.5 6L10 1" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <div class="pi-contact-us__row pi-contact-us__row--upload">
              <label class="pi-contact-us__dropzone" for="pi-contact-file-{{ section.id }}">
                <input
                  class="pi-contact-us__dropzone-input"
                  type="file"
                  id="pi-contact-file-{{ section.id }}"
                  accept="image/jpeg,image/png"
                  onchange="this.closest('.pi-contact-us__dropzone').querySelector('.pi-contact-us__dropzone-filename').textContent = this.files[0] ? this.files[0].name : '';"
                >
                <svg class="pi-contact-us__dropzone-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M7 18a4 4 0 0 1-1-7.874A5 5 0 0 1 15.5 7.5 4.5 4.5 0 0 1 17 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 12v7m0-7l-2.5 2.5M12 12l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <p class="pi-contact-us__dropzone-title">Choose a file or drag &amp; drop it here</p>
                <p class="pi-contact-us__dropzone-hint">JPEG, PNG, up to 50MB</p>
                <span class="pi-contact-us__dropzone-btn">Browse File</span>
                <p class="pi-contact-us__dropzone-filename"></p>
              </label>

              <textarea
                class="pi-contact-us__textarea pi-contact-us__textarea--tall"
                name="contact[body]"
                placeholder="Tattoo Description*"
                required
              ></textarea>
            </div>

          {%- else -%}

            <div class="pi-contact-us__row">
              <input
                class="pi-contact-us__field"
                type="text"
                name="contact[First Name]"
                placeholder="First Name*"
                required
                autocomplete="given-name"
              >
              <input
                class="pi-contact-us__field"
                type="text"
                name="contact[Last Name]"
                placeholder="Last Name*"
                required
                autocomplete="family-name"
              >
            </div>

            <div class="pi-contact-us__row">
              <input
                class="pi-contact-us__field"
                type="tel"
                name="contact[Phone]"
                placeholder="Phone*"
                required
                autocomplete="tel"
              >
              <input
                class="pi-contact-us__field"
                type="email"
                name="contact[email]"
                placeholder="Email*"
                required
                autocomplete="email"
              >
            </div>

            {%- if location_blocks.size > 0 -%}
              <div class="pi-contact-us__select-wrap" style="width: 100%;">
                <select class="pi-contact-us__select" name="contact[Studio Location]" required>
                  <option value="" disabled selected>Select Our Studio Location*</option>
                  {%- for block in location_blocks -%}
                    <option value="{{ block.settings.location_name | escape }}">{{ block.settings.location_name }}</option>
                  {%- endfor -%}
                </select>
                <svg class="pi-contact-us__select-icon" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 1L5.5 6L10 1" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            {%- endif -%}

            <textarea
              class="pi-contact-us__textarea"
              name="contact[body]"
              placeholder="Message"
            ></textarea>

          {%- endif -%}

          <div class="pi-contact-us__submit-row">
            <button type="submit" class="pi-contact-us__btn">
              {{- section.settings.button_label | default: 'Submit' -}}
            </button>
          </div>

        </div>

      {%- endform -%}

    </div>
  </div>

  {%- if section.settings.background_image != blank -%}
    <div class="pi-contact-us__image-panel">
      <picture>
        {%- if section.settings.mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_background_image | image_url: width: 900 }}"
          >
        {%- endif -%}
        <img
          src="{{ section.settings.background_image | image_url: width: 1300 }}"
          alt="{{ section.settings.background_image.alt | escape }}"
          loading="lazy"
        >
      </picture>
      <div class="pi-contact-us__overlay"></div>
    </div>
  {%- endif -%}

</div>

{%- comment -%}
  Thank-you confirmation. Shopify's contact form is a real POST: it redirects
  back to this page with form.posted_successfully?, so the modal is rendered
  server-side on that response rather than shown by an AJAX callback. Kept
  outside <form> so its buttons cannot re-submit.
{%- endcomment -%}
{%- if form.posted_successfully? -%}
  <div
    class="pi-contact-us__modal"
    data-pi-contact-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="pi-contact-thanks-{{ section.id }}"
  >
    <div class="pi-contact-us__modal-card">
      <button
        type="button"
        class="pi-contact-us__modal-close"
        data-pi-contact-dismiss
        aria-label="Close"
      >
        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>

      <span class="pi-contact-us__modal-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 12.5L9.5 18L20 6.5" stroke="{{ section.settings.btn_text }}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <h3 class="pi-contact-us__modal-title" id="pi-contact-thanks-{{ section.id }}">
        {{- section.settings.success_heading | default: 'Thank You!' -}}
      </h3>

      <p class="pi-contact-us__modal-text">
        {{- section.settings.success_message | default: "Thank you! We'll be in touch soon." -}}
      </p>

      <button type="button" class="pi-contact-us__modal-btn" data-pi-contact-dismiss>
        {{- section.settings.success_button_label | default: 'Continue Browsing' -}}
      </button>
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    /* Scoped to this section: a page carrying two contact sections would
       otherwise have both scripts drive the first section's modal. */
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var modal = root.querySelector('[data-pi-contact-modal]');

    /* Present only on the successful-submit render. When it is absent the only
       thing left to do is focus any error box so a failed submit is not silent. */
    if (!modal) {
      var errs = root.querySelector('[data-pi-contact-errors]');
      if (errs) {
        errs.scrollIntoView({ block: 'center' });
        errs.focus();
      }
      return;
    }

    var lastFocus = document.activeElement;
    var scrollLocked = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    var btn = modal.querySelector('.pi-contact-us__modal-btn');
    if (btn) btn.focus();

    /* Drop Shopify's ?form_type=contact&... from the URL so a refresh or a
       back-navigation does not resurrect the modal on a stale success. */
    if (window.history && window.history.replaceState && window.location.search) {
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    function close() {
      modal.setAttribute('hidden', '');
      document.body.style.overflow = scrollLocked;
      document.removeEventListener('keydown', onKey);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function onKey(e) {
      if (e.key === 'Escape' || e.key === 'Esc') close();
    }

    modal.querySelectorAll('[data-pi-contact-dismiss]').forEach(function (el) {
      el.addEventListener('click', close);
    });

    /* Click the dimmed backdrop, but not the card itself. */
    modal.addEventListener('click', function (e) {
      if (e.target === modal) close();
    });

    document.addEventListener('keydown', onKey);
  })();
</script>

