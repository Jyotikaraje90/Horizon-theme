  "blocks": [
    {
      "type": "location",
      "name": "Studio Location",
      "settings": [
        {
          "type": "text",
          "id": "location_name",
          "label": "Location name",
          "default": "Studio Location"
        }
      ]
    }
  ],
  "presets": [
    {
