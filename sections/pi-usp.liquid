<style>
  /* ─── Section wrapper ─────────────────────────── */
  .pi-usp {
    position: relative;
    min-height: 374px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* ─── Background image ────────────────────────── */
  .pi-usp__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pi-usp__bg img,
  .pi-usp__bg .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Dark overlay ────────────────────────────── */
  .pi-usp__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* ─── Content container ───────────────────────── */
  .pi-usp__inner {
    position: relative;
    z-index: 2;
    max-width: 1500px;
    margin-inline: auto;
    padding: 100px 40px;
    width: 100%;
    box-sizing: border-box;
  }

  /* ─── Items grid ──────────────────────────────── */
  .pi-usp__grid {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .pi-usp__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  /* ─── Vertical dividers ───────────────────────── */
  .pi-usp__divider {
    width: 1px;
    height: 174px;
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
  }

  /* ─── Icon ────────────────────────────────────── */
  .pi-usp__icon {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pi-usp__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ─── Label ───────────────────────────────────── */
  .pi-usp__label {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 34px;
    font-weight: 500;
    line-height: 44px;
    letter-spacing: 0;
    text-align: center;
    color: #ffffff;
    text-transform: uppercase;
    margin: 0;
  }

  /* ─── Responsive ──────────────────────────────── */
  @media (max-width: 1199px) {
    .pi-usp__label { font-size: 26px; line-height: 36px; }
  }

  @media (max-width: 989px) {
    .pi-usp__inner { padding: 60px 24px; }
    .pi-usp__icon { width: 72px; height: 72px; }
    .pi-usp__label { font-size: 22px; line-height: 30px; }
    .pi-usp__divider { height: 130px; }
  }

  @media (max-width: 749px) {
    .pi-usp__grid { flex-wrap: wrap; justify-content: center; gap: 40px; }
    .pi-usp__item { flex: 0 0 calc(50% - 20px); }
    .pi-usp__divider { display: none; }
    .pi-usp__inner { padding: 48px 16px; }
    .pi-usp__icon { width: 60px; height: 60px; }
    .pi-usp__label { font-size: 20px; line-height: 28px; }
  }

  /* ─── Icon placeholder (no image uploaded) ───── */
  .pi-usp__icon-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(255,255,255,0.15);
    border-radius: 8px;
  }
</style>

<div class="pi-usp">

  {%- comment -%} Background image {%- endcomment -%}
  <div class="pi-usp__bg">
    {%- if section.settings.background_image != blank -%}
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="{{ section.settings.background_image.alt | default: '' | escape }}"
        width="1920"
        height="374"
        loading="lazy"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- comment -%} Dark overlay {%- endcomment -%}
  <div class="pi-usp__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }});"></div>

  {%- comment -%} Items {%- endcomment -%}
  <div class="pi-usp__inner">
    <div class="pi-usp__grid">

      {%- for block in section.blocks -%}

        {%- unless forloop.first -%}
          <div class="pi-usp__divider" aria-hidden="true"></div>
        {%- endunless -%}

        <div class="pi-usp__item" {{ block.shopify_attributes }}>

          <div class="pi-usp__icon">
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 200 }}"
                alt="{{ block.settings.icon.alt | default: block.settings.label | escape }}"
                width="100"
                height="100"
                loading="lazy"
              >
            {%- else -%}
              <div class="pi-usp__icon-placeholder"></div>
            {%- endif -%}
          </div>

          <p class="pi-usp__label">{{ block.settings.label }}</p>

        </div>

      {%- endfor -%}

    </div>
  </div>

</div>

{% schema %}
{
  "name": "PI USPs",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Authentic"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PI USPs",
      "blocks": [
        { "type": "usp", "settings": { "label": "Authentic" } },
        { "type": "usp", "settings": { "label": "Premium" } },
        { "type": "usp", "settings": { "label": "Inclusive" } },
        { "type": "usp", "settings": { "label": "Creative" } }
      ]
    }
  ]
}
{% endschema %}
