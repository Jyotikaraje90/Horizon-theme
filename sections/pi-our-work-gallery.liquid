<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  #pi-owg-{{ section.id }} {
    --pi-owg-bg: {{ section.settings.bg_color }};
    --pi-owg-heading-color: {{ section.settings.heading_color }};
    --pi-owg-radius: {{ section.settings.image_radius }}px;
  }
</style>

<style>
  .pi-owg {
    background: var(--pi-owg-bg, #ffffff);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pi-owg__heading-wrap {
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: 40px;
    box-sizing: border-box;
    margin-bottom: 40px;
  }

  .pi-owg__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.75vw, 54px);
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--pi-owg-heading-color, #000000);
    margin: 0;
    text-align: center;
  }

  /* Full-bleed, edge-to-edge grid — intentionally not constrained to the
     1500px content width like the heading above it, and no gap between
     cells so photos sit flush against each other. */
  .pi-owg__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 0;
    width: 100%;
  }

  /* Row wrappers exist only so mobile can animate two independent marquee
     tracks; on desktop they dissolve and the cells form the grid directly. */
  .pi-owg__row { display: contents; }
  .pi-owg__photo--dupe { display: none; }

  .pi-owg__photo {
    aspect-ratio: 6 / 7;
    border-radius: var(--pi-owg-radius, 8px);
    overflow: hidden;
    background: #f3f3f3;
  }

  /* display:contents so the <picture> wrapper (added for the mobile image)
     doesn't become a layout box between the frame and the img */
  .pi-owg__photo picture { display: contents; }

  .pi-owg__photo img,
  .pi-owg__photo .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Responsive ───────────────────────────────── */
  @media (max-width: 989px) {
    .pi-owg__heading-wrap { padding-inline: 24px; }
    .pi-owg__grid { grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr); }
  }

{%- if section.settings.mobile_marquee -%}
  /* ─── Mobile: two auto-scrolling marquee rows ───
     Each row holds its photo set twice, so translating by exactly -50% lands on
     an identical frame and the loop is seamless with no JS. Both rows run the
     same direction, per the design. */
  @keyframes pi-owg-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (max-width: 749px) {
    .pi-owg { overflow-x: hidden; }

    .pi-owg__grid {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.marquee_row_gap }}px;
      width: 100%;
    }

    .pi-owg__row {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      width: max-content;
      gap: {{ section.settings.marquee_row_gap }}px;
      animation: pi-owg-marquee {{ section.settings.marquee_speed }}s linear infinite;
      will-change: transform;
    }

    /* Both rows run the same direction, so without an offset they'd move in
       perfect lockstep and read as one sliding block. A negative delay starts
       row 2 part-way through the same loop — it's already mid-animation on load,
       so nothing waits and the loop stays seamless. */
    .pi-owg__row--2 {
      animation-delay: -{{ section.settings.marquee_speed | times: section.settings.marquee_row2_offset | divided_by: 100.0 }}s;
    }

    /* Figma shows 2 photos per row: at the 390px design width each is 195px,
       i.e. exactly half the viewport, with a 195x215 cell. Sizing off vw rather
       than a fixed px keeps it 2-up (and column-aligned with the row above) at
       every screen width. The track is width:max-content, so a percentage would
       have nothing to resolve against — vw does. */
    .pi-owg__photo {
      flex: 0 0 calc((100vw - ({{ section.settings.marquee_row_gap }}px * {{ section.settings.marquee_per_row }})) / {{ section.settings.marquee_per_row }});
      aspect-ratio: 195 / 215;
    }
    .pi-owg__photo--dupe { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-owg__row { animation: none; }
  }
{%- else -%}
  /* Phones get the mobile column count across the whole range, not just below
     600 — 601-749 was still falling through to the tablet count. Gap stays 0
     and the grid stays full-bleed, so the photos sit flush edge to edge. */
  @media (max-width: 749px) {
    .pi-owg__grid { grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); }
  }
{%- endif -%}

  @media (max-width: 600px) {
    .pi-owg__heading-wrap { padding-inline: 18px; margin-bottom: 24px; }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

{%- assign photos = section.blocks | where: 'type', 'photo' -%}

<div class="pi-owg" id="pi-owg-{{ section.id }}">

  {%- if section.settings.heading != blank -%}
    <div class="pi-owg__heading-wrap">
      <h2 class="pi-owg__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if photos.size > 0 -%}
    {%- comment -%}
      The mobile marquee needs the photo set rendered twice so translating the
      strip by exactly -50% lands on an identical frame and the loop is seamless.
      The second pass is display:none above 750px, so the desktop grid is
      unaffected. Duplicates carry no shopify_attributes (that would give the
      theme editor two handles for one block) and are aria-hidden.
    {%- endcomment -%}
    {%- comment -%}
      Photos are split across two row wrappers. On desktop the wrappers are
      display:contents, so the cells collapse back into the single N-column grid
      exactly as before. On mobile each row becomes its own marquee track.
    {%- endcomment -%}
    {%- if section.settings.mobile_marquee -%}
      {%- assign passes = 2 -%}
    {%- else -%}
      {%- assign passes = 1 -%}
    {%- endif -%}
    {%- assign row1_count = photos.size | plus: 1 | divided_by: 2 -%}
    {%- assign row2_count = photos.size | minus: row1_count -%}
    <div class="pi-owg__grid">
      {%- for r in (1..2) -%}
        {%- if r == 1 -%}
          {%- assign row_photos = photos | slice: 0, row1_count -%}
        {%- else -%}
          {%- assign row_photos = photos | slice: row1_count, row2_count -%}
        {%- endif -%}
        {%- if row_photos.size > 0 -%}
          <div class="pi-owg__row pi-owg__row--{{ r }}">
            {%- for pass in (1..passes) -%}
              {%- for block in row_photos -%}
                <div class="pi-owg__photo{% if pass == 2 %} pi-owg__photo--dupe{% endif %}"
                     {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                  {%- if block.settings.image != blank -%}
                    <picture>
                      {%- if block.settings.image_mobile != blank -%}
                        <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 600 }}">
                      {%- endif -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 600 }}"
                        alt="{% if pass == 1 %}{{ block.settings.image.alt | escape }}{% endif %}"
                        width="300"
                        height="350"
                        loading="lazy"
                      >
                    </picture>
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "PI Our Work Gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Work"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns (mobile)",
      "info": "Used only when the mobile marquee below is off.",
      "default": 2
    },
    {
      "type": "header",
      "content": "Mobile marquee"
    },
    {
      "type": "checkbox",
      "id": "mobile_marquee",
      "label": "Auto-scrolling marquee on mobile",
      "info": "Below 750px, shows two rows of photos that scroll continuously in opposite directions instead of a static grid.",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Marquee loop duration",
      "info": "Seconds for one full loop. Lower = faster.",
      "default": 22
    },
    {
      "type": "range",
      "id": "marquee_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Photos visible per row",
      "info": "Figma shows 2. Each photo is sized to this fraction of the screen width.",
      "default": 2
    },
    {
      "type": "range",
      "id": "marquee_row2_offset",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Second row offset",
      "info": "Shifts row 2 along its loop. Any value above 0 breaks the column alignment between the two rows, so keep it at 0 to match Figma's aligned 2x2.",
      "default": 0
    },
    {
      "type": "range",
      "id": "marquee_row_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Marquee gap",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image — Desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image — Mobile",
          "info": "Optional. Shown at ≤749px. If empty, the desktop image is used."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI Our Work Gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
