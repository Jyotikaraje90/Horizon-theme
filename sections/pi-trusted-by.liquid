<style>
  #shopify-section-{{ section.id }} {
    background: #000000;
    overflow: hidden;
  }

  .pi-tb {
    display: flex;
    flex-direction: row;
    min-height: 500px;
  }

  /* ── Left column ──────────────────────────────── */
  .pi-tb__left {
    flex: 0 0 38%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 70px 60px;
    box-sizing: border-box;
  }

  .pi-tb__deco {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .pi-tb__deco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
    opacity: 0.25;
  }

  .pi-tb__left-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .pi-tb__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 54px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .pi-tb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    background: #ffffff;
    color: #000000;
    border: none;
    width: fit-content;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .pi-tb__btn:hover { opacity: 0.82; }

  /* ── Right column: photo grid ─────────────────── */
  .pi-tb__grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 250px;
    gap: 0;
  }

  .pi-tb__photo {
    position: relative;
    overflow: hidden;
  }

  .pi-tb__photo img,
  .pi-tb__photo .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .pi-tb__photo:hover img {
    transform: scale(1.05);
  }

  .pi-tb__photo-name {
    position: absolute;
    bottom: 10px;
    left: 12px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 1279px) {
    .pi-tb__heading { font-size: 42px; }
    .pi-tb__left { padding: 60px 48px; }
    .pi-tb__grid { grid-auto-rows: 220px; }
  }

  @media (max-width: 989px) {
    .pi-tb { flex-direction: column; }
    .pi-tb__left { flex: none; padding: 50px 32px; min-height: 260px; }
    .pi-tb__heading { font-size: 34px; }
    .pi-tb__grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 180px; }
  }

  @media (max-width: 749px) {
    .pi-tb__left { padding: 40px 20px; min-height: 220px; }
    .pi-tb__heading { font-size: 28px; }
    .pi-tb__btn { font-size: 14px; height: auto; padding: 14px 24px; }
    .pi-tb__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
  }
</style>

<div class="pi-tb">

  {%- comment -%} Left column {%- endcomment -%}
  <div class="pi-tb__left">
    {%- if section.settings.deco_image != blank -%}
      <div class="pi-tb__deco">
        <img
          src="{{ section.settings.deco_image | image_url: width: 800 }}"
          alt=""
          loading="lazy"
        >
      </div>
    {%- endif -%}
    <div class="pi-tb__left-content">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-tb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="pi-tb__btn">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Right column: photo grid {%- endcomment -%}
  <div class="pi-tb__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'photo' -%}
        <div class="pi-tb__photo" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.name | default: '' | escape }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <span class="pi-tb__photo-name">{{ block.settings.name }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Trusted By",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted By The Best"
    },
    {
      "type": "image_picker",
      "id": "deco_image",
      "label": "Decoration image (sketch / illustration)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Celebrity Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "PI Trusted By",
      "blocks": [
        { "type": "photo", "settings": { "name": "Mohamed Salah" } },
        { "type": "photo", "settings": { "name": "Kostas Tsimikas" } },
        { "type": "photo", "settings": { "name": "Thiago Alcantara" } },
        { "type": "photo", "settings": { "name": "Anna Theodoridi" } },
        { "type": "photo", "settings": { "name": "Mykola Shaparenko" } }
      ]
    }
  ]
}
{% endschema %}
