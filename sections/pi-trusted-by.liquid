  "max_blocks": 9,
  "presets": [
    {
      "name": "PI Trusted By",
      "blocks": [
        { "type": "photo", "settings": { "name": "Mohamed Salah" } },
        { "type": "photo", "settings": { "name": "Kostas Tsimikas" } },
        { "type": "photo", "settings": { "name": "Thiago Alcantara" } },
        { "type": "photo", "settings": { "name": "Anna Theodoridi" } },
        { "type": "photo", "settings": { "name": "Mykola Shaparenko" } }
      ]
    }
  ]
}
{% endschema %}
