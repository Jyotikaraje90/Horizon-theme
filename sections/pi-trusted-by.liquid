<style>
  #shopify-section-{{ section.id }} {
    background: #ffffff;
    overflow: visible;
    margin-top: 0;
    padding-top: 0;
  }

  /*
   * Figma layout: 1920 × 978px, 3 equal columns × 2 rows of 489px each.
   * Top-left cell = text panel. Remaining 5 cells = celebrity photos.
   * Block order (JSON): Mohamed Salah, Kostas Tsimikas, Thiago Alcantara,
   *   Anna Theodoridi, Mykola Shaparenko.
   * With the text panel pinned to grid-column 1 / grid-row 1, CSS auto-flow
   * places Mohamed→col2 row1, Kostas→col3 row1, Thiago→col1 row2,
   * Anna→col2 row2, Mykola→col3 row2. ✓
   */
  .pi-tb {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 489px);
    width: 100%;
  }

  /* ── Text panel (top-left cell) ──────────────────── */
  .pi-tb__text-panel {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 60px 40px;
    box-sizing: border-box;
    background: #ffffff;
    overflow: visible;
  }

  /* Decorative sketch image — fixed 197.58×326px, peeks into section above */
  .pi-tb__deco {
    position: absolute;
    top: -20px;
    left: -15px;
    z-index: 10;
    pointer-events: none;
    width: 197.58px;
    height: 326px;
  }

  .pi-tb__deco img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    opacity: 1;
  }

  /* Content above deco */
  .pi-tb__left-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 28px;
    width: 100%;
  }

  .pi-tb__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  .pi-tb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    background: #000000;
    color: #ffffff;
    border: none;
    width: fit-content;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .pi-tb__btn:hover { opacity: 0.82; }

  /* ── Celebrity photo cells ────────────────────────── */
  .pi-tb__photo {
    position: relative;
    overflow: hidden;
  }

  .pi-tb__photo img,
  .pi-tb__photo .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-tb__photo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .pi-tb__photo:hover .pi-tb__photo-overlay {
    opacity: 1;
  }

  .pi-tb__photo-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(16px, 1.6vw, 28px);
    font-weight: 600;
    color: #ffffff;
    text-align: center;
    padding: 0 12px;
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 1279px) {
    .pi-tb { grid-template-rows: repeat(2, 380px); }
    .pi-tb__heading { font-size: 42px; line-height: 56px; }
    .pi-tb__text-panel { padding: 48px 40px; }
  }

  @media (max-width: 989px) {
    .pi-tb {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
    .pi-tb__text-panel {
      grid-column: 1 / -1;
      grid-row: auto;
      height: auto;
      min-height: 260px;
      padding: 50px 32px;
      justify-content: center;
    }
    .pi-tb__photo { height: 200px; }
    .pi-tb__heading { font-size: 34px; line-height: 44px; }
  }

  @media (max-width: 749px) {
    .pi-tb { grid-template-columns: 1fr 1fr; }
    .pi-tb__text-panel { padding: 40px 20px; min-height: 220px; }
    .pi-tb__heading { font-size: 28px; line-height: 38px; }
    .pi-tb__btn { font-size: 14px; height: auto; padding: 14px 24px; }
    .pi-tb__photo { height: 160px; }
  }
</style>

<div class="pi-tb">

  {%- comment -%} Top-left cell: text panel {%- endcomment -%}
  <div class="pi-tb__text-panel">
    {%- if section.settings.deco_image != blank -%}
      <div class="pi-tb__deco">
        <img
          src="{{ section.settings.deco_image | image_url: width: 800 }}"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
      </div>
    {%- endif -%}
    <div class="pi-tb__left-content">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-tb__heading">{{ section.settings.heading | replace: ' The Best', '<br>The Best' }}</h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="pi-tb__btn">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    Photo blocks auto-placed by CSS grid starting at col 2, row 1.
    JSON block order: Mohamed(col2,row1) → Kostas(col3,row1) →
    Thiago(col1,row2) → Anna(col2,row2) → Mykola(col3,row2)
  {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'photo' -%}
      <div class="pi-tb__photo" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 660 }}"
            alt="{{ block.settings.name | default: '' | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if block.settings.name != blank -%}
          <div class="pi-tb__photo-overlay" aria-hidden="true">
            <span class="pi-tb__photo-name">{{ block.settings.name }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

</div>

{% schema %}
{
  "name": "PI Trusted By",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted By The Best"
    },
    {
      "type": "image_picker",
      "id": "deco_image",
      "label": "Decoration image (sketch / illustration)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Celebrity Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "PI Trusted By",
      "blocks": [
        { "type": "photo", "settings": { "name": "Mohamed Salah" } },
        { "type": "photo", "settings": { "name": "Kostas Tsimikas" } },
        { "type": "photo", "settings": { "name": "Thiago Alcantara" } },
        { "type": "photo", "settings": { "name": "Anna Theodoridi" } },
        { "type": "photo", "settings": { "name": "Mykola Shaparenko" } }
      ]
    }
  ]
}
{% endschema %}
