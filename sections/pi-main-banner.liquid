<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

<style>
  .pi-hero-{{ section.id }} {
    --pi-hero-side-margin: {{ section.settings.side_margin_desktop }}px;
    --pi-hero-border-radius: {{ section.settings.border_radius }}px;
    --pi-hero-desktop-height: {{ section.settings.desktop_height }}px;
    --pi-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --pi-hero-heading-size: {{ section.settings.heading_size }}px;
    --pi-hero-heading-color: {{ section.settings.heading_color }};
    --pi-hero-subheading-size: {{ section.settings.subheading_size }}px;
    --pi-hero-subheading-color: {{ section.settings.subheading_color }};
    --pi-hero-btn-bg: {{ section.settings.btn_bg }};
    --pi-hero-btn-text-color: {{ section.settings.btn_text_color }};
    --pi-hero-btn-border-color: {{ section.settings.btn_border_color }};
    --pi-hero-btn-radius: {{ section.settings.btn_radius }}px;
    --pi-hero-btn-size: {{ section.settings.btn_size }}px;
    --pi-hero-side-label-size: {{ section.settings.side_label_size }}px;
    --pi-hero-side-label-color: {{ section.settings.side_label_color }};
    --pi-hero-mobile-height: {{ section.settings.mobile_height }}px;
    --pi-hero-mobile-main-height: {{ section.settings.mobile_main_height }}px;
    --pi-hero-mobile-side-height: {{ section.settings.mobile_side_height }}px;
  }
  @media (max-width: 749px) {
    .pi-hero-{{ section.id }} {
      --pi-hero-side-margin: {{ section.settings.side_margin_mobile }}px;
    }
  }
</style>

<style>
  .pi-hero {
    display: grid;
    grid-template-columns: 71.5fr 28.5fr;
    gap: 0;
    margin: 0 var(--pi-hero-side-margin, 60px);
    height: var(--pi-hero-desktop-height, 829px);
    min-height: 500px;
    max-height: var(--pi-hero-desktop-height, 829px);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--pi-hero-border-radius, 20px);
    clip-path: inset(0 round var(--pi-hero-border-radius, 20px));
    /* Dark backdrop so sub-pixel seams between the grid/flex image cells show
       near-black (invisible against the images) instead of the white page
       background bleeding through as hairline lines. */
    background-color: #000;
  }

  .pi-hero__main {
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  .pi-hero__main::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--pi-hero-overlay-opacity, 0.45));
    pointer-events: none;
    z-index: 1;
  }

  .pi-hero__main picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pi-hero__main img,
  .pi-hero__main .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-hero__main-content {
    position: absolute;
    top: 80px;
    left: 61px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: calc(100% - 122px);
    z-index: 2;
  }

  .pi-hero__main-content h1 {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: clamp(36px, 4.4vw, var(--pi-hero-heading-size, 64px));
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--pi-hero-heading-color, #ffffff);
    text-align: {{ section.settings.text_alignment }};
    margin: 0;
    padding: 0;
    max-width: 100%;
  }

  .pi-hero__subframe {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .pi-hero__main-content p {
    color: var(--pi-hero-subheading-color, #ffffff);
    font-size: var(--pi-hero-subheading-size, 18px);
    line-height: 29px;
    font-weight: 400;
    letter-spacing: 0;
    margin: 0;
    max-width: 100%;
    /* Allow wrapping so the subheading never gets clipped when the main column
       is too narrow for one line (e.g. at 1024px). It still renders on a single
       line on wide screens where it fits. */
    white-space: normal;
  }

  .pi-hero__btn {
    display: inline-block;
    padding: 16px 32px;
    border: 2px solid var(--pi-hero-btn-border-color, #ffffff);
    border-radius: var(--pi-hero-btn-radius, 8px);
    color: var(--pi-hero-btn-text-color, #000000);
    text-decoration: none;
    text-transform: uppercase;
    /* Figma "Btn" text layer: Proxima Nova Semibold 600, 16/21, 0% tracking,
       uppercase, #000 — and 14/18 on the Mobile Btn, which the <=749 rules below
       already match. Proxima Nova is not licensed here, so it falls through to
       Nunito Sans as everywhere else in the theme; without this declaration the
       button inherited Inter from the theme font settings and rendered ~16%
       wider than the design's 186px text box. */
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: var(--pi-hero-btn-size, 16px);
    line-height: 21px;
    letter-spacing: 0;
    font-weight: 600;
    background: var(--pi-hero-btn-bg, #ffffff);
    width: fit-content;
  }

  .pi-hero__side {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
  }

  .pi-hero__side-banner {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .pi-hero__side-banner a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pi-hero__side-banner img,
  .pi-hero__side-banner .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-hero__side-label {
    position: absolute;
    bottom: 50px;
    left: 50px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    pointer-events: none;
  }

  .pi-hero__side-label span {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: var(--pi-hero-side-label-size, 36px);
    line-height: 57px;
    color: var(--pi-hero-side-label-color, #ffffff);
    display: block;
  }

  @media (max-width: 989px) {
    .pi-hero {
      grid-template-columns: 1fr;
      height: auto;
      max-height: none;
      min-height: unset;
      margin: 0 40px;
      border-radius: var(--pi-hero-border-radius, 20px);
      clip-path: inset(0 round var(--pi-hero-border-radius, 20px));
    }

    .pi-hero__main {
      height: 65vw;

      /* 380px, not 320px. .pi-hero__main-content is absolutely positioned, so it
         cannot push this box taller; at 481-508px the content needed 331px against
         a 320px box and BOOK AN APPOINTMENT hung 11px past the bottom, on top of
         the side tiles (which start exactly at this box's bottom edge).
         380px = 40 top + h1 3x42 + 20 gap + p 3x26 + 20 gap + 50 button + 40
         bottom, i.e. the mobile type scale's worst-case wrap with the same 40px
         breathing room at the bottom as the top. Only binds below ~585px, where
         65vw is smaller than this; wider viewports are unchanged, and <=480px is
         overridden by its own fixed-height block further down. */
      min-height: 380px;
      max-height: 520px;
    }

    .pi-hero__main-content {
      top: 40px;
      left: 30px;
      max-width: calc(100% - 60px);
    }

    .pi-hero__main-content h1 {
      font-size: clamp(28px, 5vw, 48px);
      line-height: 1.2;
    }

    .pi-hero__main-content p {
      white-space: normal;
    }

    .pi-hero__side {
      flex-direction: row;
      height: 220px;
    }

    .pi-hero__side-label {
      bottom: 24px;
      left: 24px;
    }

    .pi-hero__side-label span {
      font-size: 24px;
    }
  }

  @media (max-width: 480px) {
    .pi-hero {
      margin: 0 var(--pi-hero-side-margin, 18px);
      border-radius: var(--pi-hero-border-radius, 20px);
      clip-path: inset(0 round var(--pi-hero-border-radius, 20px));
      height: var(--pi-hero-mobile-height, 514px);
      max-height: var(--pi-hero-mobile-height, 514px);
      min-height: var(--pi-hero-mobile-height, 514px);
    }

    .pi-hero__main {
      height: var(--pi-hero-mobile-main-height, 364px);
      min-height: var(--pi-hero-mobile-main-height, 364px);
      max-height: var(--pi-hero-mobile-main-height, 364px);
    }

    .pi-hero__main-content {
      top: 40px;
      left: 20px;
      /* Fluid instead of a fixed 314px, which overflowed the hero at 320 */
      max-width: calc(100% - 40px);
      gap: 20px;
    }

    .pi-hero__main-content h1 {
      font-size: 32px;
      line-height: 42px;
    }

    .pi-hero__main-content p {
      font-size: 16px;
      line-height: 26px;
      white-space: normal;
    }

    .pi-hero__btn {
      font-size: 14px;
      line-height: 18px;
    }

    .pi-hero__subframe {
      gap: 20px;
    }

    .pi-hero__side {
      height: var(--pi-hero-mobile-side-height, 150px);
    }
  }

  /* Shared mobile type scale — one set of sizes for the whole mobile range
     so 320, 360, 375, 390, 414 and everything up to 768 match. Kept last so
     it wins over the breakpoint blocks above. */
  @media (max-width: 767px) {
    /* h1 is intentionally larger than the h2 used by every other section */
    .pi-hero__main-content h1 {
      font-size: 32px;
      line-height: 42px;
    }
    .pi-hero__main-content p {
      font-size: 16px;
      line-height: 26px;
      white-space: normal;
    }
    .pi-hero__btn {
      font-size: 14px;
      line-height: 18px;
    }
  }

  /* Narrow phones (374 and below) step the type down. At 320 the h1 text box
     is only 244px wide, so 32px wraps the heading to 5 lines instead of 3 and
     the content no longer fits the 514px banner height from the design —
     which pushed the button out of view. 26/34 keeps it at 3 lines.
     Boundary is 374px (not 360): the 364px main box needs the heading at
     3 lines, and 32px only breaks to 3 lines once the content box is ~288px
     wide (~≥364px viewport). Between 361–374px the 32px heading still wrapped
     to 4 lines, so BOOK AN APPOINTMENT overflowed the box onto the side tiles.
     375px+ keeps 32px (it fits 3 lines there).
     Must stay after the 767px block so it overrides it. */
  @media (max-width: 374px) {
    .pi-hero__main-content {
      top: 30px;
      gap: 12px;
    }
    .pi-hero__main-content h1 {
      font-size: 26px;
      line-height: 34px;
    }
    .pi-hero__main-content p {
      font-size: 14px;
      line-height: 22px;
    }
    .pi-hero__btn {
      padding: 12px 24px;
    }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: 0 !important;
    font-size: 0;
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .pi-hero {
    font-size: 14px;
    line-height: normal;
  }
</style>

<div class="pi-hero pi-hero-{{ section.id }}">
  {%- comment -%} Main Banner {%- endcomment -%}
  <div class="pi-hero__main">
    {%- if section.settings.main_image != blank -%}
      <picture>
        {%- if section.settings.mobile_main_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_main_image | image_url: width: 900 }}"
          >
        {%- endif -%}
        <img
          src="{{ section.settings.main_image | image_url: width: 1800 }}"
          alt="{{ section.settings.main_image.alt | escape }}"
          loading="eager"
          width="{{ section.settings.main_image.width }}"
          height="{{ section.settings.main_image.height }}"
        >
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    <div class="pi-hero__main-content">
      {%- if section.settings.main_heading != blank -%}
        {%- comment -%}
          newline_to_br so the heading's line break is authored in the setting
          rather than forced by CSS. The Figma frames break it as
          "THE ART OF SELF EXPRESSION" / "WITH PUERTO INK" on desktop and
          "THE ART OF SELF" / "EXPRESSION" / "WITH PUERTO INK" at 390 — one hard
          break before WITH reproduces both, because the first group then wraps
          naturally inside whatever column it has. A max-width cap cannot: it
          would need 16em at 1920 but ~8.9em at 390, so no single font-relative
          value serves both.
        {%- endcomment -%}
        <h1>{{ section.settings.main_heading | newline_to_br }}</h1>
      {%- endif -%}
      <div class="pi-hero__subframe">
        {%- if section.settings.main_subheading != blank -%}
          <p>{{ section.settings.main_subheading }}</p>
        {%- endif -%}
        {%- if section.settings.main_button_label != blank -%}
          <a href="{{ section.settings.main_button_link }}" class="pi-hero__btn">
            {{ section.settings.main_button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Right Side Banners {%- endcomment -%}
  <div class="pi-hero__side">
    <div class="pi-hero__side-banner">
      <a href="{{ section.settings.banner2_link }}">
        {%- if section.settings.banner2_image != blank -%}
          <img
            src="{{ section.settings.banner2_image | image_url: width: 600 }}"
            alt="{{ section.settings.banner2_image.alt | escape }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.banner2_label != blank -%}
          <div class="pi-hero__side-label">
            <span>{{ section.settings.banner2_label }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>

    <div class="pi-hero__side-banner">
      <a href="{{ section.settings.banner3_link }}">
        {%- if section.settings.banner3_image != blank -%}
          <img
            src="{{ section.settings.banner3_image | image_url: width: 600 }}"
            alt="{{ section.settings.banner3_image.alt | escape }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.banner3_label != blank -%}
          <div class="pi-hero__side-label">
            <span>{{ section.settings.banner3_label }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PI Main Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Main Banner"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Background image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_main_image",
      "label": "Background image — Mobile",
      "info": "Optional. Shown at ≤749px. If empty, the desktop image is used."
    },
    {
      "type": "textarea",
      "id": "main_heading",
      "label": "Heading",
      "info": "Press Enter to force a line break. The design breaks before \"With\".",
      "default": "The Art of Self Expression\nWith Puerto Ink"
    },
    {
      "type": "text",
      "id": "main_subheading",
      "label": "Subheading",
      "default": "The #1 Tattoo and Piercing Studio. From Heraklion to Antwerp, Amsterdam, and soon in Athens."
    },
    {
      "type": "text",
      "id": "main_button_label",
      "label": "Button text",
      "default": "Book an Appointment"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Tattoos Banner"
    },
    {
      "type": "image_picker",
      "id": "banner2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner2_label",
      "label": "Label",
      "default": "Tattoos"
    },
    {
      "type": "url",
      "id": "banner2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Piercings Banner"
    },
    {
      "type": "image_picker",
      "id": "banner3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner3_label",
      "label": "Label",
      "default": "Piercings"
    },
    {
      "type": "url",
      "id": "banner3_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "side_margin_desktop",
      "label": "Side margin (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "side_margin_mobile",
      "label": "Side margin (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 830
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile overall height",
      "min": 350,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 510
    },
    {
      "type": "range",
      "id": "mobile_main_height",
      "label": "Mobile main image height",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "mobile_side_height",
      "label": "Mobile side strip height",
      "min": 80,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop max)",
      "min": 36,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button border color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "btn_size",
      "label": "Button font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Side Banner Labels"
    },
    {
      "type": "range",
      "id": "side_label_size",
      "label": "Side label font size",
      "min": 18,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "side_label_color",
      "label": "Side label color",
      "default": "#ffffff"
    },
