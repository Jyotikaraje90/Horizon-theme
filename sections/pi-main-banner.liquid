<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

<style>
  .pi-hero {
    display: grid;
    grid-template-columns: 71.5fr 28.5fr;
    gap: 0;
    width: 100%;
    height: 75vh;
    min-height: 500px;
    max-height: 829px;
    padding: 0 40px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .pi-hero__main {
    position: relative;
    border-radius: 20px 0 0 20px;
    overflow: hidden;
    height: 100%;
  }

  .pi-hero__main::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    pointer-events: none;
    z-index: 1;
  }

  .pi-hero__main img,
  .pi-hero__main .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-hero__main-content {
    position: absolute;
    top: 80px;
    left: 61px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: calc(100% - 122px);
    z-index: 2;
  }

  .pi-hero__main-content h1 {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    padding: 0;
    max-width: 100%;
  }

  .pi-hero__subframe {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .pi-hero__main-content p {
    color: #ffffff;
    font-size: 18px;
    line-height: 29px;
    font-weight: 400;
    letter-spacing: 0;
    margin: 0;
    max-width: 100%;
    white-space: nowrap;
  }

  .pi-hero__btn {
    display: inline-block;
    padding: 16px 32px;
    border: 2px solid #ffffff;
    border-radius: 8px;
    color: #000000;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 18px;
    line-height: 23px;
    letter-spacing: 0;
    font-weight: 600;
    background: #ffffff;
    width: fit-content;
  }

  .pi-hero__side {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
  }

  .pi-hero__side-banner {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .pi-hero__side-banner:first-child {
    border-radius: 0 20px 0 0;
  }

  .pi-hero__side-banner:last-child {
    border-radius: 0 0 20px 0;
  }

  .pi-hero__side-banner a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pi-hero__side-banner img,
  .pi-hero__side-banner .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-hero__side-label {
    position: absolute;
    bottom: 50px;
    left: 50px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    pointer-events: none;
  }

  .pi-hero__side-label span {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 57px;
    color: #ffffff;
    display: block;
  }

  @media (max-width: 989px) {
    .pi-hero {
      grid-template-columns: 1fr;
      height: auto;
      max-height: none;
      min-height: unset;
    }

    .pi-hero__main {
      border-radius: 20px;
      height: 65vw;
      min-height: 320px;
      max-height: 520px;
    }

    .pi-hero__main-content {
      top: 40px;
      left: 30px;
      max-width: calc(100% - 60px);
    }

    .pi-hero__main-content h1 {
      font-size: clamp(28px, 5vw, 48px);
      line-height: 1.2;
    }

    .pi-hero__side {
      flex-direction: row;
      height: 220px;
    }

    .pi-hero__side-banner:first-child {
      border-radius: 20px 0 0 20px;
    }

    .pi-hero__side-banner:last-child {
      border-radius: 0 20px 20px 0;
    }

    .pi-hero__side-label {
      bottom: 24px;
      left: 24px;
    }

    .pi-hero__side-label span {
      font-size: 24px;
    }
  }

  @media (max-width: 480px) {
    .pi-hero__main {
      height: 80vw;
    }

    .pi-hero__main-content h1 {
      font-size: clamp(24px, 7vw, 36px);
    }

    .pi-hero__side {
      height: 180px;
    }
  }
</style>

<div class="pi-hero">
  {%- comment -%} Main Banner {%- endcomment -%}
  <div class="pi-hero__main">
    {%- if section.settings.main_image != blank -%}
      <img
        src="{{ section.settings.main_image | image_url: width: 1800 }}"
        alt="{{ section.settings.main_image.alt | escape }}"
        loading="eager"
        width="{{ section.settings.main_image.width }}"
        height="{{ section.settings.main_image.height }}"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    <div class="pi-hero__main-content">
      {%- if section.settings.main_heading != blank -%}
        <h1>{{ section.settings.main_heading }}</h1>
      {%- endif -%}
      <div class="pi-hero__subframe">
        {%- if section.settings.main_subheading != blank -%}
          <p>{{ section.settings.main_subheading }}</p>
        {%- endif -%}
        {%- if section.settings.main_button_label != blank -%}
          <a href="{{ section.settings.main_button_link }}" class="pi-hero__btn">
            {{ section.settings.main_button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Right Side Banners {%- endcomment -%}
  <div class="pi-hero__side">
    <div class="pi-hero__side-banner">
      <a href="{{ section.settings.banner2_link }}">
        {%- if section.settings.banner2_image != blank -%}
          <img
            src="{{ section.settings.banner2_image | image_url: width: 600 }}"
            alt="{{ section.settings.banner2_image.alt | escape }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.banner2_label != blank -%}
          <div class="pi-hero__side-label">
            <span>{{ section.settings.banner2_label }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>

    <div class="pi-hero__side-banner">
      <a href="{{ section.settings.banner3_link }}">
        {%- if section.settings.banner3_image != blank -%}
          <img
            src="{{ section.settings.banner3_image | image_url: width: 600 }}"
            alt="{{ section.settings.banner3_image.alt | escape }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.banner3_label != blank -%}
          <div class="pi-hero__side-label">
            <span>{{ section.settings.banner3_label }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PI Main Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Main Banner"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Heading",
      "default": "The Art of Self Expression With Puerto Ink"
    },
    {
      "type": "text",
      "id": "main_subheading",
      "label": "Subheading",
      "default": "The #1 Tattoo and Piercing Studio. From Heraklion to Antwerp, Amsterdam, and soon in Athens."
    },
    {
      "type": "text",
      "id": "main_button_label",
      "label": "Button text",
      "default": "Book an Appointment"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Tattoos Banner"
    },
    {
      "type": "image_picker",
      "id": "banner2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner2_label",
      "label": "Label",
      "default": "Tattoos"
    },
    {
      "type": "url",
      "id": "banner2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Piercings Banner"
    },
    {
      "type": "image_picker",
      "id": "banner3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner3_label",
      "label": "Label",
      "default": "Piercings"
    },
    {
      "type": "url",
      "id": "banner3_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "PI Main Banner"
    }
  ]
}
{% endschema %}
