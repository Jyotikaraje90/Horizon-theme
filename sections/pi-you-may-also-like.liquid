<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

{%- liquid
  assign collection = section.settings.collection
  assign max_products = section.settings.max_products
-%}

<style>
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  .pyml { background: {{ section.settings.bg_color }}; }
  .pyml__inner {
    max-width: 1580px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* ── Header: heading left, circle arrows right ── */
  .pyml__head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
  }
  .pyml__heading {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    text-transform: {{ section.settings.heading_case }};
    margin: 0;
  }
  .pyml__nav { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .pyml__arrow {
    width: 50px;
    height: 50px;
    min-width: 50px;
    border-radius: 50%;
    border: 1.5px solid #000000;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: background 0.2s, opacity 0.2s;
  }
  .pyml__arrow svg { display: block; }
  .pyml__arrow svg path { fill: #000000; }
  /* Next arrow starts filled (matches Figma) */
  .pyml__arrow--next { background: #000000; }
  .pyml__arrow--next svg path { fill: #ffffff; }
  .pyml__arrow:hover:not([disabled]) { background: #000000; }
  .pyml__arrow:hover:not([disabled]) svg path { fill: #ffffff; }
  .pyml__arrow--next:hover:not([disabled]) { background: #ffffff; }
  .pyml__arrow--next:hover:not([disabled]) svg path { fill: #000000; }
  .pyml__arrow[disabled] { opacity: 0.3; cursor: default; }

  /* ── Track: horizontal carousel, 4 per view ── */
  .pyml__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .pyml__track::-webkit-scrollbar { display: none; }

  .pyml__card {
    flex: 0 0 calc((100% - 60px) / 4);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .pyml__card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }
  .pyml__card-img-wrap img,
  .pyml__card-img-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    display: block;
  }
  .pyml__wishlist {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 33px;
    height: 30px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.15s ease;
  }
  .pyml__wishlist:hover { transform: scale(1.15); }
  .pyml__wishlist svg { width: 100%; height: 100%; display: block; }
  .pyml__wishlist--active .pyml__wishlist-path { fill: #000000; }

  .pyml__card-info { display: flex; flex-direction: column; gap: 10px; }
  .pyml__card-title {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    color: #000000;
    margin: 0;
    text-decoration: none;
  }
  .pyml__card-title:hover { text-decoration: underline; }
  .pyml__card-price {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: #000000;
    margin: 0;
  }
  .pyml__card-atc form { margin: 0; }
  .pyml__card-atc-btn {
    display: inline-block;
    background: none;
    border: none;
    border-bottom: 1px solid #000000;
    padding: 0 0 2px;
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: {{ section.settings.card_btn_size | default: 16 }}px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000000;
    cursor: pointer;
    line-height: 21px;
  }
  .pyml__card-atc-btn:hover { border-bottom-color: #b49146; color: #b49146; }
  /* Sold out: same slot, no affordance — it isn't a button */
  .pyml__card-atc-btn--sold-out {
    cursor: default;
    opacity: 0.45;
  }
  .pyml__card-atc-btn--sold-out:hover { border-bottom-color: #000000; color: #000000; }

  .pyml__empty {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 16px;
    color: #555555;
    padding: 20px 0;
  }

  @media (max-width: 1100px) {
    .pyml__card { flex-basis: calc((100% - 40px) / 3); }
  }
  @media (max-width: 900px) {
    .pyml__card { flex-basis: calc((100% - 20px) / 2); }
    .pyml__heading { font-size: {{ section.settings.heading_size | times: 0.75 | round }}px; }
  }
  @media (max-width: 600px) {
    .pyml__inner { padding-left: 18px; padding-right: 18px; }
    .pyml__card { flex-basis: calc((100% - 16px) / 1.35); }
    .pyml__card-img-wrap { border-radius: 15px; }
    /* Match the jewelry grid's mobile heart so the two read the same size */
    .pyml__wishlist { width: 16px; height: 15px; top: 15px; right: 15px; }
    .pyml__heading { font-size: {{ section.settings.heading_size | times: 0.6 | round }}px; }
    .pyml__card-title { font-size: 16px; line-height: 22px; }
  }
  /* 481-600: keep cards near their 601px size instead of jumping to the
     single-card phone peek, which makes the products look oversized. */
  @media (min-width: 481px) and (max-width: 600px) {
    .pyml__card { flex-basis: calc((100% - 16px) / 1.9); }
  }
</style>

<div class="pyml" id="pyml-{{ section.id }}">
  <div class="pyml__inner">

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="pyml__head">
        <h2 class="pyml__heading">{{ section.settings.heading }}</h2>
        <div class="pyml__nav">
          <button type="button" class="pyml__arrow pyml__arrow--prev" aria-label="Previous">
            <svg width="16" height="16" viewBox="4 4 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
          </button>
          <button type="button" class="pyml__arrow pyml__arrow--next" aria-label="Next">
            <svg width="16" height="16" viewBox="4 4 16 16" xmlns="http://www.w3.org/2000/svg" style="transform:rotate(180deg);"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
          </button>
        </div>
      </div>

      <div class="pyml__track" id="pyml-track-{{ section.id }}">
        {%- assign shown = 0 -%}
        {%- for card_product in collection.products -%}
          {%- if section.settings.exclude_current and product != blank and card_product.id == product.id -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown >= max_products -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <div class="pyml__card">
            <a href="{{ card_product.url }}" class="pyml__card-img-wrap" tabindex="-1" aria-hidden="true">
              {%- if card_product.featured_image -%}
                <img src="{{ card_product.featured_image | image_url: width: 720 }}"
                     alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
                     loading="lazy" width="360" height="360">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <button class="pyml__wishlist" aria-label="Add {{ card_product.title | escape }} to wishlist" data-pi-wish="{{ card_product.handle }}" type="button">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 20.5C12 20.5 3.25 15.35 3.25 9.5C3.25 6.74 5.49 4.5 8.25 4.5C10 4.5 11.29 5.34 12 6.53C12.71 5.34 14 4.5 15.75 4.5C18.51 4.5 20.75 6.74 20.75 9.5C20.75 15.35 12 20.5 12 20.5Z"
                        stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                        fill="transparent" class="pyml__wishlist-path"/>
                </svg>
              </button>
            </a>
            <div class="pyml__card-info">
              <a href="{{ card_product.url }}" class="pyml__card-title">{{ card_product.title }}</a>
              <p class="pyml__card-price">
                {%- if card_product.price_min < card_product.price_max -%}
                  {{ card_product.price_min | money }}&ndash;{{ card_product.price_max | money }}
                {%- else -%}
                  {{ card_product.price | money }}
                {%- endif -%}
              </p>
              <div class="pyml__card-atc">
                {%- if card_product.available -%}
                  {%- assign atc_variant = card_product.selected_or_first_available_variant | default: card_product.variants.first -%}
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="{{ atc_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="pyml__card-atc-btn">{{ section.settings.atc_label }}</button>
                  </form>
                {%- else -%}
                  <span class="pyml__card-atc-btn pyml__card-atc-btn--sold-out">{{ section.settings.sold_out_label | default: 'Out of Stock' }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

    {%- else -%}
      <p class="pyml__empty">Select a collection in the section settings to show products here.</p>
    {%- endif -%}

  </div>
</div>

<script>
(function () {
  var id    = {{ section.id | json }};
  var root  = document.getElementById('pyml-' + id);
  var track = document.getElementById('pyml-track-' + id);
  if (!root || !track) return;

  var prev = root.querySelector('.pyml__arrow--prev');
  var next = root.querySelector('.pyml__arrow--next');

  function step() {
    var card = track.querySelector('.pyml__card');
    if (!card) return track.clientWidth;
    var gap = parseInt(getComputedStyle(track).columnGap || getComputedStyle(track).gap, 10) || 20;
    return card.getBoundingClientRect().width + gap;
  }

  function sync() {
    var max = track.scrollWidth - track.clientWidth - 1;
    if (prev) prev.disabled = track.scrollLeft <= 1;
    if (next) next.disabled = track.scrollLeft >= max;
  }

  if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function () { track.scrollBy({ left:  step(), behavior: 'smooth' }); });
  track.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync);
  sync();

  /* Wishlist toggle — visual state here, persistence in pi-wishlist.js */
  var pymlHearts = track.querySelectorAll('.pyml__wishlist');

  pymlHearts.forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      var active = btn.classList.toggle('pyml__wishlist--active');
      if (window.PIWishlist) window.PIWishlist.set(btn.getAttribute('data-pi-wish'), active);
    });
  });

  if (window.PIWishlist) {
    window.PIWishlist.hydrate(pymlHearts, function (btn) {
      btn.classList.add('pyml__wishlist--active');
    });
  }
})();
</script>

{% schema %}
{
  "name": "PI You May Also Like",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to show" },
    { "type": "range", "id": "max_products", "label": "Max products", "min": 4, "max": 20, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "exclude_current", "label": "Hide the product currently being viewed", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    {
      "type": "select", "id": "heading_case", "label": "Heading case", "default": "uppercase",
      "options": [ { "value": "none", "label": "As typed" }, { "value": "uppercase", "label": "UPPERCASE" } ]
    },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 40 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Out of Stock" },
    { "type": "range", "id": "card_btn_size", "label": "Card button text size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card image background", "default": "#E6E6E6" },
    { "type": "range", "id": "card_radius", "label": "Card image radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 20 },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 148, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 148, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Section Margin" },
    { "type": "range", "id": "margin_top", "label": "Margin Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "PI You May Also Like" }
  ]
}
{% endschema %}
