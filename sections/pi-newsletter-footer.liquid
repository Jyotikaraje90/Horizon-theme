<script>
  (function(){
    if(window.innerWidth > 749) return;
    var card = document.querySelector('.pi-nf__nl-card');
    if(card && card.dataset.mobileBg) {
      card.style.backgroundImage = "url('" + card.dataset.mobileBg + "')";
    }
    var cols = document.querySelectorAll('.pi-nf__col');
    if(cols.length > 0) cols[0].classList.add('is-open');
    document.querySelectorAll('.pi-nf__col-heading').forEach(function(h){
      h.addEventListener('click', function(){
        this.closest('.pi-nf__col').classList.toggle('is-open');
      });
    });
  })();
</script>

{% schema %}
