<div class="product-metafields-section">

  {% if product.type == 'Body Jewelry' %}
    <div class="metafields-card">
      <h3 class="metafields-title">Product Details</h3>
      <div class="metafields-grid">
        {% if product.metafields.custom.metal_type != blank %}
          <div class="metafield-item">
            <span class="metafield-label">Metal Type</span>
            <span class="metafield-value">{{ product.metafields.custom.metal_type.value }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.gemstone != blank %}
          <div class="metafield-item">
            <span class="metafield-label">Gemstone</span>
            <span class="metafield-value">{{ product.metafields.custom.gemstone.value }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.piercing_type != blank %}
          <div class="metafield-item">
            <span class="metafield-label">Piercing Type</span>
            <span class="metafield-value">{{ product.metafields.custom.piercing_type.value }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.care_instructions != blank %}
          <div class="metafield-item metafield-full-width">
            <span class="metafield-label">Care Instructions</span>
            <span class="metafield-value">{{ product.metafields.custom.care_instructions.value }}</span>
          </div>
        {% endif %}
      </div>
    </div>

  {% elsif product.type == 'Tattoo Service' or product.type == 'Piercing Service' %}
    <div class="metafields-card">
      <h3 class="metafields-title">Service Details</h3>
      <div class="metafields-grid">
        {% if product.metafields.custom.tattoo_style != blank %}
          <div class="metafield-item">
            <span class="metafield-label">Tattoo Style</span>
            <span class="metafield-value">{{ product.metafields.custom.tattoo_style.value }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.session_duration != blank %}
          <div class="metafield-item">
            <span class="metafield-label">Session Duration</span>
            <span class="metafield-value">{{ product.metafields.custom.session_duration.value }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.artist_name != blank %}
          <div class="metafield-item">
            <span class="metafield-label">Artist</span>
            <span class="metafield-value">{{ product.metafields.custom.artist_name.value }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.aftercare != blank %}
          <div class="metafield-item metafield-full-width">
            <span class="metafield-label">Aftercare Instructions</span>
            <span class="metafield-value">{{ product.metafields.custom.aftercare.value }}</span>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

</div>

<style>
  .product-metafields-section { margin: 2rem 0; }
  .metafields-card { background: #fff; border: 1px solid #e6e6e6; border-radius: 8px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  .metafields-title { font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .metafields-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
  .metafield-item { display: flex; flex-direction: column; gap: 0.4rem; }
  .metafield-full-width { grid-column: 1 / -1; }
  .metafield-label { font-size: 0.75rem; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: 0.05em; }
  .metafield-value { font-size: 1rem; color: #111; line-height: 1.5; }
  @media (max-width: 768px) { .metafields-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Product Metafields",
  "settings": [],
  "presets": [{ "name": "Product Metafields Details" }]
}
{% endschema %}
