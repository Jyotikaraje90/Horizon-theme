<style>
  /* ═══ PI PAGE HERO — CUSTOMIZER VARIABLES ═══════════ */
  #shopify-section-{{ section.id }} {
    --pi-ph-height:          {{ section.settings.desktop_height }}px;
    --pi-ph-heading-size:    {{ section.settings.heading_size }}px;
    --pi-ph-heading-color:   {{ section.settings.heading_color }};
    --pi-ph-deco-opacity:    {{ section.settings.deco_opacity | times: 0.01 }};
    --pi-ph-bg:              {{ section.settings.bg_fallback_color }};
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --pi-ph-height:       {{ section.settings.tablet_height }}px;
      --pi-ph-heading-size: {{ section.settings.tablet_heading_size }}px;
    }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-ph-height:       {{ section.settings.mobile_height }}px;
      --pi-ph-heading-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
    margin: 0;
    background: var(--pi-ph-bg, #000000);
    overflow: hidden;
  }

  .pi-ph {
    position: relative;
    height: var(--pi-ph-height, 270px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .pi-ph__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .pi-ph__bg picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pi-ph__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-ph__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Decorative swirl images */
  .pi-ph__deco {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    opacity: 0.30;
    display: block;
    object-fit: contain;
    width: 99px;
    height: 211px;
  }
  /* Left — Figma: left -1.73%, top 40.89%, matrix(-0.59,-0.81,-0.81,0.58,0,0) */
  .pi-ph__deco--l {
    left: -1.73%;
    top: 40.89%;
    transform: matrix(-0.59, -0.81, -0.81, 0.58, 0, 0);
  }
  /* Right — Figma: left 89.76%, top -16.12%, matrix(0.59,0.81,0.81,-0.58,0,0) */
  .pi-ph__deco--r {
    left: 89.76%;
    top: -16.12%;
    transform: matrix(0.59, 0.81, 0.81, -0.58, 0, 0);
  }

  .pi-ph__content {
    position: relative;
    z-index: 3;
    text-align: {{ section.settings.text_alignment }};
  }

  .pi-ph__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    /* Driven by the customizer: desktop / tablet / mobile font-size vars. */
    font-size: var(--pi-ph-heading-size, 54px);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--pi-ph-heading-color, #ffffff);
    margin: 0;
  }

  /* The section height (desktop / tablet / mobile) is driven entirely by the
     --pi-ph-height var set from the customizer at each breakpoint. */

  @media (max-width: 749px) {
    /* Fallback only: when NO dedicated mobile image is uploaded we still show
       the wide 1920×270 desktop banner. Its swirls sit in the outer ~9% of the
       image, so a cover-crop would hide them — use contain so the full banner
       (both swirls) shows, letterboxed invisibly on the black background.
       When a mobile image IS uploaded (.pi-ph--mob) we use cover so the
       purpose-made mobile banner fills the box edge to edge. */
    .pi-ph:not(.pi-ph--mob) .pi-ph__bg img { object-fit: contain; }

    /* Swirl decorations: the desktop coords (99×211 at those percentages)
       don't fit the short 139px mobile box. Re-anchor the pair to the
       top-left / top-right corners at natural orientation, per Figma. */
    .pi-ph__deco {
      width: 64px;
      height: auto;
    }
    .pi-ph__deco--l {
      left: 6px;
      right: auto;
      top: 6px;
      transform: none;
    }
    .pi-ph__deco--r {
      left: auto;
      right: 6px;
      top: 6px;
      transform: none;
    }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

{%- assign pi_ph_desktop_img = section.settings.background_image -%}
{%- assign pi_ph_mobile_img  = section.settings.mobile_background_image -%}
{%- assign pi_ph_main_img    = pi_ph_desktop_img | default: pi_ph_mobile_img -%}

<div class="pi-ph{% if pi_ph_mobile_img != blank %} pi-ph--mob{% endif %}">

  {%- if pi_ph_main_img != blank -%}
    <div class="pi-ph__bg">
      <picture>
        {%- if pi_ph_mobile_img != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ pi_ph_mobile_img | image_url: width: 780 }}"
          >
        {%- endif -%}
        <img
          src="{{ pi_ph_main_img | image_url: width: 1920 }}"
          alt=""
          loading="eager"
          width="1920"
          height="270"
        >
      </picture>
    </div>
  {%- endif -%}

  <div class="pi-ph__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }});"></div>

  {%- if section.settings.deco_left != blank -%}
    <img
      class="pi-ph__deco pi-ph__deco--l"
      src="{{ section.settings.deco_left | image_url: width: 200 }}"
      alt="" aria-hidden="true"
      width="99" height="211"
    >
  {%- endif -%}

  {%- if section.settings.deco_right != blank -%}
    <img
      class="pi-ph__deco pi-ph__deco--r"
      src="{{ section.settings.deco_right | image_url: width: 200 }}"
      alt="" aria-hidden="true"
      width="99" height="211"
    >
  {%- endif -%}

  <div class="pi-ph__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="pi-ph__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Page Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero Height" },
    { "type": "range", "id": "desktop_height",       "label": "Desktop height",       "min": 150, "max": 500, "step": 10, "unit": "px", "default": 270 },
    { "type": "range", "id": "tablet_height",        "label": "Tablet height",        "min": 120, "max": 400, "step": 10, "unit": "px", "default": 200 },
    { "type": "range", "id": "mobile_height",        "label": "Mobile height",        "min": 100, "max": 200, "step": 1, "unit": "px", "default": 139 },

    { "type": "header", "content": "Heading" },
    { "type": "range", "id": "heading_size",         "label": "Desktop font size",    "min": 24, "max": 72, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "tablet_heading_size",  "label": "Tablet font size",     "min": 20, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_heading_size",  "label": "Mobile font size",     "min": 16, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "color", "id": "heading_color",        "label": "Heading color",        "default": "#ffffff" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Decorative Elements" },
    { "type": "range", "id": "deco_opacity",         "label": "Swirl opacity",        "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "bg_fallback_color",    "label": "Background fallback",  "default": "#000000" },

    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "default": "About Us"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image — Desktop (1920×270)"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Background image — Mobile (e.g. 780×278)",
      "info": "Optional. Shown at ≤749px. Upload a mobile-cropped banner so the swirls sit correctly. If empty, the desktop banner is shown full-width instead."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Decorative Swirls"
    },
    {
      "type": "image_picker",
      "id": "deco_left",
      "label": "Left swirl image"
    },
    {
      "type": "image_picker",
      "id": "deco_right",
      "label": "Right swirl image"
    },

    { "type": "header", "content": "Section Margin" },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "PI Page Hero"
    }
  ]
}
{% endschema %}
