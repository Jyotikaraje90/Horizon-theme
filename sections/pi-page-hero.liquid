<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
    margin: 0;
    background: #000000;
    overflow: hidden;
  }

  .pi-ph {
    position: relative;
    height: 270px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .pi-ph__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .pi-ph__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-ph__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Decorative swirl images */
  .pi-ph__deco {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    opacity: 0.30;
    display: block;
    object-fit: contain;
    width: 99px;
    height: 211px;
  }
  /* Left — Figma: left -1.73%, top 40.89%, matrix(-0.59,-0.81,-0.81,0.58,0,0) */
  .pi-ph__deco--l {
    left: -1.73%;
    top: 40.89%;
    transform: matrix(-0.59, -0.81, -0.81, 0.58, 0, 0);
  }
  /* Right — Figma: left 89.76%, top -16.12%, matrix(0.59,0.81,0.81,-0.58,0,0) */
  .pi-ph__deco--r {
    left: 89.76%;
    top: -16.12%;
    transform: matrix(0.59, 0.81, 0.81, -0.58, 0, 0);
  }

  .pi-ph__content {
    position: relative;
    z-index: 3;
    text-align: center;
  }

  .pi-ph__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0;
  }

  @media (max-width: 989px) {
    .pi-ph          { height: 200px; }
    .pi-ph__heading { font-size: 40px; line-height: 52px; }
  }

  @media (max-width: 749px) {
    .pi-ph          { height: 160px; }
    .pi-ph__heading { font-size: 28px; line-height: 38px; }
  }
</style>

<div class="pi-ph">

  {%- if section.settings.background_image != blank -%}
    <div class="pi-ph__bg">
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt=""
        loading="eager"
        width="1920"
        height="270"
      >
    </div>
  {%- endif -%}

  <div class="pi-ph__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }});"></div>

  {%- if section.settings.deco_left != blank -%}
    <img
      class="pi-ph__deco pi-ph__deco--l"
      src="{{ section.settings.deco_left | image_url: width: 200 }}"
      alt="" aria-hidden="true"
      width="99" height="211"
    >
  {%- endif -%}

  {%- if section.settings.deco_right != blank -%}
    <img
      class="pi-ph__deco pi-ph__deco--r"
      src="{{ section.settings.deco_right | image_url: width: 200 }}"
      alt="" aria-hidden="true"
      width="99" height="211"
    >
  {%- endif -%}

  <div class="pi-ph__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="pi-ph__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Page Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "default": "About Us"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Decorative Swirls"
    },
    {
      "type": "image_picker",
      "id": "deco_left",
      "label": "Left swirl image"
    },
    {
      "type": "image_picker",
      "id": "deco_right",
      "label": "Right swirl image"
    }
  ],
  "presets": [
    {
      "name": "PI Page Hero"
    }
  ]
}
{% endschema %}
