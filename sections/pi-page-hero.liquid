<style>
  /* ═══ PI PAGE HERO — CUSTOMIZER VARIABLES ═══════════ */
  #shopify-section-{{ section.id }} {
    --pi-ph-heading-size:  {{ section.settings.heading_size }}px;
    --pi-ph-heading-color: {{ section.settings.heading_color }};
    --pi-ph-bg:            {{ section.settings.bg_fallback_color }};
    --pi-ph-deco-opacity:  {{ section.settings.deco_opacity | times: 0.01 }};
    --pi-ph-deco-scale:    {{ section.settings.deco_scale }};
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --pi-ph-heading-size: {{ section.settings.tablet_heading_size }}px;
    }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-ph-heading-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
    margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;
    background: var(--pi-ph-bg, #000000);
  }

  /* Solid black banner. The two swirls are placed by CSS — left swirl in the
     bottom-left corner, right swirl in the top-right corner — so they stay in
     the corners at EVERY width. Their size tracks the banner height (%), so the
     proportions look identical from mobile to desktop. */
  .pi-ph {
    position: relative;
    width: 100%;
    /* Height linearly interpolates between the two Figma frames so it stays
       smooth at EVERY width (no breakpoint jump):
         390px → 139px (mobile)   1920px → 270px (desktop)
       slope = (270-139)/(1920-390) = 8.56vw; intercept = 105.6px.
       Clamped: floor 120px on tiny screens, cap 270px at ≥1920px. */
    height: clamp(120px, calc(8.56vw + 105.6px), 270px);
    background: var(--pi-ph-bg, #000000);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Size to match the Figma swirl footprint (~76% of banner height on desktop,
     ~63% on mobile ≈ the asset's native size). The PNGs are already drawn
     horizontally with the flourishes pointing toward each corner, so they need
     NO rotation (the Figma "−53.5°" is relative to Figma's own tall source
     element and doesn't transfer here). */
  /* display:contents so the <picture> wrapper (added for the mobile source)
     doesn't interrupt the swirl's absolute positioning against .pi-ph */
  .pi-ph__deco-pic { display: contents; }

  .pi-ph__deco {
    position: absolute;
    z-index: 1;
    height: calc(76% * var(--pi-ph-deco-scale, 1));
    width: auto;
    /* The swirl PNG is already white and baked at ~30% alpha, so the swirl
       opacity setting should stay at 100% — otherwise it compounds with the
       asset's alpha (30% × 30% ≈ 9%) and reads far too faint. */
    opacity: var(--pi-ph-deco-opacity, 1);
    pointer-events: none;
    user-select: none;
  }
  /* Tucked into the corners, peeking off the edge like Figma (negative insets
     let the corner of the swirl clip past the banner edge). */
  .pi-ph__deco--l {   /* bottom-left corner */
    left: -1.5%;
    bottom: -12%;
  }
  .pi-ph__deco--r {   /* top-right corner */
    right: -1.5%;
    top: -12%;
  }

  @media (max-width: 749px) {
    .pi-ph__deco { height: calc(63% * var(--pi-ph-deco-scale, 1)); }
  }

  .pi-ph__content {
    position: relative;
    z-index: 3;
    text-align: {{ section.settings.text_alignment }};
    padding: 0 clamp(90px, 20vw, 260px);
    box-sizing: border-box;
  }

  .pi-ph__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-ph-heading-size, 54px);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--pi-ph-heading-color, #ffffff);
    margin: 0;
  }
</style>

{%- liquid
  assign swirl_l = section.settings.deco_left
  assign swirl_r = section.settings.deco_right
  assign swirl_l_m = section.settings.deco_left_mobile
  assign swirl_r_m = section.settings.deco_right_mobile
-%}

<div class="pi-ph">

  <picture class="pi-ph__deco-pic">
    {%- if swirl_l_m != blank -%}
      <source media="(max-width: 749px)" srcset="{{ swirl_l_m | image_url: width: 300 }}">
    {%- endif -%}
    {%- if swirl_l != blank -%}
      <img class="pi-ph__deco pi-ph__deco--l" src="{{ swirl_l | image_url: width: 300 }}" alt="" aria-hidden="true" loading="eager">
    {%- else -%}
      <img class="pi-ph__deco pi-ph__deco--l" src="{{ 'pi-swirl-left.png' | asset_url }}" alt="" aria-hidden="true" loading="eager">
    {%- endif -%}
  </picture>

  <picture class="pi-ph__deco-pic">
    {%- if swirl_r_m != blank -%}
      <source media="(max-width: 749px)" srcset="{{ swirl_r_m | image_url: width: 300 }}">
    {%- endif -%}
    {%- if swirl_r != blank -%}
      <img class="pi-ph__deco pi-ph__deco--r" src="{{ swirl_r | image_url: width: 300 }}" alt="" aria-hidden="true" loading="eager">
    {%- else -%}
      <img class="pi-ph__deco pi-ph__deco--r" src="{{ 'pi-swirl-right.png' | asset_url }}" alt="" aria-hidden="true" loading="eager">
    {%- endif -%}
  </picture>

  {%- comment -%}
    Leaving the heading empty falls back to the page title, so one template can
    serve several pages that differ only by name.
  {%- endcomment -%}
  {%- assign ph_heading = section.settings.heading | default: page.title -%}
  <div class="pi-ph__content">
    {%- if ph_heading != blank -%}
      <h1 class="pi-ph__heading">{{ ph_heading | escape }}</h1>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Page Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text",  "id": "heading",              "label": "Page title",           "info": "Leave empty to use the page's own title.", "default": "About Us" },
    { "type": "range", "id": "heading_size",         "label": "Desktop font size",    "min": 24, "max": 72, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "tablet_heading_size",  "label": "Tablet font size",     "min": 20, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_heading_size",  "label": "Mobile font size",     "min": 16, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "color", "id": "heading_color",        "label": "Heading color",        "default": "#ffffff" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "bg_fallback_color",    "label": "Background color",  "default": "#000000" },

    { "type": "header", "content": "Corner Swirls" },
    {
      "type": "image_picker",
      "id": "deco_left",
      "label": "Left swirl (bottom-left corner) — Desktop",
      "info": "Transparent PNG. If empty, the built-in swirl is used."
    },
    {
      "type": "image_picker",
      "id": "deco_left_mobile",
      "label": "Left swirl — Mobile",
      "info": "Optional. Shown at ≤749px. If empty, the desktop swirl is used."
    },
    {
      "type": "image_picker",
      "id": "deco_right",
      "label": "Right swirl (top-right corner) — Desktop",
      "info": "Transparent PNG. If empty, the built-in swirl is used."
    },
    {
      "type": "image_picker",
      "id": "deco_right_mobile",
      "label": "Right swirl — Mobile",
      "info": "Optional. Shown at ≤749px. If empty, the desktop swirl is used."
    },
    { "type": "range", "id": "deco_scale",   "label": "Swirl size",    "min": 0.5, "max": 1.6, "step": 0.1, "default": 1.0 },
    { "type": "range", "id": "deco_opacity", "label": "Swirl opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 90 },

    { "type": "header", "content": "Section Margin" },
    { "type": "range", "id": "margin_top",    "label": "Margin Top",    "min": 0, "max": 100, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "margin_bottom", "label": "Margin Bottom", "min": 0, "max": 100, "step": 4, "default": 0, "unit": "px" }
  ],
  "presets": [
    {
      "name": "PI Page Hero"
    }
  ]
}
{% endschema %}
