<style>
  #shopify-section-{{ section.id }} {
    background: #000000;
    overflow: hidden;
  }

  .pi-ph {
    position: relative;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pi-ph__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pi-ph__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pi-ph__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pi-ph__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 60px;
    width: 100%;
  }

  .pi-ph__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 72px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    letter-spacing: 0.05em;
  }

  @media (max-width: 989px) {
    .pi-ph { min-height: 220px; }
    .pi-ph__heading { font-size: 48px; }
    .pi-ph__content { padding: 60px 32px; }
  }

  @media (max-width: 749px) {
    .pi-ph { min-height: 180px; }
    .pi-ph__heading { font-size: 36px; }
    .pi-ph__content { padding: 50px 20px; }
  }
</style>

<div class="pi-ph">
  {%- if section.settings.background_image != blank -%}
    <div class="pi-ph__bg">
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt=""
        loading="eager"
        width="1920"
        height="300"
      >
    </div>
  {%- endif -%}
  <div class="pi-ph__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }});"></div>
  <div class="pi-ph__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="pi-ph__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PI Page Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (ornament/decorative)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "default": "About Us"
    }
  ],
  "presets": [
    {
      "name": "PI Page Hero"
    }
  ]
}
{% endschema %}
