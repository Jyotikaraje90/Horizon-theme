<style>
  /* ═══ PI PAGE HERO — CUSTOMIZER VARIABLES ═══════════ */
  #shopify-section-{{ section.id }} {
    --pi-ph-heading-size:  {{ section.settings.heading_size }}px;
    --pi-ph-heading-color: {{ section.settings.heading_color }};
    --pi-ph-bg:            {{ section.settings.bg_fallback_color }};
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --pi-ph-heading-size: {{ section.settings.tablet_heading_size }}px;
    }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-ph-heading-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
    margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;
    background: var(--pi-ph-bg, #000000);
    overflow: hidden;
  }

  /* Image-driven banner: the background image sets the height, so the FULL
     artwork (both edge swirls) is always visible at every width — no cropping.
     The black image background blends into the black section background, so
     there is nothing to crop and nothing to letterbox. */
  .pi-ph {
    position: relative;
    width: 100%;
    background: var(--pi-ph-bg, #000000);
    overflow: hidden;
  }

  .pi-ph__bg {
    display: block;
    width: 100%;
    line-height: 0;
  }
  .pi-ph__bg img {
    display: block;
    width: 100%;
    height: auto;
  }

  .pi-ph__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pi-ph__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: {{ section.settings.text_alignment }};
    padding: 0 clamp(64px, 12vw, 220px);
    box-sizing: border-box;
  }

  .pi-ph__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-ph-heading-size, 54px);
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--pi-ph-heading-color, #ffffff);
    margin: 0;
  }
</style>

{%- liquid
  assign compact_bg = 'pi-about-swirl-bg.png' | asset_url
  assign desktop_bg = ''
  if section.settings.background_image != blank
    assign desktop_bg = section.settings.background_image | image_url: width: 1920
  else
    assign desktop_bg = compact_bg
  endif
-%}

<div class="pi-ph">

  <picture class="pi-ph__bg">
    <source media="(max-width: 749px)" srcset="{{ compact_bg }}" width="780" height="278">
    <img
      src="{{ desktop_bg }}"
      alt=""
      loading="eager"
      width="1920"
      height="270"
    >
  </picture>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="pi-ph__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }});"></div>
  {%- endif -%}

  <div class="pi-ph__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="pi-ph__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "PI Page Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text",  "id": "heading",              "label": "Page title",           "default": "About Us" },
    { "type": "range", "id": "heading_size",         "label": "Desktop font size",    "min": 24, "max": 72, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "tablet_heading_size",  "label": "Tablet font size",     "min": 20, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_heading_size",  "label": "Mobile font size",     "min": 16, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "color", "id": "heading_color",        "label": "Heading color",        "default": "#ffffff" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Background" },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image — Desktop & tablet",
      "info": "Wide banner artwork (e.g. 1920×270). Shown full-width with no cropping, so both corner swirls always stay visible. Phones automatically use the built-in compact swirl banner (pi-about-swirl-bg.png)."
    },
    { "type": "color", "id": "bg_fallback_color",    "label": "Background fallback",  "default": "#000000" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },

    { "type": "header", "content": "Section Margin" },
    { "type": "range", "id": "margin_top",    "label": "Margin Top",    "min": 0, "max": 100, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "margin_bottom", "label": "Margin Bottom", "min": 0, "max": 100, "step": 4, "default": 0, "unit": "px" }
  ],
  "presets": [
    {
      "name": "PI Page Hero"
    }
  ]
}
{% endschema %}
