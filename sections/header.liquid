

{% liquid
  assign order = 'logo,menu,localization,search,drawer_search,actions'

  if shop.customer_accounts_enabled
    assign order = 'drawer_search,logo,menu,localization,search,actions'
  endif

  assign rows = 'top,bottom' | split: ','
  assign search_style = 'none'

  if section.settings.show_search
    assign search_style = 'modal'
  endif

  if section.settings.show_search
    render 'predictive-search-styles'
    render 'slideshow-styles'
  endif

  if section.settings.enable_transparent_header_home and template.name == 'index'
    assign transparent = 'always'
    assign transparent_color_scheme = section.settings.home_color_scheme
  elsif section.settings.enable_transparent_header_product and template.name == 'product'
    assign transparent = 'always'
    assign transparent_color_scheme = section.settings.product_color_scheme
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection'
    assign transparent = 'always'
    assign transparent_color_scheme = section.settings.collection_color_scheme
  endif

  if section.settings.enable_sticky_header == 'always'
    assign sticky = 'always'
  elsif section.settings.enable_sticky_header == 'scroll-up'
    assign sticky = 'scroll-up'
  endif

  if transparent and sticky
    assign transparent = 'not-sticky'
  endif

  if transparent
    if transparent_color_scheme == 'inverse'
      assign transparent_color_scheme = 'color-' | append: section.settings.color_scheme_transparent
    else
      assign transparent_color_scheme = 'color-' | append: section.settings.color_scheme_top
    endif
  endif

  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture

  # theme-check-disable UniqueStaticBlockId
  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture

  capture drawer_menu
    content_for 'block', type: '_header-menu', id: 'header-menu', variant: 'mobile'
  endcapture

  capture navigation_bar
    content_for 'block', type: '_header-menu', id: 'header-menu', variant: 'navigation_bar', transparent: transparent
  endcapture
  # theme-check-enable UniqueStaticBlockId

  capture actions
    render 'header-actions', customer_account_menu: section.settings.customer_account_menu, display_style: section.settings.actions_display_style, section: section
  endcapture

  if shop.customer_accounts_enabled
    assign search_class = 'search-action--hidden-on-drawer'
  endif

  # Handle localization positioning
  if section.settings.localization_position == 'left'
    if section.settings.search_position == 'left'
      if shop.customer_accounts_enabled
        assign order = 'drawer_search,logo,search,localization,menu,actions'
      else
        assign order = 'logo,search,localization,menu,drawer_search,actions'
      endif
    else
      if shop.customer_accounts_enabled
        assign order = 'drawer_search,logo,localization,menu,search,actions'
      else
        assign order = 'logo,localization,menu,search,drawer_search,actions'
      endif
    endif
  else
    if section.settings.search_position == 'left'
      if shop.customer_accounts_enabled
        assign order = 'drawer_search,logo,search,menu,localization,actions'
      else
        assign order = 'logo,search,menu,localization,drawer_search,actions'
      endif
    endif
  endif
  capture search
    render 'search', style: search_style, class: search_class, display_style: section.settings.actions_display_style
  endcapture

  # Skip drawer search under specific conditions:
  # Always render if search_row is bottom
  # Don't render when shop.customer_accounts_enabled is false and search_position is left and search_style is not none
  assign skip_drawer_search = false
  if shop.customer_accounts_enabled == false and section.settings.search_position == 'left' and search_style != 'none'
    assign skip_drawer_search = true
  endif

  if section.settings.search_row == 'bottom' or search_style != 'none' and skip_drawer_search == false
    # Mobile search duplicate for when search is not in the right order for mobile layout
    capture drawer_search
      render 'search', class: 'search-action--hidden-on-menu', style: search_style, display_style: section.settings.actions_display_style
    endcapture
  endif

  assign show_language = section.settings.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  assign show_country = section.settings.show_country
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  assign bottom_row_blocks = ''

  if section.settings.menu_row == 'bottom'
    assign bottom_row_blocks = bottom_row_blocks | append: 'menu,'
  endif

  if section.settings.search_style != 'none'
    if section.settings.search_row == 'bottom'
      assign bottom_row_blocks = bottom_row_blocks | append: 'search,'
    endif
  endif

  if section.settings.show_country or section.settings.show_language
    if section.settings.localization_row == 'bottom'
      assign bottom_row_blocks = bottom_row_blocks | append: 'localization,'
    endif
  endif

  assign bottom_row_blocks = bottom_row_blocks | split: ',' | compact

  if section.settings.section_height == 'compact'
    assign header_height_class = ' header--compact'
  endif

  if bottom_row_blocks.size > 0 and section.settings.color_scheme_top.settings.background.rgb == section.settings.color_scheme_bottom.settings.background.rgb and section.settings.divider_width == 0
    assign collapse_header_paddings_class = 'header--collapse-row-paddings'
  endif

  assign class = 'header'

  if transparent_color_scheme
    assign class = class | append: ' ' | append: transparent_color_scheme
  endif

  if header_height_class
    assign class = class | append: ' ' | append: header_height_class
  endif

  if collapse_header_paddings_class
    assign class = class | append: ' ' | append: collapse_header_paddings_class
  endif

  # Determine transparent background value
  assign top_transparent = false
  assign bottom_transparent = false

  if section.settings.color_scheme_top.settings.background.alpha != 1
    assign top_transparent = true
  endif

  if section.settings.color_scheme_bottom.settings.background.alpha != 1
    assign bottom_transparent = true
  endif

  if top_transparent and bottom_transparent
    assign transparent_color_scheme_value = 'both'
  elsif top_transparent
    assign transparent_color_scheme_value = 'top'
  elsif bottom_transparent
    assign transparent_color_scheme_value = 'bottom'
  endif
%}

{% capture localization_markup %}
  {% liquid
    assign localization_font = '--menu-localization-font: var(--font-[localization_font]--family); ' | replace: '[localization_font]', section.settings.localization_font
    assign localization_font_size = '--menu-localization-font-size: [localization_font_size]; ' | replace: '[localization_font_size]', section.settings.localization_font_size
    assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
    assign form_style = localization_font | append: localization_font_size | append: color_shadow
  %}
  {% if show_language and show_country == false %}
    <div class="dropdown-localization mobile:hidden">
      {% render 'localization-form',
        show_country: show_country,
        show_language: show_language,
        localization_style: 'dropdown',
        form_style: form_style,
        form_id: section.id
      %}
    </div>
  {% elsif show_country %}
    <dropdown-localization-component
      class="dropdown-localization mobile:hidden"
    >
      <button
        type="button"
        class="button dropdown-localization__button localization-selector header-actions__action"
        aria-expanded="false"
        aria-controls="dropdown-localization-results"
        ref="button"
        on:click="/toggleSelector"
        style="{{ localization_font }} {{ localization_font_size }}"
      >
        {% if show_country %}
          {% if section.settings.country_selector_style == true %}
            {% liquid
              assign background_brightness = section.settings.color_scheme.settings.background | color_brightness
              if background_brightness < 64
                assign shadow_size = 4
              else
                assign shadow_size = 2
              endif
            %}
            <span
              class="icon-flag"
              style="
                background-image: url({{- localization.country | image_url: width: 32 }});
                --size-shadow: {{ shadow_size }}px;
                --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
              "
            ></span>
          {% endif %}
          <span
            class="currency-code"
            data-testid="localization-currency-code"
          >
            {{- localization.country.currency.iso_code -}}
          </span>
        {% endif %}
        <span
          class="visually-hidden"
          data-testid="localization-visually-hidden"
        >
          {{- 'accessibility.localization_region_and_language' | t -}}
        </span>

        {%- if show_country and show_language -%}
          <span>/</span>
        {%- endif -%}

        {%- if show_language -%}
          <span>
            {{ localization.language.iso_code | upcase }}
          </span>
        {%- endif -%}
        <span class="svg-wrapper icon-caret">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div
        class="localization-wrapper {{ section.settings.localization_position }}-bound color-{{ settings.popover_color_scheme }}"
        hidden
        ref="panel"
      >
        {% render 'localization-form',
          show_country: show_country,
          show_language: show_language,
          localization_style: 'dropdown',
          form_style: form_style,
          form_id: section.id
        %}
      </div>
    </dropdown-localization-component>
  {% endif %}
{% endcapture %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

<header-component
  id="header-component"
  class="{{ class }}"
  data-theme-color="rgb({{ section.settings.color_scheme_top.settings.background.rgb }})"
  {% if transparent %}
    transparent="{{ transparent }}"
  {% endif %}
  {% if sticky %}
    sticky="{{ sticky }}"
  {% endif %}
  data-skip-node-update
  data-scroll-direction="none"
  {% if section.settings.menu_row == 'top' and bottom_row_blocks.size > 0 %}
    data-submenu-overlap-bottom-row
  {% endif %}
  {% if transparent_color_scheme_value %}
    data-transparent-color-scheme="{{ transparent_color_scheme_value }}"
  {% endif %}
  style="
    --color-scheme-top-row: rgba({{ section.settings.color_scheme_top.settings.background.rgba }});
    --color-scheme-bottom-row: rgba({{ section.settings.color_scheme_bottom.settings.background.rgba }});
    {% if section.settings.actions_display_style == 'text' %}
      --header-actions-font-size: {{ section.settings.actions_font_size | default: '1rem' }};
      --header-actions-font-family: var(--font-{{ section.settings.actions_font | default: 'heading' }}--family);
      --header-actions-font-weight: var(--font-{{ section.settings.actions_font | default: 'heading' }}--weight);
      --header-actions-text-case: {{ section.settings.actions_text_case | default: 'none' }};
    {% endif %}
  "
>
  <div class="header__underlay header__underlay-closed"></div>
  <div
    class="header__underlay header__underlay-open"
  ></div>
  {%- if request.page_type == 'index' -%}
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- endif -%}
  {% for row in rows %}
    {% liquid
      assign scheme = 'color_scheme_' | append: row
      assign class = 'header__row header__row--[row] color-[row_scheme] section section--full-width-margin section--[section-width]' | replace: '[row]', row | replace: '[row_scheme]', section.settings[scheme] | replace: '[section-width]', section.settings.section_width

      case row
        when 'top'
          assign first = drawer_menu

          if bottom_row_blocks.size > 0 and section.settings.divider_size == 'page-width'
            assign class = class | append: ' divider--page-width'
          endif

          if bottom_row_blocks.size > 0
            assign border_bottom_setting_id = 'divider_width'
          else
            assign border_bottom_setting_id = 'border_width'
          endif
        when 'bottom'
          assign first = ''
          assign class = class | append: ' mobile:hidden'

          assign border_bottom_setting_id = 'border_width'
      endcase

      assign style = '--border-bottom-width: [width]px; ' | replace: '[width]', section.settings[border_bottom_setting_id]

      if row == 'top'
        assign style = style | append: '--border-bottom-width-mobile: [width]px; ' | replace: '[width]', section.settings.border_width
      endif
    %}

    {% capture content %}
      {% render 'header-row',
        row: row,
        order: order,
        settings: section.settings,
        first: first,
        logo: logo,
        menu: menu,
        actions: actions,
        localization: localization_markup,
        search: search,
        drawer_search: drawer_search
      %}
    {% endcapture %}

    {% assign content = content | strip %}
    {% if content != blank %}
      <div
        class="{{ class | strip }}"
        ref="headerRowTop"
        {%- if style != blank -%}
          style="{{ style | strip }}"
        {%- endif -%}
      >
        <div class="header__columns spacing-style">
          {{ content }}
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {% if navigation_bar != blank %}
    <div class="header__row header__navigation-bar-row color-{{ section.settings.color_scheme_bottom }}">
      {{ navigation_bar }}
    </div>
  {% endif %}
</header-component>

<script
  src="{{ 'header.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  body {
    --header-height: 95px;
    --header-group-height: var(--header-height);
    --transparent-header-offset-boolean: 0; /* stylelint-disable-line declaration-property-value-disallowed-list */
  }

  .header {
    /* Set header paddings based on height setting */
    --header-padding: 20px;
    --font-paragraph--line-height: 1;
    --header-content-transition-timing: 0s;

    display: block;
    contain: layout style;
    background: transparent;

    a,
    .button,
    .button-secondary,
    .header-actions__action {
      /* reset style from base.css */
      transition: color var(--header-content-transition-timing), border-color var(--header-content-transition-timing);
    }
  }

  #header-component :is(.header-menu, .dropdown-localization) {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #header-component[data-menu-style='menu'] :is(.header-menu, .dropdown-localization) {
      display: flex;
    }
  }

  #header-component[data-menu-style='drawer'] .header__column {
    display: contents;
  }

  @media screen and (min-width: 750px) {
    #header-component[data-menu-style='menu'] .header__navigation-bar-row {
      display: none;
    }
  }

  .header[transparent] {
    --language-button-background-color: transparent;
    --language-button-border-color: transparent;
    --header-content-transition-timing: calc(var(--submenu-animation-speed) - var(--animation-speed-fast))
      var(--animation-speed-fast) var(--ease-out-cubic);

    --closed-underlay-height: 0px;

    /* used to display the appropriate logo based on transparency state */
    --header-logo-display: none;
    --header-logo-inverse-display: block;

    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    z-index: var(--layer-overlay);

    &[transparent='not-sticky'][data-sticky-state='active'],
    &:has(.menu-list__link:not([aria-haspopup]):hover) {
      --header-logo-display: unset;
      --header-logo-inverse-display: unset;
      --color-foreground: inherit;
      --color-foreground-rgb: inherit;
      --color-background: inherit;
      --color-background-rgb: inherit;
      --color-border: inherit;
      --color-border-rgb: inherit;
      --closed-underlay-height: 100%;
    }

    /** For transparent header, apply inherit to rows when menu is not hovered */
    &:not([data-sticky-state='active']):not(:has(.menu-list__link:is(:hover, [aria-expanded='true']))) .header__row {
      --color-foreground: inherit;
      --color-foreground-rgb: inherit;
      --color-border: inherit;
      --color-border-rgb: inherit;
      --color-primary-button-background: inherit;
      --color-primary-button-text: inherit;
    }

    /* Multiple selectors for performance: each simple :has() check is faster than one complex selector with multiple conditions */
    &:has(.mega-menu__list:hover),
    &:has(.menu-list__link:is(:hover, [aria-expanded='true'])),
    &:has(.menu-list__list-item[slot='overflow'] .menu-list__link:is(:hover, [aria-expanded='true'])) {
      --header-logo-display: unset;
      --header-logo-inverse-display: unset;
      --color-foreground: inherit;
      --color-foreground-rgb: inherit;
      --color-background: inherit;
      --color-background-rgb: inherit;
      --color-border: inherit;
      --color-border-rgb: inherit;
      --header-content-transition-timing: var(--submenu-animation-speed) var(--ease-out-cubic);
    }
  }

  /* When top row has transparent background, make it inherit colors from header component */
  [data-transparent-color-scheme='top']:hover .header__row--top,
  [data-transparent-color-scheme='top']:focus-within .header__row--top,
  [data-transparent-color-scheme='both']:hover .header__row--top,
  [data-transparent-color-scheme='both']:focus-within .header__row--top {
    --color-foreground: inherit;
    --color-foreground-rgb: inherit;
    --color-border: inherit;
    --color-border-rgb: inherit;
    --color-primary-button-background: inherit;
    --color-primary-button-text: inherit;
  }

  /* When bottom row has transparent background, make it inherit colors from header component */
  [data-transparent-color-scheme='bottom']:hover .header__row--bottom,
  [data-transparent-color-scheme='bottom']:focus-within .header__row--bottom,
  [data-transparent-color-scheme='both']:hover .header__row--bottom,
  [data-transparent-color-scheme='both']:focus-within .header__row--bottom {
    --color-foreground: inherit;
    --color-foreground-rgb: inherit;
    --color-border: inherit;
    --color-border-rgb: inherit;
    --color-primary-button-background: inherit;
    --color-primary-button-text: inherit;
  }

  .header-section {
    position: relative;
    z-index: var(--layer-heightened);
  }

  /* need default values for non-flash transitions on first overflow menu open */
  #header-component {
    --submenu-height: 0px;
    --full-open-header-height: 0px;
  }

  #header-group:has(#header-component[sticky]) {
    display: contents;
  }

  .header-section:has(> #header-component[sticky='always']),
  .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) {
    position: sticky;

    /* Use -1 instead of 0 so intersection observer can track sticky state */
    top: -1px;
    z-index: var(--layer-sticky);
  }

  .header[data-sticky-state] {
    transition: opacity var(--animation-speed) var(--animation-easing);
    opacity: 1;
  }

  .header[data-sticky-state='active'] {
    view-transition-name: sticky-header;
  }

  :active-view-transition-type(empty-cart-drawer) {
    .header[data-sticky-state='active'] {
      view-transition-name: none;
    }
  }

  .header[data-sticky-state='idle'] {
    opacity: 0;
  }

  /* ================================
     * Underlays
     * ================================ */
  .header__underlay {
    position: absolute;
    inset: 0;
  }

  .header__underlay-closed {
    height: var(--closed-underlay-height, 100%);
    z-index: var(--layer-lowest);
    background: linear-gradient(
      var(--color-scheme-top-row) 0 var(--top-row-height),
      var(--color-scheme-bottom-row) var(--top-row-height) var(--header-height)
    );
    transition: height var(--animation-speed-slow) var(--ease-out-cubic);
  }

  .header__underlay-open {
    height: var(--full-open-header-height);
    background: linear-gradient(
      var(--color-scheme-top-row) 0 var(--top-row-height),
      var(--color-scheme-bottom-row) var(--top-row-height) var(--header-height),
      var(--color-submenu) var(--header-height) 100%
    );
    /* header-height is updated via js, the transition works automagically */
    transition: height var(--submenu-animation-speed) var(--ease-out-cubic);
  }

  .header__underlay-open::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: var(--shadow-popover);
    clip-path: inset(var(--header-height) 0 -100px 0); /* stylelint-disable-line */
    transition: height var(--submenu-animation-speed) var(--ease-out-cubic);
  }

  /* When top row has transparent background, make underlay inherit colors from header component */
  [data-transparent-color-scheme='top']:hover,
  [data-transparent-color-scheme='top']:focus-within,
  [data-transparent-color-scheme='both']:hover,
  [data-transparent-color-scheme='both']:focus-within {
    :is(.header__underlay-open, .header__underlay-closed) {
      --color-scheme-top-row: var(--color-background);
    }
  }

  /* When bottom row has transparent background, make underlay inherit colors from header component */
  [data-transparent-color-scheme='bottom']:hover,
  [data-transparent-color-scheme='bottom']:focus-within,
  [data-transparent-color-scheme='both']:hover,
  [data-transparent-color-scheme='both']:focus-within {
    :is(.header__underlay-open, .header__underlay-closed) {
      --color-scheme-bottom-row: var(--color-background);
    }
  }

  [data-submenu-overlap-bottom-row] {
    .header__underlay-open {
      background: linear-gradient(
        var(--color-scheme-top-row) 0 var(--top-row-height),
        var(--color-submenu) var(--top-row-height) 100%
      );
    }

    .header__row--bottom {
      z-index: var(--layer-lowest);
    }
  }

  /* End Underlays ================ */

  .header__row {
    /* The account component uses a different color scheme, but we need to override it to inherit the color of the header row */
    --color-account-icon: var(--color-foreground);

    position: relative;

    /* Overwrite color from color scheme, background is controlled by the underlays */
    background-color: transparent;

    &:has(.mega-menu__list:hover),
    &:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])),
    &:has(.menu-list__list-item[slot='overflow'] .menu-list__link:is(:hover, [aria-expanded='true'])) {
      /* Only elevate the row when the submenu is open to avoid overlapping other elevated content */
      z-index: var(--layer-heightened);
    }
  }

  .header__row--top:not(.divider--page-width),
  .header__row--top.divider--page-width .header__columns,
  .header__row--bottom {
    border-bottom: var(--border-bottom-width) solid var(--color-border);
  }

  @media screen and (max-width: 749px) {
    .header__row--top:not(.divider--page-width),
    .header__row--top.divider--page-width .header__columns {
      border-bottom-width: var(--border-bottom-width-mobile);
    }
  }

  #header-component[data-menu-style='drawer'] .header__row--top:not(.divider--page-width),
  #header-component[data-menu-style='drawer'] .header__row--top.divider--page-width .header__columns {
    border-bottom-width: var(--border-bottom-width-mobile);
  }

  .header__row.divider--page-width:not(.section--page-width) .header__columns {
    @media screen and (min-width: 750px) {
      padding-inline-start: 0;
      padding-inline-end: 0;
      margin-inline-start: var(--page-margin);
      margin-inline-end: var(--page-margin);
    }
  }

  .header__column {
    display: flex;
    align-items: center;

    /* on mobile, header__column nodes are ignored to create a new grid-template-area based on all visible content */
    @media screen and (max-width: 749px) {
      display: contents;
    }
  }

  .header__column--left,
  .header__column--center {
    gap: var(--gap-xl);
    grid-area: left;
  }

  .header__column--left {
    gap: 40px;
  }

  .header__column--center {
    justify-content: center;
    grid-area: center;

    header-menu:only-child .overflow-menu::part(list) {
      justify-content: center;
    }
  }

  .header__column--right {
    gap: var(--gap-xl);
    justify-content: flex-end;
    grid-area: right;

    .overflow-menu::part(list) {
      justify-content: flex-end;
    }
  }

  .header__columns {
    /* Three column layout */
    --header-left: 1fr;
    --header-center: auto;
    --header-right: 1fr;
    --header-template-columns: var(--header-left) var(--header-center) var(--header-right);

    /* Mobile layout */
    --header-mobile-bookend: 44px;

    display: grid;
    grid-template-areas: 'left center right';
    grid-gap: var(--gap-xl);
    grid-template-columns: var(--header-template-columns);

    /* If menu is in center column */
    &:has(.header__column--center header-menu) {
      --header-center: auto;
      --header-left: minmax(max-content, 1fr);
      --header-right: minmax(max-content, 1fr);
    }

    /* If there is no center column, make the column the menu is in grow eagerly */
    &:where(:not(:has(.header__column--center))) {
      @media screen and (min-width: 750px) {
        --header-template-columns: var(--header-left) var(--header-right);

        grid-template-areas: 'left right';
      }

      /* If the header-menu is in the right column */
      &:has(.header__column--right header-menu) {
        --header-right: auto;
        --header-left: minmax(max-content, 1fr);
      }

      /* If the header-menu is in the left column */
      &:has(.header__column--left header-menu) {
        --header-left: auto;
        --header-right: minmax(max-content, 1fr);
      }
    }

    @media screen and (max-width: 749px) {
      --header-template-columns: var(--header-mobile-bookend) var(--header-mobile-bookend) 1fr
        var(--header-mobile-bookend) var(--header-mobile-bookend);

      grid-template-areas: 'leftA leftB center rightA rightB';
      grid-column: span 3;
      column-gap: 0;
      align-items: center;
      padding-block: 0;
      padding-inline: 0 var(--padding-3xs);

      .header-logo {
        grid-area: center;
      }

      &:not(:has(header-actions)) .search-action {
        grid-area: leftB;
      }

      &:not(:has(shopify-account)) .search-action {
        grid-area: rightA;
      }

      .search-action {
        grid-area: leftB;
      }

      header-actions {
        grid-area: rightB;
      }
    }
  }

  /* not ideal but we need to duplicate these styles for when touch comes into play
    We could avoid the duplication using js to set the data-menu-style attribute on small screens instead of using @media queries */
  #header-component[data-menu-style='drawer'] .header__columns {
    --header-template-columns: var(--header-mobile-bookend) var(--header-mobile-bookend) 1fr
      var(--header-mobile-bookend) var(--header-mobile-bookend);

    grid-template-areas: 'leftA leftB center rightA rightB';
    grid-column: span 3;
    column-gap: 0;
    align-items: center;
    padding-block: 0;
    padding-inline: 0 var(--padding-3xs);

    .header-logo {
      grid-area: center;
    }

    &:not(:has(header-actions)) .search-action {
      grid-area: leftB;
    }

    &:not(:has(shopify-account)) .search-action {
      grid-area: rightA;
    }

    .search-action {
      grid-area: leftB;
    }

    header-actions {
      grid-area: rightB;
    }
  }

  /* Single column layout if there are no columns within */
  .header__columns:not(:has(.header__column)) {
    grid-template-columns: 1fr;
  }

  /* Check for hover support to avoid unnecessary expensive recalculations when tapping on mobile */
  @media (hover: hover) {
    /* Column-specific dimming effect when any interactive element is hovered
        Multiple selectors for performance: each simple :has() check is faster than one complex selector with multiple conditions */
    .header__column:has(header-menu:hover),
    .header__column:has(.header-actions__action:hover),
    .header__column:has(.header__icon--menu:hover) {
      header-menu:not(:hover),
      .header-actions__action:not(:hover),
      .header__icon--menu:not(:hover) {
        opacity: var(--opacity-subdued-text);
        transition: opacity var(--animation-speed) var(--animation-easing);
      }
    }
  }

  /* Ensure smooth transitions for all interactive elements */
  header-menu,
  .header-actions__action,
  .header__icon--menu {
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  /* Header action button styles */
  .header-actions__action {
    --button-color: var(--color-foreground);
    color: var(--button-color);
    cursor: pointer;
    display: flex;
    justify-content: center;

    &:hover {
      --button-color: var(--color-foreground);
    }
  }

  .header-actions__action:not(.account-button) .svg-wrapper {
    height: var(--button-size);
    width: var(--button-size);
  }

  .header-actions__action:not(.account-button) svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .header:has(#Details-menu-drawer-container[open]) {
    contain: style;
  }

  .header .menu-list {
    --menu-horizontal-gap: 40px;
  }

  .header.header--compact {
    --header-padding: var(--padding-2xs);
  }

  .header__columns {
    --padding-block-start: var(--header-padding);
    --padding-block-end: var(--header-padding);
  }

  .header:not(.header--compact) .header__row--bottom {
    --header-padding: var(--padding-xs);
  }

  .header--collapse-row-paddings {
    .header__row--top .header__columns {
      --padding-block-end: 0px;
    }

    .header__row--bottom .header__columns {
      --padding-block-start: 0px;
    }
  }

  /* When the header is transparent, add a margin to a potential header-section below it */
  .header-section:has(.header[transparent]) + .shopify-section {
    margin-top: var(--header-height);
  }

  /* When the header is transparent, and when there is no header-section below it, offset the first main-section with
     * the height of the header
     */

  main > .shopify-section:first-child .section:not(.disable-section-top-offset) {
    &.spacing-style,
    .spacing-style {
      --section-top-offset: calc(var(--header-height) * var(--transparent-header-offset-boolean));

      /* Any nested sections should not be offset */
      :is(.spacing-style, .inherit-spacing) {
        --section-top-offset: 0px;
      }
    }

    /* Make sticky content immediately stick to the top of the page */
    .sticky-content {
      margin-top: calc(var(--header-height) * var(--transparent-header-offset-boolean) * -1);
    }
  }

  /* Optimize layout performance for hidden menus */
  .header-menu .menu-list__submenu {
    content-visibility: auto;
    contain-intrinsic-size: 0px 500px;
  }

  /* Force visibility when open/animating and in overflow submenu to prevent layout issues */
  .header-menu details[open] .menu-list__submenu,
  .header-menu .menu-list__submenu[data-active],
  .header-menu .menu-list__list-item[slot='overflow'] .menu-list__submenu {
    content-visibility: visible;
  }

  /* Dropdown Localization Styles */
  .dropdown-localization__button {
    display: flex;
    position: relative;
    align-items: center;
    gap: 4px;
    font-family: var(--menu-localization-font);
    font-size: var(--menu-localization-font-size);
    font-weight: var(--menu-top-level-font-weight);
    padding-inline: var(--padding-2xs);
    margin-inline: calc(-1 * var(--padding-2xs));
  }

  .dropdown-localization__button .svg-wrapper.icon-caret {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    right: var(--margin-xs);
    top: calc(50% - var(--padding-2xs));
    flex-shrink: 0;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .dropdown-localization__button .icon-flag {
    width: var(--menu-localization-font-size, var(--icon-size-sm));
    height: var(--menu-localization-font-size, var(--icon-size-sm));
    clip-path: circle(50%); /* stylelint-disable-line */
    background-position: center;
    background-size: cover;
    margin-inline-end: 4px;
    position: relative;
  }

  .dropdown-localization__button .icon-flag::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 var(--size-shadow) var(--color-shadow);
    border-radius: 50%;
  }

  .dropdown-localization__button[aria-expanded='true'] .icon-caret svg {
    transform: rotate(180deg);
  }

  .dropdown-localization__button,
  .dropdown-localization__button:hover {
    box-shadow: none;
    background-color: transparent;
    border-color: transparent;
  }

  dropdown-localization-component .localization-form__list {
    max-height: 20.5rem;
  }

  .localization-wrapper {
    position: fixed;
    z-index: var(--layer-raised);
    border-radius: var(--style-border-radius-popover);
    transition-property: display, opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: var(--ease-out-quad);
    transition-behavior: allow-discrete;
    translate: 0 20px;
    opacity: 0;
  }

  .localization-wrapper:not([hidden]) {
    translate: 0 0;
    opacity: 1;
  }

  @starting-style {
    .localization-wrapper:not([hidden]) {
      translate: 0 20px;
      opacity: 0;
    }
  }

  dropdown-localization-component {
    position: relative;
    background-color: transparent;
  }

  dropdown-localization-component .country-filter {
    position: relative;
    padding: 8px;
  }

  dropdown-localization-component .country-filter__input {
    border: none;
  }

  dropdown-localization-component .localization-form__list-item {
    margin-inline: 8px;
  }

  dropdown-localization-component .localization-wrapper {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    background-color: var(--color-background);
    max-height: 27.5rem;
    position: absolute;
    top: calc(100% + 10px);
    z-index: calc(var(--layer-header-menu) + 1);
  }

  dropdown-localization-component .localization-wrapper.right-bound {
    right: 0;
    left: unset;
  }

  dropdown-localization-component .localization-wrapper.left-bound {
    left: -8px;
    right: unset;
  }

  /* Additional specificity due to dropdown-localization-component getting a low score */
  dropdown-localization-component .language-selector.language-selector {
    padding: 10px 8px 10px 16px;
  }

  dropdown-localization-component .localization-form__currency {
    width: max-content;
    opacity: 0;
    visibility: hidden;
    transition: none;
  }

  dropdown-localization-component .localization-form__select:hover {
    background-color: rgb(var(--color-primary-hover-rgb) / var(--opacity-8));
  }

  dropdown-localization-component
    :is(
      .localization-form__list-item:hover,
      .localization-form__list-item[aria-selected='true'],
      .localization-form__list-item[aria-current='true']
    )
    .localization-form__currency {
    opacity: 1;
    color: var(--color-foreground-muted);
    transition: opacity var(--animation-speed-slow) var(--animation-easing);
    visibility: visible;
  }

  .dropdown-localization .language-selector:where(:not(.top-shadow)) {
    font-weight: var(--menu-top-level-font-weight);
  }

  .dropdown-localization:not(dropdown-localization-component) .language-selector {
    font-family: var(--menu-localization-font);
    font-size: var(--menu-localization-font-size);
  }

  @media screen and (max-width: 749px) {
    body {
      --header-height: 95px;
    }

    /* Logo first, then search + cart + hamburger on the right.
       The track order is flipped via grid-template-areas so the hamburger
       (leftA) lands in the last column, after the cart icon. */
    .header__columns,
    #header-component[data-menu-style='drawer'] .header__columns {
      --header-template-columns: 140px 1fr 44px 44px 44px;

      grid-template-areas: 'leftB center rightA rightB leftA';
      padding-block: 10px;
      padding-inline: 20px;
    }

    /* Hamburger: pin to the last (right-most) track, pulled out past the 20px
       page padding so the icon sits ~14px from the viewport edge. */
    .header__columns .header__drawer,
    #header-component[data-menu-style='drawer'] .header__columns .header__drawer {
      grid-area: leftA;
      justify-self: end;
      margin-inline-end: -14px;
    }

    /* Logo positioning + size handled by the unified <=1199 rule below; search
       visibility is handled there too (hidden only at <=599). */
  }

  /* PI: tablet header — match mobile layout with proper spacing */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    /* Force the hamburger drawer and hide the inline nav links in the tablet
       range, regardless of the JS-decided data-menu-style (which is 'menu' in
       non-touch responsive previews because the links technically fit). */
    #header-component .header-menu,
    #header-component[data-menu-style='menu'] .header-menu,
    #header-component .dropdown-localization,
    #header-component[data-menu-style='menu'] .dropdown-localization {
      display: none !important;
    }

    /* Hamburger sits in the last track, after the INQUIRE NOW button, pulled
       out past the 20px page padding so the icon sits ~14px from the viewport
       edge. Only the hamburger shifts — the icons and INQUIRE NOW keep their
       inset. -14px stays inside the 20px padding, so nothing overflows. */
    #header-component .header__drawer,
    #header-component[data-menu-style='menu'] .header__drawer {
      display: flex !important;
      grid-area: leftA;
      align-items: center;
      justify-self: end;
      margin-inline-end: -14px;
    }

    /* Track order flipped so leftA (the hamburger) is the right-most column.
       Padding matches the Figma frame: 10px block, 20px inline. */
    .header__columns,
    #header-component[data-menu-style='drawer'] .header__columns {
      --header-template-columns: auto 1fr auto 44px !important;
      grid-template-areas: 'leftB center rightB leftA' !important;
      padding-inline: 20px !important;
      padding-block: 10px !important;
    }

    /* Logo positioning + size handled by the unified <=1199 rule below. */

    #header-component[data-menu-style='drawer'] .header__columns header-actions {
      grid-area: rightB !important;
      justify-self: end;
    }
    /* Search is no longer hidden in the tablet range — the unified <=1199 layout
       shows it on the right (visibility handled by search.liquid). */
  }

  /* PI: when the hamburger/drawer layout is active on wider (>=990px) touch
     screens, align its edges to the page margins instead of hugging the
     viewport edges (the theme's default touch-duplicate uses flush padding).
     Scoped to data-menu-style='drawer' so the desktop nav-links layout is
     untouched. */
  @media screen and (min-width: 990px) {
    #header-component[data-menu-style='drawer'] .header__columns {
      padding-inline: var(--page-margin) !important;
    }
  }

  /* PI: small-laptop / landscape-tablet band (990–1199px). Same arrangement as
     the 750–989px block: logo left, then search + action icons + INQUIRE NOW,
     with the hamburger last. Replaces the theme's default drawer grid, which
     centers the logo and puts the hamburger and search on the far left.
     Scoped to data-menu-style='drawer' so that when the JS decides the inline
     nav links fit, that layout is left completely alone. */
  @media screen and (min-width: 990px) and (max-width: 1199px) {
    #header-component[data-menu-style='drawer'] .header__columns {
      --header-template-columns: auto 1fr auto auto auto !important;

      grid-template-areas: 'leftB center rightA rightB leftA' !important;
    }

    /* Logo: centre → first (left-most) track */
    #header-component[data-menu-style='drawer'] .header__columns .header-logo {
      grid-area: leftB !important;
      justify-self: start;
    }

    /* Search: far left → immediately before the wishlist icon. No display
       override here: the header renders two .search-action copies (one tagged
       --hidden-on-drawer, one --hidden-on-menu) and forcing display would show
       both. Placing them in the same area is fine — the other stays hidden.
       The negative margins from search.liquid are zeroed so the search icon's
       --button-size box butts directly against the wishlist's, giving the same
       icon-to-icon spacing as the rest of the row. */
    #header-component[data-menu-style='drawer'] .header__columns .search-action {
      grid-area: rightA !important;
      justify-self: end;
      margin-inline: 0 !important;
    }

    /* Wishlist / account / cart / INQUIRE NOW. header-actions carries
       margin-inline: -8px at >=750px, which would pull the wishlist 8px closer
       to search than the icons are to each other — zeroed for even spacing. */
    #header-component[data-menu-style='drawer'] .header__columns header-actions {
      grid-area: rightB !important;
      justify-self: end;
      margin-inline: 0 !important;
    }

    /* Hamburger: last track, after INQUIRE NOW, pulled out past the 40px page
       margin so the icon sits ~14px from the viewport edge. */
    #header-component[data-menu-style='drawer'] .header__columns .header__drawer {
      grid-area: leftA !important;
      justify-self: end;
      align-items: center;
      margin-inline-end: -34px;
    }
  }

  /* PI: unified drawer-navbar layout for every width the hamburger shows (<=1199).
     Hamburger far-left, logo dead-centre, search + cart on the right; nav links,
     wishlist, account and INQUIRE live in the drawer (hidden here / see
     header-actions.liquid). Uses flex + an absolutely-centred logo so the logo
     stays centred regardless of the right-side icon count. Overrides the grid
     positioning in the <=749 / 750-989 / 990-1199 blocks above (declared after
     them; !important beats their un-!important margins). */
  @media screen and (max-width: 1199px) {
    #header-component .header__columns,
    #header-component[data-menu-style='drawer'] .header__columns {
      display: flex !important;
      align-items: center;
      position: relative;
      gap: 8px;
    }

    /* Nav links + the inline localization dropdown never show in the bar here —
       they're in the drawer. Force-hidden regardless of the JS menu-style. */
    #header-component .header__columns .header-menu,
    #header-component .header__columns .dropdown-localization {
      display: none !important;
    }

    /* Logo constant size across all widths (shared --header-logo-image-* vars). */
    #header-component .header__columns .header-logo img,
    #header-component .header__columns .header-logo svg,
    #header-component .header__columns .header-logo__image {
      height: var(--header-logo-image-height) !important;
      width: var(--header-logo-image-width) !important;
      max-width: none !important;
      object-fit: contain;
    }

    /* Hamburger always at the far LEFT (holds whatever overflowed). auto end
       margin pushes the icons to the right; -6px start sits it ~14px from the
       20px edge. */
    #header-component .header__columns .header__drawer,
    #header-component[data-menu-style='drawer'] .header__columns .header__drawer {
      display: flex !important;
      order: -1 !important;
      align-self: center;
      justify-self: auto !important;
      grid-area: auto !important;
      margin: 0 auto 0 -6px !important;
    }

    /* Logo centred in the bar at every hamburger width (up to 1199). */
    #header-component .header__columns .header-logo,
    #header-component[data-menu-style='drawer'] .header__columns .header-logo {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      margin: 0 !important;
      max-width: none !important;
      height: auto !important;
      justify-self: auto !important;
      grid-area: auto !important;
    }

    #header-component .header__columns .search-action,
    #header-component[data-menu-style='drawer'] .header__columns .search-action {
      order: 1 !important;
      justify-self: auto !important;
      grid-area: auto !important;
      margin-inline: 0 !important;
    }
    #header-component .header__columns header-actions,
    #header-component[data-menu-style='drawer'] .header__columns header-actions {
      order: 2 !important;
      justify-self: auto !important;
      grid-area: auto !important;
      margin-inline: 0 !important;
    }
  }

  /* Phones (<=599): search stays in the bar, next to the cart.
     It used to be hidden here and reachable only from inside the drawer, but the
     Figma 390 frame puts search and cart side by side on the right of the navbar,
     so hiding it was a departure from the design. The grid already reserves a
     44px track for it (the mobile template is
     `140px 1fr 44px 44px 44px` / 'leftB center rightA rightB leftA'), so showing
     it fills an existing empty column rather than adding width — measured at 390:
     logo ends at 264 and the search button occupies 284-328, clear of both the
     logo and the cart. The drawer keeps its own search as well, which is
     harmless: two entry points to the same panel. */

  /* Below the 390 design frame there is genuinely no room for it. The row needs
     10 + hamburger 51 + logo 193 + search 44 + cart 44 + 10 = 352px of content
     before any gaps, so at 360 the cart was pushed 18px past the right edge
     (measured: cart right 368 against a content edge of 350; hiding search put it
     back at exactly 350). The logo is fixed at 193px by design and 44px is the
     minimum touch target, so nothing here can absorb that. Falling back to the
     drawer below 390 keeps search reachable without breaking the row — and 390 is
     the narrowest width the design actually specifies. */
  @media screen and (max-width: 389px) {
    #header-component .header__columns .search-action {
      display: none !important;
    }
  }

  /* PI: at >=1200px show the inline nav and hide the hamburger on first paint,
     so there's no hamburger flash before header.js runs. Safe against overlap
     because the JS keeps data-menu-style out of 'drawer' at >=1200px, so the
     mobile grid (centered logo, no nav column) never activates here. */
  @media screen and (min-width: 1200px) {
    #header-component .header-menu {
      display: flex !important;
    }

    #header-component .header__drawer,
    #header-component .header__navigation-bar-row {
      display: none !important;
    }
  }

  /* PI: laptop widths — scale the whole navbar down proportionally so it reads
     as the same design as desktop, just slightly smaller.

     Replaces an earlier attempt that tightened --menu-horizontal-gap to 12px
     and link padding to 6px. That block was dead CSS on both counts, measured
     in a browser:
       1. `#header-component .header .menu-list` never matched — #header-component
          IS the .header element (<header-component class="header">), so there is
          no .header descendant.
       2. `#header-component .menu-list__link-title { padding-inline: 6px }` lost
          to `.menu-list__link-title { padding-inline: 20px !important }` in
          base.css.
     Note --menu-horizontal-gap is inert for the top-level row anyway:
     `.overflow-menu::part(list) { gap: 0 }` zeroes it, so all link spacing comes
     from that base.css padding.

     Consequence: full desktop metrics applied at every width >=1200px, and the
     nav ran into the search icon — measured overlap of 106px at 1280 and 20px
     at 1366. 1440 and 1920 were always fine (+54px and +144px of clearance), so
     they get no scaling at all and stay pixel-identical to the desktop design.

     Scaling with `zoom` (not transform: scale) because zoom participates in
     layout, so the grid still tracks the shrunken content and the row keeps its
     95px height. Applied to the two .header__column children rather than
     .header__columns so the grid itself still spans the full page width.

     Factors come from a model fitted to browser measurements —
     gap = contentW - 1280*f - 16, where contentW = min(1440, viewport - 80) —
     which reproduced every sample within 2px. Each band's factor is the one that
     is safe at that band's LOWER bound, so there is no width inside a band where
     the nav collides. Bands are >=40px wide so a target resolves to the same
     band whether or not the platform reserves scrollbar width (0-17px). */
  @media screen and (min-width: 1200px) {
    .header__row--top .header__columns > .header__column {
      zoom: var(--pi-header-scale, 1);
    }

    /* Counter the proportional zoom on the logo ONLY, so it renders at the same
       pixel size as at <=1199px (and >=1420px) — the logo must stay constant
       across every width even though the links/icons scale to fit. Each band's
       --pi-logo-unzoom is 1 / --pi-header-scale. */
    #header-component .header-logo {
      zoom: var(--pi-logo-unzoom, 1);
    }
  }

  /* PI: stop the "More" chip reserving width during overflow-list's fit test, so
     all five top-level links stay inline instead of the last one (RESOURCES)
     being pushed into a More dropdown.

     overflow-list measures by un-hiding the More chip, switching the row to
     flex-wrap and seeing which items land on a second row. Measured at 1440: the
     chip is 83px wide but only 54px of clearance remains, so RESOURCES wrapped
     and was moved into the overflow slot. Because the reflow only re-runs on
     resize/mutation, a fresh load could look fine and then break on the next
     reflow — which is why it appeared intermittently.

     Zeroing the chip's reserved width means nothing overflows, and the component
     then hides More on its own (`moreSlot.hidden = !hasOverflow`) — no JS and no
     fighting the component. It also lets 1440 and 1920 stay at scale 1.0, i.e.
     pixel-identical to the desktop design.

     Width is driven by --overflow-count (which overflow-list sets on its host
     after every pass) rather than hard-coded to 0, so if the menu ever genuinely
     outgrows the row the chip regains width and those links stay reachable
     instead of silently vanishing.

     Scoped to >=1200px: below that the inline nav is hidden in favour of the
     hamburger drawer, so normal overflow behaviour is left untouched. */
  @media screen and (min-width: 1200px) {
    #header-component .overflow-menu::part(more) {
      width: calc(var(--overflow-count, 0) * 90px);
      min-width: 0;
      overflow: hidden;
    }

    /* Belt and braces on the same problem. overflow-list decides what fits by
       setting `flex-wrap: wrap` on the row and seeing which items land on a
       second line. That measurement is not reliable here: on a resize it can run
       before the zoom above has been applied, compare the old item sizes against
       the new container, and conclude that everything overflows — collapsing the
       entire nav to just "More" and latching there until the next reload, which
       is why a refresh restored the full nav.

       Forcing nowrap means nothing can wrap, so every item reports the same
       offsetTop, `hasOverflow` stays false, and the component keeps all five
       links inline and hides More on its own. Immune to when the measurement
       runs. !important is needed to beat the inline style the component sets.

       Safe because the zoom bands guarantee the links fit at every width >=1200px
       (verified 1200-1920), and below 1200px the inline nav is hidden in favour
       of the drawer. The trade-off: this also removes the --overflow-count escape
       hatch above, so if menu items are ever added the links would crowd rather
       than fold into More — re-tune the bands if the menu changes. */
    #header-component .overflow-menu::part(list) {
      flex-wrap: nowrap !important;

      /* PI: let the dropdown panels escape the nav row.
         overflow-list's shadow sheet sets `overflow-x: auto; overflow-y: hidden`
         on this <ul> so a too-wide nav can scroll sideways. In stock Horizon
         that is harmless: the mega-menu panel is positioned against
         #header-component, i.e. an ancestor of this <ul>, so the clip does not
         apply to it. The PI dropdown is different — `.menu-list__list-item` was
         given `position: relative` so the small panel could anchor under its own
         link, which moves the panel's containing block INSIDE this <ul>. It then
         gets clipped at the bottom edge of the ~30px nav row, which is exactly
         where the panel starts: the whole dropdown was cut away, both visually
         and for hit-testing. Measured with elementFromPoint at 1280 and 1440 —
         the point over a dropdown link resolved to page content behind the
         header, so the links could not be clicked at all, and moving the pointer
         off the parent link fired pointerleave and closed the menu.

         Nothing needs the scroll here: the rule above forces nowrap and the
         `::part(more)` rule zeroes the More chip, so at every width >=1200px the
         five links are guaranteed to fit. Below 1200px the inline nav is hidden
         in favour of the drawer, so the stock scrolling behaviour is untouched. */
      overflow: visible;
    }
  }

  /* The two lowest bands were re-fitted after the dropdown carets were added.
     Each caret link costs an extra 41px of nav width (11px chevron + 10px gap +
     20px trailing padding) and there are two of them, so ~82px appeared in the
     row after the factors above were measured. Re-measuring at the band lower
     bounds showed the RESOURCES caret overlapping the search icon by 17px at
     1200 and touching it at 1260; the upper bands stayed clear (+16 at 1300,
     +11 at 1340, +18 at 1380, +25 at 1420) and are left alone.

     Refitted from measurements taken across all six bands, which fit
     `caretRight = 231 + 730*f` and `searchIconLeft = W - 40 - 395.5*f` to within
     1px, i.e. gap = W - 271 - 1125.5*f. Solving that for the gap 1420 gets
     (23.5px, scaled by f so the spacing stays proportional) gives 0.808 at
     W=1200 and 0.861 at W=1260, rounded down to the values below. Verified: 29px
     of clearance at 1200 and 21px at 1260. */
  @media screen and (min-width: 1200px) and (max-width: 1259px) {
    .header__row--top {
      --pi-header-scale: 0.8;
      --pi-logo-unzoom: 1.25;
    }
  }

  /* covers 1280-wide viewports on any platform */
  @media screen and (min-width: 1260px) and (max-width: 1299px) {
    .header__row--top {
      --pi-header-scale: 0.86;
      --pi-logo-unzoom: 1.1628;
    }
  }

  @media screen and (min-width: 1300px) and (max-width: 1339px) {
    .header__row--top {
      --pi-header-scale: 0.9;
      --pi-logo-unzoom: 1.1111;
    }
  }

  /* covers 1366-wide viewports on any platform */
  @media screen and (min-width: 1340px) and (max-width: 1379px) {
    .header__row--top {
      --pi-header-scale: 0.94;
      --pi-logo-unzoom: 1.0638;
    }
  }

  @media screen and (min-width: 1380px) and (max-width: 1419px) {
    .header__row--top {
      --pi-header-scale: 0.97;
      --pi-logo-unzoom: 1.0309;
    }
  }

  /* PI: keep the announcement bar stuck to the top together with the navbar.
     The theme sticks .header-section on its own and sets #header-group to
     `display: contents`, so the announcement bar — a sibling section inside the
     same group — scrolls away underneath it. Making the group itself the sticky
     element pins both as one block, with no need to measure the announcement
     bar's height.

     z-index is --layer-menu-drawer (18) rather than --layer-sticky (8):
     `position: sticky` always creates a stacking context, so everything inside
     the header (menu drawer 18, underlay 16, submenus 12) is now confined to
     it, while page content reaches z-index 10 (pi-trusted-by). At 18 the group
     and its overlays stay above all page content and keep their relative order.
     Dialogs/popovers are unaffected — they render in the top layer. */
  #header-group:has(#header-component[sticky]) {
    display: block;
    position: sticky;
    top: 0;
    z-index: var(--layer-menu-drawer);
  }

  /* The group now owns the stickiness, so the inner section doesn't need the
     top: -1px offset. Side effect: the intersection observer in header.js keeps
     data-sticky-state at 'inactive', which only feeds transparent-header colour
     inheritance (disabled on this store) and a view-transition name.
     Only the 'always' mode is overridden — 'scroll-up' keeps theme behaviour. */
  .header-section:has(> #header-component[sticky='always']) {
    position: static;
  }

  /* PI: pin desktop navbar to Figma height (95px) with vertically centered content */
  @media screen and (min-width: 750px) {
    .header__row--top .header__columns {
      height: 95px;
      box-sizing: border-box;
      --padding-block-start: 0px;
      --padding-block-end: 0px;
      align-items: center;
    }
  }

  /* PI: uniform 95px navbar height at all widths (matches desktop). Explicit
     height keeps the row deterministic; 20px inline / 10px block padding hold
     the content off the edges. */
  @media screen and (max-width: 989px) {
    body {
      --header-height: 95px;
    }

    .header__row--top .header__columns {
      height: 95px;
      box-sizing: border-box;
      padding-block: 10px;
      padding-inline: 20px;
      --padding-block-start: 0px;
      --padding-block-end: 0px;
      align-items: center;
    }

    #header-component .header__drawer {
      align-self: stretch;
    }
  }

  /* PI: dropdown caret beside menu link text (Figma: horizontal, 10px gap, 11×7 caret) */
  .pi-menu-link-with-caret {
    display: flex;
    align-items: center;
    gap: 10px;

    /* Re-adds, after the chevron, the 20px removed from the label below. Without
       it the caret sat only 20px from the next link (that link's own start
       padding) while plain links are 40px apart — 20 + 20 — so SERVICES and
       RESOURCES read as crowding their neighbours. The 20px is moved rather than
       deleted, so item widths are unchanged overall. */
    padding-inline-end: 20px;
  }

  /* The label carries `padding-inline: 20px !important` from base.css, and on a
     caret link that 20px lands between the text and the chevron — so the gap read
     as 29px instead of the 10px above. Drop the end padding on caret links only;
     the wrapper above puts the same 20px back on the far side of the caret. */
  #header-component .pi-menu-link-with-caret .menu-list__link-title {
    padding-inline-end: 0 !important;
  }

  .pi-menu-caret {
    display: inline-flex;
    align-items: center;
    width: 11px;
    height: 7px;
    flex-shrink: 0;
    color: #000000;
  }

  .pi-menu-caret svg {
    width: 11px;
    height: 7px;
  }

  /* PI: simple dropdown menu (overrides mega-menu positioning) */
  .menu-list__list-item {
    position: relative;
  }

  /* This wrapper is a zero-size anchor: height 0 and, because width is auto with
     only `left` set, it collapses to width 0 too (measured: 0px). `left: 0` puts
     it on the list item's left edge. Note a translateX(%) here would be a
     percentage of this element's own 0 width and resolve to nothing — any
     horizontal offset has to go on the inner panel, which has a real width. */
  .menu-list__list-item:where(:not([slot='overflow'])) > .pi-simple-dropdown {
    position: absolute !important;
    width: auto !important;
    left: 0 !important;
    top: 100% !important;
    clip-path: none !important;
    padding-inline: 0 !important;
    margin-top: 0 !important;
    height: 0 !important;
    overflow: visible !important;
  }

  .pi-simple-dropdown__inner {
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);

    /* 20px inline padding, matching the parent link's own padding-inline, so the
       child links start at exactly the same x as the label text: the anchor above
       sits on the list item's left edge (which is also the label's border-box
       left), the label text begins 20px in, and so do these.
       !important is required — base.css sets
       `.menu-list__submenu-inner { padding-inline: var(--section-padding-inline) }`
       at the same specificity but later in the bundle, which was flattening this
       to 0px and pinning the links flush to the panel edge. */
    padding: 20px !important;

    /* No horizontal offset: the anchor is already on the right edge. !important
       cancels the base mega-menu's translateY animation on
       .menu-list__submenu-inner and substitutes a short one sized for this
       small panel — the base value is scaled for a full-width mega menu.

       This is also what makes the panel ease open at all: the wrapper above
       drops the base clip-path reveal, so `visibility` is the only remaining
       open/close switch and it is binary. Fading the inner gives the panel its
       own transition instead of letting it pop. */
    transform: translateY(-6px) !important;
    opacity: 0 !important;
    transition:
      opacity 200ms var(--ease-out-cubic, ease),
      transform 200ms var(--ease-out-cubic, ease);
    position: relative;
    z-index: var(--layer-header-menu, 100);

    /* Hugs its content like the Figma panel (~138px) instead of the previous
       200px, which left a wide empty gutter once the links were left-aligned. */
    min-width: 140px;
  }

  /* Open state. Mirrors the two selectors the base sheet uses to reveal a
     submenu — aria-expanded on the item (set by header-menu.js) and hover on
     the panel itself, which is what keeps it open once the pointer is inside. */
  .menu-list__list-item:has([aria-expanded='true']) > .pi-simple-dropdown .pi-simple-dropdown__inner,
  .pi-simple-dropdown:hover .pi-simple-dropdown__inner {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }

  /* `visibility` flips instantly, which would clip the fade-out mid-way. Delay
     the hide until the fade has finished; on open the delay is removed so the
     panel becomes visible immediately and the opacity transition is seen. */
  .menu-list__list-item:where(:not([slot='overflow'])) > .pi-simple-dropdown {
    transition: visibility 0s linear 200ms !important;
  }

  .menu-list__list-item:has([aria-expanded='true']) > .pi-simple-dropdown,
  .pi-simple-dropdown:hover {
    transition-delay: 0s !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-simple-dropdown__inner {
      transition: none !important;
      transform: none !important;
    }

    .menu-list__list-item:where(:not([slot='overflow'])) > .pi-simple-dropdown {
      transition: none !important;
    }
  }

  .pi-simple-dropdown__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Left-aligned, per the Figma: the child links form a single column whose left
     edge lines up with the parent link's label (see the translateX on
     .pi-simple-dropdown__inner). Centring them made each row start at a different
     x depending on its text length, which is what read as misaligned. */
  .pi-simple-dropdown__item {
    text-align: left !important;
  }

  .pi-simple-dropdown__link {
    color: #000000;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    white-space: nowrap;
    transition: color 0.2s ease;
    text-align: left !important;
  }

  .pi-simple-dropdown__link:hover {
    color: rgb(0 0 0 / 0.7);
  }

  /* PI: all nav links pure black. Figma types every top-level link at #000000,
     so the active/hovered state is distinguished by the underline alone rather
     than by also dropping to --opacity-subdued-text (which rendered the current
     page's link at 70% black against a spec of 100%). */
  #header-component .menu-list .menu-list__link {
    color: var(--menu-top-level-font-color) !important;
  }

  #header-component .menu-list .menu-list__link--active,
  #header-component .menu-list .menu-list__link:hover {
    color: var(--menu-top-level-font-color) !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* PI: Figma nav type — Proxima Nova is not licensed on this store (no font
     files, no @font-face anywhere), so Nunito Sans stands in for it, matching
     the substitution used across the pi-* sections. Without a family here the
     links fell back to the theme default (Inter) and to a 30.09px line box. */
  #header-component .menu-list .menu-list__link {
    font-family: 'Nunito Sans', sans-serif;
    line-height: 23px;
  }

  /* PI: Figma header fill. The row painted nothing at all — it only looked white
     because the page behind it is, which shows through once content scrolls
     under the sticky header.

     The 1px bottom rule is NOT set here: the theme drives it from the
     `border_width` section setting via --border-bottom-width /
     --border-bottom-width-mobile (see the row loop near the top of this file),
     and those rules outrank a plain `.header__row--top`. It is set to 1 in
     header-group.json instead. */
  .header__row--top {
    background-color: #ffffff;
  }

  /* PI: logo left-aligned right after the hamburger (not absolutely centred),
     wherever the hamburger shows (≤1199) — per the Figma navbar. margin-right:auto
     on the logo pushes the search + cart to the far right:
       [hamburger] [logo] …… [search] [cart] */
  @media screen and (max-width: 1199px) {
    #header-component .header__columns .header-logo,
    #header-component[data-menu-style='drawer'] .header__columns .header-logo {
      position: static !important;
      left: auto !important;
      top: auto !important;
      transform: none !important;
      margin: 0 auto 0 0 !important;
    }

    /* Hamburger keeps a small fixed gap before the logo instead of the
       margin-right:auto it had (which pushed everything to the far right while
       the logo was absolutely positioned). */
    #header-component .header__columns .header__drawer,
    #header-component[data-menu-style='drawer'] .header__columns .header__drawer {
      margin: 0 10px 0 -6px !important;
    }
  }

  /* PI: Figma mobile navbar (390px frame) — 60px bar, 20px side padding,
     140×40 logo, 27×20 hamburger flush to the 20px edge, 20×20 search + cart
     15px apart ending on the 20px right edge:
       [hamburger] 20px [logo] …… [search] 15px [cart]

     This replaces an earlier `@media (max-width: 400px) { padding-inline: 10px }`
     hack. That hack existed only because the logo was rendering at its 193×55
     DESKTOP size on phones and shoved the cart past the edge — see the logo
     override below for why. With the logo at its real mobile size there is room
     to spare, so the side padding can match the design instead of fighting it. */
  @media screen and (max-width: 749px) {
    body {
      --header-height: 60px;
    }

    .header__row--top .header__columns {
      height: 60px;
      padding-block: 10px;
      padding-inline: 20px;
    }

    /* Spacing is done with explicit margins below, so the inherited 8px flex gap
       has to go. The [data-menu-style='drawer'] twin is required: the ≤1199 block
       above declares its rules against both selectors, and that variant scores
       higher than a plain `#header-component .header__columns`, so a single-
       selector override silently loses the cascade. */
    #header-component .header__columns,
    #header-component[data-menu-style='drawer'] .header__columns {
      gap: 0 !important;
    }

    /* Undoes the blanket `@media (max-width: 1199px)` rule further up that feeds
       the DESKTOP --header-logo-image-* vars to every sub-desktop width. That
       rule outranks `.header-logo__image` (id + 3 classes vs 1 class), so the
       -mobile vars _blocks/_header-logo.liquid_ emits could never win and the
       mobile logo size was dead code. Re-asserted here for phones only; the
       750–1199 tablet band keeps the constant-size behaviour it was given. */
    #header-component .header__columns .header-logo img,
    #header-component .header__columns .header-logo svg,
    #header-component .header__columns .header-logo__image {
      height: var(--header-logo-image-height-mobile) !important;
      width: var(--header-logo-image-width-mobile) !important;
    }

    /* Hamburger glyph flush to the 20px padding, 20px before the logo. The stock
       summary is a 51px-wide tap target that centres the 27px glyph, which left
       it sitting ~14px from the edge. */
    #header-component .header__columns .header__drawer,
    #header-component[data-menu-style='drawer'] .header__columns .header__drawer {
      margin: 0 20px 0 0 !important;
      min-height: 0 !important;
    }

    #header-component .header__columns .header__drawer .header__icon--menu {
      width: 27px !important;
      min-width: 0 !important;
      padding-inline: 0 !important;
      justify-content: flex-start !important;
    }

    /* 20×20 action glyphs with a real 15px gap, instead of 22×22 glyphs centred
       in 44px tap targets (which read as a 30px gap). */
    #header-component .header__columns .search-action .header-actions__action,
    #header-component .header__columns header-actions .header-actions__action {
      width: 20px !important;
      min-width: 0 !important;
      padding: 0 !important;
    }

    #header-component .header__columns .search-action .svg-wrapper,
    #header-component .header__columns header-actions .svg-wrapper {
      width: 20px !important;
      height: 20px !important;
    }

    #header-component .header__columns .search-action svg,
    #header-component .header__columns header-actions svg {
      width: 20px !important;
      height: 20px !important;
    }

    #header-component .header__columns .search-action,
    #header-component[data-menu-style='drawer'] .header__columns .search-action {
      margin-inline-end: 15px !important;
    }
  }

  /* PI: Figma desktop action cluster — "Top Right icons" is Hug(153) × Hug(20)
     with a uniform 20px gap, then 30px before INQUIRE NOW. Stock Horizon centres
     22×22 glyphs inside 44px tap targets, which reads as 22–25px of drift
     between icons and 43px before the button. Sizing the boxes to the glyph and
     spacing them explicitly restores the design's rhythm.
     The account glyph is 15×17, not square, so it is scaled by height only —
     forcing it to 20×20 would stretch it ~13% wider than drawn. */
  @media screen and (min-width: 1200px) {
    #header-component .header__column--right .search-action .header-actions__action,
    #header-component .header__column--right header-actions .header-actions__action {
      width: 20px;
      min-width: 0;
      padding: 0;
    }

    #header-component .header__column--right .search-action .svg-wrapper,
    #header-component .header__column--right header-actions .svg-wrapper {
      width: 20px;
      height: 20px;
    }

    #header-component .header__column--right .search-action svg,
    #header-component .header__column--right header-actions svg {
      width: 20px;
      height: 20px;
    }

    #header-component .header__column--right .account-button svg {
      width: auto;
      height: 20px;
    }

    #header-component .header__column--right header-actions {
      gap: 20px;
    }

    /* Figma puts 40px between the logo and the HOME label. The left column's
       flex gap is already 40px, but overflow-list pulls its items 20px back to
       cancel the 20px inline padding each menu item carries — which lands the
       first label 20px from the logo. Re-add the 20px here rather than unpicking
       that padding system, which the caret spacing above depends on. */
    #header-component .header__column--left .header-menu {
      margin-inline-start: 20px;
    }

    /* .header__column--right already carries a 20px flex gap, which is exactly
       the spec — so no extra margin is needed between search and the actions
       group. What did need removing is stock Horizon's negative inline-start
       pulls (-14.4px inline-start, -8px inline-end on the search button). Those
       exist to drag 44px tap targets outward so their glyphs sit optically on
       the margin; with the boxes now sized to the glyph they just eat into the
       gap — the -8px is why search→account measured 12px instead of 20px. */
    #header-component .header__column--right .search-action,
    #header-component .header__column--right header-actions {
      margin-inline: 0;
    }

    /* 30px from the cart to the button. 20px of that is the header-actions flex
       gap above (the button is the last child of header-actions), so only the
       remaining 10px comes from the margin. */
    #header-component .header__column--right .pi-inquire-btn {
      margin-left: 10px;
    }
  }

  /* PI: count badges, re-anchored for the glyph-sized action boxes.

     The cart bubble and wishlist count are absolutely positioned against their
     action box using stock offsets (top 4.5 / right 2.5) that assume a 44px tap
     target. Once the boxes were sized to the 20px glyph those offsets covered
     the icon completely — the cart rendered as a solid black disc with the
     number on it, and the heart sat behind its own badge.

     Figma draws the qty badge as 18×18 overhanging the icon's top-right corner
     (Left 14, Top -9), which is exactly why its cart frame measures 33×20 rather
     than 20×20. The wishlist badge mirrors it, per the pairing note in
     header-actions.liquid.

     Scoped to the two bands where the boxes were actually shrunk — the 750–1199
     tablet band still uses 44px targets, where the stock offsets remain correct. */
  @media screen and (max-width: 749px), screen and (min-width: 1200px) {
    /* Re-centre the cart glyph. .header-actions__cart-icon is display:block with
       a 22.4px line-height wrapping an inline-flex .svg-wrapper, so the glyph
       rode a text baseline inside a 26.39px box and sat 3.2px above the other
       three icons. Flex-centring at a fixed 20px takes the baseline out of it.

       Scoped to the cart on purpose. A blanket rule on .header-actions__action
       looks tidier but sets `display`, which outranks the `display: none` that
       hides the account (≤989) and wishlist (≤849) buttons — it put both back on
       phones and pushed the search icon 40px out of place. The other three
       actions were already centred and need nothing. */
    #header-component .header__columns .action__cart {
      height: 20px;
      align-items: center;
    }

    #header-component .header__columns .header-actions__cart-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 20px;
    }

    #header-component .cart-bubble:not(.visually-hidden),
    #header-component .pi-wishlist-count:not([hidden]) {
      inset: -9px auto auto 14px;
      width: 18px;
      min-width: 18px;
      height: 18px;
      padding: 0;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      line-height: 1;
    }
  }
{% endstylesheet %}

{% unless request.design_mode %}
  <script type="module">
    import { hydrate } from '@theme/section-hydration';
    const url = new URL(window.location.href);
    url.searchParams.delete('page');
    hydrate('{{ section.id }}', url);
  </script>
{% endunless %}

{% schema %}
{
  "name": "t:names.header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.logo"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.menu"
    },
    {
      "type": "select",
      "id": "menu_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
