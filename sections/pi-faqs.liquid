<style>
  #shopify-section-{{ section.id }} {
    padding: 100px 0;
    background: #ffffff;
  }

  .pi-faqs {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 50px;
  }

  .pi-faqs__title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .pi-faqs__body {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .pi-faqs__list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-faqs__item {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-faqs__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .pi-faqs__question {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
  }

  .pi-faqs__icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 20px;
  }

  .pi-faqs__icon-minus { display: none; }

  .pi-faqs__item.is-open .pi-faqs__icon-plus  { display: none; }
  .pi-faqs__item.is-open .pi-faqs__icon-minus { display: block; }

  .pi-faqs__answer {
    display: none;
    width: 100%;
  }

  .pi-faqs__item.is-open .pi-faqs__answer {
    display: block;
  }

  .pi-faqs__answer-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #121212;
    margin: 0;
  }

  .pi-faqs__divider {
    width: 100%;
    height: 1px;
    background: #000000;
    flex-shrink: 0;
  }

  .pi-faqs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    white-space: nowrap;
    cursor: pointer;
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .pi-faqs__btn:hover { opacity: 0.82; }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 70px 0; }
    .pi-faqs { padding: 0 32px; gap: 40px; }
    .pi-faqs__title { font-size: 40px; line-height: 52px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 50px 0; }
    .pi-faqs { padding: 0 20px; gap: 30px; }
    .pi-faqs__title { font-size: 32px; line-height: 42px; }
    .pi-faqs__question { font-size: 17px; line-height: 22px; }
    .pi-faqs__answer-text { font-size: 16px; line-height: 26px; }
    .pi-faqs__btn { font-size: 14px; padding: 14px 24px; height: auto; }
  }
</style>

<div class="pi-faqs">

  <h2 class="pi-faqs__title">FAQs</h2>

  <div class="pi-faqs__body">

    {%- if section.blocks.size > 0 -%}
    <div class="pi-faqs__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
        <div class="pi-faqs__item" {{ block.shopify_attributes }}>

          <button class="pi-faqs__trigger" type="button" aria-expanded="false">
            <span class="pi-faqs__question">{{ block.settings.question }}</span>
            <span class="pi-faqs__icon" aria-hidden="true">
              <svg class="pi-faqs__icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="5" y="0" width="2" height="12" fill="#000000"/>
                <rect x="0" y="5" width="12" height="2" fill="#000000"/>
              </svg>
              <svg class="pi-faqs__icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="12" height="2" fill="#000000"/>
              </svg>
            </span>
          </button>

          {%- if block.settings.answer != blank -%}
            <div class="pi-faqs__answer">
              <p class="pi-faqs__answer-text">{{ block.settings.answer }}</p>
            </div>
          {%- endif -%}

          <div class="pi-faqs__divider"></div>

        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="pi-faqs__btn"
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}

  </div>

</div>

<script>
  (function () {
    document.querySelectorAll('#shopify-section-{{ section.id }} .pi-faqs__trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var item = this.closest('.pi-faqs__item');
        var isOpen = item.classList.toggle('is-open');
        this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "PI FAQs",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Inquire Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is there an age requirement for tattoos and piercings?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, you must be 18+ for tattoos. For piercings, 16+ with parental consent (valid ID required)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI FAQs"
    }
  ]
}
{% endschema %}
