<style>
  #shopify-section-{{ section.id }} {
    --pi-faqs-pad-top: {{ section.settings.padding_top }}px;
    --pi-faqs-pad-bottom: {{ section.settings.padding_bottom }}px;
    --pi-faqs-bg: {{ section.settings.bg_color }};
    --pi-faqs-title-size: {{ section.settings.title_size }}px;
    /* Never overridden — the laptop/tablet steps scale from this so they can't
       collide with the mobile --pi-faqs-title-size override below. */
    --pi-faqs-title-base: {{ section.settings.title_size }}px;
    --pi-faqs-title-color: {{ section.settings.title_color }};
    --pi-faqs-question-size: {{ section.settings.question_size }}px;
    --pi-faqs-question-color: {{ section.settings.question_color }};
    --pi-faqs-answer-size: {{ section.settings.answer_size }}px;
    --pi-faqs-answer-color: {{ section.settings.answer_color }};
    --pi-faqs-divider-color: {{ section.settings.divider_color }};
    --pi-faqs-icon-color: {{ section.settings.icon_color }};
    --pi-faqs-btn-bg: {{ section.settings.btn_bg }};
    --pi-faqs-btn-text: {{ section.settings.btn_text }};
    --pi-faqs-btn-radius: {{ section.settings.btn_radius }}px;
    --pi-faqs-btn-size: {{ section.settings.btn_size }}px;
    --pi-faqs-btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --pi-faqs-btn-hover-text: {{ section.settings.btn_hover_text }};
    padding: var(--pi-faqs-pad-top) 0 var(--pi-faqs-pad-bottom);
    background: var(--pi-faqs-bg);
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-faqs-pad-top: {{ section.settings.mobile_padding_top }}px;
      --pi-faqs-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pi-faqs-title-size: {{ section.settings.mobile_title_size }}px;
    }
  }
</style>

<style>
  .pi-faqs {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 50px;
  }

  .pi-faqs__title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-faqs-title-size, 54px);
    line-height: 1.3;
    text-align: {{ section.settings.text_alignment }};
    text-transform: uppercase;
    color: var(--pi-faqs-title-color, #000000);
    margin: 0;
  }

  .pi-faqs__body {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .pi-faqs__list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-faqs__item {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-faqs__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .pi-faqs__question {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: var(--pi-faqs-question-size, 20px);
    line-height: 1.3;
    color: var(--pi-faqs-question-color, #000000);
  }

  .pi-faqs__icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 20px;
    color: var(--pi-faqs-icon-color, #000000);
  }

  .pi-faqs__icon svg rect {
    fill: var(--pi-faqs-icon-color, #000000);
  }

  .pi-faqs__icon-minus { display: none; }

  .pi-faqs__item.is-open .pi-faqs__icon-plus  { display: none; }
  .pi-faqs__item.is-open .pi-faqs__icon-minus { display: block; }

  .pi-faqs__answer {
    display: none;
    width: 100%;
  }

  .pi-faqs__item.is-open .pi-faqs__answer {
    display: block;
  }

  .pi-faqs__answer-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: var(--pi-faqs-answer-size, 18px);
    line-height: 1.6;
    color: var(--pi-faqs-answer-color, #121212);
    margin: 0;
  }

  .pi-faqs__divider {
    width: 100%;
    height: 1px;
    background: var(--pi-faqs-divider-color, #000000);
    flex-shrink: 0;
  }

  .pi-faqs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: var(--pi-faqs-btn-size, 16px);
    line-height: 1.3;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--pi-faqs-btn-radius, 8px);
    white-space: nowrap;
    cursor: pointer;
    background: var(--pi-faqs-btn-bg, #000000);
    color: var(--pi-faqs-btn-text, #ffffff);
    border: 1px solid var(--pi-faqs-btn-bg, #000000);
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .pi-faqs__btn:hover {
    background: var(--pi-faqs-btn-hover-bg, #B49146);
    color: var(--pi-faqs-btn-hover-text, #ffffff);
    border-color: var(--pi-faqs-btn-hover-bg, #B49146);
    opacity: 1;
  }

  @media (max-width: 1279px) {
    .pi-faqs__title { font-size: calc(var(--pi-faqs-title-base, 54px) * 0.82); }
  }

  @media (max-width: 989px) {
    .pi-faqs { padding: 0 40px; gap: 40px; }
    .pi-faqs__title { font-size: clamp(28px, 5vw, calc(var(--pi-faqs-title-base, 54px) * 0.89)); line-height: 1.2; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: 0; }
    .pi-faqs { padding: 0 10px; gap: 30px; }
    .pi-faqs__title { font-size: var(--pi-faqs-title-size, 32px); line-height: 1.3; }
    .pi-faqs__question { font-size: 18px; line-height: 23px; }
    .pi-faqs__answer-text { font-size: 14px; line-height: 22px; color: #121212; }
    .pi-faqs__btn { width: 100%; height: 50px; padding: 16px 32px; font-size: 14px; }
  }
</style>

<div class="pi-faqs">

  <h2 class="pi-faqs__title">{{ section.settings.title }}</h2>

  <div class="pi-faqs__body">

    {%- if section.blocks.size > 0 -%}
    <div class="pi-faqs__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
        <div class="pi-faqs__item" {{ block.shopify_attributes }}>

          <button class="pi-faqs__trigger" type="button" aria-expanded="false">
            <span class="pi-faqs__question">{{ block.settings.question }}</span>
            <span class="pi-faqs__icon" aria-hidden="true">
              <svg class="pi-faqs__icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="5" y="0" width="2" height="12" fill="currentColor"/>
                <rect x="0" y="5" width="12" height="2" fill="currentColor"/>
              </svg>
              <svg class="pi-faqs__icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="12" height="2" fill="currentColor"/>
              </svg>
            </span>
          </button>

          {%- if block.settings.answer != blank -%}
            <div class="pi-faqs__answer">
              <p class="pi-faqs__answer-text">{{ block.settings.answer }}</p>
            </div>
          {%- endif -%}

          <div class="pi-faqs__divider"></div>

        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="pi-faqs__btn"
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}

  </div>

</div>

<script>
  (function () {
    document.querySelectorAll('#shopify-section-{{ section.id }} .pi-faqs__trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var item = this.closest('.pi-faqs__item');
        var isOpen = item.classList.toggle('is-open');
        this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();
</script>

