        { "type": "service_card", "settings": { "title": "Geometric Tattoos", "description": "Precise lines and symmetrical patterns that turn mathematical elegance into striking body art." } },
        { "type": "service_card", "settings": { "title": "Script & Lettering Tattoos", "description": "Personalized quotes, meaningful names, and calligraphy in custom fonts that tell your story." } },
        { "type": "service_card", "settings": { "title": "Dotwork & Mandala Tattoos", "description": "Intricate stippling and radial patterns creating mesmerizing, symmetrical works of art." } },
        { "type": "service_card", "settings": { "title": "Tribal & Polynesian Tattoos", "description": "Bold tribal patterns with deep cultural roots, symbolizing strength, heritage and identity." } },
        { "type": "service_card", "settings": { "title": "Maori Tattoos", "description": "Dark, swirling patterns steeped in Maori heritage, honoring tradition through storytelling in ink." } }
      ]
