        { "type": "service_card", "settings": { "title": "Minimalist Tattoos", "description": "Clean and simple designs that speak volumes through subtlety, perfect for understated body art." } },
        { "type": "service_card", "settings": { "title": "Traditional Tattoos", "description": "Bold outlines and vibrant colors inspired by classic tattoo artistry that never goes out of style." } },
