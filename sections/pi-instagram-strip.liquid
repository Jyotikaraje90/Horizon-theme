<style>
  #shopify-section-{{ section.id }} {
    padding-top: 100px;
  }
  .pi-ig-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    width: 100%;
    height: 311px;
    overflow: hidden;
  }
  .pi-ig-strip__cell {
    overflow: hidden;
    position: relative;
    background: #111;
    cursor: pointer;
  }
  .pi-ig-strip__cell img,
  .pi-ig-strip__cell .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .pi-ig-strip__cell:hover img,
  .pi-ig-strip__cell:hover .placeholder-svg {
    transform: scale(1.05);
  }
  .pi-ig-strip__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pi-ig-strip__cell:hover .pi-ig-strip__overlay {
    opacity: 1;
  }
  .pi-ig-strip__overlay svg {
    width: 40px;
    height: 40px;
  }

  @media (max-width: 749px) {
    .pi-ig-strip {
      grid-template-columns: repeat(3, 1fr);
      height: auto;
    }
    .pi-ig-strip__cell {
      aspect-ratio: 1 / 1;
    }
  }
  @media (max-width: 479px) {
    .pi-ig-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<div class="pi-ig-strip">
  {%- for i in (1..6) -%}
    {%- assign img_key = 'image_' | append: i -%}
    {%- assign img = section.settings[img_key] -%}
    <div class="pi-ig-strip__cell">
      {%- if img != blank -%}
        <img
          src="{{ img | image_url: width: 640 }}"
          alt="{{ img.alt | escape }}"
          width="320"
          height="311"
          loading="lazy"
        >
      {%- else -%}
        {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <div class="pi-ig-strip__overlay">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" fill="white"/>
        </svg>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "PI Instagram Strip",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Instagram Images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" }
  ],
  "presets": [
    {
      "name": "PI Instagram Strip"
    }
  ]
}
{% endschema %}
