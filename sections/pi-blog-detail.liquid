<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .pi-bd {
    max-width: 1500px;
    margin: 0 auto;
  }

  /* ── Back link ───────────────────────────────────── */
  /* Sits above the two-column row: in Figma the search box aligns with the top
     of the hero image, not with this link. */
  .pi-bd__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    text-decoration: none;
  }

  .pi-bd__back-icon {
    width: 7.81px;
    height: 12.61px;
    flex-shrink: 0;
    color: #000000;
  }

  .pi-bd__back-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #000000;
  }

  .pi-bd__back:hover .pi-bd__back-text {
    color: {{ section.settings.accent_color }};
  }

  /* ── Two-column row ──────────────────────────────── */
  /* 1063 + 30 + 407 = 1500. The sidebar keeps its fixed width and the article
     column takes the remainder, so the pair still fills narrower viewports. */
  .pi-bd__row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 30px;
  }

  .pi-bd__main {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* The blog PNGs carry a 19px rounded corner baked into their alpha channel.
     At 487px wide displayed across 1063px that corner renders ~41px — twice
     the intended radius — and layering a CSS radius on top cut a second corner
     just inside it. So the image is overflowed past this frame (below) to clip
     the baked corners away entirely, and the rounding is re-applied here at a
     controlled size. One corner, right radius, at any display width. */
  .pi-bd__hero-wrap {
    width: 100%;
    aspect-ratio: 1063 / 786;
    overflow: hidden;
    background: #e0e0e0;
    border-radius: 20px;
  }

  .pi-bd__hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* 19/487 = 3.9% per side; scaling 9% crops 4.5% each side, clearing it. */
    transform: scale(1.09);
  }

  /* ── Article header ──────────────────────────────── */
  .pi-bd__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* 1063 × 31 row, space-between: category badge left, share control right. */
  .pi-bd__meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .pi-bd__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 10px;
    border-radius: 4px;
    background: #CCCCCC;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 21px;
    color: #000000;
  }

  /* 80.03px hug = 52 label + 10 gap + 18.03 icon. */
  .pi-bd__share {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    color: #808080;
  }

  .pi-bd__share:hover {
    color: {{ section.settings.accent_color }};
  }

  .pi-bd__share-icon {
    width: 18.03px;
    height: 20px;
    flex-shrink: 0;
  }

  .pi-bd__title {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-weight: 600;
    font-size: 44px;
    line-height: 57px;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
  }

  /* ── Article body ────────────────────────────────── */
  /* Blocks sit 20px apart. Paragraph-to-paragraph inside a block is already
     29px, so a wider gap here reads as a hole rather than a division. */
  .pi-bd__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-bd__group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-bd__h {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
    margin: 0;
  }

  .pi-bd__p {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #121212;
    margin: 0;
  }

  /* Spacing lives between siblings, so the paragraph-before-a-list case can be
     tighter than paragraph-to-paragraph without trailing margins at the edges. */
  .pi-bd__p > * { margin: 0; }
  .pi-bd__p > * + * { margin-top: 29px; }
  /* Figma runs the list 39px below the last line of copy against a 29px line
     height, so the paragraph's own 29px margin already covers it — no extra
     margin on top. Items sit exactly one line apart, with no gap between. */
  .pi-bd__p ul,
  .pi-bd__p ol { padding-left: 22px; }
  /* A list belongs to the copy above it, so it sits 10px below rather than a
     full paragraph's 29px. */
  .pi-bd__p > * + ul,
  .pi-bd__p > * + ol { margin-top: 10px; }
  .pi-bd__p li { margin-bottom: 0; }

  /* Smaller marker, still in the body text colour. */
  .pi-bd__p li::marker {
    font-size: 0.55em;
  }
  .pi-bd__p a { color: inherit; }

  /* Image beside text, 20px gap. The image keeps its natural ratio at the
     chosen width and the copy takes the remainder of the 1063px column. */
  .pi-bd__split {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
  }

  .pi-bd__split--right { flex-direction: row-reverse; }

  /* Same treatment as the hero: the blog PNGs carry a 19px corner in their
     alpha channel, which reads far rounder than the Figma crop. Overflow the
     image past this frame to clip the baked corner off, then re-cut it here at
     the size the design asks for. */
  /* The Figma width is an upper bound, not a fixed size: capped at 45% of the
     row so the copy beside it always keeps the majority of the column, however
     narrow the viewport gets. */
  .pi-bd__split-media {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 45%;
    overflow: hidden;
    border-radius: 8px;
    line-height: 0;
  }

  .pi-bd__split-media img {
    display: block;
    width: 100%;
    height: auto;
    /* 19/487 = 3.9% per side; scaling 9% crops 4.5% each side, clearing it. */
    transform: scale(1.09);
  }

  .pi-bd__split-text {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Callout panel: 10px radius, 30px padding, 20px gap, #F0F0F0. */
  .pi-bd__quote {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
    padding: 30px;
    border-radius: 10px;
    background: {{ section.settings.panel_bg }};
  }

  /* Vertical rule down the left of the pull quote, sized to the copy. */
  .pi-bd__quote-bar {
    flex: 0 0 4px;
    align-self: stretch;
    background: #121212;
    border-radius: 2px;
  }

  /* Figma sets this panel two lines tall (112px = 30 + 26 + 26 + 30). The live
     font runs narrower than the Proxima Nova the design uses, so the sentence
     would otherwise fit on one line; the cap holds the intended break. */
  .pi-bd__quote-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 26px;
    color: #121212;
    margin: 0;
    max-width: 900px;
  }

  .pi-bd__quote-text > p { margin: 0 0 26px; }
  .pi-bd__quote-text > p:last-child { margin-bottom: 0; }

  /* ── Previous / Next ─────────────────────────────── */
  .pi-bd__nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .pi-bd__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    color: #000000;
  }

  .pi-bd__nav-link--prev { color: #808080; }

  .pi-bd__nav-link:hover { color: {{ section.settings.accent_color }}; }

  .pi-bd__nav-icon {
    width: 7.81px;
    height: 12.61px;
    flex-shrink: 0;
  }

  .pi-bd__sidebar {
    flex: 0 1 407px;
    min-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Search ──────────────────────────────────────── */
  .pi-bd__search {
    position: relative;
  }

  .pi-bd__search-input {
    box-sizing: border-box;
    width: 100%;
    height: 59px;
    padding: 0 52px 0 20px;
    background: #ffffff;
    /* 1px #808080 on all sides, softly rounded corners as in Figma. */
    border: 1px solid #808080;
    border-radius: 8px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: #000000;
    outline: none;
  }

  .pi-bd__search-input::placeholder {
    color: #000000;
    opacity: 0.55;
  }

  .pi-bd__search-input:focus {
    border-color: {{ section.settings.accent_color }};
  }

  /* 22px icon with its right edge 20px in from the panel edge, matching the
     20px text inset on the left. */
  .pi-bd__search-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    color: #808080;
    pointer-events: none;
  }

  /* ── Read Next ───────────────────────────────────── */
  /* 20px padding on all sides and a 20px internal gap reproduce the 432px
     panel height: 20 + 44 + 20 + (96 × 3) + (20 × 2) + 20. */
  .pi-bd__next {
    background: {{ section.settings.panel_bg }};
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-bd__next-heading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 34px;
    line-height: 44px;
    color: #000000;
    margin: 0;
  }

  .pi-bd__next-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  .pi-bd__next-thumb {
    flex: 0 0 130px;
    width: 130px;
    height: 96px;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 8px;
    background: #e0e0e0;
  }

  .pi-bd__next-title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    color: #000000;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-bd__next-item:hover .pi-bd__next-title {
    color: {{ section.settings.accent_color }};
  }

  /* ── Responsive ──────────────────────────────────── */
  /* The row needs 1063 + 30 + 407 plus padding — about 1580px — to hold its
     Figma proportions. Below 1200 the article column is squeezed harder than
     the copy can take, so the sidebar drops underneath instead. */
  @media (max-width: 1199px) {
    #shopify-section-{{ section.id }} {
      padding-left: 30px;
      padding-right: 30px;
    }

    .pi-bd__row {
      flex-direction: column;
    }

    .pi-bd__sidebar {
      flex: none;
      width: 100%;
      min-width: 0;
    }

    .pi-bd__next-heading {
      font-size: 28px;
      line-height: 36px;
    }

    .pi-bd__title {
      font-size: 36px;
      line-height: 46px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
    }

    .pi-bd__row { gap: 24px; }
    .pi-bd__main { gap: 20px; }
    .pi-bd__hero-wrap { border-radius: 12px; }
    .pi-bd__search-input { height: 53px; }

    .pi-bd__title {
      font-size: 28px;
      line-height: 38px;
    }

    .pi-bd__body { gap: 18px; }
    .pi-bd__group { gap: 14px; }

    .pi-bd__h { font-size: 18px; line-height: 24px; }

    .pi-bd__p {
      font-size: 16px;
      line-height: 26px;
    }

    .pi-bd__p > * + * { margin-top: 26px; }
    .pi-bd__p > * + ul,
    .pi-bd__p > * + ol { margin-top: 8px; }

    /* The image goes full width rather than holding its Figma width in a column
       that no longer has room for it. It keeps its side: an image set to the
       left of the copy stacks above it, one set to the right stacks below. */
    .pi-bd__split {
      flex-direction: column;
      gap: 14px;
    }

    .pi-bd__split--right { flex-direction: column-reverse; }

    .pi-bd__split-media { width: 100% !important; max-width: 100%; }
    .pi-bd__split-text { gap: 14px; }

    .pi-bd__quote { padding: 20px; gap: 14px; }
    .pi-bd__quote-text { font-size: 16px; line-height: 24px; }

    .pi-bd__nav-link { font-size: 14px; }

    .pi-bd__next-heading {
      font-size: 24px;
      line-height: 32px;
    }

    .pi-bd__next-thumb {
      flex: 0 0 104px;
      width: 104px;
      height: 77px;
    }

    .pi-bd__next-title {
      font-size: 15px;
      line-height: 23px;
    }
  }
</style>

{%- comment -%}
  Data source. On templates/article.json the `article` object drives everything
  and each post gets its own page for free. The section settings stay as
  fallbacks so the older page-based post still renders while content moves over.

  Per-article layout comes from the `custom.body_sections` metafield: an ordered
  list of `blog_body_section` metaobjects, each one a group / split / quote —
  the same three shapes this section's blocks used to provide.
{%- endcomment -%}
{%- assign bd_is_article = false -%}
{%- if article != blank and article.title != blank -%}
  {%- assign bd_is_article = true -%}
{%- endif -%}

{%- if bd_is_article -%}
  {%- assign bd_hero        = article.image -%}
  {%- assign bd_title       = article.title -%}
  {%- comment -%}
    This slot renders the post date in the design (the legacy page had
    "Feb 28, 2025" in category_label), so an article fills it from published_at.
    Set "Meta shows" to Tag to use the article's first tag instead.
  {%- endcomment -%}
  {%- if section.settings.article_meta == 'tag' -%}
    {%- assign bd_tag = article.tags.first -%}
  {%- else -%}
    {%- assign bd_tag = article.published_at | date: section.settings.date_format | default: '%b %d, %Y' -%}
  {%- endif -%}
  {%- assign bd_sections    = article.metafields.custom.body_sections.value -%}
  {%- comment -%}
    Shopify names these by position in the blog's newest-first order, not by
    reading order: `next_article` is the NEWER post and `previous_article` is the
    OLDER one. The design reads the other way — Next carries you onward through
    the archive — so they are crossed over here. Without this the newest post
    shows only a Previous arrow and no Next at all.
  {%- endcomment -%}
  {%- assign bd_prev        = blog.next_article -%}
  {%- assign bd_next        = blog.previous_article -%}
  {%- assign bd_back_link   = blog.url | default: section.settings.back_link -%}
  {%- assign bd_search_action = blog.url | default: section.settings.search_action -%}
{%- else -%}
  {%- assign bd_hero        = section.settings.hero_image -%}
  {%- assign bd_title       = section.settings.article_title -%}
  {%- assign bd_tag         = section.settings.category_label -%}
  {%- assign bd_back_link   = section.settings.back_link -%}
  {%- assign bd_search_action = section.settings.search_action -%}
{%- endif -%}

<div class="pi-bd">

  <a href="{{ bd_back_link | default: '/pages/blogs' }}" class="pi-bd__back">
    <svg class="pi-bd__back-icon" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M7 1L1 6.5L7 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="pi-bd__back-text">{{ section.settings.back_label | default: 'Back To Blogs' }}</span>
  </a>

  <div class="pi-bd__row">

    <div class="pi-bd__main">
      <div class="pi-bd__hero-wrap">
        {%- if bd_hero != blank -%}
          <img
            src="{{ bd_hero | image_url: width: 1400 }}"
            alt="{{ bd_hero.alt | default: bd_title | escape }}"
            class="pi-bd__hero"
            width="1063"
            height="786"
          >
        {%- endif -%}
      </div>

      <div class="pi-bd__head">
        {%- if bd_tag != blank or section.settings.show_share -%}
          <div class="pi-bd__meta">
            {%- if bd_tag != blank -%}
              <span class="pi-bd__tag">{{ bd_tag }}</span>
            {%- else -%}
              <span></span>
            {%- endif -%}

            {%- if section.settings.show_share -%}
              <button type="button" class="pi-bd__share" data-pi-bd-share>
                <svg class="pi-bd__share-icon" viewBox="0 0 18 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M5.1 8.9L12.9 4.6M5.1 11.1L12.9 15.4" stroke="currentColor" stroke-width="1"/>
                  <circle cx="3" cy="10" r="2.4" fill="currentColor"/>
                  <circle cx="15" cy="3.6" r="2.4" fill="currentColor"/>
                  <circle cx="15" cy="16.4" r="2.4" fill="currentColor"/>
                </svg>
                <span class="pi-bd__share-text">{{ section.settings.share_label | default: 'Share' }}</span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if bd_title != blank -%}
          <h1 class="pi-bd__title">{{ bd_title }}</h1>
        {%- endif -%}
      </div>

      <div class="pi-bd__body">
        {%- if bd_sections != blank and bd_sections.size > 0 -%}

          {%- comment -%}
            Same three shapes as the old blocks, driven per article. Rich text
            goes through metafield_tag so Shopify renders its own markup rather
            than us re-implementing it.
          {%- endcomment -%}
          {%- for bd_part in bd_sections -%}
            {%- assign bd_layout = bd_part.layout.value | default: 'group' -%}

            {%- if bd_layout == 'quote' -%}
              <div class="pi-bd__quote">
                <span class="pi-bd__quote-bar"></span>
                <div class="pi-bd__quote-text">{{ bd_part.quote.value }}</div>
              </div>

            {%- elsif bd_layout == 'split' -%}
              <div class="pi-bd__split{% if bd_part.image_position.value == 'right' %} pi-bd__split--right{% endif %}">
                {%- if bd_part.image.value != blank -%}
                  <div class="pi-bd__split-media">
                    <img
                      src="{{ bd_part.image.value | image_url: width: 1000 }}"
                      alt="{{ bd_part.image.value.alt | default: bd_part.heading.value | escape }}"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}
                <div class="pi-bd__split-text">
                  {%- if bd_part.heading.value != blank -%}
                    <h2 class="pi-bd__h">{{ bd_part.heading.value }}</h2>
                  {%- endif -%}
                  {%- if bd_part.body != blank -%}
                    <div class="pi-bd__p">{{ bd_part.body | metafield_tag }}</div>
                  {%- endif -%}
                </div>
              </div>

            {%- else -%}
              <div class="pi-bd__group">
                {%- if bd_part.heading.value != blank -%}
                  <h2 class="pi-bd__h">{{ bd_part.heading.value }}</h2>
                {%- endif -%}
                {%- if bd_part.body != blank -%}
                  <div class="pi-bd__p">{{ bd_part.body | metafield_tag }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

        {%- elsif bd_is_article and article.content != blank -%}
          {%- comment -%}
            No body_sections filled in yet — fall back to the article's own rich
            text so a post is never blank just because the metafield is empty.
          {%- endcomment -%}
          <div class="pi-bd__group">
            <div class="pi-bd__p">{{ article.content }}</div>
          </div>

        {%- else -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'body_group' -%}
              <div class="pi-bd__group" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="pi-bd__h">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="pi-bd__p">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

            {%- when 'body_split' -%}
              <div
                class="pi-bd__split{% if block.settings.image_position == 'right' %} pi-bd__split--right{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  <div class="pi-bd__split-media" style="width: {{ block.settings.image_width }}px;">
                    <img
                      src="{{ block.settings.image | image_url: width: 1000 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </div>
                {%- endif -%}

                <div class="pi-bd__split-text">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="pi-bd__h">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="pi-bd__p">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'body_quote' -%}
              <div class="pi-bd__quote" {{ block.shopify_attributes }}>
                <span class="pi-bd__quote-bar"></span>
                <div class="pi-bd__quote-text">{{ block.settings.text }}</div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if bd_is_article -%}
        {%- assign bd_prev_url = bd_prev.url -%}
        {%- assign bd_next_url = bd_next.url -%}
        {%- comment -%}
          The design labels these Previous / Next rather than spelling out the
          neighbouring post, so the titles only ride along as the accessible name.
        {%- endcomment -%}
        {%- assign bd_prev_text = section.settings.prev_label -%}
        {%- assign bd_next_text = section.settings.next_label -%}
        {%- assign bd_prev_label = bd_prev.title -%}
        {%- assign bd_next_label = bd_next.title -%}
      {%- else -%}
        {%- assign bd_prev_url = section.settings.prev_link -%}
        {%- assign bd_next_url = section.settings.next_link -%}
        {%- assign bd_prev_text = section.settings.prev_label -%}
        {%- assign bd_next_text = section.settings.next_label -%}
      {%- endif -%}

      {%- comment -%}
        On an article the arrows are hidden when there is no neighbour, rather
        than linking to '#'.
      {%- endcomment -%}
      {%- if section.settings.show_nav -%}
        <div class="pi-bd__nav">
          {%- if bd_prev_url != blank or bd_is_article == false -%}
          <a href="{{ bd_prev_url | default: '#' }}" class="pi-bd__nav-link pi-bd__nav-link--prev"{% if bd_prev_label != blank %} aria-label="{{ bd_prev_label | escape }}"{% endif %}>
            <svg class="pi-bd__nav-icon" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7 1L1 6.5L7 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ bd_prev_text | default: 'Previous' }}</span>
          </a>
          {%- else -%}<span></span>{%- endif -%}

          {%- if bd_next_url != blank or bd_is_article == false -%}
          <a href="{{ bd_next_url | default: '#' }}" class="pi-bd__nav-link pi-bd__nav-link--next"{% if bd_next_label != blank %} aria-label="{{ bd_next_label | escape }}"{% endif %}>
            <span>{{ bd_next_text | default: 'Next' }}</span>
            <svg class="pi-bd__nav-icon" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L7 6.5L1 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          {%- else -%}<span></span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <aside class="pi-bd__sidebar">

      {%- if section.settings.show_search -%}
        {%- comment -%}
          Searches the blog listing, not the storefront. Shopify search would
          return jewelry products, and scoping it to articles would return
          nothing at all — the blog posts are Pages on the blog-detail
          template, not blog articles.
        {%- endcomment -%}
        <form
          action="{{ bd_search_action | default: '/pages/blogs' }}"
          method="get"
          role="search"
          class="pi-bd__search"
        >
          <input
            type="search"
            name="q"
            class="pi-bd__search-input"
            placeholder="{{ section.settings.search_placeholder | default: 'Search' | escape }}"
            aria-label="{{ section.settings.search_placeholder | default: 'Search' | escape }}"
          >
          <svg class="pi-bd__search-icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="9.5" cy="9.5" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M15 15L20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </form>
      {%- endif -%}

      {%- comment -%}
        Read Next builds itself from the blog on an article. It starts at the post
        being read and walks forward through the blog, wrapping back to the top
        once it runs off the end, so each post recommends a different set. Taking
        the first N of blog.articles instead would surface the same three newest
        posts on all nine pages.

        Two passes because Liquid can't slice-and-rotate an array: the first picks
        up everything after the current post, the second wraps round to the start.
        The next_post blocks remain for the legacy page.
      {%- endcomment -%}
      {%- assign next_blocks = section.blocks | where: 'type', 'next_post' -%}
      {%- if bd_is_article -%}
        {%- liquid
          assign bd_limit = section.settings.next_count | default: 3
          assign bd_index = 0
          assign bd_i = 0

          for bd_other in blog.articles
            if bd_other.id == article.id
              assign bd_index = bd_i
            endif
            assign bd_i = bd_i | plus: 1
          endfor
        -%}
        <div class="pi-bd__next">
          <h2 class="pi-bd__next-heading">{{ section.settings.next_heading | default: 'Read Next' }}</h2>
          {%- assign bd_shown = 0 -%}

          {%- assign bd_i = 0 -%}
          {%- for bd_other in blog.articles -%}
            {%- if bd_i > bd_index and bd_shown < bd_limit -%}
              {%- assign bd_shown = bd_shown | plus: 1 -%}
              {% render 'pi-blog-next-item', article_item: bd_other %}
            {%- endif -%}
            {%- assign bd_i = bd_i | plus: 1 -%}
          {%- endfor -%}

          {%- assign bd_i = 0 -%}
          {%- for bd_other in blog.articles -%}
            {%- if bd_i < bd_index and bd_shown < bd_limit -%}
              {%- assign bd_shown = bd_shown | plus: 1 -%}
              {% render 'pi-blog-next-item', article_item: bd_other %}
            {%- endif -%}
            {%- assign bd_i = bd_i | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- elsif next_blocks.size > 0 -%}
        <div class="pi-bd__next">
          <h2 class="pi-bd__next-heading">{{ section.settings.next_heading | default: 'Read Next' }}</h2>

          {%- for block in next_blocks -%}
            <a
              href="{{ block.settings.post_link | default: '#' }}"
              class="pi-bd__next-item"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.post_image != blank -%}
                <img
                  src="{{ block.settings.post_image | image_url: width: 300 }}"
                  alt="{{ block.settings.post_title | escape }}"
                  class="pi-bd__next-thumb"
                  loading="lazy"
                  width="130"
                  height="96"
                >
              {%- else -%}
                <span class="pi-bd__next-thumb"></span>
              {%- endif -%}
              <h3 class="pi-bd__next-title">{{ block.settings.post_title | default: 'Blog post title' }}</h3>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </aside>

  </div>
</div>

<script>
  document.querySelectorAll('[data-pi-bd-share]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function () {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url);
      }
    });
  });
</script>

