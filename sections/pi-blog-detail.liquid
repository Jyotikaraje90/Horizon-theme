<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .pi-bd {
    max-width: 1500px;
    margin: 0 auto;
  }

  /* ── Back link ───────────────────────────────────── */
  /* Sits above the two-column row: in Figma the search box aligns with the top
     of the hero image, not with this link. */
  .pi-bd__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    text-decoration: none;
  }

  .pi-bd__back-icon {
    width: 7.81px;
    height: 12.61px;
    flex-shrink: 0;
    color: #000000;
  }

  .pi-bd__back-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #000000;
  }

  .pi-bd__back:hover .pi-bd__back-text {
    color: {{ section.settings.accent_color }};
  }

  /* ── Two-column row ──────────────────────────────── */
  /* 1063 + 30 + 407 = 1500. The sidebar keeps its fixed width and the article
     column takes the remainder, so the pair still fills narrower viewports. */
  .pi-bd__row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 30px;
  }

  .pi-bd__main {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* The blog PNGs carry a 19px rounded corner baked into their alpha channel.
     At 487px wide displayed across 1063px that corner renders ~41px — twice
     the intended radius — and layering a CSS radius on top cut a second corner
     just inside it. So the image is overflowed past this frame (below) to clip
     the baked corners away entirely, and the rounding is re-applied here at a
     controlled size. One corner, right radius, at any display width. */
  .pi-bd__hero-wrap {
    width: 100%;
    aspect-ratio: 1063 / 786;
    overflow: hidden;
    background: #e0e0e0;
    border-radius: 20px;
  }

  .pi-bd__hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* 19/487 = 3.9% per side; scaling 9% crops 4.5% each side, clearing it. */
    transform: scale(1.09);
  }

  /* ── Article header ──────────────────────────────── */
  .pi-bd__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* 1063 × 31 row, space-between: category badge left, share control right. */
  .pi-bd__meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .pi-bd__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 10px;
    border-radius: 4px;
    background: #CCCCCC;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 21px;
    color: #000000;
  }

  /* 80.03px hug = 52 label + 10 gap + 18.03 icon. */
  .pi-bd__share {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    color: #808080;
  }

  .pi-bd__share:hover {
    color: {{ section.settings.accent_color }};
  }

  .pi-bd__share-icon {
    width: 18.03px;
    height: 20px;
    flex-shrink: 0;
  }

  .pi-bd__title {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-weight: 600;
    font-size: 44px;
    line-height: 57px;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
  }

  /* ── Article body ────────────────────────────────── */
  /* Blocks sit 20px apart. Paragraph-to-paragraph inside a block is already
     29px, so a wider gap here reads as a hole rather than a division. */
  .pi-bd__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-bd__group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-bd__h {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
    margin: 0;
  }

  .pi-bd__p {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #121212;
    margin: 0;
  }

  /* Spacing lives between siblings, so the paragraph-before-a-list case can be
     tighter than paragraph-to-paragraph without trailing margins at the edges. */
  .pi-bd__p > * { margin: 0; }
  .pi-bd__p > * + * { margin-top: 29px; }
  /* Figma runs the list 39px below the last line of copy against a 29px line
     height, so the paragraph's own 29px margin already covers it — no extra
     margin on top. Items sit exactly one line apart, with no gap between. */
  .pi-bd__p ul,
  .pi-bd__p ol { padding-left: 22px; }
  /* A list belongs to the copy above it, so it sits 10px below rather than a
     full paragraph's 29px. */
  .pi-bd__p > * + ul,
  .pi-bd__p > * + ol { margin-top: 10px; }
  .pi-bd__p li { margin-bottom: 0; }

  /* Smaller marker, still in the body text colour. */
  .pi-bd__p li::marker {
    font-size: 0.55em;
  }
  .pi-bd__p a { color: inherit; }

  /* Image beside text, 20px gap. The image keeps its natural ratio at the
     chosen width and the copy takes the remainder of the 1063px column. */
  .pi-bd__split {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
  }

  .pi-bd__split--right { flex-direction: row-reverse; }

  /* Same treatment as the hero: the blog PNGs carry a 19px corner in their
     alpha channel, which reads far rounder than the Figma crop. Overflow the
     image past this frame to clip the baked corner off, then re-cut it here at
     the size the design asks for. */
  .pi-bd__split-media {
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 8px;
    line-height: 0;
  }

  .pi-bd__split-media img {
    display: block;
    width: 100%;
    height: auto;
    /* 19/487 = 3.9% per side; scaling 9% crops 4.5% each side, clearing it. */
    transform: scale(1.09);
  }

  .pi-bd__split-text {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Callout panel: 10px radius, 30px padding, 20px gap, #F0F0F0. */
  .pi-bd__quote {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
    padding: 30px;
    border-radius: 10px;
    background: {{ section.settings.panel_bg }};
  }

  /* Vertical rule down the left of the pull quote, sized to the copy. */
  .pi-bd__quote-bar {
    flex: 0 0 4px;
    align-self: stretch;
    background: #121212;
    border-radius: 2px;
  }

  .pi-bd__quote-text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 26px;
    color: #121212;
    margin: 0;
  }

  .pi-bd__quote-text > p { margin: 0 0 26px; }
  .pi-bd__quote-text > p:last-child { margin-bottom: 0; }

  /* ── Previous / Next ─────────────────────────────── */
  .pi-bd__nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .pi-bd__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    color: #000000;
  }

  .pi-bd__nav-link--prev { color: #808080; }

  .pi-bd__nav-link:hover { color: {{ section.settings.accent_color }}; }

  .pi-bd__nav-icon {
    width: 7.81px;
    height: 12.61px;
    flex-shrink: 0;
  }

  .pi-bd__sidebar {
    flex: 0 0 407px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Search ──────────────────────────────────────── */
  .pi-bd__search {
    position: relative;
  }

  .pi-bd__search-input {
    box-sizing: border-box;
    width: 100%;
    height: 59px;
    padding: 0 52px 0 20px;
    background: #ffffff;
    /* 1px #808080 on all sides, softly rounded corners as in Figma. */
    border: 1px solid #808080;
    border-radius: 8px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: #000000;
    outline: none;
  }

  .pi-bd__search-input::placeholder {
    color: #000000;
    opacity: 0.55;
  }

  .pi-bd__search-input:focus {
    border-color: {{ section.settings.accent_color }};
  }

  /* 22px icon with its right edge 20px in from the panel edge, matching the
     20px text inset on the left. */
  .pi-bd__search-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    color: #808080;
    pointer-events: none;
  }

  /* ── Read Next ───────────────────────────────────── */
  /* 20px padding on all sides and a 20px internal gap reproduce the 432px
     panel height: 20 + 44 + 20 + (96 × 3) + (20 × 2) + 20. */
  .pi-bd__next {
    background: {{ section.settings.panel_bg }};
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-bd__next-heading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 34px;
    line-height: 44px;
    color: #000000;
    margin: 0;
  }

  .pi-bd__next-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  .pi-bd__next-thumb {
    flex: 0 0 130px;
    width: 130px;
    height: 96px;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 8px;
    background: #e0e0e0;
  }

  .pi-bd__next-title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    color: #000000;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-bd__next-item:hover .pi-bd__next-title {
    color: {{ section.settings.accent_color }};
  }

  /* ── Responsive ──────────────────────────────────── */
  /* Below the point where 1063 + 30 + 407 still fits comfortably, the sidebar
     drops under the article rather than squeezing the hero image. */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      padding-left: 30px;
      padding-right: 30px;
    }

    .pi-bd__row {
      flex-direction: column;
    }

    .pi-bd__sidebar {
      flex: none;
      width: 100%;
    }

    .pi-bd__next-heading {
      font-size: 28px;
      line-height: 36px;
    }

    .pi-bd__title {
      font-size: 36px;
      line-height: 46px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
    }

    .pi-bd__row { gap: 24px; }
    .pi-bd__main { gap: 20px; }
    .pi-bd__hero-wrap { border-radius: 12px; }
    .pi-bd__search-input { height: 53px; }

    .pi-bd__title {
      font-size: 28px;
      line-height: 38px;
    }

    .pi-bd__body { gap: 18px; }
    .pi-bd__group { gap: 14px; }

    .pi-bd__h { font-size: 18px; line-height: 24px; }

    .pi-bd__p {
      font-size: 16px;
      line-height: 26px;
    }

    .pi-bd__p > * + * { margin-top: 26px; }
    .pi-bd__p > * + ul,
    .pi-bd__p > * + ol { margin-top: 8px; }

    /* The image goes full width above the copy rather than holding its
       Figma width in a column that no longer has room for it. */
    .pi-bd__split,
    .pi-bd__split--right {
      flex-direction: column;
      gap: 14px;
    }

    .pi-bd__split-media { width: 100% !important; }
    .pi-bd__split-text { gap: 14px; }

    .pi-bd__quote { padding: 20px; gap: 14px; }
    .pi-bd__quote-text { font-size: 16px; line-height: 24px; }

    .pi-bd__nav-link { font-size: 14px; }

    .pi-bd__next-heading {
      font-size: 24px;
      line-height: 32px;
    }

    .pi-bd__next-thumb {
      flex: 0 0 104px;
      width: 104px;
      height: 77px;
    }

    .pi-bd__next-title {
      font-size: 15px;
      line-height: 23px;
    }
  }
</style>

<div class="pi-bd">

  <a href="{{ section.settings.back_link | default: '/pages/blogs' }}" class="pi-bd__back">
    <svg class="pi-bd__back-icon" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M7 1L1 6.5L7 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="pi-bd__back-text">{{ section.settings.back_label | default: 'Back To Blogs' }}</span>
  </a>

  <div class="pi-bd__row">

    <div class="pi-bd__main">
      <div class="pi-bd__hero-wrap">
        {%- if section.settings.hero_image != blank -%}
          <img
            src="{{ section.settings.hero_image | image_url: width: 1400 }}"
            alt="{{ section.settings.hero_image.alt | escape }}"
            class="pi-bd__hero"
            width="1063"
            height="786"
          >
        {%- endif -%}
      </div>

      <div class="pi-bd__head">
        {%- if section.settings.category_label != blank or section.settings.show_share -%}
          <div class="pi-bd__meta">
            {%- if section.settings.category_label != blank -%}
              <span class="pi-bd__tag">{{ section.settings.category_label }}</span>
            {%- else -%}
              <span></span>
            {%- endif -%}

            {%- if section.settings.show_share -%}
              <button type="button" class="pi-bd__share" data-pi-bd-share>
                <span class="pi-bd__share-text">{{ section.settings.share_label | default: 'Share' }}</span>
                <svg class="pi-bd__share-icon" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="15" cy="4" r="3" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="4" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="15" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M6.6 8.6L12.4 5.4M6.6 11.4L12.4 14.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.article_title != blank -%}
          <h1 class="pi-bd__title">{{ section.settings.article_title }}</h1>
        {%- endif -%}
      </div>

      <div class="pi-bd__body">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'body_group' -%}
              <div class="pi-bd__group" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="pi-bd__h">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="pi-bd__p">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

            {%- when 'body_split' -%}
              <div
                class="pi-bd__split{% if block.settings.image_position == 'right' %} pi-bd__split--right{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  <div class="pi-bd__split-media" style="width: {{ block.settings.image_width }}px;">
                    <img
                      src="{{ block.settings.image | image_url: width: 1000 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </div>
                {%- endif -%}

                <div class="pi-bd__split-text">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="pi-bd__h">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="pi-bd__p">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'body_quote' -%}
              <div class="pi-bd__quote" {{ block.shopify_attributes }}>
                <span class="pi-bd__quote-bar"></span>
                <div class="pi-bd__quote-text">{{ block.settings.text }}</div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_nav -%}
        <div class="pi-bd__nav">
          <a href="{{ section.settings.prev_link | default: '#' }}" class="pi-bd__nav-link pi-bd__nav-link--prev">
            <svg class="pi-bd__nav-icon" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7 1L1 6.5L7 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ section.settings.prev_label | default: 'Previous' }}</span>
          </a>

          <a href="{{ section.settings.next_link | default: '#' }}" class="pi-bd__nav-link pi-bd__nav-link--next">
            <span>{{ section.settings.next_label | default: 'Next' }}</span>
            <svg class="pi-bd__nav-icon" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L7 6.5L1 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <aside class="pi-bd__sidebar">

      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="pi-bd__search">
          <input
            type="search"
            name="q"
            class="pi-bd__search-input"
            placeholder="{{ section.settings.search_placeholder | default: 'Search' | escape }}"
            aria-label="{{ section.settings.search_placeholder | default: 'Search' | escape }}"
          >
          <svg class="pi-bd__search-icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="9.5" cy="9.5" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M15 15L20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </form>
      {%- endif -%}

      {%- assign next_blocks = section.blocks | where: 'type', 'next_post' -%}
      {%- if next_blocks.size > 0 -%}
        <div class="pi-bd__next">
          <h2 class="pi-bd__next-heading">{{ section.settings.next_heading | default: 'Read Next' }}</h2>

          {%- for block in next_blocks -%}
            <a
              href="{{ block.settings.post_link | default: '#' }}"
              class="pi-bd__next-item"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.post_image != blank -%}
                <img
                  src="{{ block.settings.post_image | image_url: width: 300 }}"
                  alt="{{ block.settings.post_title | escape }}"
                  class="pi-bd__next-thumb"
                  loading="lazy"
                  width="130"
                  height="96"
                >
              {%- else -%}
                <span class="pi-bd__next-thumb"></span>
              {%- endif -%}
              <h3 class="pi-bd__next-title">{{ block.settings.post_title | default: 'Blog post title' }}</h3>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </aside>

  </div>
</div>

<script>
  document.querySelectorAll('[data-pi-bd-share]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function () {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url);
      }
    });
  });
</script>

{% schema %}
{
  "name": "PI Blog Detail",
  "settings": [
    {
      "type": "header",
      "content": "Back Link"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Back To Blogs"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Back link URL"
    },
    {
      "type": "header",
      "content": "Article"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Shown at a 1063 × 786 ratio."
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Badge",
      "info": "Shown above the title — a date or a category."
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share button",
      "default": true
    },
    {
      "type": "text",
      "id": "share_label",
      "label": "Share label",
      "default": "Share"
    },
    {
      "type": "text",
      "id": "article_title",
      "label": "Article title"
    },
    {
      "type": "header",
      "content": "Previous / Next"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show previous / next links",
