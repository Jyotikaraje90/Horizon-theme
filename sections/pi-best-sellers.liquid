<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  /* ── Section wrapper ── */
  .pi-bs {
    background: #ffffff;
  }

  .pi-bs__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: var(--pi-bs-pad-top) 24px var(--pi-bs-pad-bottom);
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  /* ── Header row: heading left, arrows right ── */
  .pi-bs__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 70px;
  }

  .pi-bs__title {
    font-family: 'Nunito Sans', sans-serif;
    font-size: clamp(22px, 2.4vw, 36px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
    line-height: 1;
  }

  /* ── Arrow frame (Frame 48095942): Horizontal, Hug 120×50px, gap 20px ── */
  .pi-bs__arrows {
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
    width: 120px;
    height: 50px;
  }

  /* ── Each arrow: 50×50px circle ── */
  .pi-bs__arrow {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
    padding: 0;
  }

  /* Prev: outline circle, same icon as Next rotated -180° */
  .pi-bs__arrow--prev {
    background: #ffffff;
    border: 1.5px solid #000000;
    color: #000000;
  }

  .pi-bs__arrow--prev:hover { background: #f2f2f2; }

  .pi-bs__arrow--prev svg { transform: rotate(180deg); }

  /* Next: filled black circle */
  .pi-bs__arrow--next {
    background: #000000;
    border: 1.5px solid #000000;
    color: #ffffff;
  }

  .pi-bs__arrow--next:hover { background: #222222; }

  .pi-bs__arrow:disabled { opacity: 0.35; cursor: default; }

  .pi-bs__arrow svg {
    width: 18px;
    height: 18px;
    display: block;
    pointer-events: none;
  }

  /* ── Body: track + explore button ── */
  .pi-bs__body {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 100%;
  }

  /* ── Carousel track ── */
  .pi-bs__track-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .pi-bs__track {
    display: flex;
    flex-direction: row;
    gap: 30px;
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
  }

  /* ── Product card: 360px, Vertical, gap 20px ── */
  .pi-bs__card {
    flex: 0 0 calc((100% - 90px) / 4);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Image frame: 360×360, bg #E6E6E6, radius 20px ── */
  .pi-bs__card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #E6E6E6;
    border-radius: 20px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .pi-bs__card-img-wrap img,
  .pi-bs__card-img-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    display: block;
  }

  /* ── Wishlist icon: 33×30px, top 20px, right 20px ── */
  .pi-bs__wishlist {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 33px;
    height: 30px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.15s ease;
  }

  .pi-bs__wishlist:hover { transform: scale(1.15); }

  .pi-bs__wishlist svg { width: 100%; height: 100%; display: block; }

  .pi-bs__wishlist--active path { fill: #000000; }

  /* ── Description: plain, no border, no frame ── */
  .pi-bs__card-info {
    background: transparent;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 12px 0 0;
  }

  /* ── Product title ── */
  .pi-bs__card-title {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
    color: #000000;
    margin: 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-bs__card-title:hover { text-decoration: underline; }

  /* ── Price ── */
  .pi-bs__card-price {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: #000000;
    margin: 6px 0 10px;
  }

  /* ── Add to Cart: plain underlined text link ── */
  .pi-bs__card-atc form { margin: 0; }

  .pi-bs__card-atc-btn {
    display: inline;
    background: none;
    border: none;
    border-bottom: 1px solid #000000;
    padding: 0;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
    cursor: pointer;
    text-decoration: none;
    line-height: 1.5;
  }

  .pi-bs__card-atc-btn:hover {
    border-bottom-color: #555555;
    color: #555555;
  }

  /* ── Explore button: Figma Btn spec (H 55px, R 8px, P 16/32, bg #000) ── */
  .pi-bs__explore {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .pi-bs__explore-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 20px;
    height: 55px;
    padding: 16px 32px;
    border-radius: 8px;
    background: #000000;
    color: #ffffff;
    border: none;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
  }

  .pi-bs__explore-btn:hover {
    background: #222222;
    color: #ffffff;
    text-decoration: none;
  }

  /* ── Responsive: 2 cards on tablet, 1.5 on mobile ── */
  @media (max-width: 989px) {
    .pi-bs__card {
      flex: 0 0 calc((100% - 30px) / 2);
    }
  }

  @media (max-width: 600px) {
    .pi-bs__card {
      flex: 0 0 75cqw;
    }
    .pi-bs__inner {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>

{%- liquid
  assign collection   = section.settings.collection
  assign max_products = section.settings.max_products
  assign heading      = section.settings.heading      | default: 'Best Sellers'
  assign btn_label    = section.settings.explore_label | default: 'Explore Our Jewelry Collection'
  assign btn_link     = section.settings.explore_link
  if btn_link == blank
    if collection != blank
      assign btn_link = collection.url
    else
      assign btn_link = '/collections/all'
    endif
  endif
-%}

<div
  class="pi-bs"
  style="--pi-bs-pad-top: {{ section.settings.padding_top }}px; --pi-bs-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pi-bs__inner">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="pi-bs__header">
      <h2 class="pi-bs__title">{{ heading }}</h2>
      <div class="pi-bs__arrows">
        {%- comment -%} Prev: same icon as Next, CSS rotates it -180° {%- endcomment -%}
        <button
          class="pi-bs__arrow pi-bs__arrow--prev"
          id="pi-bs-prev-{{ section.id }}"
          aria-label="Previous products"
          type="button"
          disabled
        >
          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6.75 4.5L11.25 9L6.75 13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          class="pi-bs__arrow pi-bs__arrow--next"
          id="pi-bs-next-{{ section.id }}"
          aria-label="Next products"
          type="button"
        >
          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6.75 4.5L11.25 9L6.75 13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    {%- comment -%} ── Body ── {%- endcomment -%}
    <div class="pi-bs__body">

      {%- comment -%} Carousel track {%- endcomment -%}
      <div class="pi-bs__track-wrapper" id="pi-bs-wrapper-{{ section.id }}">
        <div class="pi-bs__track" id="pi-bs-track-{{ section.id }}">

          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: max_products -%}
              <div class="pi-bs__card">

                {%- comment -%} Image frame {%- endcomment -%}
                <a href="{{ product.url }}" class="pi-bs__card-img-wrap" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 720 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="360"
                      height="360"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}

                  {%- comment -%} Wishlist icon — 33×30, top 20, right 20 {%- endcomment -%}
                  <button
                    class="pi-bs__wishlist"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    data-product-id="{{ product.id }}"
                    type="button"
                  >
                    <svg viewBox="0 0 33 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M16.5 26.5C16.5 26.5 2 18 2 9.5C2 6.186 4.686 3.5 8 3.5C10.6 3.5 12.9 5.1 14.3 6.9C15.05 7.9 16.5 7.9 16.5 7.9C16.5 7.9 17.95 7.9 18.7 6.9C20.1 5.1 22.4 3.5 25 3.5C28.314 3.5 31 6.186 31 9.5C31 18 16.5 26.5 16.5 26.5Z"
                        stroke="#000000"
                        stroke-width="1.5"
                        stroke-linejoin="round"
                        fill="transparent"
                        class="pi-bs__wishlist-path"
                      />
                    </svg>
                  </button>
                </a>

                {%- comment -%} Description frame (Frame 2123): dashed l/r/b border, radius br/bl 10px {%- endcomment -%}
                <div class="pi-bs__card-info">
                  <a href="{{ product.url }}" class="pi-bs__card-title">{{ product.title }}</a>
                  <p class="pi-bs__card-price">
                    {%- if product.price_min < product.price_max -%}
                      {{ product.price_min | money }}&ndash;{{ product.price_max | money }}
                    {%- else -%}
                      {{ product.price_min | money }}
                    {%- endif -%}
                  </p>
                  <div class="pi-bs__card-atc">
                    {%- if product.available -%}
                      <form action="/cart/add" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="pi-bs__card-atc-btn">Add to Cart</button>
                      </form>
                    {%- else -%}
                      <a href="{{ product.url }}" class="pi-bs__card-atc-btn">View Product</a>
                    {%- endif -%}
                  </div>

                </div>

              </div>
            {%- endfor -%}

          {%- else -%}
            {%- comment -%} Placeholder cards when no collection is set {%- endcomment -%}
            {%- for i in (1..4) -%}
              {%- assign ph_num = forloop.index -%}
              <div class="pi-bs__card">
                <a href="#" class="pi-bs__card-img-wrap" tabindex="-1" aria-hidden="true">
                  {{ 'product-' | append: ph_num | placeholder_svg_tag: 'placeholder-svg' }}
                  <button class="pi-bs__wishlist" aria-label="Add to wishlist" type="button">
                    <svg viewBox="0 0 33 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16.5 26.5C16.5 26.5 2 18 2 9.5C2 6.186 4.686 3.5 8 3.5C10.6 3.5 12.9 5.1 14.3 6.9C15.05 7.9 16.5 7.9 16.5 7.9C16.5 7.9 17.95 7.9 18.7 6.9C20.1 5.1 22.4 3.5 25 3.5C28.314 3.5 31 6.186 31 9.5C31 18 16.5 26.5 16.5 26.5Z" stroke="#000000" stroke-width="1.5" stroke-linejoin="round" fill="transparent"/>
                    </svg>
                  </button>
                </a>
                <div class="pi-bs__card-info">
                  <span class="pi-bs__card-title">Sample Jewelry Product</span>
                  <p class="pi-bs__card-price">€0.00</p>
                  <div class="pi-bs__card-atc">
                    <button type="button" class="pi-bs__card-atc-btn">Add to Cart</button>
                  </div>
                </div>

              </div>
            {%- endfor -%}
          {%- endif -%}

        </div>
      </div>

      {%- comment -%} Explore button {%- endcomment -%}
      <div class="pi-bs__explore">
        <a href="{{ btn_link }}" class="pi-bs__explore-btn">{{ btn_label }}</a>
      </div>

    </div>
  </div>
</div>

<script>
(function () {
  var sectionId  = {{ section.id | json }};
  var wrapper    = document.getElementById('pi-bs-wrapper-' + sectionId);
  var track      = document.getElementById('pi-bs-track-' + sectionId);
  var prevBtn    = document.getElementById('pi-bs-prev-' + sectionId);
  var nextBtn    = document.getElementById('pi-bs-next-' + sectionId);
  if (!track || !prevBtn || !nextBtn) return;

  var current = 0;

  function visibleCount() {
    var w = wrapper.offsetWidth;
    if (w < 601)  return 1;
    if (w < 990)  return 2;
    return 4;
  }

  function cardWidth() {
    var gap     = 30;
    var visible = visibleCount();
    return (wrapper.offsetWidth - gap * (visible - 1)) / visible;
  }

  function totalCards() { return track.children.length; }

  function slideTo(idx) {
    current = Math.max(0, Math.min(idx, totalCards() - visibleCount()));
    var offset = current * (cardWidth() + 30);
    track.style.transform = 'translateX(-' + offset + 'px)';
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current >= totalCards() - visibleCount();
  }

  prevBtn.addEventListener('click', function () { slideTo(current - 1); });
  nextBtn.addEventListener('click', function () { slideTo(current + 1); });

  window.addEventListener('resize', function () { slideTo(0); });

  /* Wishlist toggle */
  track.querySelectorAll('.pi-bs__wishlist').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var path = btn.querySelector('.pi-bs__wishlist-path');
      if (!path) return;
      var active = btn.classList.toggle('pi-bs__wishlist--active');
      path.setAttribute('fill', active ? '#000000' : 'transparent');
    });
  });

  slideTo(0);
})();
</script>

{% schema %}
{
  "name": "PI Best Sellers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Explore button"
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "Button label",
      "default": "Explore Our Jewelry Collection"
    },
    {
      "type": "url",
      "id": "explore_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "PI Best Sellers"
    }
  ]
}
{% endschema %}
