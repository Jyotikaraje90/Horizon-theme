<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  /* ── Section wrapper ── */
  .pi-bs {
    background: var(--pi-bs-bg, #ffffff);
  }

  .pi-bs__inner {
    /* 1580 = the design's 1500 content column + the 40px gutters below, so the
       inner width is 1500 rather than 1420. At 1500 the section was an outer box
       and the 40px padding ate into it: the track measured 1420, the four-card
       formula produced 333px cards against the Figma rectangle's 360x360, and
       the whole section sat 40px inset from the rest of the page (cards started
       at x=245 where the logo and header content start at 205). */
    max-width: 1580px;
    margin: 0 auto;
    padding: var(--pi-bs-pad-top) 40px var(--pi-bs-pad-bottom);
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  /* ── Header row: heading left, arrows right ── */
  .pi-bs__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 70px;
  }

  .pi-bs__title {
    font-family: 'Playfair Display', serif;
    font-size: var(--pi-bs-heading-size, 54px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--pi-bs-heading-color, #000000);
    margin: 0;
    text-align: var(--pi-bs-text-align, center);
  }

  /* ── Arrow frame (Frame 48095942): Horizontal, Hug 120×50px, gap 20px ── */
  .pi-bs__arrows {
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
    width: 120px;
    height: 50px;
  }

  /* ── Each arrow: 50×50px circle ── */
  .pi-bs__arrow {
    -webkit-appearance: none;
    appearance: none;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s, opacity 0.2s;
    padding: 0;
    outline: none;
  }

  /* Prev: white circle with black border */
  .pi-bs__arrow--prev {
    background-color: var(--pi-bs-arrow-prev-bg, #ffffff) !important;
    border: 1.5px solid #000000 !important;
    color: #000000 !important;
  }

  .pi-bs__arrow--prev:hover { background-color: #f2f2f2 !important; }

  .pi-bs__arrow--next svg { transform: rotate(180deg); }

  /* Next: filled black circle */
  .pi-bs__arrow--next {
    background-color: var(--pi-bs-arrow-next-bg, #000000) !important;
    border: 1.5px solid #000000 !important;
    color: #ffffff !important;
  }

  .pi-bs__arrow--next:hover { background-color: #222222 !important; }

  .pi-bs__arrow:disabled { cursor: default; }

  .pi-bs__arrow svg {
    width: 15.91px;
    height: 15.91px;
    display: block;
    pointer-events: none;
  }

  /* ── Body: track + explore button ── */
  .pi-bs__body {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 100%;
  }

  /* ── Carousel track ── */
  .pi-bs__track-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .pi-bs__track {
    display: flex;
    flex-direction: row;
    /* 20, not 30: four 360px cards plus three gaps must total the design's 1500
       content column (1440 + 60). The mobile track below already used 20. */
    gap: 20px;
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
  }

  /* ── Product card: 360px, Vertical, gap 20px ── */
  .pi-bs__card {
    /* 60px = three 20px gaps. Was 90px, which paired with the old 30px gap. */
    flex: 0 0 calc((100% - 60px) / 4);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Image frame: 360×360, bg #E6E6E6, radius 20px ── */
  .pi-bs__card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--pi-bs-card-bg, #E6E6E6);
    border-radius: var(--pi-bs-card-radius, 20px);
    overflow: hidden;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .pi-bs__card-img-wrap img,
  .pi-bs__card-img-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    display: block;
  }

  /* ── Wishlist icon: 33×30px, top 20px, right 20px ── */
  .pi-bs__wishlist {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 33px;
    height: 30px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.15s ease;
  }

  .pi-bs__wishlist:hover { transform: scale(1.15); }

  .pi-bs__wishlist svg { width: 100%; height: 100%; display: block; }

  /* Figma "favorite": 2px border on desktop, 1px on the mobile frame. The markup
     carries stroke-width="1.5" as an attribute, which cannot vary by breakpoint;
     this presentation attribute is the weakest source in the cascade, so setting
     the property here overrides it at both sizes. */
  .pi-bs__wishlist svg path { stroke-width: 2; }

  .pi-bs__wishlist--active path { fill: #000000; }

  /* ── Description: plain, no border, no frame ──
     Figma's "Frame 2123" draws this block as a #FFFFFF panel with a 1px dashed
     (10, 10) border on left/right/bottom and 10px bottom corners. That is
     deliberately NOT implemented — confirmed with the client on review. Treat the
     dashed outline in the design file as a frame guide, not a visual element, and
     do not "restore" it on a future design-fidelity pass. */
  .pi-bs__card-info {
    background: transparent;
    border: none;
    display: flex;
    flex-direction: column;
    /* 10px here is the title→price gap; the price→ADD TO CART gap is taken to
       20px by the margin on .pi-bs__card-atc below. Figma nests title+price in
       their own frame, so the two gaps differ — a single 20px gap made the block
       116px against the design's 106px (26 + 10 + 29 + 20 + 21). */
    gap: 10px;
    padding: 0;
  }

  /* Second half of the 20px price→ADD TO CART gap (10px flex gap + 10px here). */
  .pi-bs__card-atc {
    margin-top: 10px;
    /* Without a family and line-height this block inherited Inter at 22.4px and
       stood 23px tall against the design's 21px, padding every card by 2px. The
       button inside it was already correct; only its wrapper was not. */
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    line-height: 21px;
  }

  /* ── Product title ── */
  .pi-bs__card-title {
    /* Figma "V2/H5 Proxima Nova": Semibold 600, 20/26. The rem-based 1.1rem/1.3
       resolved to 17.6/22.88 -- the fractional values were the tell that this was
       a type scale rather than a design number. Weight was 400, which inverted
       the hierarchy against the price below (design has the name heavier than the
       price; this had it the other way round). */
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    color: #000000;
    margin: 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-bs__card-title:hover { text-decoration: underline; }

  /* ── Price ── */
  .pi-bs__card-price {
    /* Figma "V2/Paragraph Proxima Nova": Regular 400, 18/29. Was 600 at
       1rem/1.6 (16/25.6) -- see the note on the title about the swapped weights. */
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    color: #000000;
    margin: 0;
  }

  /* ── Add to Cart: plain underlined text link ── */
  .pi-bs__card-atc form { margin: 0; }

  .pi-bs__card-atc-btn {
    display: inline;
    background: none;
    border: none;
    border-bottom: 1px solid #000000;
    padding: 0;
    /* Figma "V2/Btn Proxima Nova": Semibold 600, 16/21 (14/18 on mobile, set in
       the breakpoint block below). The 12.8px default came from a 0.8rem scale. */
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: {{ section.settings.card_btn_size | default: 16 }}px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #000000;
    cursor: pointer;
    text-decoration: none;
    line-height: 21px;
  }

  .pi-bs__card-atc-btn:hover {
    border-bottom-color: #555555;
    color: #555555;
  }

  /* ── Explore button: Figma Btn spec (H 55px, R 8px, P 16/32, bg #000) ── */
  .pi-bs__explore {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .pi-bs__explore-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 20px;
    height: 55px;
    padding: 16px 32px;
    border-radius: var(--pi-bs-btn-radius, 8px);
    background: var(--pi-bs-btn-bg, #000000);
    color: var(--pi-bs-btn-text, #ffffff);
    border: none;
    /* Figma "V2/Btn Proxima Nova": Semibold 600, 16/21. Line height was
       unset and inherited to 25.6; the button keeps its fixed 55px height either
       way, but the label sat in a taller line box than the design's. */
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: var(--pi-bs-btn-size, 16px);
    font-weight: 600;
    line-height: 21px;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
  }

  .pi-bs__explore-btn:hover {
    background: var(--pi-bs-btn-hover-bg, #222222);
    color: var(--pi-bs-btn-hover-text, #ffffff);
    text-decoration: none;
  }

  /* ── Carousel container & mobile arrows (base: desktop) ── */
  .pi-bs__carousel-container {
    width: 100%;
  }

  .pi-bs__mobile-arrows {
    display: none;
  }

  /* ── Responsive: 2 cards on tablet, 1.5 on mobile ── */
  /* Shared laptop heading step (same breakpoint in every homepage section) */
  @media (max-width: 1279px) {
    .pi-bs__title {
      font-size: calc(var(--pi-bs-heading-base, 54px) * 0.82);
      line-height: 1.3;
    }
  }

  @media (max-width: 989px) {
    /* One 20px gap between the two visible cards, matching the track gap. This
       said 30px, which was correct only while the base track gap was also 30 --
       once that moved to 20 to hit the design's 360px desktop card, this left the
       cards 4px narrower than the space available. */
    .pi-bs__card {
      flex: 0 0 calc((100% - 20px) / 2);
    }
    .pi-bs__title {
      font-size: clamp(28px, 5vw, calc(var(--pi-bs-heading-base, 54px) * 0.89));
      line-height: 1.2;
    }
  }

  /* Mobile heading size applies from 749px, matching the other sections
     (the card carousel still reflows separately at 600px below). */
  @media (max-width: 749px) {
    .pi-bs__title {
      font-size: var(--pi-bs-heading-size-mobile, 30px);
      line-height: 1.3;
    }
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .pi-bs__card-info {
      padding: 8px 0;
      gap: 10px;
    }
    .pi-bs__card-title {
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.4;
    }
    .pi-bs__card-price {
      font-size: 1.125rem;
      font-weight: 600;
    }
    .pi-bs__card-atc-btn {
      font-size: 0.9rem;
      font-weight: 700;
    }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  @media (max-width: 767px) {
    /* Card title pinned to the shared mobile scale (18/23) */
    .pi-bs__card-title {
      font-size: 18px;
      line-height: 23px;
    }

    .pi-bs__inner {
      padding-left: 18px;
      padding-right: 18px;
      /* 30px between the heading and the carousel, per the mobile frame's
         section gap. Was 20px. */
      gap: 30px;
    }

    .pi-bs__title {
      font-size: var(--pi-bs-heading-size-mobile, 30px);
      line-height: 1.3;
    }

    .pi-bs__header {
      min-height: 35px;
    }

    .pi-bs__arrows {
      width: 90px;
      height: 35px;
    }

    .pi-bs__arrow {
      width: 35px;
      height: 35px;
    }

    /* 20px gap gives a 167px card at 390 (354 inner - 20 / 2), matching the
       Figma card size used by every carousel section */
    .pi-bs__track {
      gap: 20px;
    }

    .pi-bs__card {
      flex: 0 0 calc((100% - 20px) / 2);
      gap: 10px;
    }

    .pi-bs__card-img-wrap {
      border-radius: 15px;
    }

    .pi-bs__wishlist {
      width: 16px;
      height: 15px;
      top: 15px;
      right: 15px;
      left: auto;
    }

    .pi-bs__wishlist svg {
      width: 16px;
      height: 15px;
    }

    .pi-bs__card-info {
      /* No padding on the mobile frame — the card is a plain hug of image (167),
         10px, and this block (101). The 8px all round added 16px to every card. */
      padding: 0;
      /* Mobile runs the same two-gap rhythm as desktop at half scale:
         5px title→price, 10px price→ADD TO CART, giving
         46 + 5 + 22 + 10 + 18 = 101. */
      gap: 5px;
    }

    .pi-bs__card-atc {
      margin-top: 5px;
      line-height: 18px;
    }

    .pi-bs__explore {
      width: 100%;
    }

    /* Mobile frame type: name 600 18/23, price 400 14/22, add-to-cart 600 14/18.
       The sizes were inheriting the desktop values and every weight was one step
       heavy, which flattened the name/price contrast the design relies on. */
    .pi-bs__card-title {
      font-weight: 600;
      font-size: 18px;
      line-height: 23px;
    }

    .pi-bs__card-price {
      font-weight: 400;
      font-size: 14px;
      line-height: 22px;
    }

    .pi-bs__card-atc-btn {
      font-weight: 600;
      font-size: 14px;
      line-height: 18px;
    }

    /* 1px on the mobile frame, against 2px on desktop */
    .pi-bs__wishlist svg path {
      stroke-width: 1;
    }

    .pi-bs__explore-btn {
      width: 100%;
      height: 50px;
      font-size: 14px;
      font-family: 'Proxima Nova', sans-serif;
      line-height: 18px;
    }

    /* Hide desktop arrows from header on mobile */
    .pi-bs__header .pi-bs__arrows {
      display: none;
    }

    /* Mobile arrows: float over carousel at mid-image height */
    .pi-bs__carousel-container {
      position: relative;
    }

    .pi-bs__mobile-arrows {
      display: flex;
      position: absolute;
      top: 0;
      transform: translateY(-50%);

      /* Figma's arrow row is Fixed(380) against a 354px content column, i.e. it
         hangs 13px outside the cards on each side.

         An earlier revision tried -17px (a full half-arrow, centring each one on
         the container edge) and reverted to 0 because the 18px section gutter
         left the next arrow 1px from the viewport edge, looking cut off and
         sitting under the scrollbar. -13px is the design's own figure and keeps
         5px of clearance, so it does not reintroduce that. */
      left: -13px;
      right: -13px;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 5;
    }

    .pi-bs__mobile-arrows .pi-bs__arrow {
      pointer-events: all;
    }
  }

</style>

{%- liquid
  assign collection   = section.settings.collection
  assign max_products = section.settings.max_products
  assign heading      = section.settings.heading      | default: 'Best Sellers'
  assign btn_label    = section.settings.explore_label | default: 'Explore Our Jewelry Collection'
  assign btn_link     = section.settings.explore_link
  if btn_link == blank
    if collection != blank
      assign btn_link = collection.url
    else
      assign btn_link = '/collections/all'
    endif
  endif
-%}

<div
  class="pi-bs"
  style="--pi-bs-pad-top: {{ section.settings.padding_top }}px; --pi-bs-pad-bottom: {{ section.settings.padding_bottom }}px; --pi-bs-bg: {{ section.settings.bg_color }}; --pi-bs-heading-size: {{ section.settings.heading_size }}px; --pi-bs-heading-base: {{ section.settings.heading_size }}px; --pi-bs-heading-size-mobile: {{ section.settings.mobile_heading_size }}px; --pi-bs-heading-color: {{ section.settings.heading_color }}; --pi-bs-text-align: {{ section.settings.text_alignment }}; --pi-bs-card-radius: {{ section.settings.card_radius }}px; --pi-bs-card-bg: {{ section.settings.card_bg }}; --pi-bs-btn-bg: {{ section.settings.btn_bg }}; --pi-bs-btn-text: {{ section.settings.btn_text }}; --pi-bs-btn-radius: {{ section.settings.btn_radius }}px; --pi-bs-btn-size: {{ section.settings.btn_size }}px; --pi-bs-btn-hover-bg: {{ section.settings.btn_hover_bg }}; --pi-bs-btn-hover-text: {{ section.settings.btn_hover_text }}; --pi-bs-arrow-prev-bg: {{ section.settings.arrow_prev_bg }}; --pi-bs-arrow-next-bg: {{ section.settings.arrow_next_bg }};"
>
  <div class="pi-bs__inner">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="pi-bs__header">
      <h2 class="pi-bs__title">{{ heading }}</h2>
      <div class="pi-bs__arrows">
        <button
          class="pi-bs__arrow pi-bs__arrow--prev"
          id="pi-bs-prev-{{ section.id }}"
          aria-label="Previous products"
          type="button"
          disabled
        >
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
        <button
          class="pi-bs__arrow pi-bs__arrow--next"
          id="pi-bs-next-{{ section.id }}"
          aria-label="Next products"
          type="button"
        >
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
      </div>
    </div>

    {%- comment -%} ── Body ── {%- endcomment -%}
    <div class="pi-bs__body">

      {%- comment -%} Carousel track {%- endcomment -%}
      <div class="pi-bs__carousel-container">
      <div class="pi-bs__mobile-arrows">
        <button class="pi-bs__arrow pi-bs__arrow--prev" id="pi-bs-mprev-{{ section.id }}" aria-label="Previous products" type="button" disabled>
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
        <button class="pi-bs__arrow pi-bs__arrow--next" id="pi-bs-mnext-{{ section.id }}" aria-label="Next products" type="button">
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
      </div>
      <div class="pi-bs__track-wrapper" id="pi-bs-wrapper-{{ section.id }}">
        <div class="pi-bs__track" id="pi-bs-track-{{ section.id }}">

          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: max_products -%}
              <div class="pi-bs__card">

                {%- comment -%} Image frame {%- endcomment -%}
                <a href="{{ product.url }}" class="pi-bs__card-img-wrap" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 720 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="360"
                      height="360"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}

                  {%- comment -%} Wishlist icon — 33×30, top 20, right 20 {%- endcomment -%}
                  <button
                    class="pi-bs__wishlist"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    data-product-id="{{ product.id }}"
                    data-pi-wish="{{ product.handle }}"
                    type="button"
                  >
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M12 21.68C12 21.68 0.69 15.505 0.69 8.491C0.69 5.179 3.583 2.49 7.148 2.49C9.41 2.49 11.081 3.502 12 4.923C12.919 3.502 14.59 2.49 16.852 2.49C20.417 2.49 23.31 5.179 23.31 8.491C23.31 15.505 12 21.68 12 21.68Z"
                        stroke="#000000"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        fill="transparent"
                        class="pi-bs__wishlist-path"
                      />
                    </svg>
                  </button>
                </a>

                {%- comment -%} Description frame (Frame 2123): dashed l/r/b border, radius br/bl 10px {%- endcomment -%}
                <div class="pi-bs__card-info">
                  <a href="{{ product.url }}" class="pi-bs__card-title">{{ product.title }}</a>
                  <p class="pi-bs__card-price">
                    {%- if product.price_min < product.price_max -%}
                      {{ product.price_min | money }}&ndash;{{ product.price_max | money }}
                    {%- else -%}
                      {{ product.price_min | money }}
                    {%- endif -%}
                  </p>
                  <div class="pi-bs__card-atc">
                    {%- if product.available -%}
                      <form action="/cart/add" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="pi-bs__card-atc-btn">{{ section.settings.atc_label | default: 'Add to Cart' }}</button>
                      </form>
                    {%- else -%}
                      <a href="{{ product.url }}" class="pi-bs__card-atc-btn">{{ section.settings.view_label | default: 'View Product' }}</a>
                    {%- endif -%}
                  </div>

                </div>

              </div>
            {%- endfor -%}

          {%- else -%}
            {%- comment -%} Placeholder cards when no collection is set {%- endcomment -%}
            {%- for i in (1..4) -%}
              {%- assign ph_num = forloop.index -%}
              <div class="pi-bs__card">
                <a href="#" class="pi-bs__card-img-wrap" tabindex="-1" aria-hidden="true">
                  {{ 'product-' | append: ph_num | placeholder_svg_tag: 'placeholder-svg' }}
                  <button class="pi-bs__wishlist" aria-label="Add to wishlist" type="button">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 21.68C12 21.68 0.69 15.505 0.69 8.491C0.69 5.179 3.583 2.49 7.148 2.49C9.41 2.49 11.081 3.502 12 4.923C12.919 3.502 14.59 2.49 16.852 2.49C20.417 2.49 23.31 5.179 23.31 8.491C23.31 15.505 12 21.68 12 21.68Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="transparent"/>
                    </svg>
                  </button>
                </a>
                <div class="pi-bs__card-info">
                  <span class="pi-bs__card-title">Sample Jewelry Product</span>
                  <p class="pi-bs__card-price">€0.00</p>
                  <div class="pi-bs__card-atc">
                    <button type="button" class="pi-bs__card-atc-btn">{{ section.settings.atc_label | default: 'Add to Cart' }}</button>
                  </div>
                </div>

              </div>
            {%- endfor -%}
          {%- endif -%}

        </div>
      </div>
      </div>{%- comment -%} /.pi-bs__carousel-container {%- endcomment -%}

      {%- comment -%} Explore button {%- endcomment -%}
      <div class="pi-bs__explore">
        <a href="{{ btn_link }}" class="pi-bs__explore-btn">{{ btn_label }}</a>
      </div>

    </div>
  </div>
</div>

<script>
(function () {
  var sectionId  = {{ section.id | json }};
  var wrapper    = document.getElementById('pi-bs-wrapper-' + sectionId);
  var track      = document.getElementById('pi-bs-track-' + sectionId);
  var prevBtn    = document.getElementById('pi-bs-prev-' + sectionId);
  var nextBtn    = document.getElementById('pi-bs-next-' + sectionId);
  if (!track || !prevBtn || !nextBtn) return;

  var mobilePrevBtn = document.getElementById('pi-bs-mprev-' + sectionId);
  var mobileNextBtn = document.getElementById('pi-bs-mnext-' + sectionId);
  var mobileArrowsEl = wrapper.closest('.pi-bs__carousel-container').querySelector('.pi-bs__mobile-arrows');
  var current = 0;
  var arrowsEl = prevBtn.closest('.pi-bs__arrows');

  function updateMobileArrowPos() {
    if (!mobileArrowsEl) return;
    var imgWrap = track.querySelector('.pi-bs__card-img-wrap');
    if (!imgWrap) return;
    mobileArrowsEl.style.top = (imgWrap.offsetHeight / 2) + 'px';
  }

  function visibleCount() {
    var w = wrapper.offsetWidth;
    if (w < 601)  return 2;
    if (w < 990)  return 2;
    return 4;
  }

  function getGap() {
    return wrapper.offsetWidth < 601 ? 10 : 30;
  }

  function cardWidth() {
    var gap     = getGap();
    var visible = visibleCount();
    return (wrapper.offsetWidth - gap * (visible - 1)) / visible;
  }

  function totalCards() { return track.children.length; }

  function slideTo(idx) {
    var gap     = getGap();
    var total   = totalCards();
    var visible = visibleCount();
    current = Math.max(0, Math.min(idx, total - visible));
    var offset = current * (cardWidth() + gap);
    track.style.transform = 'translateX(-' + offset + 'px)';
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current >= total - visible;
    if (mobilePrevBtn) mobilePrevBtn.disabled = current === 0;
    if (mobileNextBtn) mobileNextBtn.disabled = current >= total - visible;
  }

  prevBtn.addEventListener('click', function () { slideTo(current - 1); });
  nextBtn.addEventListener('click', function () { slideTo(current + 1); });
  if (mobilePrevBtn) mobilePrevBtn.addEventListener('click', function () { slideTo(current - 1); });
  if (mobileNextBtn) mobileNextBtn.addEventListener('click', function () { slideTo(current + 1); });

  window.addEventListener('resize', function () { slideTo(0); updateMobileArrowPos(); });

  /* Wishlist toggle — visual state here, persistence in pi-wishlist.js */
  function bsPaint(btn, active) {
    var path = btn.querySelector('.pi-bs__wishlist-path');
    btn.classList.toggle('pi-bs__wishlist--active', active);
    if (path) path.setAttribute('fill', active ? '#000000' : 'transparent');
  }

  var bsHearts = track.querySelectorAll('.pi-bs__wishlist');

  bsHearts.forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var handle = btn.getAttribute('data-pi-wish');
      var active = !btn.classList.contains('pi-bs__wishlist--active');
      bsPaint(btn, active);
      if (window.PIWishlist) window.PIWishlist.set(handle, active);
    });
  });

  /* Restore saved hearts on load so the state survives a refresh */
  if (window.PIWishlist) {
    window.PIWishlist.hydrate(bsHearts, function (btn) { bsPaint(btn, true); });
  }

  slideTo(0);
  updateMobileArrowPos();
})();
</script>

