<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  /* ── Section wrapper ── */
  .pi-bs {
    background: var(--pi-bs-bg, #ffffff);
  }

  .pi-bs__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: var(--pi-bs-pad-top) 40px var(--pi-bs-pad-bottom);
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  /* ── Header row: heading left, arrows right ── */
  .pi-bs__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 70px;
  }

  .pi-bs__title {
    font-family: 'Playfair Display', serif;
    font-size: var(--pi-bs-heading-size, 54px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--pi-bs-heading-color, #000000);
    margin: 0;
    text-align: var(--pi-bs-text-align, center);
  }

  /* ── Arrow frame (Frame 48095942): Horizontal, Hug 120×50px, gap 20px ── */
  .pi-bs__arrows {
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
    width: 120px;
    height: 50px;
  }

  /* ── Each arrow: 50×50px circle ── */
  .pi-bs__arrow {
    -webkit-appearance: none;
    appearance: none;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s, opacity 0.2s;
    padding: 0;
    outline: none;
  }

  /* Prev: white circle with black border */
  .pi-bs__arrow--prev {
    background-color: var(--pi-bs-arrow-prev-bg, #ffffff) !important;
    border: 1.5px solid #000000 !important;
    color: #000000 !important;
  }

  .pi-bs__arrow--prev:hover { background-color: #f2f2f2 !important; }

  .pi-bs__arrow--next svg { transform: rotate(180deg); }

  /* Next: filled black circle */
  .pi-bs__arrow--next {
    background-color: var(--pi-bs-arrow-next-bg, #000000) !important;
    border: 1.5px solid #000000 !important;
    color: #ffffff !important;
  }

  .pi-bs__arrow--next:hover { background-color: #222222 !important; }

  .pi-bs__arrow:disabled { cursor: default; }

  .pi-bs__arrow svg {
    width: 15.91px;
    height: 15.91px;
    display: block;
    pointer-events: none;
  }

  /* ── Body: track + explore button ── */
  .pi-bs__body {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 100%;
  }

  /* ── Carousel track ── */
  .pi-bs__track-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .pi-bs__track {
    display: flex;
    flex-direction: row;
    gap: 30px;
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
  }

  /* ── Product card: 360px, Vertical, gap 20px ── */
  .pi-bs__card {
    flex: 0 0 calc((100% - 90px) / 4);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Image frame: 360×360, bg #E6E6E6, radius 20px ── */
  .pi-bs__card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--pi-bs-card-bg, #E6E6E6);
    border-radius: var(--pi-bs-card-radius, 20px);
    overflow: hidden;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .pi-bs__card-img-wrap img,
  .pi-bs__card-img-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    display: block;
  }

  /* ── Wishlist icon: 33×30px, top 20px, right 20px ── */
  .pi-bs__wishlist {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 33px;
    height: 30px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.15s ease;
  }

  .pi-bs__wishlist:hover { transform: scale(1.15); }

  .pi-bs__wishlist svg { width: 100%; height: 100%; display: block; }

  .pi-bs__wishlist--active path { fill: #000000; }

  /* ── Description: plain, no border, no frame ── */
  .pi-bs__card-info {
    background: transparent;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0;
  }

  /* ── Product title ── */
  .pi-bs__card-title {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.3;
    color: #000000;
    margin: 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-bs__card-title:hover { text-decoration: underline; }

  /* ── Price ── */
  .pi-bs__card-price {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
    color: #000000;
    margin: 0;
  }

  /* ── Add to Cart: plain underlined text link ── */
  .pi-bs__card-atc form { margin: 0; }

  .pi-bs__card-atc-btn {
    display: inline;
    background: none;
    border: none;
    border-bottom: 1px solid #000000;
    padding: 0;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #000000;
    cursor: pointer;
    text-decoration: none;
    line-height: 1.5;
  }

  .pi-bs__card-atc-btn:hover {
    border-bottom-color: #555555;
    color: #555555;
  }

  /* ── Explore button: Figma Btn spec (H 55px, R 8px, P 16/32, bg #000) ── */
  .pi-bs__explore {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .pi-bs__explore-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 20px;
    height: 55px;
    padding: 16px 32px;
    border-radius: var(--pi-bs-btn-radius, 8px);
    background: var(--pi-bs-btn-bg, #000000);
    color: var(--pi-bs-btn-text, #ffffff);
    border: none;
    font-family: 'Nunito Sans', sans-serif;
    font-size: var(--pi-bs-btn-size, 16px);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
  }

  .pi-bs__explore-btn:hover {
    background: var(--pi-bs-btn-hover-bg, #222222);
    color: var(--pi-bs-btn-hover-text, #ffffff);
    text-decoration: none;
  }

  /* ── Carousel container & mobile arrows (base: desktop) ── */
  .pi-bs__carousel-container {
    width: 100%;
  }

  .pi-bs__mobile-arrows {
    display: none;
  }

  /* ── Responsive: 2 cards on tablet, 1.5 on mobile ── */
  /* Shared laptop heading step (same breakpoint in every homepage section) */
  @media (max-width: 1279px) {
    .pi-bs__title {
      font-size: calc(var(--pi-bs-heading-base, 54px) * 0.82);
      line-height: 1.3;
    }
  }

  @media (max-width: 989px) {
    .pi-bs__card {
      flex: 0 0 calc((100% - 30px) / 2);
    }
    .pi-bs__title {
      font-size: clamp(28px, 5vw, calc(var(--pi-bs-heading-base, 54px) * 0.89));
      line-height: 1.2;
    }
  }

  /* Mobile heading size applies from 749px, matching the other sections
     (the card carousel still reflows separately at 600px below). */
  @media (max-width: 749px) {
    .pi-bs__title {
      font-size: var(--pi-bs-heading-size-mobile, 30px);
      line-height: 1.3;
    }
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .pi-bs__card-info {
      padding: 8px 0;
      gap: 10px;
    }
    .pi-bs__card-title {
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.4;
    }
    .pi-bs__card-price {
      font-size: 1.125rem;
      font-weight: 600;
    }
    .pi-bs__card-atc-btn {
      font-size: 0.9rem;
      font-weight: 700;
    }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  @media (max-width: 767px) {
    /* Card title pinned to the shared mobile scale (18/23) */
    .pi-bs__card-title {
      font-size: 18px;
      line-height: 23px;
    }

    .pi-bs__inner {
      padding-left: 18px;
      padding-right: 18px;
      gap: 20px;
    }

    .pi-bs__title {
      font-size: var(--pi-bs-heading-size-mobile, 30px);
      line-height: 1.3;
    }

    .pi-bs__header {
      min-height: 35px;
    }

    .pi-bs__arrows {
      width: 90px;
      height: 35px;
    }

    .pi-bs__arrow {
      width: 35px;
      height: 35px;
    }

    /* 20px gap gives a 167px card at 390 (354 inner - 20 / 2), matching the
       Figma card size used by every carousel section */
    .pi-bs__track {
      gap: 20px;
    }

    .pi-bs__card {
      flex: 0 0 calc((100% - 20px) / 2);
      gap: 10px;
    }

    .pi-bs__card-img-wrap {
      border-radius: 15px;
    }

    .pi-bs__wishlist {
      width: 16px;
      height: 15px;
      top: 15px;
      right: 15px;
      left: auto;
    }

    .pi-bs__wishlist svg {
      width: 16px;
      height: 15px;
    }

    .pi-bs__card-info {
      padding: 8px;
      gap: 10px;
    }

    .pi-bs__explore {
      width: 100%;
    }

    .pi-bs__card-title {
      font-weight: 700;
    }

    .pi-bs__card-price {
      font-weight: 600;
    }

    .pi-bs__card-atc-btn {
      font-weight: 700;
    }

    .pi-bs__explore-btn {
      width: 100%;
      height: 50px;
      font-size: 14px;
      font-family: 'Proxima Nova', sans-serif;
      line-height: 18px;
    }

    /* Hide desktop arrows from header on mobile */
    .pi-bs__header .pi-bs__arrows {
      display: none;
    }

    /* Mobile arrows: float over carousel at mid-image height */
    .pi-bs__carousel-container {
      position: relative;
    }

    .pi-bs__mobile-arrows {
      display: flex;
      position: absolute;
      top: 0;
      transform: translateY(-50%);

      /* Flush with the carousel edges, not -17px outside them. The arrows are
         35px wide, so a -17px offset centred each one on the container edge —
         and since the section gutter here is only 18px, that left the next arrow
         1px from the viewport edge at every width, looking cut off (and sitting
         under the scrollbar in a real browser). At 0 they sit just inside the
         card edges and inherit the section's gutter as clearance. */
      left: 0;
      right: 0;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 5;
    }

    .pi-bs__mobile-arrows .pi-bs__arrow {
      pointer-events: all;
    }
  }

</style>

{%- liquid
  assign collection   = section.settings.collection
  assign max_products = section.settings.max_products
  assign heading      = section.settings.heading      | default: 'Best Sellers'
  assign btn_label    = section.settings.explore_label | default: 'Explore Our Jewelry Collection'
  assign btn_link     = section.settings.explore_link
  if btn_link == blank
    if collection != blank
      assign btn_link = collection.url
    else
      assign btn_link = '/collections/all'
    endif
  endif
-%}

<div
  class="pi-bs"
  style="--pi-bs-pad-top: {{ section.settings.padding_top }}px; --pi-bs-pad-bottom: {{ section.settings.padding_bottom }}px; --pi-bs-bg: {{ section.settings.bg_color }}; --pi-bs-heading-size: {{ section.settings.heading_size }}px; --pi-bs-heading-base: {{ section.settings.heading_size }}px; --pi-bs-heading-size-mobile: {{ section.settings.mobile_heading_size }}px; --pi-bs-heading-color: {{ section.settings.heading_color }}; --pi-bs-text-align: {{ section.settings.text_alignment }}; --pi-bs-card-radius: {{ section.settings.card_radius }}px; --pi-bs-card-bg: {{ section.settings.card_bg }}; --pi-bs-btn-bg: {{ section.settings.btn_bg }}; --pi-bs-btn-text: {{ section.settings.btn_text }}; --pi-bs-btn-radius: {{ section.settings.btn_radius }}px; --pi-bs-btn-size: {{ section.settings.btn_size }}px; --pi-bs-btn-hover-bg: {{ section.settings.btn_hover_bg }}; --pi-bs-btn-hover-text: {{ section.settings.btn_hover_text }}; --pi-bs-arrow-prev-bg: {{ section.settings.arrow_prev_bg }}; --pi-bs-arrow-next-bg: {{ section.settings.arrow_next_bg }};"
>
  <div class="pi-bs__inner">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="pi-bs__header">
      <h2 class="pi-bs__title">{{ heading }}</h2>
      <div class="pi-bs__arrows">
        <button
          class="pi-bs__arrow pi-bs__arrow--prev"
          id="pi-bs-prev-{{ section.id }}"
          aria-label="Previous products"
          type="button"
          disabled
        >
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
        <button
          class="pi-bs__arrow pi-bs__arrow--next"
          id="pi-bs-next-{{ section.id }}"
          aria-label="Next products"
          type="button"
        >
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
      </div>
    </div>

    {%- comment -%} ── Body ── {%- endcomment -%}
    <div class="pi-bs__body">

      {%- comment -%} Carousel track {%- endcomment -%}
      <div class="pi-bs__carousel-container">
      <div class="pi-bs__mobile-arrows">
        <button class="pi-bs__arrow pi-bs__arrow--prev" id="pi-bs-mprev-{{ section.id }}" aria-label="Previous products" type="button" disabled>
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
        <button class="pi-bs__arrow pi-bs__arrow--next" id="pi-bs-mnext-{{ section.id }}" aria-label="Next products" type="button">
          <svg viewBox="4 4 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </button>
      </div>
      <div class="pi-bs__track-wrapper" id="pi-bs-wrapper-{{ section.id }}">
        <div class="pi-bs__track" id="pi-bs-track-{{ section.id }}">

          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: max_products -%}
              <div class="pi-bs__card">

                {%- comment -%} Image frame {%- endcomment -%}
                <a href="{{ product.url }}" class="pi-bs__card-img-wrap" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 720 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="360"
                      height="360"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}

                  {%- comment -%} Wishlist icon — 33×30, top 20, right 20 {%- endcomment -%}
                  <button
                    class="pi-bs__wishlist"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    data-product-id="{{ product.id }}"
                    type="button"
                  >
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                        stroke="#000000"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        fill="transparent"
                        class="pi-bs__wishlist-path"
                      />
                    </svg>
                  </button>
                </a>

                {%- comment -%} Description frame (Frame 2123): dashed l/r/b border, radius br/bl 10px {%- endcomment -%}
                <div class="pi-bs__card-info">
                  <a href="{{ product.url }}" class="pi-bs__card-title">{{ product.title }}</a>
                  <p class="pi-bs__card-price">
                    {%- if product.price_min < product.price_max -%}
                      {{ product.price_min | money }}&ndash;{{ product.price_max | money }}
                    {%- else -%}
                      {{ product.price_min | money }}
                    {%- endif -%}
                  </p>
                  <div class="pi-bs__card-atc">
                    {%- if product.available -%}
                      <form action="/cart/add" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="pi-bs__card-atc-btn">Add to Cart</button>
                      </form>
                    {%- else -%}
                      <a href="{{ product.url }}" class="pi-bs__card-atc-btn">View Product</a>
                    {%- endif -%}
                  </div>

                </div>

              </div>
            {%- endfor -%}

          {%- else -%}
            {%- comment -%} Placeholder cards when no collection is set {%- endcomment -%}
            {%- for i in (1..4) -%}
              {%- assign ph_num = forloop.index -%}
              <div class="pi-bs__card">
                <a href="#" class="pi-bs__card-img-wrap" tabindex="-1" aria-hidden="true">
                  {{ 'product-' | append: ph_num | placeholder_svg_tag: 'placeholder-svg' }}
                  <button class="pi-bs__wishlist" aria-label="Add to wishlist" type="button">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="transparent"/>
                    </svg>
                  </button>
                </a>
                <div class="pi-bs__card-info">
                  <span class="pi-bs__card-title">Sample Jewelry Product</span>
                  <p class="pi-bs__card-price">€0.00</p>
                  <div class="pi-bs__card-atc">
                    <button type="button" class="pi-bs__card-atc-btn">Add to Cart</button>
                  </div>
                </div>

              </div>
            {%- endfor -%}
          {%- endif -%}

        </div>
      </div>
      </div>{%- comment -%} /.pi-bs__carousel-container {%- endcomment -%}

      {%- comment -%} Explore button {%- endcomment -%}
      <div class="pi-bs__explore">
        <a href="{{ btn_link }}" class="pi-bs__explore-btn">{{ btn_label }}</a>
      </div>

    </div>
  </div>
</div>

<script>
(function () {
  var sectionId  = {{ section.id | json }};
  var wrapper    = document.getElementById('pi-bs-wrapper-' + sectionId);
  var track      = document.getElementById('pi-bs-track-' + sectionId);
  var prevBtn    = document.getElementById('pi-bs-prev-' + sectionId);
  var nextBtn    = document.getElementById('pi-bs-next-' + sectionId);
  if (!track || !prevBtn || !nextBtn) return;

  var mobilePrevBtn = document.getElementById('pi-bs-mprev-' + sectionId);
  var mobileNextBtn = document.getElementById('pi-bs-mnext-' + sectionId);
  var mobileArrowsEl = wrapper.closest('.pi-bs__carousel-container').querySelector('.pi-bs__mobile-arrows');
  var current = 0;
  var arrowsEl = prevBtn.closest('.pi-bs__arrows');

  function updateMobileArrowPos() {
    if (!mobileArrowsEl) return;
    var imgWrap = track.querySelector('.pi-bs__card-img-wrap');
    if (!imgWrap) return;
    mobileArrowsEl.style.top = (imgWrap.offsetHeight / 2) + 'px';
  }

  function visibleCount() {
    var w = wrapper.offsetWidth;
    if (w < 601)  return 2;
    if (w < 990)  return 2;
    return 4;
  }

  function getGap() {
    return wrapper.offsetWidth < 601 ? 10 : 30;
  }

  function cardWidth() {
    var gap     = getGap();
    var visible = visibleCount();
    return (wrapper.offsetWidth - gap * (visible - 1)) / visible;
  }

  function totalCards() { return track.children.length; }

  function slideTo(idx) {
    var gap     = getGap();
    var total   = totalCards();
    var visible = visibleCount();
    current = Math.max(0, Math.min(idx, total - visible));
    var offset = current * (cardWidth() + gap);
    track.style.transform = 'translateX(-' + offset + 'px)';
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current >= total - visible;
    if (mobilePrevBtn) mobilePrevBtn.disabled = current === 0;
    if (mobileNextBtn) mobileNextBtn.disabled = current >= total - visible;
  }

  prevBtn.addEventListener('click', function () { slideTo(current - 1); });
  nextBtn.addEventListener('click', function () { slideTo(current + 1); });
  if (mobilePrevBtn) mobilePrevBtn.addEventListener('click', function () { slideTo(current - 1); });
  if (mobileNextBtn) mobileNextBtn.addEventListener('click', function () { slideTo(current + 1); });

  window.addEventListener('resize', function () { slideTo(0); updateMobileArrowPos(); });

  /* Wishlist toggle */
  track.querySelectorAll('.pi-bs__wishlist').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var path = btn.querySelector('.pi-bs__wishlist-path');
      if (!path) return;
      var active = btn.classList.toggle('pi-bs__wishlist--active');
      path.setAttribute('fill', active ? '#000000' : 'transparent');
    });
  });

  slideTo(0);
  updateMobileArrowPos();
})();
</script>

