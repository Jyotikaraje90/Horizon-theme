<style>
  #shopify-section-{{ section.id }} {
    padding: 100px 0;
    background: #ffffff;
  }

  /* ─── Outer wrapper — 1500px centred ───────────────── */
  .pi-au {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
  }

  /* ─── Optional "ABOUT US" heading ──────────────────── */
  .pi-au__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    margin: 0 0 60px;
  }

  /* ─── Row: images (left) + content (right) ──────────── */
  .pi-au__body {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 50px;
  }

  /* ─── Left: overlapping images ──────────────────────── */
  .pi-au__images {
    position: relative;
    flex: 0 0 740px;
    height: 608px;
  }

  /* Image 1 — woman (top): Figma 550×550, left:190px, top:0 */
  .pi-au__img-top {
    position: absolute;
    width: 550px;
    height: 550px;
    left: 190px;
    top: 0;
    z-index: 1;
    overflow: hidden;
  }

  /*
    Dark ink overlay at bottom of top image.
    Organic torn edge — jagged peaks of varying heights.
  */
  .pi-au__img-top::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #121212;
    pointer-events: none;
    z-index: 2;
    clip-path: polygon(
      0% 100%, 100% 100%,
      100% 86%,
      98% 80%, 96% 87%, 94% 79%, 92% 85%, 90% 78%,
      88% 84%, 86% 77%, 84% 83%, 82% 76%, 80% 82%,
      78% 75%, 76% 82%, 74% 76%, 72% 82%, 70% 75%,
      68% 81%, 66% 74%, 64% 81%, 62% 74%, 60% 80%,
      58% 73%, 56% 80%, 54% 74%, 52% 80%, 50% 73%,
      48% 80%, 46% 74%, 44% 80%, 42% 73%, 40% 79%,
      38% 73%, 36% 79%, 34% 73%, 32% 79%, 30% 73%,
      28% 79%, 26% 74%, 24% 80%, 22% 74%, 20% 80%,
      18% 74%, 16% 80%, 14% 74%, 12% 80%, 10% 75%,
      8% 81%, 6% 75%, 4% 81%, 2% 76%, 0% 80%
    );
  }

  /* Image 2 — man (bottom): Figma 455×370, left:0, top:233px */
  .pi-au__img-bottom {
    position: absolute;
    width: 455px;
    height: 370px;
    left: 0;
    top: 233px;
    z-index: 2;
    overflow: hidden;
  }

  /*
    Dark ink overlay at TOP of bottom image.
    Organic torn edge — peaks pointing downward into the photo.
  */
  .pi-au__img-bottom::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #121212;
    pointer-events: none;
    z-index: 3;
    clip-path: polygon(
      0% 0%, 100% 0%,
      100% 14%,
      98% 8%, 96% 14%, 94% 7%, 92% 13%, 90% 6%,
      88% 12%, 86% 5%, 84% 12%, 82% 5%, 80% 11%,
      78% 5%, 76% 11%, 74% 4%, 72% 11%, 70% 4%,
      68% 10%, 66% 3%, 64% 10%, 62% 3%, 60% 9%,
      58% 3%, 56% 9%, 54% 3%, 52% 9%, 50% 2%,
      48% 9%, 46% 2%, 44% 9%, 42% 2%, 40% 8%,
      38% 2%, 36% 8%, 34% 2%, 32% 8%, 30% 2%,
      28% 8%, 26% 2%, 24% 8%, 22% 2%, 20% 8%,
      18% 2%, 16% 8%, 14% 2%, 12% 8%, 10% 3%,
      8% 9%, 6% 3%, 4% 9%, 2% 4%, 0% 8%
    );
  }

  /*
    Dark ink overlay on LEFT edge of bottom image.
    Organic torn left boundary against the white background.
  */
  .pi-au__img-bottom::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #121212;
    pointer-events: none;
    z-index: 3;
    clip-path: polygon(
      0% 0%, 7% 0%,
      12% 4%,  6% 8%,  12% 12%, 5% 16%,
      11% 20%, 5% 24%, 11% 28%, 5% 32%,
      11% 36%, 5% 40%, 10% 44%, 4% 48%,
      10% 52%, 5% 56%, 11% 60%, 5% 64%,
      11% 68%, 5% 72%, 11% 76%, 5% 80%,
      10% 84%, 4% 88%, 10% 92%, 5% 96%,
      7% 100%, 0% 100%
    );
  }

  .pi-au__img-top img,
  .pi-au__img-bottom img,
  .pi-au__img-top .placeholder-svg,
  .pi-au__img-bottom .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Right: content column ─────────────────────────── */
  .pi-au__content {
    flex: 0 0 710px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 30px;
  }

  /* Left-border accent wrapping the subheading */
  .pi-au__subheading-wrap {
    border-left: 3px solid #000000;
    padding-left: 15px;
  }

  .pi-au__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 34px;
    line-height: 44px;
    color: #000000;
    margin: 0;
  }

  .pi-au__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #121212;
    margin: 0;
  }

  /* ─── Buttons row ────────────────────────────────────── */
  .pi-au__buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 20px;
  }

  .pi-au__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .pi-au__btn:hover { opacity: 0.82; }

  .pi-au__btn--primary {
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .pi-au__btn--secondary {
    background: #ffffff;
    color: #000000;
    border: 1px solid #000000;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 1599px) {
    .pi-au { padding: 0 40px; }
    .pi-au__images { flex: 0 0 600px; height: 500px; }
    .pi-au__img-top { width: 440px; height: 440px; left: 160px; }
    .pi-au__img-bottom { width: 370px; height: 300px; top: 190px; }
    .pi-au__content { flex: 0 0 560px; }
  }

  @media (max-width: 1279px) {
    .pi-au__heading { font-size: 44px; line-height: 58px; }
    .pi-au__body { gap: 40px; }
    .pi-au__images { flex: 0 0 480px; height: 420px; }
    .pi-au__img-top { width: 350px; height: 350px; left: 130px; }
    .pi-au__img-bottom { width: 300px; height: 250px; top: 160px; }
    .pi-au__content { flex: 1; }
    .pi-au__subheading { font-size: 28px; line-height: 38px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 70px 0; }
    .pi-au { padding: 0 32px; }
    .pi-au__heading { font-size: 36px; line-height: 48px; margin-bottom: 40px; }
    .pi-au__body { flex-direction: column; gap: 40px; }
    .pi-au__images { flex: none; width: 100%; height: 380px; }
    .pi-au__img-top { width: 280px; height: 280px; left: calc(100% - 280px); }
    .pi-au__img-bottom { width: 260px; height: 220px; top: 150px; left: 0; }
    .pi-au__content { flex: none; width: 100%; padding-top: 0; }
    .pi-au__subheading { font-size: 26px; line-height: 34px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 50px 0; }
    .pi-au { padding: 0 20px; }
    .pi-au__heading { font-size: 28px; line-height: 38px; margin-bottom: 28px; }
    .pi-au__images { height: 300px; }
    .pi-au__img-top { width: 210px; height: 210px; left: calc(100% - 210px); }
    .pi-au__img-bottom { width: 200px; height: 170px; top: 120px; }
    .pi-au__content { gap: 20px; }
    .pi-au__subheading { font-size: 22px; line-height: 30px; }
    .pi-au__text { font-size: 16px; line-height: 26px; }
    .pi-au__btn { font-size: 14px; padding: 14px 24px; height: auto; }
  }
</style>

<div class="pi-au">

  {%- if section.settings.heading != blank -%}
    <h2 class="pi-au__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pi-au__body">

    {%- comment -%} Left column: two overlapping images {%- endcomment -%}
    <div class="pi-au__images" aria-hidden="true">

      <div class="pi-au__img-top">
        {%- if section.settings.image_1 != blank -%}
          <img
            src="{{ section.settings.image_1 | image_url: width: 1100 }}"
            alt="{{ section.settings.image_1.alt | default: 'About us' | escape }}"
            width="550"
            height="550"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="pi-au__img-bottom">
        {%- if section.settings.image_2 != blank -%}
          <img
            src="{{ section.settings.image_2 | image_url: width: 910 }}"
            alt="{{ section.settings.image_2.alt | default: 'About us' | escape }}"
            width="455"
            height="370"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} Right column: text + buttons {%- endcomment -%}
    <div class="pi-au__content">

      {%- if section.settings.subheading != blank -%}
        <div class="pi-au__subheading-wrap">
          <h3 class="pi-au__subheading">{{ section.settings.subheading }}</h3>
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="pi-au__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="pi-au__buttons">
          {%- if section.settings.button_1_label != blank -%}
            <a
              href="{{ section.settings.button_1_link | default: '#' }}"
              class="pi-au__btn pi-au__btn--primary"
            >
              {{- section.settings.button_1_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a
              href="{{ section.settings.button_2_link | default: '#' }}"
              class="pi-au__btn pi-au__btn--secondary"
            >
              {{- section.settings.button_2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

  </div>

</div>

{% schema %}
{
  "name": "PI About Us",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (optional)"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Photo 1 — top (woman tattooing)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Photo 2 — bottom (man being tattooed)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Turning Visions into Timeless Tattoos"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "At PuertoInk, we believe tattoos and piercings are more than just body art – they are a form of self-expression, a story inked onto skin. With a team of passionate artists, we've built a reputation for precision, creativity, and a commitment to safety. Whether you're looking for a fine-line tattoo, bold blackwork, or a perfectly placed piercing, our studios across Europe bring your vision to life. Visit us in Crete, Athens, Antwerp, or Amsterdam, and let's create something unforgettable together."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Book a Session"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Shop Piercing Jewelry"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "PI About Us"
    }
  ]
}
{% endschema %}
