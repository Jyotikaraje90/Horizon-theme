<style>
  #shopify-section-{{ section.id }} {
    padding: 100px 0;
    background: #ffffff;
  }

  /* ─── Outer wrapper — 1500px centred ───────────────── */
  .pi-au {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
  }

  /* ─── Optional "ABOUT US" heading ──────────────────── */
  .pi-au__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    margin: 0 0 60px;
  }

  /* ─── Row: images (left) + content (right) ──────────── */
  .pi-au__body {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 50px;
  }

  /* ─── Left: overlapping images ──────────────────────── */
  .pi-au__images {
    position: relative;
    flex: 0 0 740px;
    height: 608px;
  }

  /* Image 1 — woman (top): Figma 550×550, left:190px, top:0 */
  .pi-au__img-top {
    position: absolute;
    width: 550px;
    height: 550px;
    left: 190px;
    top: 0;
    z-index: 1;
    overflow: hidden;
  }

  /* Image 2 — man (bottom): Figma 455×370, left:0, top:233px */
  .pi-au__img-bottom {
    position: absolute;
    width: 455px;
    height: 370px;
    left: 0;
    top: 233px;
    z-index: 2;
    overflow: hidden;
  }

  .pi-au__img-top img,
  .pi-au__img-bottom img,
  .pi-au__img-top .placeholder-svg,
  .pi-au__img-bottom .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Right: content column ─────────────────────────── */
  .pi-au__content {
    flex: 0 0 710px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 30px;
  }

  /* Left-border accent wrapping the subheading */
  .pi-au__subheading-wrap {
    border-left: 3px solid #000000;
    padding-left: 15px;
  }

  .pi-au__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: 34px;
    line-height: 44px;
    color: #000000;
    margin: 0;
  }

  .pi-au__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #121212;
    margin: 0;
  }

  /* ─── Buttons row ────────────────────────────────────── */
  .pi-au__buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 20px;
  }

  .pi-au__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .pi-au__btn:hover { opacity: 0.82; }

  .pi-au__btn--primary {
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .pi-au__btn--secondary {
    background: #ffffff;
    color: #000000;
    border: 1px solid #000000;
  }

  /* ─── FAQs Subsection ────────────────────────────────── */
  .pi-au__faqs {
    max-width: 1120px;
    width: 100%;
    margin: 100px auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 50px;
  }

  .pi-au__faqs-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .pi-au__faqs-body {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .pi-au__faqs-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-au__faq-item {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pi-au__faq-trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .pi-au__faq-question {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
  }

  .pi-au__faq-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 20px;
  }

  .pi-au__icon-minus { display: none; }

  .pi-au__faq-item.is-open .pi-au__icon-plus  { display: none; }
  .pi-au__faq-item.is-open .pi-au__icon-minus { display: block; }

  .pi-au__faq-answer {
    display: none;
    width: 100%;
  }

  .pi-au__faq-item.is-open .pi-au__faq-answer {
    display: block;
  }

  .pi-au__faq-divider {
    width: 100%;
    height: 1px;
    background: #000000;
    flex-shrink: 0;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 1599px) {
    .pi-au { padding: 0 40px; }
    .pi-au__images { flex: 0 0 600px; height: 500px; }
    .pi-au__img-top { width: 440px; height: 440px; left: 160px; }
    .pi-au__img-bottom { width: 370px; height: 300px; top: 190px; }
    .pi-au__content { flex: 0 0 560px; }
  }

  @media (max-width: 1279px) {
    .pi-au__heading { font-size: 44px; line-height: 58px; }
    .pi-au__body { gap: 40px; }
    .pi-au__images { flex: 0 0 480px; height: 420px; }
    .pi-au__img-top { width: 350px; height: 350px; left: 130px; }
    .pi-au__img-bottom { width: 300px; height: 250px; top: 160px; }
    .pi-au__content { flex: 1; }
    .pi-au__subheading { font-size: 28px; line-height: 38px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 70px 0; }
    .pi-au { padding: 0 32px; }
    .pi-au__heading { font-size: 36px; line-height: 48px; margin-bottom: 40px; }
    .pi-au__body { flex-direction: column; gap: 40px; }
    .pi-au__images { flex: none; width: 100%; height: 380px; }
    .pi-au__img-top { width: 280px; height: 280px; left: calc(100% - 280px); }
    .pi-au__img-bottom { width: 260px; height: 220px; top: 150px; left: 0; }
    .pi-au__content { flex: none; width: 100%; padding-top: 0; }
    .pi-au__subheading { font-size: 26px; line-height: 34px; }
    .pi-au__faqs { margin-top: 70px; gap: 40px; }
    .pi-au__faqs-title { font-size: 40px; line-height: 52px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 50px 0; }
    .pi-au { padding: 0 20px; }
    .pi-au__heading { font-size: 28px; line-height: 38px; margin-bottom: 28px; }
    .pi-au__images { height: 300px; }
    .pi-au__img-top { width: 210px; height: 210px; left: calc(100% - 210px); }
    .pi-au__img-bottom { width: 200px; height: 170px; top: 120px; }
    .pi-au__content { gap: 20px; }
    .pi-au__subheading { font-size: 22px; line-height: 30px; }
    .pi-au__text { font-size: 16px; line-height: 26px; }
    .pi-au__btn { font-size: 14px; padding: 14px 24px; height: auto; }
    .pi-au__faqs { margin-top: 50px; gap: 30px; }
    .pi-au__faqs-title { font-size: 32px; line-height: 42px; }
    .pi-au__faq-question { font-size: 17px; line-height: 22px; }
  }
</style>

<div class="pi-au">

  {%- if section.settings.heading != blank -%}
    <h2 class="pi-au__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pi-au__body">

    {%- comment -%} Left column: two overlapping images {%- endcomment -%}
    <div class="pi-au__images" aria-hidden="true">

      <div class="pi-au__img-top">
        {%- if section.settings.image_1 != blank -%}
          <img
            src="{{ section.settings.image_1 | image_url: width: 1100 }}"
            alt="{{ section.settings.image_1.alt | default: 'About us' | escape }}"
            width="550"
            height="550"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="pi-au__img-bottom">
        {%- if section.settings.image_2 != blank -%}
          <img
            src="{{ section.settings.image_2 | image_url: width: 910 }}"
            alt="{{ section.settings.image_2.alt | default: 'About us' | escape }}"
            width="455"
            height="370"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} Right column: text + buttons {%- endcomment -%}
    <div class="pi-au__content">

      {%- if section.settings.subheading != blank -%}
        <div class="pi-au__subheading-wrap">
          <h3 class="pi-au__subheading">{{ section.settings.subheading }}</h3>
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="pi-au__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="pi-au__buttons">
          {%- if section.settings.button_1_label != blank -%}
            <a
              href="{{ section.settings.button_1_link | default: '#' }}"
              class="pi-au__btn pi-au__btn--primary"
            >
              {{- section.settings.button_1_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a
              href="{{ section.settings.button_2_link | default: '#' }}"
              class="pi-au__btn pi-au__btn--secondary"
            >
              {{- section.settings.button_2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

  </div>

  {%- comment -%} FAQs Subsection {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
  <div class="pi-au__faqs">

    <h2 class="pi-au__faqs-title">FAQs</h2>

    <div class="pi-au__faqs-body">

      <div class="pi-au__faqs-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
          <div class="pi-au__faq-item" {{ block.shopify_attributes }}>

            <button class="pi-au__faq-trigger" type="button" aria-expanded="false">
              <span class="pi-au__faq-question">{{ block.settings.question }}</span>
              <span class="pi-au__faq-icon" aria-hidden="true">
                <svg class="pi-au__icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="5" y="0" width="2" height="12" fill="#000000"/>
                  <rect x="0" y="5" width="12" height="2" fill="#000000"/>
                </svg>
                <svg class="pi-au__icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="12" height="2" fill="#000000"/>
                </svg>
              </span>
            </button>

            {%- if block.settings.answer != blank -%}
              <div class="pi-au__faq-answer">
                <p class="pi-au__text">{{ block.settings.answer }}</p>
              </div>
            {%- endif -%}

            <div class="pi-au__faq-divider"></div>

          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.faq_button_label != blank -%}
        <a
          href="{{ section.settings.faq_button_link | default: '#' }}"
          class="pi-au__btn pi-au__btn--primary"
        >
          {{- section.settings.faq_button_label -}}
        </a>
      {%- endif -%}

    </div>

  </div>
  {%- endif -%}

</div>

<script>
  (function () {
    document.querySelectorAll('#shopify-section-{{ section.id }} .pi-au__faq-trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var item = this.closest('.pi-au__faq-item');
        var isOpen = item.classList.toggle('is-open');
        this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
