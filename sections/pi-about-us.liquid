<style>
  /* ═══ PI ABOUT US — CUSTOMIZER VARIABLES ════════════ */
  #shopify-section-{{ section.id }} {
    --pi-au-pad-top:            {{ section.settings.padding_top }}px;
    --pi-au-pad-bottom:         {{ section.settings.padding_bottom }}px;
    --pi-au-bg:                 {{ section.settings.bg_color }};
    --pi-au-heading-size:       {{ section.settings.heading_size }}px;
    --pi-au-heading-color:      {{ section.settings.heading_color }};
    {%- comment -%}
      Never overridden — the laptop/tablet/mobile steps scale from this. This
      section has no separate mobile heading setting, so all steps derive from
      the one heading_size value.
    {%- endcomment -%}
    --pi-au-heading-base:       {{ section.settings.heading_size }}px;
    --pi-au-subheading-size:    {{ section.settings.subheading_size }}px;
    --pi-au-subheading-color:   {{ section.settings.subheading_color }};
    --pi-au-accent-border:      {{ section.settings.accent_border_color }};
    --pi-au-body-size:          {{ section.settings.body_text_size }}px;
    --pi-au-body-color:         {{ section.settings.body_text_color }};
    --pi-au-btn-primary-bg:     {{ section.settings.btn_primary_bg }};
    --pi-au-btn-primary-text:   {{ section.settings.btn_primary_text }};
    --pi-au-btn-secondary-bg:   {{ section.settings.btn_secondary_bg }};
    --pi-au-btn-secondary-text: {{ section.settings.btn_secondary_text }};
    --pi-au-btn-border:         {{ section.settings.btn_border_color }};
    --pi-au-btn-radius:         {{ section.settings.btn_radius }}px;
    --pi-au-btn-size:           {{ section.settings.btn_size }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-au-pad-top:    {{ section.settings.mobile_padding_top }}px;
      --pi-au-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pi-au-body-size:  {{ section.settings.mobile_body_text_size }}px;
    }
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    padding: var(--pi-au-pad-top, 100px) 0 var(--pi-au-pad-bottom, 100px);
    background: var(--pi-au-bg, #ffffff);
  }

  /* ─── Outer wrapper — 1500px centred ───────────────── */
  .pi-au {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
  }

  /* ─── Optional "ABOUT US" heading ──────────────────── */
  .pi-au__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-au-heading-size, 54px);
    line-height: 1.3;
    text-align: {{ section.settings.text_alignment }};
    text-transform: uppercase;
    color: var(--pi-au-heading-color, #000000);
    margin: 0 0 60px;
  }

  /* ─── Row: images (left) + content (right) ──────────── */
  .pi-au__body {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 50px;
  }

  /* ─── Left: overlapping images ──────────────────────── */
  .pi-au__images {
    position: relative;
    flex: 0 0 740px;
    /* Aspect instead of a fixed height so the whole two-image composition scales
       as ONE unit — the man image keeps overlapping the woman image at every
       width (matching the reference) instead of the two drifting apart. Each
       breakpoint below only changes the container width; the % images follow. */
    aspect-ratio: 740 / 608;
  }

  /* Image 1 — woman (top): Figma 550×550 at left:190,top:0 in the 740×608 box,
     as % so it scales with the container. */
  .pi-au__img-top {
    position: absolute;
    width: 74.32%;   /* 550 / 740 */
    height: 90.46%;  /* 550 / 608 */
    left: 25.68%;    /* 190 / 740 */
    top: 0;
    z-index: 1;
    overflow: hidden;
  }

  /* Image 2 — man (bottom): Figma 455×370 at left:0,top:233 in the 740×608 box,
     as % so it keeps overlapping the woman image at every width. */
  .pi-au__img-bottom {
    position: absolute;
    width: 61.49%;   /* 455 / 740 */
    height: 60.86%;  /* 370 / 608 */
    left: 0;
    top: 38.32%;     /* 233 / 608 */
    z-index: 2;
    overflow: hidden;
  }

  .pi-au__img-top img,
  .pi-au__img-bottom img,
  .pi-au__img-top .placeholder-svg,
  .pi-au__img-bottom .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Right: content column ─────────────────────────── */
  .pi-au__content {
    flex: 0 0 710px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 30px;
  }

  /* Left-border accent wrapping the subheading */
  .pi-au__subheading-wrap {
    border-left: 3px solid #000000;
    padding-left: 15px;
  }

  .pi-au__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 34px;
    line-height: 44px;
    color: #000000;
    margin: 0;
  }

  .pi-au__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #121212;
    margin: 0;
  }

  /* ─── Buttons row ────────────────────────────────────── */
  .pi-au__buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 20px;
  }

  .pi-au__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .pi-au__btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
    opacity: 1;
  }

  .pi-au__btn--primary {
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .pi-au__btn--secondary {
    background: #ffffff;
    color: #000000;
    border: 1px solid #000000;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 1599px) {
    .pi-au { padding: 0 40px; }
    /* Only the container width changes per breakpoint now; the % images scale. */
    .pi-au__images { flex: 0 0 600px; }
    .pi-au__content { flex: 0 0 560px; }
  }

  @media (max-width: 1279px) {
    .pi-au__heading { font-size: calc(var(--pi-au-heading-base, 54px) * 0.82); line-height: 1.3; }
    .pi-au__body { gap: 40px; }
    .pi-au__images { flex: 0 0 480px; }
    .pi-au__content { flex: 1; }
    .pi-au__subheading { font-size: 28px; line-height: 38px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 70px 0; }
    .pi-au { padding: 0 40px; }
    .pi-au__heading { font-size: clamp(28px, 5vw, calc(var(--pi-au-heading-base, 54px) * 0.89)); line-height: 1.2; margin-bottom: 40px; }
    .pi-au__body { flex-direction: column; gap: 40px; }
    /* Stacked: composition spans the column but capped so it doesn't get huge;
       % images + aspect keep the overlap intact. */
    .pi-au__images { flex: none; width: 100%; max-width: 500px; margin-inline: auto; }
    .pi-au__content { flex: none; width: 100%; padding-top: 0; }
    .pi-au__subheading { font-size: 26px; line-height: 34px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 50px 0 30px; }
    .pi-au { padding: 0 10px; }
    .pi-au__heading { font-size: calc(var(--pi-au-heading-base, 54px) * 0.56); line-height: 1.3; margin-bottom: 28px; }
    .pi-au__content { gap: 10px; }
    .pi-au__subheading-wrap { padding-left: 10px; }
    .pi-au__subheading { font-size: 22px; line-height: 30px; }
    .pi-au__text { font-size: 16px; line-height: 26px; }
    /* Both CTAs on one line at mobile, each sized to its own text (different
       widths, like desktop) — not stacked and not forced equal-width. Base
       already sets flex row + wrap, so very narrow phones still wrap gracefully. */
    .pi-au__buttons { gap: 12px; }
    .pi-au__btn { font-size: 14px; padding: 16px 22px; height: 50px; }
  }

  /* Tablet (768–989): keep the 1024-style two-column layout (overlapping images
     left, content right) instead of the ≤989 stacked/scattered column. The image
     composition is compacted so the content column still has room to breathe.
     990px+ (1024/desktop) and ≤749 (mobile) are untouched. */
  @media (min-width: 768px) and (max-width: 989px) {
    .pi-au__body { flex-direction: row; align-items: flex-start; gap: 30px; }
    /* Two-column at tablet: composition sits in a fixed 300px column (overriding
       the stacked full-width above); % images + aspect keep the same overlap. */
    .pi-au__images { flex: 0 0 300px; width: 300px; max-width: none; margin-inline: 0; }
    .pi-au__content { flex: 1; width: auto; padding-top: 0; }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

<div class="pi-au">

  {%- if section.settings.heading != blank -%}
    <h2 class="pi-au__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pi-au__body">

    {%- comment -%} Left column: two overlapping images {%- endcomment -%}
    <div class="pi-au__images" aria-hidden="true">

      <div class="pi-au__img-top">
        {%- if section.settings.image_1 != blank -%}
          <img
            src="{{ section.settings.image_1 | image_url: width: 1100 }}"
            alt="{{ section.settings.image_1.alt | default: 'About us' | escape }}"
            width="550"
            height="550"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="pi-au__img-bottom">
        {%- if section.settings.image_2 != blank -%}
          <img
            src="{{ section.settings.image_2 | image_url: width: 910 }}"
            alt="{{ section.settings.image_2.alt | default: 'About us' | escape }}"
            width="455"
            height="370"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} Right column: text + buttons {%- endcomment -%}
    <div class="pi-au__content">

      {%- if section.settings.subheading != blank -%}
        <div class="pi-au__subheading-wrap">
          <h3 class="pi-au__subheading">{{ section.settings.subheading }}</h3>
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="pi-au__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="pi-au__buttons">
          {%- if section.settings.button_1_label != blank -%}
            <a
              href="{{ section.settings.button_1_link | default: '#' }}"
              class="pi-au__btn pi-au__btn--primary"
            >
              {{- section.settings.button_1_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a
              href="{{ section.settings.button_2_link | default: '#' }}"
              class="pi-au__btn pi-au__btn--secondary"
            >
              {{- section.settings.button_2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

  </div>

</div>

{% schema %}
{
  "name": "PI About Us",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top",         "label": "Top padding (desktop)",    "min": 0, "max": 148, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom",      "label": "Bottom padding (desktop)",  "min": 0, "max": 148, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "mobile_padding_top",  "label": "Top padding (mobile)",      "min": 0, "max": 80,  "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom","label": "Bottom padding (mobile)",  "min": 0, "max": 80,  "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Section Margin" },
    { "type": "range", "id": "margin_top",    "label": "Margin Top",    "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "bg_color",            "label": "Background color",          "default": "#ffffff" },

    { "type": "header", "content": "Heading" },
    { "type": "range", "id": "heading_size",        "label": "Heading font size",         "min": 28, "max": 72, "step": 2, "unit": "px", "default": 54 },
    { "type": "color", "id": "heading_color",       "label": "Heading color",             "default": "#000000" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Subheading" },
    { "type": "range", "id": "subheading_size",     "label": "Subheading font size",      "min": 18, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "color", "id": "subheading_color",    "label": "Subheading color",          "default": "#000000" },
    { "type": "color", "id": "accent_border_color", "label": "Left accent border color",  "default": "#000000" },

    { "type": "header", "content": "Body Text" },
    { "type": "range", "id": "body_text_size",        "label": "Body font size (desktop)",  "min": 12, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_body_text_size", "label": "Body font size (mobile)",   "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "body_text_color",       "label": "Body text color",           "default": "#121212" },

    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "btn_primary_bg",      "label": "Primary button background", "default": "#000000" },
    { "type": "color", "id": "btn_primary_text",    "label": "Primary button text",       "default": "#ffffff" },
    { "type": "color", "id": "btn_secondary_bg",    "label": "Secondary button background","default": "#ffffff" },
    { "type": "color", "id": "btn_secondary_text",  "label": "Secondary button text",     "default": "#000000" },
    { "type": "color", "id": "btn_border_color",    "label": "Button border color",       "default": "#000000" },
    { "type": "range", "id": "btn_radius",          "label": "Button corner radius",      "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "btn_size",            "label": "Button font size",          "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "btn_hover_bg",        "label": "Button Hover Background",   "default": "#B49146" },
    { "type": "color", "id": "btn_hover_text",      "label": "Button Hover Text Color",   "default": "#ffffff" },

    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (optional)"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Photo 1 — top (woman tattooing)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Photo 2 — bottom (man being tattooed)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Turning Visions into Timeless Tattoos"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "At PuertoInk, we believe tattoos and piercings are more than just body art – they are a form of self-expression, a story inked onto skin. With a team of passionate artists, we've built a reputation for precision, creativity, and a commitment to safety. Whether you're looking for a fine-line tattoo, bold blackwork, or a perfectly placed piercing, our studios across Europe bring your vision to life. Visit us in Crete, Athens, Antwerp, or Amsterdam, and let's create something unforgettable together."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Book a Session"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Shop Piercing Jewelry"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "PI About Us"
    }
  ]
}
{% endschema %}
