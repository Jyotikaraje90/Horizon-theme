<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  #pi-hiw-{{ section.id }} {
    --pi-hiw-bg: {{ section.settings.bg_color }};
    --pi-hiw-heading-color: {{ section.settings.heading_color }};
    --pi-hiw-step-title-color: {{ section.settings.step_title_color }};
    --pi-hiw-step-desc-color: {{ section.settings.step_desc_color }};
    --pi-hiw-icon-bg: {{ section.settings.icon_bg }};
    --pi-hiw-icon-color: {{ section.settings.icon_color }};
    --pi-hiw-icon-img: {{ section.settings.icon_image_size | default: 100 }}px;
    --pi-hiw-step-gap: {{ section.settings.step_gap | default: 20 }}px;
  }
</style>

<style>
  .pi-hiw {
    background: var(--pi-hiw-bg, #ffffff);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pi-hiw__inner {
    max-width: 1580px;
    margin-inline: auto;
    padding-inline: 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 50px;
  }

  .pi-hiw__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp({{ section.settings.mobile_heading_size | default: 28 }}px, 3.75vw, {{ section.settings.heading_size | default: 54 }}px);
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--pi-hiw-heading-color, #000000);
    margin: 0;
    text-align: center;
  }

  /* The columns are flex: 1 1 0, so this gap also sets how wide each one ends up
     and therefore where the descriptions wrap. Figma's columns land near 430px
     on a 1500px row, i.e. roughly a 100px gap — at 20px they nearly touch. */
  .pi-hiw__steps {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    gap: var(--pi-hiw-step-gap, 20px);
  }

  .pi-hiw__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 50px;
    flex: 1 1 0;
    max-width: 487px;
  }

  /* Figma "Frame 18": title + description group, 10px gap */
  .pi-hiw__step-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  /* Figma vector: 166.09 x 31.49, #000000. The first arrow arcs up beside the
     icons; the second is mirrored into a valley and sits at the bottom of the
     row, below the description, overhanging it slightly (as in the design).
     Anchoring the second to the bottom keeps it correct when a description
     runs to one line on one page and two on another. */
  .pi-hiw__arrow {
    display: none;
    position: absolute;
    z-index: 1;
    width: 166.09px;
    height: 31.49px;
    left: calc(33.333% - 83px);
    top: 24px;
    color: var(--pi-hiw-icon-color, #000000);
  }

  .pi-hiw__arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pi-hiw__arrow--flip {
    left: calc(66.666% - 83px);
    top: auto;
    bottom: -14px;
    transform: scaleY(-1);
  }

  .pi-hiw__icon {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--pi-hiw-icon-bg, #f0f0f0);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* display:contents so the <picture> wrapper (added for the mobile icon)
     isn't the flex item instead of the img */
  .pi-hiw__icon picture { display: contents; }

  /* Icon size depends on how the asset was exported, so it's a setting:
       - 100 for assets exported at the full circle size with the glyph already
         centred in transparent padding (e.g. Nutrition.png, 100x100 with a 50px
         glyph) — the img fills the circle and the glyph lands at 50px.
       - 50 for tight exports of the glyph alone (e.g. Capa_1.png, 50x50). At 100
         these would fill the circle edge to edge and the square's corners would
         spill outside it, since a square only fits a 100px circle up to ~70px.
     The inline-SVG fallbacks below are drawn tight to their viewBox and keep
     their own 44px sizing. */
  /* Figma constrains each glyph by HEIGHT and lets the width follow its own
     aspect ratio, all centred in the 100px circle:
       Capa_1  50 x 50    (top 25, left 25)
       2 2     48.33 x 50 (top 25, left 26)
       1 9     43.33 x 50 (top 25, left 28.5)
     So height comes from the setting and width is auto — a square box would
     letterbox the narrower glyphs instead of matching the design. Use 50 for
     tight glyph exports; 100 for assets exported at the full circle size with
     the glyph already centred in transparent padding (e.g. Nutrition.png). */
  .pi-hiw__icon img {
    width: auto;
    height: var(--pi-hiw-icon-img, 100px);
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .pi-hiw__icon svg { width: 44px; height: 44px; }
  .pi-hiw__icon svg * { stroke: var(--pi-hiw-icon-color, #000000); }

  .pi-hiw__step-title {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    color: var(--pi-hiw-step-title-color, #121212);
    margin: 0;
  }

  .pi-hiw__step-desc {
    font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: var(--pi-hiw-step-desc-color, #121212);
    margin: 0;
  }

  /* ─── Responsive ───────────────────────────────── */
  @media (max-width: 989px) {
    .pi-hiw__inner { padding-inline: 24px; gap: 40px; }
  }

  @media (min-width: 1100px) {
    .pi-hiw__arrow { display: block; }
  }

  /* ─── Mobile: horizontal swipe scroller (Figma 390 frame) ───
     The arrow is a real 105.48px flex item between the steps. An earlier version
     squeezed it into a 20px box and let the artwork overflow (to match Figma's
     1102px track exactly) but overflow inside an overflow-x:auto scroller is not
     dependable — it rendered as a hairline sliver. Giving it its true width costs
     a little track length and makes it reliably visible. */
  @media (max-width: 749px) {
    /* 80px top/bottom is desktop spacing; on a phone it reads as dead space */
    .pi-hiw {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .pi-hiw__inner { gap: 30px; }

    /* Heading: Playfair 600, 30/39 (the clamp bottoms out at 28/1.3) */
    .pi-hiw__heading { font-size: 30px; line-height: 39px; }

    .pi-hiw__steps {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .pi-hiw__steps::-webkit-scrollbar { display: none; }

    /* Step fills the scrollport so its icon/title/text centre on the frame,
       lining up with the heading. Figma gap 20 between icon and text.
       position:relative makes it the anchor for its own arrow. */
    .pi-hiw__step {
      position: relative;
      flex: 0 0 100%;
      max-width: none;
      gap: 20px;
      scroll-snap-align: center;
    }

    /* Nutrition: 60x60 circle, radius 30; glyph stays half the circle */
    .pi-hiw__icon { width: 60px; height: 60px; }
    .pi-hiw__icon img {
      height: {{ section.settings.icon_image_size | default: 100 | times: 0.6 | round }}px;
    }
    .pi-hiw__icon svg { width: 26px; height: 26px; }

    /* Title 18/23 semibold, description 14/22 regular */
    .pi-hiw__step-title { font-size: 18px; line-height: 23px; }
    .pi-hiw__step-desc  { font-size: 14px; line-height: 22px; }

    /* Arrow vector 105.48 x 20 — the same 5.27 ratio as the desktop
       166.09 x 31.49, so the viewBox scales without distortion. */
    /* Absolutely positioned against its own step, so it takes no space in the
       flex track and can't shift the step off centre. Its right edge sits 30px
       past the step, putting ~75 of its 105.48px over the step's right side —
       visible while the step stays centred, exactly as Figma shows it.
       (Earlier attempts kept it in the flex flow, via overflow from a 20px box
       and then via negative margins; both left it invisible.) */
    .pi-hiw__arrow {
      display: block;
      position: absolute;
      z-index: 1;
      left: auto;
      right: -30px;
      top: 20px;
      bottom: auto;
      width: 105.48px;
      height: 20px;
      margin: 0;
    }

    /* Second arrow is the mirrored (valley) one and sits at the bottom of the
       step, same as desktop — the rule above would otherwise pin it to the top. */
    .pi-hiw__arrow--flip {
      top: auto;
      bottom: 0;
    }
    .pi-hiw__arrow svg {
      width: 105.48px;
      height: 20px;
    }

    /* 105.48/166.09 scales the viewBox to 0.635, which would also scale the
       stroke and dashes down (2px -> 1.27px, 6/7 -> 3.8/4.4) and leave the arrow
       looking like a hairline. Dividing by 0.635 in user units renders the same
       2px stroke and 6/7 dashes as desktop. */
    .pi-hiw__arrow-curve,
    .pi-hiw__arrow-head { stroke-width: 3.15; }
    .pi-hiw__arrow-curve { stroke-dasharray: 9.45 11; }
  }

  /* Figma mobile gutter is 18px (390 frame, 354 content) */
  @media (max-width: 600px) {
    .pi-hiw__inner { padding-inline: 18px; }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

{%- assign steps = section.blocks | where: 'type', 'step' -%}

<div class="pi-hiw" id="pi-hiw-{{ section.id }}">
  <div class="pi-hiw__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="pi-hiw__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if steps.size > 0 -%}
      <div class="pi-hiw__steps">
        {%- for block in steps -%}
          <div class="pi-hiw__step" {{ block.shopify_attributes }}>
            {%- comment -%}
              Per-step height override, for when one step's icon was exported
              differently from the others (a padded full-circle export needs 100
              where a tight glyph export needs 50). 0 = inherit the section value.
            {%- endcomment -%}
            <span class="pi-hiw__icon"{% if block.settings.icon_height > 0 %} style="--pi-hiw-icon-img: {{ block.settings.icon_height }}px;"{% endif %}>
              {%- if block.settings.icon != blank -%}
                {%- comment -%}
                  Request 300 rather than 68: the icon fills a 100px circle, so 68
                  was downscaled then stretched back up. Shopify never upscales
                  past the original, so this asks for the largest available — and
                  will serve 2x/3x automatically if the PNGs are ever re-exported
                  bigger, with no further code change.
                {%- endcomment -%}
                <picture>
                  {%- if block.settings.icon_mobile != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.icon_mobile | image_url: width: 300 }}">
                  {%- endif -%}
                  <img src="{{ block.settings.icon | image_url: width: 300 }}" alt="" loading="lazy">
                </picture>
              {%- else -%}
                {%- assign icon_slot = forloop.index0 | modulo: 3 -%}
                {%- if icon_slot == 0 -%}
                  {%- comment -%} Consultation / design: clipboard + pencil {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="5" y="3.5" width="14" height="18" rx="1.5" stroke-width="1.5"/>
                    <rect x="9" y="2" width="6" height="3" rx="1" stroke-width="1.5"/>
                    <path d="M8.5 12.5L14 7L16.5 9.5L11 15H8.5V12.5Z" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                {%- elsif icon_slot == 1 -%}
                  {%- comment -%} Tattooing process: tattoo machine {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 20L9 15" stroke-width="1.5" stroke-linecap="round"/>
                    <rect x="8" y="10" width="5" height="5" rx="1" transform="rotate(-45 8 10)" stroke-width="1.5"/>
                    <path d="M12.5 9.5L16 6C17 5 18.5 5 19.5 6C20.5 7 20.5 8.5 19.5 9.5L16 13" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M15 5L18.5 8.5" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {%- else -%}
                  {%- comment -%} Aftercare & healing: heart with pulse {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 20C12 20 4 14.5 4 9.2C4 6.3 6.2 4.5 8.5 4.5C10 4.5 11.3 5.3 12 6.5C12.7 5.3 14 4.5 15.5 4.5C17.8 4.5 20 6.3 20 9.2C20 14.5 12 20 12 20Z" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M7 11H9.5L11 8.5L13 13.5L14.5 11H17" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank or block.settings.description != blank -%}
              <div class="pi-hiw__step-text">
                {%- if block.settings.title != blank -%}
                  <h4 class="pi-hiw__step-title">{{ block.settings.title }}</h4>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="pi-hiw__step-desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- comment -%}
              The arrow lives inside its step so mobile can anchor it to that
              step's right edge with position:absolute — outside the flex flow, so
              it can overlap without affecting the track or the step's centring.
              On desktop the step is position:static, so the arrow still resolves
              against .pi-hiw__steps and its existing left/top rules apply.
            {%- endcomment -%}
            {%- unless forloop.last -%}
            <div class="pi-hiw__arrow{% if forloop.index0 == 1 %} pi-hiw__arrow--flip{% endif %}" aria-hidden="true">
              {%- comment -%}
                Figma vector 166.09 x 31.49. A cubic, not a quadratic: the arc has
                to rise ~14 to its peak just left of centre, then fall ~27 into the
                arrowhead, so it reads as bending over and coming down. The old
                symmetric Q ended almost horizontal, which is why the head pointed
                sideways. The head is angled to the curve's end tangent (~40 deg).
              {%- endcomment -%}
              <svg viewBox="0 0 166.09 31.49" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path class="pi-hiw__arrow-curve" d="M4 15 C 38 -6 118 -4 157 28" stroke="currentColor" stroke-width="2" stroke-dasharray="6 7" stroke-linecap="round"/>
                <path class="pi-hiw__arrow-head" d="M155 18 L157.6 28.4 L147 27.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            {%- endunless -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "PI How It Works",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 20, "max": 72, "step": 1, "default": 54, "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size (mobile)",
      "min": 16, "max": 48, "step": 1, "default": 28, "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding top — mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom — mobile",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Step Styles"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon stroke color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "step_gap",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Gap between steps",
      "info": "Also controls how wide each step column is, so it changes where the descriptions wrap. Figma is about 100.",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_image_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Icon image height",
      "info": "Glyph height inside the 100px circle; width follows the image's aspect ratio. Figma uses 50. Set 100 only for assets exported at the full circle size with the glyph already centred in transparent padding.",
      "default": 100
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "step_desc_color",
      "label": "Step description color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional) — Desktop"
        },
        {
          "type": "range",
          "id": "icon_height",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Icon height override",
          "info": "0 = use the section's Icon image height. Set 100 if this one icon was exported at the full circle size with the glyph already centred in transparent padding.",
          "default": 0
        },
        {
          "type": "image_picker",
          "id": "icon_mobile",
          "label": "Icon — Mobile",
          "info": "Optional. Shown at ≤749px. If empty, the desktop icon is used."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Consultation & Design Preparation", "description": "Discuss your ideas, choose the design, and finalize the perfect placement." } },
        { "type": "step", "settings": { "title": "Tattooing Process", "description": "Our artists bring your design to life with precision and high-quality ink." } },
        { "type": "step", "settings": { "title": "Aftercare & Healing", "description": "Follow expert aftercare tips to ensure smooth healing and long-lasting vibrancy." } }
      ]
    }
  ]
}
{% endschema %}
