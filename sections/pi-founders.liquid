<style>
  #shopify-section-{{ section.id }} {
    --pi-PAD-TOP: {{ section.settings.padding_top }}px;
    --pi-PAD-BOTTOM: {{ section.settings.padding_bottom }}px;
    --pi-founders-bg: {{ section.settings.bg_color }};
    --pi-founders-image-radius: {{ section.settings.image_radius }}px;
    --pi-founders-subheading-size: {{ section.settings.subheading_size }}px;
    --pi-founders-subheading-color: {{ section.settings.subheading_color }};
    --pi-founders-accent-border-color: {{ section.settings.accent_border_color }};
    --pi-founders-accent-border-width: {{ section.settings.accent_border_width }}px;
    --pi-founders-body-size: {{ section.settings.body_text_size }}px;
    --pi-founders-body-color: {{ section.settings.body_text_color }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-PAD-TOP: {{ section.settings.mobile_padding_top }}px;
      --pi-PAD-BOTTOM: {{ section.settings.mobile_padding_bottom }}px;
      --pi-founders-body-size: {{ section.settings.mobile_body_text_size }}px;
    }
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    padding: var(--pi-PAD-TOP) 0 var(--pi-PAD-BOTTOM);
    background: var(--pi-founders-bg);
  }

  /* Figma frame = 1500px content area (image 740 + gap 50 + text 710).
     max-width 1620 + 60px side padding keeps the inner content at exactly
     1500px on the 1920 design canvas, so the image renders at 740px. */
  .pi-founders {
    max-width: 1620px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3.333%;
  }

  /* Left: image — 740px (49.333% of 1500px) */
  .pi-founders__image {
    flex: 0 0 49.333%;
    aspect-ratio: 740 / 663;
    border-radius: var(--pi-founders-image-radius);
    overflow: hidden;
    background: #121212;
  }
  .pi-founders__image img,
  .pi-founders__image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Right: content — 710px (47.333% of 1500px) */
  .pi-founders__content {
    flex: 0 0 47.333%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* Subheading with left border — Proxima Nova Medium 34px */
  .pi-founders__subheading-wrap {
    border-left: var(--pi-founders-accent-border-width) solid var(--pi-founders-accent-border-color);
    padding-left: 15px;
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .pi-founders__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, sans-serif;
    font-weight: 500;
    font-size: var(--pi-founders-subheading-size);
    line-height: 44px;
    color: var(--pi-founders-subheading-color);
    margin: 0;
  }

  /* Body text — 4 paragraphs, gap 10px */
  .pi-founders__paras {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pi-founders__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: var(--pi-founders-body-size);
    line-height: 29px;
    color: var(--pi-founders-body-color);
    margin: 0;
  }
  .pi-founders__text strong { font-weight: 700; }
  .pi-founders__text p      { margin: 0; }

  @media (max-width: 1279px) {
    .pi-founders__subheading   { font-size: 28px; line-height: 38px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 60px 0; }
    .pi-founders               { flex-direction: column; padding: 0 32px; gap: 40px; }
    /* Keep the full framed image (torn top/bottom edges) at every size —
       let the 740/663 aspect-ratio govern instead of a fixed height that
       would crop the torn edges off. */
    .pi-founders__image        { flex: none; width: 100%; height: auto; }
    .pi-founders__content      { flex: none; width: 100%; }
    .pi-founders__subheading   { font-size: 26px; line-height: 34px; }
  }

  @media (max-width: 749px) {
    .pi-founders               { padding: 0 20px; gap: 30px; }
    /* Figma mobile: content block internal gap = 20px */
    .pi-founders__content      { gap: 20px; }
    .pi-founders__subheading   { font-size: 22px; line-height: 30px; }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  .pi-founders__subheading {
    text-align: {{ section.settings.text_alignment }};
  }
</style>

<div class="pi-founders">

  <div class="pi-founders__image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1480 }}"
        alt="{{ section.settings.image.alt | default: 'Behind Puerto Ink' | escape }}"
        loading="lazy"
        width="740"
        height="663"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="pi-founders__content">

    {%- if section.settings.subheading != blank -%}
      <div class="pi-founders__subheading-wrap">
        <h2 class="pi-founders__subheading">{{ section.settings.subheading }}</h2>
      </div>
    {%- endif -%}

    <div class="pi-founders__paras">
      {%- if section.settings.text_1 != blank -%}
        <div class="pi-founders__text">{{ section.settings.text_1 }}</div>
      {%- elsif section.settings.text != blank -%}
        <div class="pi-founders__text">{{ section.settings.text | newline_to_br }}</div>
      {%- endif -%}
      {%- if section.settings.text_2 != blank -%}
        <div class="pi-founders__text">{{ section.settings.text_2 }}</div>
      {%- endif -%}
      {%- if section.settings.text_3 != blank -%}
        <div class="pi-founders__text">{{ section.settings.text_3 }}</div>
      {%- endif -%}
      {%- if section.settings.text_4 != blank -%}
        <div class="pi-founders__text">{{ section.settings.text_4 }}</div>
      {%- endif -%}
    </div>

  </div>

</div>

{% schema %}
{
  "name": "PI Founders",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Behind Puerto Ink"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "<p>Puerto Ink was founded in <strong>2016</strong> by two brothers, <strong>Vangelis and Michalis</strong>, from <strong>Heraklion, Crete</strong>. With a deep passion for art and craftsmanship, they started their journey with a vision to create a <strong>tattoo and piercing studio</strong> that blended creativity, precision, and professionalism.</p>"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "<p>What began as a small local studio quickly gained recognition for its high-quality artistry and customer experience. Driven by innovation and dedication, they opened their <strong>first studio in Heraklion</strong>, setting the foundation for what would become a renowned name in the industry.</p>"
    },
    {
      "type": "richtext",
      "id": "text_3",
      "label": "Paragraph 3",
      "default": "<p>In six years, they expanded internationally, opening a studio in <strong>Antwerp, Belgium</strong>, followed by <strong>Amsterdam and Athens</strong>, establishing Puerto Ink as a global brand.</p>"
    },
    {
      "type": "richtext",
      "id": "text_4",
      "label": "Paragraph 4",
      "default": "<p>Today, with a team of <strong>35+ skilled professionals</strong>, Puerto Ink continues to grow, offering <strong>world-class tattoos, piercings, and premium jewelry</strong> while staying true to its artistic roots.</p>"
    },
    {
      "type": "header",
      "content": "Legacy field (kept for backwards compat)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text (plain — use paragraphs above instead)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_border_color",
      "label": "Accent border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "accent_border_width",
      "label": "Accent border width",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Body Text"
    },
    {
      "type": "range",
      "id": "body_text_size",
      "label": "Body text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "mobile_body_text_size",
      "label": "Mobile body text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "PI Founders"
    }
  ]
}
{% endschema %}
