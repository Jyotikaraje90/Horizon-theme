
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

<style>
  .pi-jb {
    position: relative;
    background: linear-gradient(to right, #0A2535 0%, #0D3248 45%, #12263A 75%, #1C2030 100%);
    overflow: hidden;
  }

  /* Diagonal diamond grid pattern */
  .pi-jb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(-45deg, rgba(255,255,255,0.045) 1px, transparent 1px);
    background-size: 90px 90px;
    pointer-events: none;
    z-index: 0;
  }

  /* Warm amber glow near right image */
  .pi-jb__glow {
    position: absolute;
    right: 8%;
    top: 50%;
    transform: translateY(-50%);
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(180, 110, 20, 0.28) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .pi-jb__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    align-items: center;
    gap: 40px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 40px;
    min-height: 460px;
    box-sizing: border-box;
  }

  /* Left / Right image columns */
  .pi-jb__img-col {
    position: relative;
  }

  .pi-jb__img-col--right {
    display: flex;
    justify-content: flex-end;
  }

  /* White outline frame offset behind image */
  .pi-jb__frame {
    position: relative;
    display: inline-block;
  }

  .pi-jb__frame::before {
    content: '';
    position: absolute;
    border: 2px solid rgba(255, 255, 255, 0.55);
    z-index: -1;
  }

  .pi-jb__img-col--left .pi-jb__frame::before {
    top: -14px;
    left: -14px;
    right: 14px;
    bottom: 14px;
  }

  .pi-jb__img-col--right .pi-jb__frame::before {
    top: 14px;
    left: 14px;
    right: -14px;
    bottom: -14px;
  }

  .pi-jb__frame img,
  .pi-jb__frame .placeholder-svg {
    display: block;
    width: 260px;
    height: 300px;
    object-fit: cover;
  }

  /* Center content */
  .pi-jb__center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .pi-jb__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 3.5vw, 56px);
    font-weight: 700;
    line-height: 1.15;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
  }

  .pi-jb__subheading {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    max-width: 380px;
  }

  .pi-jb__btn {
    display: inline-block;
    background: #ffffff;
    color: #000000;
    padding: 14px 36px;
    border-radius: 8px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
    border: 2px solid #ffffff;
  }

  .pi-jb__btn:hover {
    background: transparent;
    color: #ffffff;
  }

  @media (max-width: 989px) {
    .pi-jb__inner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 48px 24px;
      gap: 32px;
    }
    .pi-jb__img-col--right { justify-content: center; }
    .pi-jb__frame img,
    .pi-jb__frame .placeholder-svg { width: 200px; height: 240px; }
  }
</style>

<div class="pi-jb">
  <div class="pi-jb__glow"></div>
  <div class="pi-jb__inner">

    <div class="pi-jb__img-col pi-jb__img-col--left">
      <div class="pi-jb__frame">
        {%- if section.settings.left_image != blank -%}
          <img
            src="{{ section.settings.left_image | image_url: width: 520 }}"
            alt="{{ section.settings.left_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="pi-jb__center">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-jb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pi-jb__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="pi-jb__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="pi-jb__img-col pi-jb__img-col--right">
      <div class="pi-jb__frame">
        {%- if section.settings.right_image != blank -%}
          <img
            src="{{ section.settings.right_image | image_url: width: 520 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "PI Jewelry Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "header", "content": "Center content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury Piercing Jewelry For Every Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium designs tailored for elegance and everyday style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Discover More"
    },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" }
  ],
  "presets": [{ "name": "PI Jewelry Banner" }]
}
{% endschema %}
