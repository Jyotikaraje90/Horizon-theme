<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
  .pi-jb {
    position: relative;
    background: linear-gradient(to right, #0A2535 0%, #0D3248 40%, #122033 70%, #1A1F2E 100%);
    overflow: hidden;
    min-height: 500px;
  }

  /* Diagonal line pattern */
  .pi-jb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(-45deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 100px 100px;
    pointer-events: none;
    z-index: 0;
  }

  /* Warm amber glow — right side */
  .pi-jb__glow {
    position: absolute;
    right: 6%;
    top: 50%;
    transform: translateY(-50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(180, 110, 20, 0.32) 0%, transparent 68%);
    pointer-events: none;
    z-index: 0;
  }

  .pi-jb__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.7fr 1fr;
    align-items: center;
    gap: 0;
    max-width: 1500px;
    margin: 0 auto;
    min-height: 500px;
    box-sizing: border-box;
  }

  /* ─── Image columns ─────────────────────────── */
  .pi-jb__img-col {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 50px 0;
  }

  /* Frame wrapper — image fills the box */
  .pi-jb__frame {
    position: relative;
    width: 300px;
    height: 395px;
    flex-shrink: 0;
  }

  /* Image fills entire frame container */
  .pi-jb__frame img,
  .pi-jb__frame .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    display: block;
  }

  /*
    White border sits ON TOP of the image (z-index: 2).
    Left image: border anchored at top-left → image bleeds past border at bottom-right.
    Right image: border anchored at bottom-right → image bleeds past border at top-left.
    The 28px offset is the "bleed" gap (matching Figma ~16-20px proportionally).
  */

  /* Left — frame at upper-left corner */
  .pi-jb__img-col--left .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% - 28px);
    height: calc(100% - 28px);
    border: 3px solid #FFFFFF;
    z-index: 2;
    pointer-events: none;
  }

  /* Right — frame at lower-right corner */
  .pi-jb__img-col--right .pi-jb__frame::before {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: calc(100% - 28px);
    height: calc(100% - 28px);
    border: 3px solid #FFFFFF;
    z-index: 2;
    pointer-events: none;
  }

  /* ─── Center content ─────────────────────────── */
  .pi-jb__center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 50px 40px;
  }

  .pi-jb__heading {
    font-family: 'Playfair Display', serif;
    font-size: 54px;
    font-weight: 600;
    line-height: 70px;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
    width: 100%;
  }

  .pi-jb__subheading {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 0;
  }

  .pi-jb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    color: #000000;
    height: 55px;
    padding: 16px 32px;
    border-radius: 8px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .pi-jb__btn:hover {
    background: #f0f0f0;
    color: #000000;
    text-decoration: none;
  }

  .pi-jb__img-col--right {
    justify-content: flex-end;
    padding-right: 60px;
  }

  .pi-jb__img-col--left {
    padding-left: 60px;
  }

  /* ─── Responsive ─────────────────────────── */
  @media (max-width: 1100px) {
    .pi-jb__heading { font-size: 42px; line-height: 54px; }
    .pi-jb__frame { width: 220px; height: 290px; }
    .pi-jb__img-col--left { padding-left: 30px; }
    .pi-jb__img-col--right { padding-right: 30px; }
  }

  @media (max-width: 768px) {
    .pi-jb__inner {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .pi-jb__img-col--left,
    .pi-jb__img-col--right {
      display: none;
    }
    .pi-jb__center { padding: 48px 24px; }
    .pi-jb__heading { font-size: 36px; line-height: 46px; }
  }
</style>

<div class="pi-jb">
  <div class="pi-jb__glow"></div>
  <div class="pi-jb__inner">

    {%- comment -%} Left image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--left">
      <div class="pi-jb__frame">
        {%- if section.settings.left_image != blank -%}
          <img
            src="{{ section.settings.left_image | image_url: width: 600 }}"
            alt="{{ section.settings.left_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Center content {%- endcomment -%}
    <div class="pi-jb__center">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-jb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pi-jb__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="pi-jb__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Right image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--right">
      <div class="pi-jb__frame">
        {%- if section.settings.right_image != blank -%}
          <img
            src="{{ section.settings.right_image | image_url: width: 600 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "PI Jewelry Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "header", "content": "Center content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury Piercing Jewelry For Every Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium designs tailored for elegance and everyday style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Discover More"
    },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" }
  ],
  "presets": [{ "name": "PI Jewelry Banner" }]
}
{% endschema %}
