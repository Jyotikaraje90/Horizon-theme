<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --pi-jb-pad-top: {{ section.settings.padding_top }}px;
    --pi-jb-pad-bottom: {{ section.settings.padding_bottom }}px;
    --pi-jb-min-height: {{ section.settings.min_height }}px;
    --pi-jb-bg-color: {{ section.settings.bg_color }};
    --pi-jb-heading-size: {{ section.settings.heading_size }}px;
    /* Never overridden — the laptop/tablet steps scale from this so they can't
       collide with the mobile --pi-jb-heading-size override below. */
    --pi-jb-heading-base: {{ section.settings.heading_size }}px;
    --pi-jb-heading-color: {{ section.settings.heading_color }};
    --pi-jb-subheading-size: {{ section.settings.subheading_size }}px;
    --pi-jb-subheading-color: {{ section.settings.subheading_color }};
    --pi-jb-btn-bg: {{ section.settings.btn_bg }};
    --pi-jb-btn-text: {{ section.settings.btn_text }};
    --pi-jb-btn-radius: {{ section.settings.btn_radius }}px;
    --pi-jb-btn-size: {{ section.settings.btn_size }}px;
    --pi-jb-frame-border-color: {{ section.settings.frame_border_color }};
    --pi-jb-btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --pi-jb-btn-hover-text: {{ section.settings.btn_hover_text }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-jb-pad-top: {{ section.settings.mobile_padding_top }}px;
      --pi-jb-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      /* Moved from 989px to 749px so this section switches to its mobile
         heading size at the same breakpoint as every other homepage section. */
      --pi-jb-heading-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
</style>

<style>
  /* ─── Banner wrapper ─────────────────────────── */
  .pi-jb {
    position: relative;
    background: linear-gradient(110deg, #062030 0%, #0B2B40 35%, #081828 65%, #060D18 100%);
    overflow: hidden;
  }

  .pi-jb--has-bg {
    background: var(--pi-jb-bg-color, #000000);
  }

  /* ─── Background image layer ─────────────────── */
  .pi-jb__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pi-jb__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Warm amber glow — right (hidden when bg image is set) */
  .pi-jb__glow {
    position: absolute;
    right: 2%;
    top: 50%;
    transform: translateY(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(180, 110, 20, 0.45) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* ─── Grid ───────────────────────────────────── */
  .pi-jb__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.57fr 1fr;
    align-items: stretch;          /* columns fill full banner height */
    max-width: 1920px;
    margin: 0 auto;
    min-height: var(--pi-jb-min-height, 650px);
  }

  /* ─── Image columns ──────────────────────────── */
  .pi-jb__img-col {
    position: relative;            /* anchor for absolute frame */
  }

  /* .pi-jb__frame sized to exact Figma dimensions (365×434px per frame, 16px/20px double-frame offset) */
  .pi-jb__frame {
    position: absolute;
    overflow: hidden;
  }

  /* LEFT container: starts at Figma frame position (top:50px left:110px) */
  .pi-jb__img-col--left .pi-jb__frame {
    left: 110px;
    top: 50px;
    width: 387px;  /* 365px + 22px image offset */
    height: 456px; /* 434px + 22px image offset */
  }

  /* RIGHT container: 22px above/left of Figma frame position (top:166px left:62px) */
  .pi-jb__img-col--right .pi-jb__frame {
    left: 40px;
    top: 144px;
    width: 387px;  /* 365px + 22px image offset */
    height: 456px; /* 434px + 22px image offset */
  }

  /* Image fills the full frame container */
  .pi-jb__frame img,
  .pi-jb__frame .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 2;
  }

  /* LEFT — image pushed 22px right+down; frame sits at container top-left (= Figma position) */
  .pi-jb__img-col--left .pi-jb__frame img,
  .pi-jb__img-col--left .pi-jb__frame .placeholder-svg {
    clip-path: inset(22px 0 0 22px);
  }

  /* LEFT — frame border exactly 365×434 at top-left of container = Figma: top:50 left:110 */
  .pi-jb__img-col--left .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 22px;
    bottom: 22px;
    border: 3px solid var(--pi-jb-frame-border-color, #FFFFFF);
    z-index: 1;
    pointer-events: none;
  }

  .pi-jb__img-col--left .pi-jb__frame::after { content: none; }

  /* RIGHT — image at container top-left; frame sits 22px right+down (= Figma: top:166 left:62) */
  .pi-jb__img-col--right .pi-jb__frame img,
  .pi-jb__img-col--right .pi-jb__frame .placeholder-svg {
    clip-path: inset(0 22px 22px 0);
  }

  /* RIGHT — frame border exactly 365×434 offset 22px from top-left = Figma: top:166 left:62 */
  .pi-jb__img-col--right .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 22px;
    right: 0;
    bottom: 0;
    border: 3px solid var(--pi-jb-frame-border-color, #FFFFFF);
    z-index: 1;
    pointer-events: none;
  }

  .pi-jb__img-col--right .pi-jb__frame::after { content: none; }

  /* ─── Center content ─────────────────────────── */
  .pi-jb__center {
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: var(--pi-jb-pad-top, 60px) 40px var(--pi-jb-pad-bottom, 60px);
  }

  .pi-jb__heading {
    font-family: 'Playfair Display', serif;
    font-size: var(--pi-jb-heading-size, 54px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--pi-jb-heading-color, #FFFFFF);
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
  }

  .pi-jb__subheading {
    font-family: 'Nunito Sans', sans-serif;
    font-size: var(--pi-jb-subheading-size, 18px);
    font-weight: 400;
    line-height: 29px;
    color: var(--pi-jb-subheading-color, #FFFFFF);
    margin: 0;
    letter-spacing: 0;
  }

  .pi-jb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--pi-jb-btn-bg, #FFFFFF);
    color: var(--pi-jb-btn-text, #000000);
    height: 55px;
    padding: 16px 32px;
    border-radius: var(--pi-jb-btn-radius, 8px);
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Nunito Sans', sans-serif;
    font-size: var(--pi-jb-btn-size, 16px);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }

  .pi-jb__btn:hover {
    background: var(--pi-jb-btn-hover-bg, #f0f0f0);
    color: var(--pi-jb-btn-hover-text, #000000);
    text-decoration: none;
  }

  .pi-jb__mobile-imgs {
    display: none;
  }

  /* ─── Responsive ─────────────────────────── */
  /* Shared laptop heading step (same breakpoint in every homepage section) */
  @media (max-width: 1279px) {
    .pi-jb__heading { font-size: calc(var(--pi-jb-heading-base, 54px) * 0.82); line-height: 1.3; }
  }

  @media (max-width: 989px) {
    .pi-jb__inner { grid-template-columns: 1fr; min-height: unset; }
    .pi-jb__img-col--left,
    .pi-jb__img-col--right { display: none; }
    .pi-jb__center { padding: 48px 40px; }

    .pi-jb__heading {
      font-size: clamp(28px, 5vw, calc(var(--pi-jb-heading-base, 54px) * 0.89));
      line-height: 1.2;
    }

    .pi-jb__subheading {
      font-family: 'Proxima Nova', 'Nunito Sans', sans-serif;
      font-size: 18px;
      line-height: 29px;
    }

    .pi-jb {
      overflow: visible;
    }

    {%- if section.settings.mobile_background_image != blank -%}
    .pi-jb__bg img { content: url('{{ section.settings.mobile_background_image | image_url: width: 800 }}'); }
    {%- endif -%}

    .pi-jb__mobile-imgs {
      display: flex;
      flex-direction: row;
      gap: 14px;
      padding: 0 40px;
      margin-bottom: 0;
      padding-bottom: 40px;
      position: relative;
      z-index: 1;
    }

    .pi-jb__mobile-img-wrap {
      flex: 1;
      /* Proportional instead of a fixed 202px height, which made the images
         change shape at every viewport width (135x202 at 320, 359x202 at
         768). 170/202 is the ratio from the design at 390px. */
      aspect-ratio: 170 / 202;
      overflow: hidden;
      position: relative;
      isolation: isolate;
    }

    /* Left image: frame top-left, image at bottom-right */
    .pi-jb__mobile-img-wrap:first-child::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 12px; bottom: 12px;
      border: 2px solid var(--pi-jb-frame-border-color, #FFFFFF);
      z-index: -1;
      pointer-events: none;
    }

    .pi-jb__mobile-img-wrap:first-child img,
    .pi-jb__mobile-img-wrap:first-child .placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      clip-path: inset(12px 0 0 12px);
    }

    /* Right image: frame bottom-right, image at top-left */
    .pi-jb__mobile-img-wrap:last-child::before {
      content: '';
      position: absolute;
      top: 12px; left: 12px; right: 0; bottom: 0;
      border: 2px solid var(--pi-jb-frame-border-color, #FFFFFF);
      z-index: -1;
      pointer-events: none;
    }

    .pi-jb__mobile-img-wrap:last-child img,
    .pi-jb__mobile-img-wrap:last-child .placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      clip-path: inset(0 12px 12px 0);
    }
  }

  @media (max-width: 749px) {
    .pi-jb__center { padding: var(--pi-jb-pad-top, 40px) 18px var(--pi-jb-pad-bottom, 30px); }
    /* Longhand bottom padding, so this shorthand does not wipe out the
       40px padding-bottom set in the 989px block above */
    .pi-jb__mobile-imgs { padding: 0 18px 40px; }
  }

  /* Shared mobile type scale — matches every other homepage section across
     the whole mobile range. Kept last so it wins over the blocks above. */
  @media (max-width: 768px) {
    .pi-jb__heading {
      font-size: var(--pi-jb-heading-size, 30px);
      /* 1.3 x 30px = the 39px in the Figma spec, and it still tracks the
         mobile heading size setting if that changes */
      line-height: 1.3;
      /* Spread the words evenly across the lines instead of leaving a
         single short word ("LOOK") stranded on the last line */
      text-wrap: balance;
    }
    /* Body copy, so it takes the shared para size */
    .pi-jb__subheading {
      font-size: 16px;
      line-height: 26px;
    }
    /* Mobile Btn: hug width, 50px tall, 16/32 padding.
       16 + 18 line-height + 16 = the 50px height from the spec. */
    .pi-jb__btn {
      height: 50px;
      padding: 16px 32px;
      font-size: 14px;
      line-height: 18px;
    }
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

<div class="pi-jb pi-jb-{{ section.id }}{% if section.settings.background_image != blank %} pi-jb--has-bg{% endif %}">

  {%- if section.settings.background_image != blank -%}
    <div class="pi-jb__bg">
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="{{ section.settings.background_image.alt | default: '' | escape }}"
        width="1920"
        height="650"
        loading="lazy"
      >
    </div>
  {%- endif -%}

{%- unless section.settings.background_image != blank -%}
    <div class="pi-jb__glow"></div>
  {%- endunless -%}
  <div class="pi-jb__inner">

    {%- comment -%} Left image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--left">
      <div class="pi-jb__frame">
        {%- if section.settings.left_image != blank -%}
          <img
            src="{{ section.settings.left_image | image_url: width: 600 }}"
            alt="{{ section.settings.left_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Center content {%- endcomment -%}
    <div class="pi-jb__center">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-jb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pi-jb__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="pi-jb__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Right image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--right">
      <div class="pi-jb__frame">
        {%- if section.settings.right_image != blank -%}
          <img
            src="{{ section.settings.right_image | image_url: width: 600 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="pi-jb__mobile-imgs">
    <div class="pi-jb__mobile-img-wrap">
      {%- if section.settings.left_image != blank -%}
        <img src="{{ section.settings.left_image | image_url: width: 400 }}" alt="{{ section.settings.left_image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="pi-jb__mobile-img-wrap">
      {%- if section.settings.right_image != blank -%}
        <img src="{{ section.settings.right_image | image_url: width: 400 }}" alt="{{ section.settings.right_image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "PI Jewelry Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_background_image", "label": "Background image (mobile)" },
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "header", "content": "Center content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury Piercing Jewelry For Every Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium designs tailored for elegance and everyday style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Discover More"
    },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Section minimum height",
      "default": 650
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color (no image)",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 54
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (mobile)",
      "default": 30
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Subheading font size",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "btn_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Button Hover Background",
      "default": "#B49146"
    },
    {
      "type": "color",
      "id": "btn_hover_text",
      "label": "Button Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image Frames"
    },
    {
      "type": "color",
      "id": "frame_border_color",
      "label": "Frame border color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [{ "name": "PI Jewelry Banner" }]
}
{% endschema %}
