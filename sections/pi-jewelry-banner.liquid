<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
  /* ─── Banner wrapper ─────────────────────────── */
  .pi-jb {
    position: relative;
    background: linear-gradient(110deg, #062030 0%, #0B2B40 35%, #081828 65%, #060D18 100%);
    overflow: hidden;
  }

  .pi-jb--has-bg {
    background: #000;
  }

  /* ─── Background image layer ─────────────────── */
  .pi-jb__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pi-jb__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Warm amber glow — right (hidden when bg image is set) */
  .pi-jb__glow {
    position: absolute;
    right: 2%;
    top: 50%;
    transform: translateY(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(180, 110, 20, 0.45) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* ─── Grid ───────────────────────────────────── */
  .pi-jb__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.57fr 1fr;
    align-items: stretch;          /* columns fill full banner height */
    max-width: 1920px;
    margin: 0 auto;
    min-height: 650px;
  }

  /* ─── Image columns ──────────────────────────── */
  .pi-jb__img-col {
    position: relative;            /* anchor for absolute frame */
  }

  /* .pi-jb__frame sized to exact Figma dimensions (365×434px per frame, 16px/20px double-frame offset) */
  .pi-jb__frame {
    position: absolute;
    overflow: hidden;
  }

  /* LEFT container: starts at Figma frame position (top:50px left:110px) */
  .pi-jb__img-col--left .pi-jb__frame {
    left: 110px;
    top: 50px;
    width: 387px;  /* 365px + 22px image offset */
    height: 456px; /* 434px + 22px image offset */
  }

  /* RIGHT container: 22px above/left of Figma frame position (top:166px left:62px) */
  .pi-jb__img-col--right .pi-jb__frame {
    left: 40px;
    top: 144px;
    width: 387px;  /* 365px + 22px image offset */
    height: 456px; /* 434px + 22px image offset */
  }

  /* Image fills the full frame container */
  .pi-jb__frame img,
  .pi-jb__frame .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 2;
  }

  /* LEFT — image pushed 22px right+down; frame sits at container top-left (= Figma position) */
  .pi-jb__img-col--left .pi-jb__frame img,
  .pi-jb__img-col--left .pi-jb__frame .placeholder-svg {
    clip-path: inset(22px 0 0 22px);
  }

  /* LEFT — frame border exactly 365×434 at top-left of container = Figma: top:50 left:110 */
  .pi-jb__img-col--left .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 22px;
    bottom: 22px;
    border: 3px solid #FFFFFF;
    z-index: 1;
    pointer-events: none;
  }

  .pi-jb__img-col--left .pi-jb__frame::after { content: none; }

  /* RIGHT — image at container top-left; frame sits 22px right+down (= Figma: top:166 left:62) */
  .pi-jb__img-col--right .pi-jb__frame img,
  .pi-jb__img-col--right .pi-jb__frame .placeholder-svg {
    clip-path: inset(0 22px 22px 0);
  }

  /* RIGHT — frame border exactly 365×434 offset 22px from top-left = Figma: top:166 left:62 */
  .pi-jb__img-col--right .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 22px;
    right: 0;
    bottom: 0;
    border: 3px solid #FFFFFF;
    z-index: 1;
    pointer-events: none;
  }

  .pi-jb__img-col--right .pi-jb__frame::after { content: none; }

  /* ─── Center content ─────────────────────────── */
  .pi-jb__center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 60px 40px;
  }

  .pi-jb__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 3.75vw, 54px);
    font-weight: 600;
    line-height: 1.3;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
  }

  .pi-jb__subheading {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 0;
  }

  .pi-jb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    color: #000000;
    height: 55px;
    padding: 16px 32px;
    border-radius: 8px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }

  .pi-jb__btn:hover {
    background: #f0f0f0;
    color: #000000;
    text-decoration: none;
  }

  /* ─── Responsive ─────────────────────────── */
  @media (max-width: 989px) {
    .pi-jb__img-col--left .pi-jb__frame { left: 20px; top: 24px; width: 222px; height: 262px; }
    .pi-jb__img-col--right .pi-jb__frame { left: 12px; top: 24px; width: 222px; height: 262px; }
    .pi-jb__center { padding: 48px 24px; }
  }

  .pi-jb__mobile-imgs {
    display: none;
  }

  @media (max-width: 768px) {
    .pi-jb__inner { grid-template-columns: 1fr; min-height: unset; }
    .pi-jb__img-col--left,
    .pi-jb__img-col--right { display: none; }
    .pi-jb__center { padding: 40px 18px 30px; }

    .pi-jb {
      overflow: visible;
    }

    .pi-jb__mobile-imgs {
      display: flex;
      flex-direction: row;
      gap: 14px;
      padding: 0 18px;
      margin-bottom: -28px;
      position: relative;
      z-index: 1;
    }

    .pi-jb__mobile-img-wrap {
      flex: 1;
      height: 202px;
      overflow: hidden;
      position: relative;
    }

    /* Left image: frame bottom-left, image at top-right */
    .pi-jb__mobile-img-wrap:first-child::before {
      content: '';
      position: absolute;
      top: 12px; left: 0; right: 12px; bottom: 0;
      border: 2px solid #FFFFFF;
      z-index: 3;
      pointer-events: none;
    }

    .pi-jb__mobile-img-wrap:first-child img,
    .pi-jb__mobile-img-wrap:first-child .placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      clip-path: inset(0 0 12px 12px);
    }

    /* Right image: frame top-right, image at bottom-left */
    .pi-jb__mobile-img-wrap:last-child::before {
      content: '';
      position: absolute;
      top: 0; left: 12px; right: 0; bottom: 12px;
      border: 2px solid #FFFFFF;
      z-index: 3;
      pointer-events: none;
    }

    .pi-jb__mobile-img-wrap:last-child img,
    .pi-jb__mobile-img-wrap:last-child .placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      clip-path: inset(12px 12px 0 0);
    }
  }
</style>

<div class="pi-jb{% if section.settings.background_image != blank %} pi-jb--has-bg{% endif %}">

  {%- if section.settings.background_image != blank -%}
    <div class="pi-jb__bg">
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="{{ section.settings.background_image.alt | default: '' | escape }}"
        width="1920"
        height="650"
        loading="lazy"
      >
    </div>
  {%- endif -%}

{%- unless section.settings.background_image != blank -%}
    <div class="pi-jb__glow"></div>
  {%- endunless -%}
  <div class="pi-jb__inner">

    {%- comment -%} Left image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--left">
      <div class="pi-jb__frame">
        {%- if section.settings.left_image != blank -%}
          <img
            src="{{ section.settings.left_image | image_url: width: 600 }}"
            alt="{{ section.settings.left_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Center content {%- endcomment -%}
    <div class="pi-jb__center">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-jb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pi-jb__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="pi-jb__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Right image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--right">
      <div class="pi-jb__frame">
        {%- if section.settings.right_image != blank -%}
          <img
            src="{{ section.settings.right_image | image_url: width: 600 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="pi-jb__mobile-imgs">
    <div class="pi-jb__mobile-img-wrap">
      {%- if section.settings.left_image != blank -%}
        <img src="{{ section.settings.left_image | image_url: width: 400 }}" alt="{{ section.settings.left_image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="pi-jb__mobile-img-wrap">
      {%- if section.settings.right_image != blank -%}
        <img src="{{ section.settings.right_image | image_url: width: 400 }}" alt="{{ section.settings.right_image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "PI Jewelry Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "header", "content": "Center content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury Piercing Jewelry For Every Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium designs tailored for elegance and everyday style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Discover More"
    },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" }
  ],
  "presets": [{ "name": "PI Jewelry Banner" }]
}
{% endschema %}
