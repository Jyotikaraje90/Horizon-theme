<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
  /* ─── Banner wrapper ─────────────────────────── */
  .pi-jb {
    position: relative;
    background: linear-gradient(110deg, #062030 0%, #0B2B40 35%, #081828 65%, #060D18 100%);
    overflow: hidden;
  }

  /* Diagonal line grid */
  .pi-jb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, rgba(255,255,255,0.055) 1px, transparent 1px),
      linear-gradient(-45deg, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 120px 120px;
    pointer-events: none;
    z-index: 0;
  }

  /* Warm amber glow — right */
  .pi-jb__glow {
    position: absolute;
    right: 2%;
    top: 50%;
    transform: translateY(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(180, 110, 20, 0.45) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* ─── Diagonal vector lines (Figma: Vector 1 & 2) ──── */
  .pi-jb__vector {
    position: absolute;
    width: 1724.66px;
    height: 1122.24px;
    border: 2px solid #4D4D4D;
    pointer-events: none;
    z-index: 0;
  }

  .pi-jb__vector--1 {
    top: -562px;
    left: 206px;
    transform: rotate(-110.13deg);
  }

  .pi-jb__vector--2 {
    top: -351px;
    left: -277px;
    transform: rotate(-15.1deg);
  }

  /* ─── Grid ───────────────────────────────────── */
  .pi-jb__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.57fr 1fr;
    align-items: stretch;          /* columns fill full banner height */
    max-width: 1500px;
    margin: 0 auto;
    min-height: 650px;
  }

  /* ─── Image columns ──────────────────────────── */
  .pi-jb__img-col {
    position: relative;            /* anchor for absolute frame */
  }

  /*
    .pi-jb__frame is absolutely positioned to fill the column,
    with controlled insets from section edges and top/bottom.
    overflow:hidden clips the oversized L-bracket pseudo-elements.
  */
  .pi-jb__frame {
    position: absolute;
    overflow: hidden;
    top: 40px;
    bottom: 40px;
  }

  .pi-jb__img-col--left .pi-jb__frame {
    left: 40px;   /* gap from section's left edge */
    right: 0;
  }

  .pi-jb__img-col--right .pi-jb__frame {
    left: 0;
    right: 40px;  /* gap from section's right edge */
  }

  /* Image fills the full frame container — clip-path restricts visible area to Frame 2 */
  .pi-jb__frame img,
  .pi-jb__frame .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 1;
  }

  /* LEFT — clip image to lower-right (Frame 2 area) */
  .pi-jb__img-col--left .pi-jb__frame img,
  .pi-jb__img-col--left .pi-jb__frame .placeholder-svg {
    clip-path: inset(32px 14px 14px 32px);
  }

  /* LEFT — Frame 1: upper-left decorative corner */
  .pi-jb__img-col--left .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 14px;
    right: 32px;
    bottom: 32px;
    border: 3px solid #FFFFFF;
    z-index: 2;
    pointer-events: none;
  }

  /* LEFT — Frame 2: lower-right border, sits on image edge */
  .pi-jb__img-col--left .pi-jb__frame::after {
    content: '';
    position: absolute;
    top: 32px;
    left: 32px;
    right: 14px;
    bottom: 14px;
    border: 3px solid #FFFFFF;
    z-index: 2;
    pointer-events: none;
  }

  /* RIGHT — clip image to lower-left (Frame 2 area, mirrored) */
  .pi-jb__img-col--right .pi-jb__frame img,
  .pi-jb__img-col--right .pi-jb__frame .placeholder-svg {
    clip-path: inset(32px 32px 14px 14px);
  }

  /* RIGHT — Frame 1: upper-right decorative corner */
  .pi-jb__img-col--right .pi-jb__frame::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 32px;
    right: 14px;
    bottom: 32px;
    border: 3px solid #FFFFFF;
    z-index: 2;
    pointer-events: none;
  }

  /* RIGHT — Frame 2: lower-left border, sits on image edge */
  .pi-jb__img-col--right .pi-jb__frame::after {
    content: '';
    position: absolute;
    top: 32px;
    left: 14px;
    right: 32px;
    bottom: 14px;
    border: 3px solid #FFFFFF;
    z-index: 2;
    pointer-events: none;
  }

  /* ─── Center content ─────────────────────────── */
  .pi-jb__center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 60px 40px;
  }

  .pi-jb__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 3.75vw, 54px);
    font-weight: 600;
    line-height: 1.3;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
  }

  .pi-jb__subheading {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 0;
  }

  .pi-jb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    color: #000000;
    height: 55px;
    padding: 16px 32px;
    border-radius: 8px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }

  .pi-jb__btn:hover {
    background: #f0f0f0;
    color: #000000;
    text-decoration: none;
  }

  /* ─── Responsive ─────────────────────────── */
  @media (max-width: 989px) {
    .pi-jb__frame { top: 24px; bottom: 24px; }
    .pi-jb__img-col--left .pi-jb__frame { left: 20px; }
    .pi-jb__img-col--right .pi-jb__frame { right: 20px; }
    .pi-jb__center { padding: 48px 24px; }
  }

  @media (max-width: 768px) {
    .pi-jb__inner { grid-template-columns: 1fr; min-height: unset; }
    .pi-jb__img-col--left,
    .pi-jb__img-col--right { display: none; }
    .pi-jb__center { padding: 60px 24px; }
  }
</style>

<div class="pi-jb">
  <div class="pi-jb__vector pi-jb__vector--1"></div>
  <div class="pi-jb__vector pi-jb__vector--2"></div>
  <div class="pi-jb__glow"></div>
  <div class="pi-jb__inner">

    {%- comment -%} Left image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--left">
      <div class="pi-jb__frame">
        {%- if section.settings.left_image != blank -%}
          <img
            src="{{ section.settings.left_image | image_url: width: 600 }}"
            alt="{{ section.settings.left_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Center content {%- endcomment -%}
    <div class="pi-jb__center">
      {%- if section.settings.heading != blank -%}
        <h2 class="pi-jb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pi-jb__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="pi-jb__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Right image {%- endcomment -%}
    <div class="pi-jb__img-col pi-jb__img-col--right">
      <div class="pi-jb__frame">
        {%- if section.settings.right_image != blank -%}
          <img
            src="{{ section.settings.right_image | image_url: width: 600 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "PI Jewelry Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "header", "content": "Center content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury Piercing Jewelry For Every Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium designs tailored for elegance and everyday style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Discover More"
    },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" }
  ],
  "presets": [{ "name": "PI Jewelry Banner" }]
}
{% endschema %}
