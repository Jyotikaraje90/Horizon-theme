{% assign banner = product.metafields.custom.hero_banner.value %}

{% if banner %}
<div class="hero-banner-meta">
  {% if banner.image.value != blank %}
    <img src="{{ banner.image.value | image_url: width: 1200 }}" alt="{{ banner.heading.value }}">
  {% endif %}
  
  <p class="subheading">{{ banner.subheading.value }}</p>

  <h2>{{ section.settings.custom_heading | default: banner.heading.value }}</h2>

  <p>{{ banner.description.value }}</p>

  {% if section.settings.show_button %}
    <a href="{{ banner.button_url.value }}" class="btn">{{ banner.button_label.value }}</a>
  {% endif %}
  style="color: {{ section.settings.heading_color }}"
  style="font-size: {{ section.settings.heading_size }}px"
  {{section.settings.banner_image | image_url: width: 1200 | image_tag }}
  style="text-align: {{ section.settings.text_align }}"

</div>
{% endif %}



<style>
  .hero-banner-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    background: #fff8f5;
    border-radius: 12px;
    margin: 2rem auto;
    max-width: 900px;
  }

  .hero-banner-meta img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 2rem;
  }

  .hero-banner-meta .subheading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e07b4f;
    margin-bottom: 0.5rem;
  }

  .hero-banner-meta h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 1rem;
  }

  .hero-banner-meta p {
    font-size: 1rem;
    color: #555;
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .hero-banner-meta .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: #e07b4f;
    color: #fff;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s;
  }

  .hero-banner-meta .btn:hover {
    background: #c9623a;
  }

  @media (max-width: 768px) {
    .hero-banner-meta h2 { font-size: 1.5rem; }
    .hero-banner-meta { padding: 2rem 1rem; }
  }
</style>


{% schema %}
{
  "name": "Hero Banner (Metaobject)",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Custom Heading",
      "placeholder": "Leave blank to use Metaobject heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [{ "name": "Hero Banner Metaobject" }]
}
{% endschema %}
