<style>
  #shopify-section-{{ section.id }} {
    background: #ffffff;
    overflow: hidden;
  }

  .pi-team__header {
    max-width: 1120px;
    margin: 0 auto;
    padding: 100px 60px 50px;
    box-sizing: border-box;
    text-align: center;
  }

  .pi-team__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-transform: uppercase;
    color: #000000;
    margin: 0 0 20px;
  }

  .pi-team__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: 18px;
    line-height: 29px;
    font-weight: 400;
    color: #000000;
    max-width: 1120px;
    margin: 0 auto;
  }

  .pi-team__image {
    width: 100%;
    overflow: hidden;
  }

  .pi-team__image img,
  .pi-team__image .placeholder-svg {
    width: 100%;
    aspect-ratio: 1920 / 708;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  @media (max-width: 989px) {
    .pi-team__header { padding: 70px 32px 36px; }
    .pi-team__heading { font-size: 36px; line-height: 48px; margin-bottom: 18px; }
    .pi-team__text { font-size: 16px; }
  }

  @media (max-width: 749px) {
    .pi-team__header { padding: 50px 20px 28px; }
    .pi-team__heading { font-size: 28px; line-height: 38px; }
  }
</style>

<div class="pi-team__header">
  {%- if section.settings.heading != blank -%}
    <h2 class="pi-team__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <p class="pi-team__text">{{ section.settings.text }}</p>
  {%- endif -%}
</div>

{%- if section.settings.team_image != blank -%}
  <div class="pi-team__image">
    <img
      src="{{ section.settings.team_image | image_url: width: 1920 }}"
      alt="{{ section.settings.team_image.alt | default: 'The Puerto Ink Team' | escape }}"
      loading="lazy"
      width="1920"
      height="708"
    >
  </div>
{%- else -%}
  <div class="pi-team__image">
    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PI Team Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Puerto Ink Team"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "At Puerto Ink, we are more than a team — we are a family of passionate artists and piercing specialists dedicated to turning visions into reality. With diverse styles, exceptional skill, and years of experience, we create custom tattoos and flawless piercings tailored to each client. Rooted in creativity, professionalism, and trust, we foster a welcoming community where artistry thrives, and every visit is a memorable experience."
    },
    {
      "type": "image_picker",
      "id": "team_image",
      "label": "Team photo (wide group shot)"
    }
  ],
  "presets": [
    {
      "name": "PI Team Banner"
    }
  ]
}
{% endschema %}
