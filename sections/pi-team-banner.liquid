<style>
  #shopify-section-{{ section.id }} {
    --pi-team-pad-top: {{ section.settings.padding_top }}px;
    --pi-team-pad-bottom: {{ section.settings.padding_bottom }}px;
    --pi-team-bg: {{ section.settings.bg_color }};
    --pi-team-heading-size: {{ section.settings.heading_size }}px;
    --pi-team-heading-color: {{ section.settings.heading_color }};
    --pi-team-text-size: {{ section.settings.text_size }}px;
    --pi-team-text-color: {{ section.settings.text_color }};
    --pi-team-aspect: {{ section.settings.image_aspect_ratio }};
    background: var(--pi-team-bg);
    overflow: hidden;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-team-pad-top: {{ section.settings.mobile_padding_top }}px;
      --pi-team-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pi-team-heading-size: {{ section.settings.mobile_heading_size }}px;
      --pi-team-text-size: {{ section.settings.mobile_text_size }}px;
    }
  }
</style>

<style>
  .pi-team__header {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--pi-team-pad-top, 100px) 60px var(--pi-team-pad-bottom, 50px);
    box-sizing: border-box;
    text-align: {{ section.settings.text_alignment | default: 'center' }};
  }

  .pi-team__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-team-heading-size, 54px);
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--pi-team-heading-color, #000000);
    margin: 0 0 20px;
  }

  .pi-team__text {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-size: var(--pi-team-text-size, 18px);
    line-height: 1.6;
    font-weight: 400;
    color: var(--pi-team-text-color, #000000);
    max-width: 1120px;
    margin: 0 auto;
  }

  .pi-team__image {
    width: 100%;
    overflow: hidden;
  }
  .pi-team__image picture {
    display: block;
    width: 100%;
  }

  .pi-team__image img,
  .pi-team__image .placeholder-svg {
    width: 100%;
    aspect-ratio: var(--pi-team-aspect, 1920 / 708);
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  @media (max-width: 989px) {
    .pi-team__header { padding-left: 32px; padding-right: 32px; }
    .pi-team__heading { font-size: clamp(28px, 4vw, var(--pi-team-heading-size, 54px)); margin-bottom: 18px; }
    .pi-team__text { font-size: 16px; }
  }

  @media (max-width: 749px) {
    .pi-team__header { padding-left: 20px; padding-right: 20px; }
  }
</style>

<div class="pi-team__header">
  {%- if section.settings.heading != blank -%}
    <h2 class="pi-team__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <p class="pi-team__text">{{ section.settings.text }}</p>
  {%- endif -%}
</div>

{%- if section.settings.team_image != blank -%}
  <div class="pi-team__image">
    <picture>
      {%- if section.settings.mobile_team_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.mobile_team_image | image_url: width: 900 }}"
        >
      {%- endif -%}
      <img
        src="{{ section.settings.team_image | image_url: width: 1920 }}"
        alt="{{ section.settings.team_image.alt | default: 'The Puerto Ink Team' | escape }}"
        loading="lazy"
        width="1920"
        height="708"
      >
    </picture>
  </div>
{%- else -%}
  <div class="pi-team__image">
    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PI Team Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    { "type": "header", "content": "Section Margin" },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Puerto Ink Team"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size (mobile)",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Description Text" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "At Puerto Ink, we are more than a team — we are a family of passionate artists and piercing specialists dedicated to turning visions into reality. With diverse styles, exceptional skill, and years of experience, we create custom tattoos and flawless piercings tailored to each client. Rooted in creativity, professionalism, and trust, we foster a welcoming community where artistry thrives, and every visit is a memorable experience."
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Text size (mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    { "type": "header", "content": "Team Image" },
    {
      "type": "image_picker",
      "id": "team_image",
      "label": "Team photo (wide group shot) — Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_team_image",
      "label": "Team photo — Mobile",
      "info": "Optional. Shown at ≤749px. If empty, the desktop photo is used."
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1920 / 708", "label": "1920:708 (default wide)" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "21 / 9", "label": "21:9 (ultrawide)" },
        { "value": "3 / 1", "label": "3:1" }
      ],
      "default": "1920 / 708"
    }
  ],
  "presets": [
    {
      "name": "PI Team Banner"
    }
  ]
}
{% endschema %}
