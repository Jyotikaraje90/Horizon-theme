<style>
  #shopify-section-{{ section.id }} {
    padding: 80px 0;
    background: #ffffff;
  }

  .pi-lb {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 50px;
  }

  .pi-lb__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 54px;
    line-height: 70px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .pi-lb__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    width: 100%;
  }

  .pi-lb__grid {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  /* Each card: 487×423px */
  .pi-lb__card {
    position: relative;
    flex: 0 0 calc((100% - 40px) / 3);
    height: 423px;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Image: full width × 360px, radius 20px */
  .pi-lb__card-img {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 360px;
    border-radius: 20px;
    overflow: hidden;
    background: #e0e0e0;
    z-index: 1;
  }

  .pi-lb__card-img img,
  .pi-lb__card-img .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Text overlay: top 270px, width ~87.7%, #F0F0F0
     radius 0 top-left / 20px on other three corners */
  .pi-lb__card-text {
    position: absolute;
    top: 270px;
    left: 0;
    width: calc(100% - 60px);
    background: #F0F0F0;
    border-radius: 0 20px 20px 20px;
    padding: 30px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 2;
  }

  .pi-lb__card-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Date badge: #CCCCCC, radius 4px, padding 5px 10px */
  .pi-lb__card-date-wrap {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    background: #CCCCCC;
    border-radius: 4px;
    align-self: flex-start;
  }

  .pi-lb__card-date {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: #000000;
  }

  /* Title: Proxima Nova SemiBold 20px/26px */
  .pi-lb__card-title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA button: black 55px height, radius 8px, uppercase */
  .pi-lb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    background: #000000;
    color: #ffffff;
    border-radius: 8px;
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .pi-lb__btn:hover { opacity: 0.82; }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 1540px) {
    .pi-lb { padding: 0 40px; }
  }

  @media (max-width: 1279px) {
    .pi-lb { padding: 0 40px; }
    .pi-lb__heading { font-size: 44px; line-height: 58px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 60px 0; }
    .pi-lb { padding: 0 32px; gap: 40px; }
    .pi-lb__heading { font-size: 36px; line-height: 48px; }
    .pi-lb__grid { flex-wrap: wrap; }
    .pi-lb__card { flex: 0 0 calc(50% - 10px); height: 380px; }
    .pi-lb__card-img { height: 310px; }
    .pi-lb__card-text { top: 230px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 50px 0; }
    .pi-lb { padding: 0 20px; gap: 30px; }
    .pi-lb__heading { font-size: 28px; line-height: 38px; }
    .pi-lb__grid { flex-direction: column; }
    .pi-lb__card { flex: none; width: 100%; height: 360px; }
    .pi-lb__card-img { height: 290px; }
    .pi-lb__card-text { top: 205px; width: calc(100% - 40px); }
    .pi-lb__card-title { font-size: 18px; line-height: 24px; }
  }
</style>

<div class="pi-lb">

  {%- if section.settings.heading != blank -%}
    <h2 class="pi-lb__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pi-lb__content">

    <div class="pi-lb__grid">
      {%- for block in section.blocks -%}
        {%- assign card_tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign card_tag = 'a' -%}{%- endif -%}

        <{{ card_tag }}
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          class="pi-lb__card"
          {{ block.shopify_attributes }}
        >
          <div class="pi-lb__card-img">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="600"
                height="360"
                loading="lazy"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="pi-lb__card-text">
            <div class="pi-lb__card-inner">
              {%- if block.settings.date != blank -%}
                <span class="pi-lb__card-date-wrap">
                  <span class="pi-lb__card-date">{{ block.settings.date }}</span>
                </span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="pi-lb__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
            </div>
          </div>
        </{{ card_tag }}>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="pi-lb__btn"
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}

  </div>

</div>

{% schema %}
{
  "name": "PI Latest Blogs",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "post",
      "name": "Blog Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Jan 01, 2025"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Blog post title goes here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Blogs"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Blogs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "PI Latest Blogs",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
