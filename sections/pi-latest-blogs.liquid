<style>
  #shopify-section-{{ section.id }} {
    --pi-lb-pad-top: {{ section.settings.padding_top }}px;
    --pi-lb-pad-bottom: {{ section.settings.padding_bottom }}px;
    --pi-lb-bg: {{ section.settings.bg_color }};
    --pi-lb-heading-size: {{ section.settings.heading_size }}px;
    --pi-lb-heading-color: {{ section.settings.heading_color }};
    --pi-lb-card-img-radius: {{ section.settings.card_img_radius }}px;
    --pi-lb-card-text-bg: {{ section.settings.card_text_bg }};
    --pi-lb-card-text-radius: {{ section.settings.card_text_radius }}px;
    --pi-lb-card-title-size: {{ section.settings.card_title_size }}px;
    --pi-lb-card-title-color: {{ section.settings.card_title_color }};
    --pi-lb-date-badge-bg: {{ section.settings.date_badge_bg }};
    --pi-lb-date-badge-radius: {{ section.settings.date_badge_radius }}px;
    --pi-lb-btn-bg: {{ section.settings.btn_bg }};
    --pi-lb-btn-text: {{ section.settings.btn_text }};
    --pi-lb-btn-radius: {{ section.settings.btn_radius }}px;
    --pi-lb-btn-size: {{ section.settings.btn_size }}px;
    --pi-lb-btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --pi-lb-btn-hover-text: {{ section.settings.btn_hover_text }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --pi-lb-pad-top: {{ section.settings.mobile_padding_top }}px;
      --pi-lb-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pi-lb-heading-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
</style>

<style>
  #shopify-section-{{ section.id }} {
    padding: var(--pi-lb-pad-top) 0 var(--pi-lb-pad-bottom);
    background: var(--pi-lb-bg);
  }

  .pi-lb {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 50px;
  }

  .pi-lb__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: var(--pi-lb-heading-size);
    line-height: 70px;
    text-align: {{ section.settings.text_alignment }};
    text-transform: uppercase;
    color: var(--pi-lb-heading-color);
    margin: 0;
  }

  .pi-lb__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    width: 100%;
  }

  .pi-lb__grid {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  /* Each card: 487×423px */
  .pi-lb__card {
    position: relative;
    flex: 0 0 calc((100% - 40px) / 3);
    height: 423px;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Image: full width × 360px, radius from setting */
  .pi-lb__card-img {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 360px;
    border-radius: var(--pi-lb-card-img-radius);
    overflow: hidden;
    background: #e0e0e0;
    z-index: 1;
  }

  .pi-lb__card-img img,
  .pi-lb__card-img .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Text overlay: top 270px, width ~87.7%, background from setting
     radius 0 top-left / setting on other three corners */
  .pi-lb__card-text {
    position: absolute;
    top: 270px;
    left: 0;
    width: calc(100% - 60px);
    background: var(--pi-lb-card-text-bg);
    border-radius: 0 var(--pi-lb-card-text-radius) var(--pi-lb-card-text-radius) var(--pi-lb-card-text-radius);
    padding: 30px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 2;
  }

  .pi-lb__card-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Date badge */
  .pi-lb__card-date-wrap {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    background: var(--pi-lb-date-badge-bg);
    border-radius: var(--pi-lb-date-badge-radius);
    align-self: flex-start;
  }

  .pi-lb__card-date {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: #000000;
  }

  /* Title */
  .pi-lb__card-title {
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: var(--pi-lb-card-title-size);
    line-height: 26px;
    color: var(--pi-lb-card-title-color);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA button */
  .pi-lb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 16px 32px;
    background: var(--pi-lb-btn-bg);
    color: var(--pi-lb-btn-text);
    border-radius: var(--pi-lb-btn-radius);
    font-family: 'Proxima Nova', 'Nunito Sans', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: var(--pi-lb-btn-size);
    line-height: 21px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .pi-lb__btn:hover {
    background: var(--pi-lb-btn-hover-bg);
    color: var(--pi-lb-btn-hover-text);
    opacity: 1;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 1540px) {
    .pi-lb { padding: 0 40px; }
  }

  @media (max-width: 1279px) {
    .pi-lb { padding: 0 40px; }
    .pi-lb__heading { font-size: 44px; line-height: 58px; }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} { padding: 60px 0; }
    .pi-lb { padding: 0 40px; gap: 40px; }
    .pi-lb__heading { font-size: 36px; line-height: 48px; }
    .pi-lb__grid { flex-wrap: wrap; }
    .pi-lb__card { flex: 0 0 calc(50% - 10px); height: 380px; }
    .pi-lb__card-img { height: 310px; }
    .pi-lb__card-text { top: 230px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding: 0 0 30px; }
    .pi-lb { padding: 0 10px; gap: 20px; }
    .pi-lb__heading { font-size: 30px; line-height: 39px; }
    .pi-lb__grid { flex-direction: row; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .pi-lb__grid::-webkit-scrollbar { display: none; }
    .pi-lb__card { flex: 0 0 250px; height: 287px; }
    .pi-lb__card-img { height: 185px; border-radius: 8px; }
    .pi-lb__card-text { top: 139px; width: 230px; padding: 20px; gap: 12px; border-radius: 0 8px 8px 8px; }
    .pi-lb__card-title { font-size: 18px; line-height: 23px; -webkit-line-clamp: unset; display: block; overflow: visible; }
    .pi-lb__card-date { font-size: 12px; line-height: 18px; }
    .pi-lb__btn { width: 100%; height: 50px; padding: 16px 32px; }
    .pi-lb__content { gap: 20px; }
  }
</style>

<div class="pi-lb">

  {%- if section.settings.heading != blank -%}
    <h2 class="pi-lb__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pi-lb__content">

    <div class="pi-lb__grid">
      {%- for block in section.blocks -%}
        {%- assign card_tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign card_tag = 'a' -%}{%- endif -%}

        <{{ card_tag }}
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          class="pi-lb__card"
          {{ block.shopify_attributes }}
        >
          <div class="pi-lb__card-img">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="600"
                height="360"
                loading="lazy"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="pi-lb__card-text">
            <div class="pi-lb__card-inner">
              {%- if block.settings.date != blank -%}
                <span class="pi-lb__card-date-wrap">
                  <span class="pi-lb__card-date">{{ block.settings.date }}</span>
                </span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="pi-lb__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
            </div>
          </div>
        </{{ card_tag }}>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="pi-lb__btn"
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}

  </div>

</div>

{% schema %}
{
  "name": "PI Latest Blogs",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "post",
      "name": "Blog Post",
