<style>
.pi-main-banner {
  position: relative;
  width: 100%;
  height: 75vh;
  min-height: 450px;
  border-radius: 20px;
  overflow: hidden;
}
.pi-main-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.pi-main-banner__content {
  position: absolute;
  bottom: 40px;
  left: 40px;
  color: #fff;
}
.pi-main-banner__content h1 {
  font-size: 3rem;
  font-weight: 800;
  text-transform: uppercase;
  line-height: 1.1;
  margin-bottom: 16px;
}
.pi-main-banner__content p {
  margin-bottom: 24px;
  max-width: 400px;
}
.pi-main-banner__btn {
  display: inline-block;
  padding: 12px 24px;
  border: 2px solid #fff;
  color: #fff;
  text-decoration: none;
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  background: transparent;
}
.pi-main-banner__btn:hover {
  background: #fff;
  color: #000;
}
</style>

<div class="pi-main-banner">
  <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}">
  <div class="pi-main-banner__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="pi-main-banner__btn">{{ section.settings.button_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "PI Main Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Art of Self Expression With Puerto Ink" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The #1 Tattoo and Piercing Studio." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Book an Appointment" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "PI Main Banner" }]
}
{% endschema %}
