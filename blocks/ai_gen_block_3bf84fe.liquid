{% doc %}
  @prompt
    Create a product metafields display block for a premium jewelry store. It should display the following metafields in a clean, minimal layout: Metal Type (custom.metal_type), Gemstone (custom.gemstone), Piercing Type (custom.piercing_type), Material (custom.material), Certification/Hallmark (custom.certification_hallmark), After Care Instructions (custom.after_care_instructions), Package Contents (custom.package_contents), and Care Guide (custom.care_guide, which is a rich text field). Only show fields that have values. Style should match a modern, luxury jewelry brand aesthetic — clean typography, subtle separators, no heavy borders. The Care Guide should render as formatted rich text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign metafield_keys = 'metal_type,gemstone,piercing_type,material,certification_hallmark,after_care_instructions,package_contents,care_guide' | split: ',' %}
{% assign metafield_labels = 'Metal Type,Gemstone,Piercing Type,Material,Certification/Hallmark,After Care Instructions,Package Contents,Care Guide' | split: ',' %}

{% style %}
  .ai-metafields-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; color: {{ block.settings.text_color }}; }
  .ai-metafields-{{ ai_gen_id }}__heading { margin: 0 0 24px; color: {{ block.settings.heading_color }}; font-family: {{ settings.type_heading_font.family }}; font-size: {{ block.settings.heading_size }}px; font-weight: 600; letter-spacing: 0.02em; }
  .ai-metafields-{{ ai_gen_id }}__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid {{ block.settings.separator_color }}; }
  .ai-metafields-{{ ai_gen_id }}__item { display: grid; grid-template-columns: minmax(110px, 38%) 1fr; gap: 20px; padding: 16px 0; margin-right: 32px; border-bottom: 1px solid {{ block.settings.separator_color }}; }
  .ai-metafields-{{ ai_gen_id }}__label { color: {{ block.settings.label_color }}; font-family: {{ settings.type_subheading_font.family }}; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; line-height: 1.5; text-transform: uppercase; }
  .ai-metafields-{{ ai_gen_id }}__value { color: {{ block.settings.text_color }}; font-family: {{ settings.type_body_font.family }}; font-size: 14px; line-height: 1.6; }
  .ai-metafields-{{ ai_gen_id }}__value p:first-child { margin-top: 0; }
  .ai-metafields-{{ ai_gen_id }}__value p:last-child { margin-bottom: 0; }
  .ai-metafields-{{ ai_gen_id }}__care { grid-column: 1 / -1; margin-right: 0; }
  .ai-metafields-{{ ai_gen_id }}__care .ai-metafields-{{ ai_gen_id }}__value { max-width: 760px; }
  @media screen and (max-width: 749px) { .ai-metafields-{{ ai_gen_id }}__list { grid-template-columns: 1fr; } .ai-metafields-{{ ai_gen_id }}__item { margin-right: 0; } .ai-metafields-{{ ai_gen_id }}__care { grid-column: auto; } }
{% endstyle %}

<product-metafields-{{ ai_gen_id }} class="ai-metafields-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign metafield_count = 0 %}
  {% for key in metafield_keys %}
    {% if product.metafields.custom[key] != blank %}{% assign metafield_count = metafield_count | plus: 1 %}{% endif %}
  {% endfor %}
  {% if metafield_count > 0 %}
    {% if block.settings.heading != blank %}<h2 class="ai-metafields-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-metafields-{{ ai_gen_id }}__list">
      {% for key in metafield_keys %}
        {% assign field = product.metafields.custom[key] %}
        {% assign label = metafield_labels[forloop.index0] %}
        {% if field != blank %}
          <div class="ai-metafields-{{ ai_gen_id }}__item{% if key == 'care_guide' %} ai-metafields-{{ ai_gen_id }}__care{% endif %}">
            <div class="ai-metafields-{{ ai_gen_id }}__label">{{ label }}</div>
            <div class="ai-metafields-{{ ai_gen_id }}__value">{% if key == 'care_guide' %}{{ field | metafield_tag }}{% else %}{{ field.value | escape | newline_to_br }}{% endif %}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</product-metafields-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 14, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#000000" },
    { "type": "color", "id": "label_color", "label": "Labels", "default": "#555555" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "separator_color", "label": "Separators", "default": "#E6E6E6" }
  ],
  "presets": [{ "name": "Product details" }],
  "tag": null,
  "class": "product-details-block"
}
{% endschema %}